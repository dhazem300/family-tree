  <script>
    (function () {
      const btn = document.getElementById("uiThemeBtn");
      function applyTheme(next) {
        document.documentElement.setAttribute("data-theme", next);
        document.documentElement.classList.toggle("dark", next === "dark");
        localStorage.setItem("theme", next);
      }
      btn?.addEventListener("click", () => {
        const current = document.documentElement.getAttribute("data-theme") || "dark";
        applyTheme(current === "dark" ? "light" : "dark");
      });
      applyTheme(localStorage.getItem("theme") || "dark");
    })();

    (function mobileNavInit(){
      const btn = document.getElementById("mobileNavBtn");
      const navDrawer = document.getElementById("mobileNavDrawer");
      const overlay = document.getElementById("mobileNavOverlay");
      const closeBtn = document.getElementById("mobileNavClose");

      function setOpenState(isOpen){
        btn?.setAttribute("data-open", isOpen ? "true" : "false");
        btn?.setAttribute("aria-expanded", isOpen ? "true" : "false");
      }

      function openNav(){
        overlay?.classList.remove("mobile-nav-hidden");
        overlay?.style.setProperty('display', 'block', 'important');
        navDrawer?.classList.add("isOpen");
        setOpenState(true);
        document.body.classList.add('overflow-hidden');
      }
      function closeNav(){
        navDrawer?.classList.remove("isOpen");
        overlay?.classList.add("mobile-nav-hidden");
        overlay?.style.setProperty('display', 'none', 'important');
        setOpenState(false);
        document.body.classList.remove('overflow-hidden');
      }

      btn?.addEventListener("click", () => {
        const open = btn.getAttribute("data-open") === "true";
        open ? closeNav() : openNav();
      });

      closeBtn?.addEventListener("click", closeNav);
      overlay?.addEventListener("click", closeNav);
      navDrawer?.querySelectorAll("a").forEach(a => a.addEventListener("click", closeNav));
      window.addEventListener("keydown", (e) => { if (e.key === "Escape") closeNav(); });

      setOpenState(false);
    })();
  </script>

  <script>
    const initialPersonId = <%- JSON.stringify(initialPersonId || null) %>;
    let selectedPerson = null;
    let branchData = null;
    const $ = (id) => document.getElementById(id);
    function esc(v){return String(v ?? '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));}
    function firstLetter(name){
      const v = String(name || 'فرد').trim();
      return v ? v[0] : 'ف';
    }
    
    function photoHtml(person, root=false){
      if(person.is_virtual_root){
        return `<div class="node-portrait placeholder male"><span class="material-symbols-outlined text-[36px]">account_tree</span></div>`;
      }
      const genderClass = String(person.gender || '').toLowerCase().includes('female') || String(person.gender || '').includes('أنث') ? 'female' : 'male';
      if(person.photo_url){
        const fallback = firstLetter(person.name);
        return `<div class="node-portrait ${genderClass}"><img src="${esc(person.photo_url)}" alt="${esc(person.name || '')}" crossorigin="anonymous" onerror="this.parentElement.outerHTML='<div class=&quot;node-portrait placeholder ${genderClass}&quot;>${esc(fallback)}</div>'"></div>`;
      }
      return `<div class="node-portrait placeholder ${genderClass}">${esc(firstLetter(person.name))}</div>`;
    }
    
    function nodeHtml(person, root=false){
      const children = person.children || [];
      const job = person.job ? `<span class="node-job">${esc(person.job)}</span>` : '';
      return `<li><div class="export-node ${root ? 'root' : ''}">
        ${photoHtml(person, root)}
        <div class="name-box"><span class="node-label-text" title="${esc(person.name || '')}">${esc(person.name)}</span>${job}</div>
      </div>${children.length ? `<ul>${children.map(c=>nodeHtml(c,false)).join('')}</ul>` : ''}</li>`;
    }
    

    function fullPhotoHtml(person){
      const src = person.photo_url || '';
      const letter = (person.name || 'ش').trim().slice(0,1) || 'ش';
      if(src){
        return `<div class="full-tree-node-photo"><img src="${esc(src)}" loading="lazy" decoding="async" onerror="this.parentElement.textContent='${esc(letter)}'; this.remove();"></div>`;
      }
      return `<div class="full-tree-node-photo">${esc(letter)}</div>`;
    }

    function renderFullTreeFast(data){
      // رغم اسم الدالة القديم، هذا الوضع يرسم مخطط شجرة كامل بخطوط ربط حقيقية، وليس قائمة أسماء.
      // الاعتماد هنا على absolute-positioned nodes + SVG connectors لتقليل البطء مقارنة بـ UL متداخلة ضخمة.
      branchData = data;
      const created = new Date().toLocaleDateString('ar-EG');
      const people = Array.isArray(data.persons) ? data.persons.map(p => ({...p, id:Number(p.id||0), primary_parent_id:Number(p.primary_parent_id||0) || null})) : [];
      const includePhotos = !!data.options?.includePhotos;
      const byId = new Map(people.filter(p=>p.id).map(p => [p.id, p]));
      const childrenByParent = new Map();
      const roots = [];

      people.forEach((p) => {
        const pid = Number(p.primary_parent_id || 0);
        if(pid && byId.has(pid) && pid !== p.id){
          if(!childrenByParent.has(pid)) childrenByParent.set(pid, []);
          childrenByParent.get(pid).push(p);
        } else {
          roots.push(p);
        }
      });
      for(const list of childrenByParent.values()) list.sort((a,b)=>a.id-b.id);
      roots.sort((a,b)=>a.id-b.id);

      const slotMemo = new Map();
      function subtreeSlots(person, stack = new Set()){
        const id = Number(person?.id || 0);
        if(!id || stack.has(id)) return 1;
        if(slotMemo.has(id)) return slotMemo.get(id);
        stack.add(id);
        const children = childrenByParent.get(id) || [];
        let slots = children.length ? children.reduce((sum, child) => sum + subtreeSlots(child, stack), 0) : 1;
        slots = Math.max(1, slots);
        stack.delete(id);
        slotMemo.set(id, slots);
        return slots;
      }

      const NODE_W = includePhotos ? 132 : 122;
      const NODE_H = includePhotos ? 78 : 58;
      const SLOT_W = includePhotos ? 158 : 145;
      const LEVEL_H = includePhotos ? 122 : 98;
      const PAD_X = 36;
      const PAD_Y = 32;
      const ROOT_GAP = 1;
      const positions = new Map();
      let maxDepth = 0;
      let totalSlots = 0;

      function place(person, startSlot, depth, stack = new Set()){
        const id = Number(person?.id || 0);
        if(!id || positions.has(id) || stack.has(id)) return subtreeSlots(person);
        stack.add(id);
        const slots = subtreeSlots(person);
        const x = PAD_X + startSlot * SLOT_W + (slots * SLOT_W - NODE_W) / 2;
        const y = PAD_Y + depth * LEVEL_H;
        positions.set(id, {x, y, depth, slots});
        maxDepth = Math.max(maxDepth, depth);
        let childStart = startSlot;
        const children = childrenByParent.get(id) || [];
        children.forEach((child) => {
          place(child, childStart, depth + 1, stack);
          childStart += subtreeSlots(child);
        });
        stack.delete(id);
        return slots;
      }

      let cursor = 0;
      roots.forEach((root) => {
        const slots = place(root, cursor, 0);
        cursor += slots + ROOT_GAP;
      });
      // ضمان أي فرد لم يتم رسمه بسبب دورة أو علاقة غير سليمة يظهر كجذر مستقل بدل الاختفاء.
      people.forEach((p) => {
        if(!positions.has(p.id)){
          const slots = place(p, cursor, 0);
          cursor += slots + ROOT_GAP;
        }
      });
      totalSlots = Math.max(cursor, 8);

      const diagramW = Math.ceil(PAD_X * 2 + totalSlots * SLOT_W);
      const diagramH = Math.ceil(PAD_Y * 2 + (maxDepth + 1) * LEVEL_H + NODE_H);
      const rootIds = new Set(roots.map(r=>r.id));

      const paths = [];
      people.forEach((p) => {
        const pos = positions.get(p.id);
        const pid = Number(p.primary_parent_id || 0);
        if(!pos || !pid || !positions.has(pid)) return;
        const parent = positions.get(pid);
        const x1 = parent.x + NODE_W / 2;
        const y1 = parent.y + NODE_H;
        const x2 = pos.x + NODE_W / 2;
        const y2 = pos.y;
        const midY = y1 + Math.max(22, (y2 - y1) / 2);
        paths.push(`<path d="M ${x1.toFixed(1)} ${y1.toFixed(1)} V ${midY.toFixed(1)} H ${x2.toFixed(1)} V ${y2.toFixed(1)}" />`);
      });

      const nodes = people.map((p) => {
        const pos = positions.get(p.id);
        if(!pos) return '';
        const hasPhoto = includePhotos && p.photo_url;
        const isRoot = rootIds.has(p.id);
        const childrenCount = Number(p.children_count || (childrenByParent.get(p.id)||[]).length || 0);
        const meta = childrenCount ? `${childrenCount} أبناء` : (p.job || p.birth_date || '');
        return `<div class="full-tree-node ${hasPhoto ? '' : 'no-photo'} ${isRoot ? 'is-root' : ''}" style="left:${pos.x.toFixed(1)}px;top:${pos.y.toFixed(1)}px;width:${NODE_W}px;min-height:${NODE_H}px">
          ${includePhotos ? fullPhotoHtml(p) : ''}
          <div class="full-tree-node-name" title="${esc(p.name || '')}">${esc(p.name || 'بدون اسم')}</div>
          <div class="full-tree-node-meta" title="${esc(meta)}">${esc(meta)}</div>
        </div>`;
      }).join('');

      $('previewStats').innerHTML = `<span class="font-bold text-gray-700 dark:text-gray-300 px-2 py-1 rounded bg-gray-100 dark:bg-white/5 text-[12px] border border-gray-200 dark:border-white/5 mr-2">${data.personsCount || people.length || 0} أفراد</span><span class="font-bold text-gray-700 dark:text-gray-300 px-2 py-1 rounded bg-gray-100 dark:bg-white/5 text-[12px] border border-gray-200 dark:border-white/5 mr-2">${data.generationsCount || (maxDepth+1) || 0} أجيال</span><span class="font-bold text-gray-700 dark:text-gray-300 px-2 py-1 rounded bg-gray-100 dark:bg-white/5 text-[12px] border border-gray-200 dark:border-white/5 mr-2">مخطط شجرة كامل</span><span class="font-bold text-gray-700 dark:text-gray-300 px-2 py-1 rounded bg-gray-100 dark:bg-white/5 text-[12px] border border-gray-200 dark:border-white/5">${includePhotos ? 'بإرفاق الصور' : 'بدون صور'}</span>`;

      const el = $('exportCanvas');
      el.classList.remove('full-fast-sheet');
      el.classList.add('full-diagram-sheet');
      el.innerHTML = `
        <div class="export-sheet-header">
          <div><h1 class="export-title">${esc(data.title || 'المخطط الكامل للشجرة')}</h1><div class="export-subtitle">كل الأشخاص المسجلين داخل الشجرة التفاعلية كمخطط متصل — ${created}</div></div>
          <div class="export-meta"><span>${data.personsCount || people.length || 0} فرد</span><span>${data.generationsCount || (maxDepth+1) || 0} جيل</span><span>${includePhotos ? 'مرفق بالصور' : 'بدون صور'}</span></div>
        </div>
        <div class="full-tree-diagram-wrap">
          <div class="full-tree-diagram-info"><span>هذا مخطط كامل حقيقي: كل اسم داخل الشجرة يظهر في مكانه مع خطوط الأبناء، وليس قائمة أسماء.</span><span>${roots.length} أصل / فرع رئيسي</span></div>
          <div class="full-tree-diagram" style="width:${diagramW}px;height:${diagramH}px">
            <svg class="full-tree-connectors" viewBox="0 0 ${diagramW} ${diagramH}" preserveAspectRatio="none">${paths.join('')}</svg>
            ${nodes || '<div class="empty-state">لا توجد أسماء داخل الشجرة.</div>'}
          </div>
        </div>`;
      $('exportPdf').disabled = false;
    }

    function renderBranch(data){
      if(data && data.mode === 'full_tree' && Array.isArray(data.persons)) {
        renderFullTreeFast(data);
        return;
      }
      $('exportCanvas').classList.remove('full-fast-sheet','full-diagram-sheet');
      branchData = data;
      const created = new Date().toLocaleDateString('ar-EG');
      const extraBadge = data.mode === 'full_tree'
        ? `<span class="font-bold text-gray-700 dark:text-gray-300 px-2 py-1 rounded bg-gray-100 dark:bg-white/5 text-[12px] border border-gray-200 dark:border-white/5 mr-2">${data.rootsCount || 0} أصل رئيسي</span>`
        : `<span class="font-bold text-gray-700 dark:text-gray-300 px-2 py-1 rounded bg-gray-100 dark:bg-white/5 text-[12px] border border-gray-200 dark:border-white/5 mr-2">${data.ancestorsCount || 0} أجداد</span>`;
      $('previewStats').innerHTML = `<span class="font-bold text-gray-700 dark:text-gray-300 px-2 py-1 rounded bg-gray-100 dark:bg-white/5 text-[12px] border border-gray-200 dark:border-white/5 mr-2">${data.personsCount || 0} أفراد</span><span class="font-bold text-gray-700 dark:text-gray-300 px-2 py-1 rounded bg-gray-100 dark:bg-white/5 text-[12px] border border-gray-200 dark:border-white/5 mr-2">${data.generationsCount || 0} أجيال</span>${extraBadge}<span class="font-bold text-gray-700 dark:text-gray-300 px-2 py-1 rounded bg-gray-100 dark:bg-white/5 text-[12px] border border-gray-200 dark:border-white/5">${data.options?.includePhotos ? 'بإرفاق الصور' : 'بدون صور'}</span>`;
      
      $('exportCanvas').innerHTML = `
        <div class="export-sheet-header">
          <div><h1 class="export-title">${esc(data.title || 'فرع من شجرة العائلة')}</h1><div class="export-subtitle">ملف صادر من المنصة الرسمية لشجرة العائلة — ${created}</div></div>
          <div class="export-meta"><span>${data.personsCount || 0} فرد</span><span>${data.generationsCount || 0} جيل</span><span>${data.options?.includePhotos ? 'مرفق بالصور' : 'بدون صور'}</span></div>
        </div>
        <div class="branch-tree-shell">
          <div class="branch-tree"><ul>${nodeHtml(data.tree,true)}</ul></div>
        </div>
      `;
      $('exportPdf').disabled = false;
    }
    
    function candidateCard(c){
      return `<button type="button" data-id="${c.id}" class="candidate w-full text-right p-3 rounded-xl border border-gray-200 dark:border-white/10 bg-white dark:bg-[#111] hover:border-primary dark:hover:border-accent-gold transition-colors mb-2"><div class="font-bold text-[14px] text-gray-800 dark:text-white">${esc(c.name)}</div><div class="text-[11px] text-gray-500 font-bold mt-1">${esc(c.lineage_label || '')}</div></button>`;
    }
    
    async function searchPeople(q){
      $('searchMessage').textContent = 'جاري البحث...';
      $('candidates').innerHTML = '';
      const r = await fetch('/api/tree/export/search?q=' + encodeURIComponent(q), {cache:'no-store'});
      const data = await r.json();
      if(!data.ok){ $('searchMessage').innerHTML = `<span class="text-red-500">${data.error || 'تعذر البحث.'}</span>`; return; }
      if(!data.candidates?.length){ $('searchMessage').textContent = data.message || 'لا توجد نتائج مطابقة.'; return; }
      $('searchMessage').textContent = data.status === 'multiple' ? 'تم العثور على عدة أشخاص، اختر الشخص المطلوب:' : 'تم العثور على الشخص، اضغط للتحديد.';
      $('candidates').innerHTML = data.candidates.map(candidateCard).join('');
      
      document.querySelectorAll('.candidate').forEach(btn => btn.addEventListener('click', () => {
        selectedPerson = data.candidates.find(x => Number(x.id) === Number(btn.dataset.id));
        document.querySelectorAll('.candidate').forEach(b => b.classList.remove('is-selected'));
        btn.classList.add('is-selected');
        $('loadBranch').disabled = false;
        $('loadBranch').className = 'w-full h-12 rounded-xl bg-white dark:bg-[#111] text-primary dark:text-accent-gold border border-primary dark:border-accent-gold font-bold text-[14px] transition-all hover:bg-gray-50 dark:hover:bg-white/5';
        $('searchMessage').innerHTML = `تم التحديد: <span class="text-primary dark:text-accent-gold font-bold">${selectedPerson.name}</span>`;
      }));
    }
    
    $('searchForm').addEventListener('submit', (e) => { e.preventDefault(); const q=$('personName').value.trim(); if(q) searchPeople(q); });
    
    
    async function loadFullTreeData(autoPdf=false){
      const btn = $('loadFullTree');
      const printBtn = $('exportFullPdf');
      const oldBtn = btn?.innerHTML;
      const oldPrint = printBtn?.innerHTML;
      if(btn) { btn.disabled = true; btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">refresh</span> جاري تجهيز مخطط كل الشجرة...'; }
      if(printBtn && autoPdf) { printBtn.disabled = true; printBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">refresh</span> جاري تجهيز كل الشجرة للطباعة...'; }
      try {
        const photos = $('includePhotos').checked ? '1' : '0';
        const r = await fetch(`/api/tree/export/full?photos=${photos}&compact=1`, {cache:'no-store'});
        const data = await r.json();
        if(!data.ok){ alert(data.error || 'تعذر تجهيز المخطط الكامل'); return false; }
        selectedPerson = null;
        renderBranch(data);
        $('searchMessage').innerHTML = `<span class="text-primary dark:text-accent-gold font-bold">تم تجهيز المخطط الكامل للشجرة</span>`;
        if(autoPdf){
          await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
          await exportToPdf();
        }
        return true;
      } finally {
        if(btn) { btn.disabled = false; btn.innerHTML = oldBtn || '<span class="material-symbols-outlined text-[19px]">account_tree</span> معاينة كل الشجرة'; }
        if(printBtn) { printBtn.disabled = false; printBtn.innerHTML = oldPrint || '<span class="material-symbols-outlined text-[19px]">print</span> طباعة كل الشجرة PDF'; }
      }
    }
    
$('loadBranch').addEventListener('click', async () => {
      if(!selectedPerson) return;
      $('loadBranch').innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">refresh</span> جاري التجهيز...';
      const gen = $('generations').value === 'all' ? 'all' : $('generations').value;
      const photos = $('includePhotos').checked ? '1' : '0';
      const r = await fetch(`/api/tree/export/branch/${selectedPerson.id}?generations=${encodeURIComponent(gen)}&photos=${photos}`, {cache:'no-store'});
      const data = await r.json();
      $('loadBranch').innerHTML = 'تجهيز مخطط الاسم مرة أخرى';
      if(!data.ok){ alert(data.error || 'تعذر تجهيز الفرع'); return; }
      renderBranch(data);
    });
    
    async function exportToPdf(){
      if(!branchData) return;
      if(!window.html2canvas || !window.jspdf){ alert('مكتبات إصدار PDF لم يتم تحميلها. تأكد من اتصال الإنترنت ثم أعد المحاولة.'); return; }
      const btn = $('exportPdf'); btn.disabled = true; btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[20px]">refresh</span> جاري الإنشاء...';
      await document.fonts?.ready?.catch(()=>{});
      const el = $('exportCanvas');
      
      // Ensures background remains white for PDF despite dark mode preference of user device.
      const isFullTreePdf = branchData?.mode === 'full_tree';
      const personCountForPdf = Number(branchData?.personsCount || 0);
      const pdfScale = isFullTreePdf ? (personCountForPdf > 1800 ? 0.45 : personCountForPdf > 1000 ? 0.58 : personCountForPdf > 500 ? 0.75 : 1) : 2;
      const canvas = await html2canvas(el, {
        scale: pdfScale,
        useCORS: true, 
        allowTaint: true, 
        backgroundColor: '#ffffff', 
        logging: false, 
        windowWidth: el.scrollWidth,
        windowHeight: el.scrollHeight
      });
      
      const img = canvas.toDataURL('image/png', 1.0);
      const { jsPDF } = window.jspdf;
      const format = $('pdfFormat').value;
      const orientation = $('pdfOrientation').value;
      const pdf = new jsPDF({orientation, unit:'pt', format});
      const pageW = pdf.internal.pageSize.getWidth();
      const pageH = pdf.internal.pageSize.getHeight();
      const margin = 24;
      const imgW = pageW - margin*2;
      const imgH = canvas.height * imgW / canvas.width;
      const usableH = pageH - margin*2;
      let heightLeft = imgH;
      let position = margin;
      pdf.addImage(img, 'PNG', margin, position, imgW, imgH, undefined, 'FAST');
      heightLeft -= usableH;
      while(heightLeft > 5){
        pdf.addPage(format, orientation);
        position = margin - (imgH - heightLeft);
        pdf.addImage(img, 'PNG', margin, position, imgW, imgH, undefined, 'FAST');
        heightLeft -= usableH;
      }
      const safeTitle = (branchData.title || branchData.root?.name || 'الشجرة').replace(/[\/:*?"<>|]/g,'-');
      const filename = `${branchData.mode === 'full_tree' ? 'الشجرة-الكاملة' : 'مخطط'}-${safeTitle}.pdf`;
      pdf.save(filename);
      fetch('/api/tree/export/log', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({person_id: branchData.mode === 'full_tree' ? null : branchData.root?.id, person_name: branchData.mode === 'full_tree' ? 'الشجرة كاملة' : branchData.root?.name, export_title: branchData.title, persons_count: branchData.personsCount, generations_count: branchData.generationsCount, options: {...(branchData.options || {}), mode: branchData.mode || 'branch'}})}).catch(()=>{});
      btn.disabled = false; btn.innerHTML = '<span class="material-symbols-outlined text-[20px]">picture_as_pdf</span> إصدار PDF للمعاينة الحالية';
    }
    
    $('loadFullTree').addEventListener('click', () => loadFullTreeData(false));
    $('exportFullPdf').addEventListener('click', () => loadFullTreeData(true));
    $('exportPdf').addEventListener('click', exportToPdf);
    if(initialPersonId){ selectedPerson = {id: initialPersonId}; $('loadBranch').disabled=false; $('loadBranch').click(); }
  </script>
  <script src="/chat-notifications.js"></script>
</body>
</html>