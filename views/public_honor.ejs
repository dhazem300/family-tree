  <main class="flex-grow relative">

    <section class="pt-16 pb-12 px-6 max-w-[90rem] mx-auto text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-islamic-pattern opacity-40 dark:opacity-10 pointer-events-none"></div>

      <img src="/assets/logo-dark.svg" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] md:w-[600px] opacity-[0.02] pointer-events-none hidden dark:block" alt="">
      <img src="/assets/logo-light.svg" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] md:w-[600px] opacity-[0.02] pointer-events-none block dark:hidden" alt="">

      <div class="w-px h-10 bg-gradient-to-b from-transparent via-accent to-transparent mx-auto mb-5 relative z-10"></div>
      
      <p class="text-[10px] md:text-xs font-sans font-bold tracking-[0.2em] uppercase text-gray-400 dark:text-gray-500 mb-2 relative z-10">توثيق التاريخ</p>

      <h1 class="text-4xl md:text-6xl font-display leading-tight mb-4 relative z-10 font-bold">
        <span class="text-primary dark:text-white transition-colors duration-300">قائمة السير</span> <span class="text-accent">الذاتية</span>
      </h1>
      
      <p class="text-[14px] md:text-base font-sans text-gray-500 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed relative z-10 font-medium">
        توثيقٌ بصري ومكتوب لسير قامات العائلة، نعرض فيه تاريخاً كُتب بماء الذهب ليبقى إرثاً تتوارثه الأجيال.
      </p>

      <div class="mt-10 max-w-lg mx-auto relative group/search z-10">
        <div class="search-glass rounded-full flex items-center px-4 py-2 relative z-20">
           <span class="material-symbols-outlined text-gray-400 ml-2">search</span>
           <input id="honorSearch" class="block w-full bg-transparent border-0 focus:ring-0 text-[15px] font-sans font-medium text-gray-800 dark:text-white placeholder-gray-400 py-2.5" placeholder="ابحث بالاسم، الإنجاز، أو النبذة..." type="text" autocomplete="off" />
           <button id="clearSearch" type="button" class="shrink-0 flex items-center justify-center w-8 h-8 rounded-full text-gray-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors" style="display:none" title="مسح">
             <span class="material-symbols-outlined text-[18px]">close</span>
           </button>
        </div>
        <div class="mt-4 text-[11px] font-sans font-bold tracking-widest text-gray-400 dark:text-gray-500 uppercase">
          <span id="resultCount">النتائج: 0 / 0</span>
        </div>
      </div>
    </section>

    <section class="py-10 px-4 sm:px-6 lg:px-8 max-w-[96rem] mx-auto relative z-10">
      <% if (!items || items.length === 0) { %>
        <div class="text-center py-20 border border-dashed border-gray-300 dark:border-white/10 max-w-2xl mx-auto p-12 rounded-[16px] bg-white/50 dark:bg-black/20 backdrop-blur-sm shadow-sm">
          <div class="w-16 h-16 mx-auto rounded-full bg-primary/5 dark:bg-white/5 border border-primary/10 dark:border-white/10 text-primary dark:text-accent flex items-center justify-center mb-5">
            <span class="material-symbols-outlined text-[32px]">auto_awesome</span>
          </div>
          <h2 class="text-2xl font-display font-bold text-primary dark:text-white mb-2">القائمة فارغة حالياً</h2>
          <p class="font-sans text-[15px] font-medium text-gray-500">أضف عناصر من لوحة الإدارة → إدارة السير الذاتية.</p>
        </div>
      <% } else { %>
        
        <div id="honorGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 md:gap-8">
          <% for (let i=0; i<items.length; i++){ const x = items[i]; %>
            
            <article
              class="hon-card group cursor-pointer js-open-details aspect-[3/4] sm:aspect-[2/3] flex flex-col"
              id="honor-item-<%= x.id %>"
              data-id="<%= x.id %>"
              data-person-id="<%= x.person_id || x.id %>"
              data-search="<%= [x.name||'', x.field||'', x.achievement||'', x.bio||'', x.birth_date||'', x.death_date||'', x.birth_place||''].join(' ') %>"
              data-name="<%= x.name || '' %>"
              data-field="<%= x.field || '' %>"
              data-achievement="<%= x.achievement || '' %>"
              data-bio="<%= x.bio || '' %>"
              data-birth-date="<%= x.birth_date || '' %>"
              data-death-date="<%= x.death_date || '' %>"
              data-birth-place="<%= x.birth_place || '' %>"
              data-photo="<%= x.photo_url || '' %>"
            >
              <div class="absolute inset-0 bg-gray-100 dark:bg-[#080808]">
                <% if (x.photo_url) { %>
