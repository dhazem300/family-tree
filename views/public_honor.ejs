<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>قائمة السير الذاتية - شجرة العائلة</title>

  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/styles.css"/>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@300;400;500;700;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries,line-clamp"></script>

  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#005A2B",     /* اللون الأخضر الملكي الفاخر */
            primaryDark: "#003D1D", /* أخضر داكن للتحويم */
            accent: "#E5B869",      /* ذهب سائل */
            "accent-gold": "#E5B869",
            "background-light": "#F8F8F6",
            "background-dark": "#050505",
            "bg-charcoal": "#050505",
            "card-light": "#FFFFFF",
            "card-dark": "#0A0A0A",
            "bg-card": "#0A0A0A",
            "text-cream": "#FAFAFA",
            "text-dark": "#111827",
            "text-muted": "#71717A",
            "muted-slate": "#71717A",
            gold: "#E5B869",
            "accent-gold-dark": "#D4A353",
          },
          fontFamily: {
            display: ["'Aref Ruqaa'", "serif"],
            sans: ["Tajawal", "sans-serif"],
          },
          backgroundImage: {
            "islamic-pattern": "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E5B869' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")",
            "islamic-pattern-dark": "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E5B869' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")"
          },
          boxShadow: {
            'luxury': '0 20px 40px -10px rgba(0,0,0,0.05), 0 0 20px rgba(229,184,105,0.03)',
            'luxury-dark': '0 20px 40px -10px rgba(0,0,0,0.4), 0 0 20px rgba(229,184,105,0.05)',
          }
        }
      }
    };
  </script>

  <style type="text/tailwindcss">
    @layer utilities {
      .scrollbar-hide::-webkit-scrollbar { display: none; }
      .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
      .glass-panel {
        @apply bg-white/85 dark:bg-[#080808]/85 backdrop-blur-xl border border-accent-gold/20 shadow-luxury dark:shadow-luxury-dark;
      }
    }
  </style>

  <style>
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(229, 184, 105, 0.4); border-radius: 4px; transition: background 0.3s; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(229, 184, 105, 0.8); }

    /* تأثيرات البطاقات السينمائية (تصميم مربع 8px استناداً للمرجع) */
    .hon-card {
      position: relative;
      overflow: hidden;
      border-radius: 8px;
      background: #000;
      box-shadow: 0 10px 30px rgba(0,0,0,0.15);
      transition: box-shadow 0.5s ease, transform 0.5s ease;
    }
    .dark .hon-card { box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
    .hon-card:hover { transform: translateY(-4px); box-shadow: 0 15px 35px rgba(0,0,0,0.2), 0 0 15px rgba(229, 184, 105, 0.1); }
    .dark .hon-card:hover { box-shadow: 0 15px 35px rgba(0,0,0,0.7), 0 0 20px rgba(229, 184, 105, 0.15); }

    .cinematic-img {
      width: 100%; height: 100%; object-fit: cover;
      opacity: 0.7; filter: grayscale(80%) contrast(1.1);
      transform: scale(1.02);
      transition: all 1.2s cubic-bezier(0.19, 1, 0.22, 1);
    }
    .hon-card:hover .cinematic-img {
      opacity: 1; filter: grayscale(0%) contrast(1.1); transform: scale(1.08);
    }

    /* الإطار الذهبي الداخلي (البرواز المربع) */
    .card-frame {
      position: absolute;
      inset: 12px;
      border: 1px solid rgba(229, 184, 105, 0);
      border-radius: 6px;
      transition: border-color 0.8s ease, inset 0.8s ease;
      pointer-events: none;
      z-index: 20;
    }
    .hon-card:hover .card-frame {
      inset: 16px; border-color: rgba(229, 184, 105, 0.6);
    }

    .card-content {
      position: relative;
      z-index: 30;
      transform: translateY(20px);
      transition: transform 0.8s cubic-bezier(0.19, 1, 0.22, 1);
    }
    .hon-card:hover .card-content { transform: translateY(0); }

    .gold-accent-line {
      width: 0;
      height: 2px;
      background-color: #E5B869;
      transition: width 0.8s cubic-bezier(0.19, 1, 0.22, 1);
      margin-top: 8px;
    }
    .hon-card:hover .gold-accent-line { width: 40px; }

    .hon-card.auto-target { box-shadow: 0 0 0 2px #E5B869, 0 0 40px rgba(229, 184, 105, 0.3); }

    /* حقل البحث الزجاجي الفاخر */
    .search-glass {
      background: rgba(255,255,255,0.7);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(229,184,105,0.3);
      transition: all 0.4s cubic-bezier(0.19, 1, 0.22, 1);
      box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }
    html.dark .search-glass {
      background: rgba(10,10,10,0.6);
      border-color: rgba(229,184,105,0.2);
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }
    .search-glass:focus-within {
      background: rgba(255,255,255,0.98);
      border-color: #E5B869;
      box-shadow: 0 10px 30px -5px rgba(229,184,105,0.2);
      transform: translateY(-1px);
    }
    html.dark .search-glass:focus-within {
      background: rgba(10,10,10,0.95);
      box-shadow: 0 10px 30px -5px rgba(229,184,105,0.25);
    }

    #mobileNavOverlay.hidden { display: none; }
    #mobileNavOverlay { display: block; }
    #mobileNavDrawer{
      transform: translateX(-110%);
      transition: transform .3s cubic-bezier(.2,.9,.2,1);
    }
    #mobileNavDrawer.isOpen{ transform: translateX(0); }
    #mobileNavBtn[data-open="true"] .ico-open { display: none; }
    #mobileNavBtn[data-open="true"] .ico-close { display: inline; }
    #mobileNavBtn[data-open="false"] .ico-open { display: inline; }
    #mobileNavBtn[data-open="false"] .ico-close { display: none; }
  </style>

  <script>
    (function () {
      const saved = localStorage.getItem("theme") || "dark";
      document.documentElement.setAttribute("data-theme", saved);
      document.documentElement.classList.toggle("dark", saved === "dark");

      const obs = new MutationObserver(() => {
        const t = document.documentElement.getAttribute("data-theme") || "dark";
        document.documentElement.classList.toggle("dark", t === "dark");
      });
      obs.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    })();
  </script>
</head>

<body class="bg-background-light dark:bg-bg-charcoal text-gray-900 dark:text-text-cream font-sans min-h-screen flex flex-col overflow-x-hidden selection:bg-accent/30 selection:text-gray-900 dark:selection:text-white transition-colors duration-400">

