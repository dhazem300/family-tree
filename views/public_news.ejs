<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>أخبار العائلة - شجرة العائلة</title>

  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/styles.css"/>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@300;400;500;700;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries,line-clamp"></script>

  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#005A2B",     /* اللون الأخضر الملكي الفاخر */
            primaryDark: "#003D1D", /* أخضر داكن للتحويم */
            accent: "#E5B869",      /* ذهب سائل */
            "accent-gold": "#E5B869",
            "background-light": "#F8F8F6",
            "background-dark": "#050505",
            "bg-charcoal": "#050505",
            "card-light": "#FFFFFF",
            "card-dark": "#0A0A0A",
            "bg-card": "#0A0A0A",
            "text-cream": "#FAFAFA",
            "text-dark": "#111827",
            "text-muted": "#71717A",
            "muted-slate": "#71717A",
            gold: "#E5B869",
            "accent-gold-dark": "#D4A353",
          },
          fontFamily: {
            display: ["'Aref Ruqaa'", "serif"],
            sans: ["Tajawal", "sans-serif"],
          },
          backgroundImage: {
            "islamic-pattern": "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E5B869' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")",
            "islamic-pattern-dark": "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E5B869' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")"
          },
          boxShadow: {
            'luxury': '0 20px 40px -10px rgba(0,0,0,0.05), 0 0 20px rgba(229,184,105,0.03)',
            'luxury-dark': '0 20px 40px -10px rgba(0,0,0,0.4), 0 0 20px rgba(229,184,105,0.05)',
          }
        }
      }
    };
  </script>

  <style type="text/tailwindcss">
    @layer utilities {
      .scrollbar-hide::-webkit-scrollbar { display: none; }
      .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
      .glass-panel {
        @apply bg-white/85 dark:bg-[#080808]/85 backdrop-blur-xl border border-accent-gold/20 shadow-luxury dark:shadow-luxury-dark;
      }
    }
  </style>

  <style>
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(229, 184, 105, 0.4); border-radius: 4px; transition: background 0.3s; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(229, 184, 105, 0.8); }

    /* حقل البحث الزجاجي */
    .search-glass {
      background: rgba(255,255,255,0.6);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(229,184,105,0.3);
      transition: all 0.3s ease;
    }
    html.dark .search-glass {
      background: rgba(10,10,10,0.6);
      border-color: rgba(229,184,105,0.2);
    }
    .search-glass:focus-within {
      background: rgba(255,255,255,0.95);
      border-color: #E5B869;
      box-shadow: 0 10px 25px -5px rgba(229,184,105,0.15);
    }
    html.dark .search-glass:focus-within {
      background: rgba(10,10,10,0.95);
      box-shadow: 0 10px 25px -5px rgba(229,184,105,0.2);
    }

    #mobileNavOverlay.hidden { display: none; }
    #mobileNavOverlay { display: block; }
    #mobileNavDrawer{
      transform: translateX(-110%);
      transition: transform .3s cubic-bezier(.2,.9,.2,1);
    }
    #mobileNavDrawer.isOpen{ transform: translateX(0); }
    #mobileNavBtn[data-open="true"] .ico-open { display: none; }
    #mobileNavBtn[data-open="true"] .ico-close { display: inline; }
    #mobileNavBtn[data-open="false"] .ico-open { display: inline; }
    #mobileNavBtn[data-open="false"] .ico-close { display: none; }
  </style>

  <script>
    (function () {
      const saved = localStorage.getItem("theme") || "dark";
      document.documentElement.setAttribute("data-theme", saved);
      document.documentElement.classList.toggle("dark", saved === "dark");

      const obs = new MutationObserver(() => {
        const t = document.documentElement.getAttribute("data-theme") || "dark";
        document.documentElement.classList.toggle("dark", t === "dark");
      });
      obs.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    })();
  </script>
</head>

<body class="bg-background-light dark:bg-bg-charcoal text-gray-900 dark:text-text-cream font-sans min-h-screen flex flex-col overflow-x-hidden selection:bg-accent/30 selection:text-gray-900 dark:selection:text-white transition-colors duration-400">

  <div id="mobileNavOverlay" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-[80] hidden" aria-hidden="true"></div>
  <aside id="mobileNavDrawer" class="fixed top-0 left-0 h-full w-[320px] max-w-[85vw] bg-white dark:bg-bg-charcoal border-r border-gray-100 dark:border-white/5 shadow-2xl z-[90] flex flex-col">
    <div class="h-1.5 w-full bg-gradient-to-r from-gray-300 via-accent to-gray-300 dark:from-gray-800 dark:via-accent dark:to-gray-800"></div>
    <div class="flex items-center justify-between p-6 border-b border-gray-100 dark:border-white/5">
      <img class="h-10 w-auto hidden dark:block drop-shadow-[0_0_2px_rgba(255,255,255,0.5)] brightness-110" src="/assets/logo-dark.svg" alt="شعار العائلة" />
      <img class="h-10 w-auto block dark:hidden" src="/assets/logo-light.svg" alt="شعار العائلة" />
      <button id="mobileNavClose" class="text-gray-400 hover:text-accent transition-colors" type="button" aria-label="إغلاق القائمة">
        <span class="material-symbols-outlined text-[26px]">close</span>
      </button>
    </div>
    <nav class="p-6 flex flex-col gap-2 text-base font-semibold flex-grow text-gray-600 dark:text-gray-400" aria-label="قائمة الجوال">
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/">الشجرة</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/about">نبذة عن العائلة</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/honor">السير الذاتية</a>
      <a class="px-4 py-3 rounded-xl text-primary dark:text-accent bg-primary/5 dark:bg-accent/10 border-r-2 border-primary dark:border-accent" href="/news">أخبار العائلة</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/tree-pdf">المشجرة</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/kinship">صلة القرابة</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/submit-person">إضافة بياناتك</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/family-members">أعضاء العائلة</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/chat">الشات العام</a>
      <%- include('partials/user_profile_chip', { siteUser }) %>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/support">الدعم</a>
    </nav>
    <div class="p-6 border-t border-gray-100 dark:border-white/5 bg-white/50 dark:bg-black/20">
      <div class="grid grid-cols-1 gap-3">
        <a href="/admin/login" class="flex items-center justify-center gap-2 py-3 bg-primary text-white dark:bg-white dark:text-primary rounded-xl hover:opacity-90 transition-all shadow-sm font-bold text-sm" title="لوحة الإدارة">
          <span class="material-symbols-outlined text-[20px]">admin_panel_settings</span>
          <span>لوحة الإدارة</span>
        </a>
      </div>
    </div>
  </aside>

  <header class="sticky top-0 z-50 w-full glass-panel border-b-0 transition-colors duration-400">
    <div class="max-w-[90rem] mx-auto px-5 sm:px-8 py-3 flex justify-between items-center h-20 md:h-24">
      
      <div class="flex items-center gap-3 xl:gap-4 shrink-0">
        <a href="/" class="block shrink-0 transition-transform hover:scale-105 duration-300">
          <img class="h-10 md:h-12 w-auto hidden dark:block drop-shadow-[0_0_2px_rgba(255,255,255,0.5)] brightness-110" src="/assets/logo-dark.svg" alt="شعار العائلة" />
          <img class="h-10 md:h-12 w-auto block dark:hidden" src="/assets/logo-light.svg" alt="شعار العائلة" />
        </a>
        
        <div class="h-7 w-px bg-gray-200 dark:bg-white/10 hidden sm:block"></div>
        
        <div class="hidden sm:flex flex-col justify-center min-w-0">
           <h1 class="text-lg md:text-xl font-display text-primary dark:text-accent font-bold leading-tight pt-1">شجرة العائلة</h1>
           <span class="text-[10px] font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-widest mt-0.5 truncate">حفظ الأنساب</span>
        </div>
      </div>

      <nav class="hidden lg:flex flex-1 justify-center gap-3 xl:gap-5 items-center font-sans font-semibold text-[12px] xl:text-[13px] tracking-wide text-gray-500 dark:text-gray-400 overflow-x-auto scrollbar-hide px-4 flex-nowrap" aria-label="التنقل الرئيسي">
        <a class="whitespace-nowrap hover:text-primary dark:hover:text-accent transition-colors duration-200" href="/">الشجرة</a>
        <a class="whitespace-nowrap hover:text-primary dark:hover:text-accent transition-colors duration-200" href="/about">نبذة عن العائلة</a>
        <a class="whitespace-nowrap hover:text-primary dark:hover:text-accent transition-colors duration-200" href="/honor">السير الذاتية</a>
        
        <a class="whitespace-nowrap text-primary dark:text-accent border-b-[1.5px] border-primary dark:border-accent pb-1 transition-colors duration-200" href="/news">أخبار العائلة</a>
        
        <a class="whitespace-nowrap hover:text-primary dark:hover:text-accent transition-colors duration-200" href="/tree-pdf">المشجرة</a>
        <a class="whitespace-nowrap hover:text-primary dark:hover:text-accent transition-colors duration-200" href="/kinship">صلة القرابة</a>
        <a class="whitespace-nowrap hover:text-primary dark:hover:text-accent transition-colors duration-200" href="/submit-person">إضافة بياناتك</a>
        <a class="whitespace-nowrap hover:text-primary dark:hover:text-accent transition-colors duration-200" href="/family-members">أعضاء العائلة</a>
        <a class="whitespace-nowrap hover:text-primary dark:hover:text-accent transition-colors duration-200" href="/chat">الشات العام</a>
        <%- include('partials/user_profile_chip', { siteUser }) %>
      </nav>

      <div class="flex items-center justify-end gap-2 shrink-0">
        <button id="themeBtn" aria-label="تبديل المظهر" class="flex items-center justify-center w-10 h-10 rounded-full border border-transparent text-gray-400 dark:text-gray-500 hover:text-accent dark:hover:text-accent hover:bg-accent/5 transition-all duration-300" type="button" title="تبديل المظهر">
          <span class="material-symbols-outlined text-[22px] dark:hidden">dark_mode</span>
          <span class="material-symbols-outlined text-[22px] hidden dark:inline">light_mode</span>
        </button>

        <a href="/admin/login" class="hidden sm:flex w-10 h-10 rounded-full border border-transparent text-gray-400 dark:text-gray-500 hover:text-primary dark:hover:text-accent hover:bg-primary/5 dark:hover:bg-accent/5 transition-all duration-300 items-center justify-center" title="لوحة الإدارة">
          <span class="material-symbols-outlined text-[22px]">admin_panel_settings</span>
        </a>

        <button id="mobileNavBtn" data-open="false" class="lg:hidden flex items-center justify-center w-10 h-10 rounded-full border border-gray-200 dark:border-white/10 text-primary dark:text-accent hover:bg-gray-50 dark:hover:bg-white/5 transition-all duration-200" type="button" aria-label="فتح القائمة">
          <span class="material-symbols-outlined text-[24px] ico-open">menu</span>
          <span class="material-symbols-outlined text-[24px] ico-close hidden">close</span>
        </button>
      </div>

    </div>
  </header>

  <main class="flex-grow relative">

    <section class="pt-16 pb-12 px-6 max-w-[90rem] mx-auto text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-islamic-pattern opacity-40 dark:opacity-10 pointer-events-none"></div>

      <img src="/assets/logo-dark.svg" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] md:w-[600px] opacity-[0.02] pointer-events-none hidden dark:block" alt="">
      <img src="/assets/logo-light.svg" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] md:w-[600px] opacity-[0.02] pointer-events-none block dark:hidden" alt="">

      <div class="w-px h-10 bg-gradient-to-b from-transparent via-accent to-transparent mx-auto mb-5 relative z-10"></div>
      
      <p class="text-[10px] md:text-xs font-sans font-bold tracking-[0.2em] uppercase text-gray-400 dark:text-gray-500 mb-2 relative z-10">نافذة رسمية</p>

      <h1 class="text-4xl md:text-6xl font-display leading-tight mb-4 relative z-10 font-bold">
        <span class="text-primary dark:text-white transition-colors duration-300">أخبار</span> <span class="text-accent">العائلة</span>
      </h1>
      
      <p class="text-[14px] md:text-base font-sans text-gray-500 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed relative z-10 font-medium">
        متابعة أخبار العائلة والمناسبات والإعلانات المهمة، بتصميم يحفظ الوقار ويعرض المحتوى بروح تراثية راقية.
      </p>
    </section>

    <section class="px-4 sm:px-6 lg:px-8 pb-10 relative z-10">
      <div class="max-w-[90rem] mx-auto">
        <div id="subscribeSuccess" class="hidden mb-6 rounded-[12px] border border-emerald-200 dark:border-emerald-500/20 bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 px-5 py-4 font-sans font-bold text-[14px] flex items-center gap-2">
          <span class="material-symbols-outlined text-[20px]">check_circle</span>
          تم الاشتراك بنجاح في أخبار العائلة.
        </div>
        <div id="subscribeInvalid" class="hidden mb-6 rounded-[12px] border border-amber-200 dark:border-amber-500/20 bg-amber-50 dark:bg-amber-500/10 text-amber-800 dark:text-amber-300 px-5 py-4 font-sans font-bold text-[14px] flex items-center gap-2">
          <span class="material-symbols-outlined text-[20px]">warning</span>
          البريد الإلكتروني غير صحيح. برجاء المحاولة مرة أخرى.
        </div>
        <div id="subscribeError" class="hidden mb-6 rounded-[12px] border border-red-200 dark:border-red-500/20 bg-red-50 dark:bg-red-500/10 text-red-700 dark:text-red-300 px-5 py-4 font-sans font-bold text-[14px] flex items-center gap-2">
          <span class="material-symbols-outlined text-[20px]">error</span>
          حدث خطأ أثناء الاشتراك. برجاء المحاولة لاحقًا.
        </div>

        <div class="glass-panel rounded-[16px] relative overflow-hidden shadow-sm">
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-accent to-transparent"></div>
          <div class="relative p-6 md:p-10 grid grid-cols-1 lg:grid-cols-[1fr_1.5fr] gap-8 items-center">
            
            <div class="text-right">
              <h2 class="text-2xl md:text-3xl font-display font-bold text-primary dark:text-white mb-2 flex items-center gap-2">
                <span class="material-symbols-outlined text-[28px] text-accent">mail</span>
                النشرة البريدية
              </h2>
              <p class="text-[14px] text-gray-500 dark:text-gray-400 font-medium leading-relaxed">
                أدخل بريدك الإلكتروني ليصلك إشعار عند نشر أخبار أو مناسبات جديدة للعائلة.
              </p>
            </div>

            <form method="post" action="/news/subscribe" class="flex flex-col sm:flex-row gap-3">
              <input name="subscriber_name" type="text" autocomplete="name" placeholder="الاسم (اختياري)" class="w-full sm:w-1/3 px-4 py-3 rounded-xl border border-gray-200 dark:border-white/10 bg-white/50 dark:bg-black/20 text-[14px] font-medium text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-accent focus:border-accent transition-shadow"/>
              
              <input name="email" type="email" required autocomplete="email" placeholder="البريد الإلكتروني" class="w-full sm:w-1/2 px-4 py-3 rounded-xl border border-gray-200 dark:border-white/10 bg-white/50 dark:bg-black/20 text-[14px] font-medium text-gray-800 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-accent focus:border-accent transition-shadow"/>
              
              <button type="submit" class="w-full sm:w-auto shrink-0 inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-primary hover:bg-primaryDark text-white dark:bg-white dark:text-[#050505] dark:hover:bg-accent font-sans font-bold text-[14px] transition-all shadow-sm">
                <span class="material-symbols-outlined text-[18px] rtl:-scale-x-100">send</span>
                اشتراك
              </button>
            </form>

          </div>
        </div>
      </div>
    </section>

    <section class="px-4 sm:px-6 lg:px-8 pb-8 relative z-10">
      <div class="max-w-lg mx-auto relative group/search">
        <div class="search-glass rounded-full flex items-center px-4 py-2">
           <span class="material-symbols-outlined text-gray-400 ml-2">search</span>
           <input id="searchInput" class="block w-full bg-transparent border-0 focus:ring-0 text-[15px] font-sans font-medium text-gray-800 dark:text-white placeholder-gray-400 py-2.5" placeholder="ابحث في الأخبار..." type="text" autocomplete="off" />
        </div>
      </div>
    </section>

    <section class="py-6 px-4 sm:px-6 lg:px-8 max-w-[96rem] mx-auto relative z-10">
      <% if (!posts || posts.length === 0) { %>
        <div class="text-center py-20 border border-dashed border-gray-300 dark:border-white/10 max-w-2xl mx-auto p-12 rounded-[16px] bg-white/50 dark:bg-black/20 backdrop-blur-sm shadow-sm">
          <div class="w-16 h-16 mx-auto rounded-full bg-primary/5 dark:bg-white/5 border border-primary/10 dark:border-white/10 text-primary dark:text-accent flex items-center justify-center mb-5">
            <span class="material-symbols-outlined text-[32px]">newspaper</span>
          </div>
          <h2 class="text-2xl font-display font-bold text-primary dark:text-white mb-2">لا توجد أخبار حالياً</h2>
          <p class="font-sans text-[15px] font-medium text-gray-500">عند إضافة أخبار جديدة ستظهر هنا مباشرة.</p>
        </div>
      <% } else { %>
        <div id="newsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
          <% posts.forEach(p => {
            const img = p.image_url || p.person_photo_url || "/images/default.png";
          %>
            <article class="news-card-item bg-white dark:bg-[#0A0A0A] border border-gray-100 dark:border-white/5 rounded-[16px] shadow-sm hover:shadow-luxury dark:hover:shadow-luxury-dark transition-all duration-400 group flex flex-col overflow-hidden">
              <a href="/news/<%= p.id %>" class="relative block h-56 overflow-hidden bg-gray-100 dark:bg-[#111]">
                <img src="<%= img %>" alt="<%= p.title || 'خبر' %>" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async" onerror="this.src='/images/default.png'" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-80 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
                
                <div class="absolute bottom-4 right-4 px-3 py-1.5 rounded-lg bg-black/60 backdrop-blur-md border border-white/10 text-white font-sans font-bold text-[11px] tracking-wide flex items-center gap-1.5 z-10">
                  <span class="material-symbols-outlined text-[14px]">calendar_month</span> <%= p.event_date || p.published_at || 'خبر جديد' %>
                </div>
              </a>

              <div class="p-6 md:p-8 flex flex-col flex-grow relative z-20">
                <span class="text-[11px] font-sans font-bold uppercase tracking-[0.2em] text-accent mb-3 flex items-center gap-1.5 w-fit">
                  <span class="material-symbols-outlined text-[14px]">article</span> خبر عائلي
                </span>

                <h2 class="text-xl md:text-2xl font-display font-bold text-primary dark:text-white leading-tight mb-4 line-clamp-2">
                  <a href="/news/<%= p.id %>" class="hover:text-accent transition-colors"><%= p.title %></a>
                </h2>

                <div class="w-12 h-[2px] bg-accent mb-4 transition-all duration-500 group-hover:w-20"></div>

                <p class="font-sans text-[14px] text-gray-500 dark:text-gray-400 line-clamp-3 leading-relaxed mb-6 font-medium">
                  <%= p.summary || p.content || '' %>
                </p>

                <div class="mt-auto pt-5 border-t border-gray-100 dark:border-white/5 flex items-center justify-between">
                  <% if (p.person_id) { %>
                    <span class="text-[11px] text-gray-400 dark:text-gray-500 font-bold flex items-center gap-1 truncate max-w-[55%]" title="<%= p.person_name || ('#' + p.person_id) %>">
                      <span class="material-symbols-outlined text-[14px]">person</span> <%= p.person_name || ('#' + p.person_id) %>
                    </span>
                  <% } else { %>
                    <span></span>
                  <% } %>
                  
                  <a href="/news/<%= p.id %>" class="text-[12px] font-sans font-bold text-primary dark:text-accent flex items-center gap-1 hover:opacity-70 transition-opacity">
                    التفاصيل <span class="material-symbols-outlined text-[16px] rtl:rotate-180">arrow_forward</span>
                  </a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>

        <div id="noResults" class="hidden py-16 text-center max-w-lg mx-auto">
          <div class="w-px h-10 bg-gradient-to-b from-transparent via-gray-400 dark:via-gray-600 to-transparent mx-auto mb-5"></div>
          <h2 class="text-[17px] font-sans font-bold text-gray-500">لم يتم العثور على نتائج مطابقة لبحثك</h2>
        </div>
      <% } %>
    </section>

  </main>

  <footer class="bg-background-light dark:bg-[#050505] border-t border-gray-200 dark:border-white/5 mt-auto py-8 relative z-10">
    <div class="max-w-[90rem] mx-auto px-6 text-center flex flex-col items-center gap-3">
      <p class="text-[11px] font-sans font-semibold text-gray-400 dark:text-gray-600 uppercase tracking-widest">
        © ٢٠٢٦ وقف عائلة خاشقجي. جميع الحقوق محفوظة. حفظ الأنساب والاحتفاء بالتراث.
      </p>
    </div>
  </footer>

  <script>
    (function () {
      const btn = document.getElementById("themeBtn");
      function applyTheme(next) {
        document.documentElement.setAttribute("data-theme", next);
        document.documentElement.classList.toggle("dark", next === "dark");
        localStorage.setItem("theme", next);
      }
      btn?.addEventListener("click", () => {
        const current = document.documentElement.getAttribute("data-theme") || "dark";
        applyTheme(current === "dark" ? "light" : "dark");
      });
      applyTheme(localStorage.getItem("theme") || "dark");
    })();

    (function(){
      const params = new URLSearchParams(window.location.search);
      const status = params.get("subscribed");

      if (status === "1") {
        document.getElementById("subscribeSuccess")?.classList.remove("hidden");
      } else if (status === "invalid") {
        document.getElementById("subscribeInvalid")?.classList.remove("hidden");
      } else if (status === "error") {
        document.getElementById("subscribeError")?.classList.remove("hidden");
      }

      if (status) {
        window.history.replaceState({}, "", window.location.pathname);
      }
    })();

    (function(){
      const input = document.getElementById("searchInput");
      const cards = Array.from(document.querySelectorAll(".news-card-item"));
      const noResults = document.getElementById("noResults");

      function norm(str){
        return (str || "")
          .toString()
          .toLowerCase()
          .replace(/[\u064B-\u065F\u0670]/g, "")
          .replace(/[إأآا]/g, "ا")
          .replace(/ى/g, "ي")
          .replace(/ؤ/g, "و")
          .replace(/ئ/g, "ي")
          .replace(/ة/g, "ه")
          .replace(/\s+/g, " ")
          .trim();
      }

      input?.addEventListener("input", () => {
        const q = norm(input.value);
        let shown = 0;

        cards.forEach(card => {
          const text = norm(card.innerText);
          const ok = !q || text.includes(q);
          card.style.display = ok ? "" : "none";
          if (ok) shown++;
        });

        if (noResults) {
          noResults.classList.toggle("hidden", shown !== 0);
        }
      });
    })();

    (function mobileNavInit(){
      const btn = document.getElementById("mobileNavBtn");
      const navDrawer = document.getElementById("mobileNavDrawer");
      const overlay = document.getElementById("mobileNavOverlay");
      const closeBtn = document.getElementById("mobileNavClose");

      function setOpenState(isOpen){
        btn?.setAttribute("data-open", isOpen ? "true" : "false");
        btn?.setAttribute("aria-expanded", isOpen ? "true" : "false");
      }

      function openNav(){
        overlay?.classList.remove("hidden");
        overlay?.style.setProperty('display', 'block', 'important');
        navDrawer?.classList.add("isOpen");
        setOpenState(true);
        document.body.classList.add('overflow-hidden');
      }
      function closeNav(){
        navDrawer?.classList.remove("isOpen");
        overlay?.classList.add("hidden");
        overlay?.style.setProperty('display', 'none', 'important');
        setOpenState(false);
        document.body.classList.remove('overflow-hidden');
      }

      btn?.addEventListener("click", () => {
        const open = btn.getAttribute("data-open") === "true";
        open ? closeNav() : openNav();
      });

      closeBtn?.addEventListener("click", closeNav);
      overlay?.addEventListener("click", closeNav);
      navDrawer?.querySelectorAll("a").forEach(a => a.addEventListener("click", closeNav));
      window.addEventListener("keydown", (e) => { if (e.key === "Escape") closeNav(); });

      setOpenState(false);
    })();
  </script>

  <script src="/site-assistant.js"></script>
</body>
</html>