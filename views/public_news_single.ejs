<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= post.title %> - أخبار العائلة</title>

  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/styles.css"/>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@300;400;500;700;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries,line-clamp"></script>

  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#005A2B",     /* اللون الأخضر الملكي الفاخر */
            primaryDark: "#003D1D", /* أخضر داكن للتحويم */
            accent: "#E5B869",      /* ذهب سائل */
            "accent-gold": "#E5B869",
            "background-light": "#F8F8F6",
            "background-dark": "#050505",
            "bg-charcoal": "#050505",
            "card-light": "#FFFFFF",
            "card-dark": "#0A0A0A",
            "bg-card": "#0A0A0A",
            "text-cream": "#FAFAFA",
            "text-dark": "#111827",
            "text-muted": "#71717A",
            "muted-slate": "#71717A",
            gold: "#E5B869",
            "accent-gold-dark": "#D4A353",
          },
          fontFamily: {
            display: ["'Aref Ruqaa'", "serif"],
            sans: ["Tajawal", "sans-serif"],
          },
          backgroundImage: {
            "islamic-pattern": "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E5B869' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")",
            "islamic-pattern-dark": "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E5B869' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")"
          },
          boxShadow: {
            'luxury': '0 20px 40px -10px rgba(0,0,0,0.05), 0 0 20px rgba(229,184,105,0.03)',
            'luxury-dark': '0 20px 40px -10px rgba(0,0,0,0.4), 0 0 20px rgba(229,184,105,0.05)',
          }
        }
      }
    };
  </script>

  <style type="text/tailwindcss">
    @layer utilities {
      .scrollbar-hide::-webkit-scrollbar { display: none; }
      .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
      .glass-panel {
        @apply bg-white/85 dark:bg-[#080808]/85 backdrop-blur-xl border border-accent-gold/20 shadow-luxury dark:shadow-luxury-dark;
      }
    }
  </style>

  <style>
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(229, 184, 105, 0.4); border-radius: 4px; transition: background 0.3s; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(229, 184, 105, 0.8); }

    #mobileNavOverlay.hidden { display: none; }
    #mobileNavOverlay { display: block; }
    #mobileNavDrawer{
      transform: translateX(-110%);
      transition: transform .3s cubic-bezier(.2,.9,.2,1);
    }
    #mobileNavDrawer.isOpen{ transform: translateX(0); }
    #mobileNavBtn[data-open="true"] .ico-open { display: none; }
    #mobileNavBtn[data-open="true"] .ico-close { display: inline; }
    #mobileNavBtn[data-open="false"] .ico-open { display: inline; }
    #mobileNavBtn[data-open="false"] .ico-close { display: none; }

    .article-shell {
      position: relative;
      overflow: hidden;
      border-radius: 8px;
      border: 1px solid rgba(229,184,105,.24);
      background: rgba(255,255,255,.88);
      box-shadow: 0 20px 40px -10px rgba(0,0,0,0.08), 0 0 20px rgba(229,184,105,0.04);
      isolation: isolate;
      transition: border-color .5s ease, box-shadow .5s ease, transform .5s ease;
    }
    .dark .article-shell {
      background: linear-gradient(180deg, rgba(10,10,10,.96), rgba(5,5,5,.99));
      border-color: rgba(255,255,255,.10);
      box-shadow: 0 20px 40px -10px rgba(0,0,0,0.48), 0 0 20px rgba(229,184,105,0.06);
    }
    .article-shell:hover {
      transform: translateY(-2px);
      border-color: rgba(229,184,105,.42);
      box-shadow: 0 24px 60px -18px rgba(0,0,0,0.16), 0 0 26px rgba(229,184,105,0.08);
    }
    .dark .article-shell:hover {
      box-shadow: 0 24px 60px -18px rgba(0,0,0,0.72), 0 0 28px rgba(229,184,105,0.10);
    }

    .article-frame {
      position: absolute;
      inset: 14px;
      border: 1px solid rgba(229,184,105,0.12);
      border-radius: 6px;
      pointer-events: none;
      z-index: 12;
    }

    .article-image-shell {
      position: relative;
      overflow: hidden;
      min-height: 300px;
      background: #f3f4f6;
      display: flex;
      align-items: center;
      justify-content: center;
      border-bottom: 1px solid rgba(229,184,105,.18);
    }
    .dark .article-image-shell { background: #050505; border-bottom-color: rgba(255,255,255,.08); }
    .article-image-shell::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(to top, rgba(5,5,5,.64), transparent 58%),
        radial-gradient(circle at top right, rgba(229,184,105,.20), transparent 45%);
      z-index: 3;
      pointer-events: none;
    }
    .article-image-blur {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: blur(28px) grayscale(35%) contrast(1.05);
      transform: scale(1.18);
      opacity: .28;
      z-index: 1;
    }
    .article-image-main {
      position: relative;
      z-index: 2;
      width: auto;
      max-width: 100%;
      max-height: 76vh;
      object-fit: contain;
      transition: transform 1.2s cubic-bezier(0.19, 1, 0.22, 1), filter 1.2s cubic-bezier(0.19, 1, 0.22, 1);
    }
    .article-shell:hover .article-image-main { transform: scale(1.012); filter: contrast(1.04); }
    .article-date-badge {
      position: absolute;
      right: 24px;
      bottom: 24px;
      z-index: 6;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      max-width: calc(100% - 48px);
      padding: 9px 14px;
      border-radius: 999px;
      border: 1px solid rgba(229,184,105,.55);
      background: rgba(5,5,5,.58);
      color: #fff;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      font-size: 12px;
      font-weight: 900;
    }
    .article-content {
      position: relative;
      padding: 26px;
      background:
        linear-gradient(180deg, rgba(255,255,255,.90), rgba(255,255,255,.98)),
        radial-gradient(circle at top left, rgba(229,184,105,.12), transparent 38%);
    }
    .dark .article-content {
      background:
        linear-gradient(180deg, rgba(10,10,10,.95), rgba(5,5,5,1)),
        radial-gradient(circle at top left, rgba(229,184,105,.08), transparent 42%);
    }
    @media (min-width: 640px) { .article-content { padding: 40px; } }
    @media (min-width: 1024px) { .article-content { padding: 52px; } }
    @media (min-width: 1280px) { .article-content { padding: 64px 72px; } }
    @media (min-width: 1536px) { .article-content { padding: 72px 88px; } }
    @media (max-width: 640px) { .article-image-main { max-height: 58vh; } }

    .article-body-text {
      max-width: none;
      width: 100%;
    }

    #likeBtn.is-liked {
      background: rgba(229,184,105,.16);
      border-color: rgba(229,184,105,.48);
      color: #005A2B;
      box-shadow: 0 12px 30px rgba(229,184,105,.16);
    }
    .dark #likeBtn.is-liked {
      color: #E5B869;
      background: rgba(229,184,105,.14);
      border-color: rgba(229,184,105,.38);
      box-shadow: 0 12px 30px rgba(229,184,105,.10);
    }
    #likeBtn.is-loading { cursor: wait; }
    #likeBtn.like-pulse { animation: likePulse .45s ease; }
    @keyframes likePulse {
      0% { transform: scale(1); }
      50% { transform: scale(1.045); }
      100% { transform: scale(1); }
    }

    .news-category-pill {
      width: fit-content;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 12px;
      border-radius: 999px;
      background: rgba(0,90,43,.06);
      color: #005A2B;
      border: 1px solid rgba(0,90,43,.12);
      font-size: 12px;
      font-weight: 900;
    }
    .dark .news-category-pill { color: #E5B869; background: rgba(229,184,105,.08); border-color: rgba(229,184,105,.18); }
    .news-separator {
      width: 70px;
      height: 2px;
      margin: 18px 0 22px auto;
      background: linear-gradient(to left, #E5B869, rgba(229,184,105,0));
    }
    .soft-card {
      border: 1px solid rgba(229,184,105,.20);
      background: rgba(255,255,255,.72);
      box-shadow: 0 14px 40px rgba(0,0,0,.05);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .dark .soft-card {
      border-color: rgba(255,255,255,.10);
      background: rgba(10,10,10,.72);
      box-shadow: 0 14px 40px rgba(0,0,0,.36);
    }
    .luxury-input {
      border: 1px solid rgba(229,184,105,.22);
      background: rgba(255,255,255,.78);
      transition: border-color .3s ease, box-shadow .3s ease, background .3s ease, transform .3s ease;
    }
    .dark .luxury-input { background: rgba(5,5,5,.36); border-color: rgba(255,255,255,.10); }
    .luxury-input:focus {
      outline: none;
      border-color: #E5B869;
      box-shadow: 0 10px 30px -5px rgba(229,184,105,0.18), 0 0 0 4px rgba(229,184,105,0.12);
      transform: translateY(-1px);
    }
    .btn-primary {
      background: #005A2B;
      color: #fff;
      transition: transform .3s ease, box-shadow .3s ease, background .3s ease, opacity .3s ease;
      box-shadow: 0 10px 24px rgba(0,90,43,.16);
    }
    .btn-primary:hover { background: #003D1D; transform: translateY(-2px); box-shadow: 0 14px 30px rgba(0,90,43,.22); }
    .dark .btn-primary { background: #FFFFFF; color: #005A2B; box-shadow: 0 10px 24px rgba(255,255,255,.08); }
    .dark .btn-primary:hover { background: #FAFAFA; }
    .btn-soft {
      border: 1px solid rgba(229,184,105,.22);
      background: rgba(255,255,255,.72);
      color: #005A2B;
      transition: transform .3s ease, background .3s ease, color .3s ease, border-color .3s ease;
    }
    .btn-soft:hover { transform: translateY(-2px); background: rgba(0,90,43,.06); border-color: rgba(0,90,43,.20); }
    .dark .btn-soft { background: rgba(255,255,255,.04); color: #E5B869; border-color: rgba(255,255,255,.10); }
    .dark .btn-soft:hover { background: rgba(229,184,105,.08); border-color: rgba(229,184,105,.24); }
    .related-card {
      position: relative;
      overflow: hidden;
      border-radius: 8px;
      background: rgba(255,255,255,.86);
      border: 1px solid rgba(229,184,105,.22);
      box-shadow: 0 18px 45px rgba(0,0,0,.08);
      transition: transform .5s ease, box-shadow .5s ease, border-color .5s ease;
    }
    .dark .related-card { background: linear-gradient(180deg, rgba(18,18,18,.95), rgba(7,7,7,.98)); border-color: rgba(255,255,255,.10); }
    .related-card:hover { transform: translateY(-4px); border-color: rgba(229,184,105,.55); box-shadow: 0 20px 50px rgba(0,0,0,.14), 0 0 16px rgba(229,184,105,.08); }
    .dark .related-card:hover { box-shadow: 0 20px 50px rgba(0,0,0,.55), 0 0 20px rgba(229,184,105,.12); }
    .related-card::after {
      content: "";
      position: absolute;
      inset: 12px;
      border: 1px solid rgba(229,184,105,0);
      border-radius: 6px;
      pointer-events: none;
      transition: border-color .5s ease, inset .5s ease;
    }
    .related-card:hover::after { inset: 16px; border-color: rgba(229,184,105,.40); }
  </style>

  <script>
    (function () {
      const saved = localStorage.getItem("theme") || "dark";
      document.documentElement.setAttribute("data-theme", saved);
      document.documentElement.classList.toggle("dark", saved === "dark");

      const obs = new MutationObserver(() => {
        const t = document.documentElement.getAttribute("data-theme") || "dark";
        document.documentElement.classList.toggle("dark", t === "dark");
      });
      obs.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    })();
  </script>
</head>

