          <span class="material-symbols-outlined text-[22px] hidden dark:inline">light_mode</span>
        </button>

        <a href="/admin/login" class="hidden sm:flex w-10 h-10 rounded-full border border-transparent text-gray-400 dark:text-gray-500 hover:text-primary dark:hover:text-accent hover:bg-primary/5 dark:hover:bg-accent/5 transition-all duration-300 items-center justify-center" title="لوحة الإدارة">
          <span class="material-symbols-outlined text-[22px]">admin_panel_settings</span>
        </a>

        <button id="mobileNavBtn" data-open="false" class="lg:hidden flex items-center justify-center w-10 h-10 rounded-full border border-gray-200 dark:border-white/10 text-primary dark:text-accent hover:bg-gray-50 dark:hover:bg-white/5 transition-all duration-200" type="button" aria-label="فتح القائمة" aria-expanded="false">
          <span class="material-symbols-outlined text-[24px] ico-open">menu</span>
          <span class="material-symbols-outlined text-[24px] ico-close hidden">close</span>
        </button>
      </div>

    </div>
  </header>

  <main class="flex-grow relative">
    <%
      const img = post.image_url || post.person_photo_url || "/images/default.png";
      const currentShareUrl = typeof shareUrl !== "undefined" && shareUrl ? shareUrl : "";
      const encodedShareUrl = encodeURIComponent(currentShareUrl);
      const encodedTitle = encodeURIComponent(post.title || "");
      const likeCount = typeof likes !== "undefined" ? Number(likes || 0) : 0;
      const commentList = typeof comments !== "undefined" && comments ? comments : [];
    %>

    <section class="pt-16 pb-10 px-6 max-w-[90rem] mx-auto text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-islamic-pattern opacity-40 dark:opacity-10 pointer-events-none"></div>

      <img src="/assets/logo-dark.svg" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[420px] md:w-[640px] opacity-[0.02] pointer-events-none hidden dark:block" alt="">
      <img src="/assets/logo-light.svg" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[420px] md:w-[640px] opacity-[0.02] pointer-events-none block dark:hidden" alt="">

      <div class="w-px h-10 bg-gradient-to-b from-transparent via-accent to-transparent mx-auto mb-5 relative z-10"></div>
      
      <p class="text-[10px] md:text-xs font-sans font-bold tracking-[0.2em] uppercase text-gray-400 dark:text-gray-500 mb-3 relative z-10">أخبار العائلة</p>

      <a href="/news" class="inline-flex items-center gap-2 text-[13px] font-bold text-primary dark:text-accent hover:text-accent transition-colors mb-5 relative z-10">
        <span class="material-symbols-outlined text-[18px] rotate-180">arrow_forward</span>
        العودة إلى أخبار العائلة
      </a>

      <h1 class="text-4xl md:text-6xl lg:text-7xl font-display leading-tight mb-6 relative z-10 font-bold max-w-[76rem] mx-auto">
        <span class="text-primary dark:text-white transition-colors duration-300"><%= post.title %></span>
      </h1>

      <div class="relative z-10 flex flex-wrap justify-center items-center gap-3 text-xs md:text-sm font-bold text-gray-500 dark:text-gray-400">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/70 dark:bg-black/35 border border-gray-200 dark:border-white/10 backdrop-blur-sm">
          <span class="material-symbols-outlined text-[16px] text-accent">calendar_month</span>
          <%= post.event_date || post.published_at || '' %>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/70 dark:bg-black/35 border border-gray-200 dark:border-white/10 backdrop-blur-sm">
          <span class="material-symbols-outlined text-[16px] text-accent">visibility</span>
          <%= Number(post.views_count || 0) %> مشاهدة
        </span>
        <% if (Number(post.is_pinned || 0) === 1) { %>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-accent/15 text-primary dark:text-accent border border-accent/30 backdrop-blur-sm">
            <span class="material-symbols-outlined text-[16px]">push_pin</span>
            خبر مهم
          </span>
        <% } %>
      </div>
    </section>

    <section class="px-3 sm:px-5 lg:px-8 xl:px-10 pb-14 relative z-10">
      <div class="w-full max-w-[92rem] mx-auto">
        <article class="article-shell">
          <div class="article-frame"></div>

          <div class="article-image-shell w-full">
            <img src="<%= img %>" alt="" class="article-image-blur" loading="lazy" decoding="async" onerror="this.style.display='none'"/>
            <img src="<%= img %>" alt="<%= post.title || 'خبر' %>" class="article-image-main" loading="eager" decoding="async" onerror="this.src='/images/default.png'"/>
            <span class="article-date-badge">
              <span class="material-symbols-outlined text-[15px]">calendar_month</span>
              <span class="truncate"><%= post.event_date || post.published_at || 'خبر جديد' %></span>
            </span>
          </div>

          <div class="article-content">
            <div class="flex flex-wrap items-center gap-3 mb-7">
              <span class="news-category-pill">
                <span class="material-symbols-outlined text-[15px]">article</span>
                خبر عائلي
              </span>
              <% if (post.person_id) { %>
                <span class="news-category-pill">
                  <span class="material-symbols-outlined text-[15px]">person</span>
                  مرتبط بـ: <%= post.person_name || ('#' + post.person_id) %>
                </span>
              <% } %>
            </div>

            <% if (post.summary) { %>
              <p class="text-lg md:text-xl leading-9 text-gray-700 dark:text-gray-300 mb-7 border-r-4 border-accent pr-5 font-bold">
                <%= post.summary %>
              </p>
            <% } %>

            <div class="news-separator"></div>

            <div class="article-body-text text-base md:text-lg leading-10 whitespace-pre-line text-gray-800 dark:text-gray-200 font-medium">
              <%= post.content || post.summary || '' %>
            </div>

            <% if (post.publisher_name || post.publisher_phone) { %>
              <div class="mt-10 rounded-[8px] border border-accent/25 bg-white/70 dark:bg-black/25 p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                  <p class="text-xs font-bold text-gray-500 dark:text-gray-400 mb-2 tracking-widest uppercase">بيانات الناشر</p>
                  <% if (post.publisher_name) { %>
                    <div class="inline-flex items-center gap-2 text-primary dark:text-accent font-bold text-base">
                      <span class="material-symbols-outlined text-[19px]">edit_note</span>
                      <span>الناشر: <%= post.publisher_name %></span>
                    </div>
                  <% } %>
                </div>
                <% if (post.publisher_phone) { %>
                  <a href="tel:<%= String(post.publisher_phone || '').replace(/[^0-9+]/g, '') %>"
                     class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-primary/5 dark:bg-accent/10 text-primary dark:text-accent border border-primary/10 dark:border-accent/20 font-bold hover:bg-primary/10 dark:hover:bg-accent/15 hover:-translate-y-1 transition-all">
                    <span class="material-symbols-outlined text-[18px]">call</span>
                    <span dir="ltr"><%= post.publisher_phone %></span>
                  </a>
                <% } %>
              </div>
            <% } %>

            <div class="mt-12 grid grid-cols-1 lg:grid-cols-2 gap-5">
              <div class="soft-card rounded-[8px] p-5">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                  <div>
                    <h3 class="font-display text-2xl font-bold text-primary dark:text-accent mb-1">التفاعل مع الخبر</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 font-medium">يمكنك تسجيل إعجابك أو إضافة تعليق.</p>
                  </div>

                  <button id="likeBtn"
                          type="button"
                          aria-label="إعجاب بالخبر"
                          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-primary/5 dark:bg-accent/10 text-primary dark:text-accent border border-primary/10 dark:border-accent/20 font-bold hover:bg-primary/10 dark:hover:bg-accent/15 hover:-translate-y-1 transition-all disabled:opacity-60 disabled:pointer-events-none">
                    <span class="material-symbols-outlined text-[20px]">favorite</span>
                    إعجاب
                    <span id="likeCount" aria-live="polite" class="inline-flex items-center justify-center min-w-7 h-7 rounded-full bg-white dark:bg-black/20 px-2 border border-gray-100 dark:border-white/10">
                      <%= likeCount %>
                    </span>
                  </button>
                </div>
              </div>

              <div class="soft-card rounded-[8px] p-5">
                <h3 class="font-display text-2xl font-bold text-primary dark:text-accent mb-3">مشاركة الخبر</h3>
                <div class="flex flex-wrap gap-2">
                  <a href="https://wa.me/?text=<%= encodedTitle %>%20<%= encodedShareUrl %>"
                     target="_blank"
                     rel="noopener"
                     class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl btn-soft font-bold">
                    <span class="material-symbols-outlined text-[18px]">share</span>
                    واتساب
                  </a>

                  <a href="https://twitter.com/intent/tweet?text=<%= encodedTitle %>&url=<%= encodedShareUrl %>"
                     target="_blank"
                     rel="noopener"
                     class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl btn-soft font-bold">
                    <span class="material-symbols-outlined text-[18px]">share</span>
                    تويتر
                  </a>

                  <button id="copyLinkBtn"
                          type="button"
                          data-url="<%= currentShareUrl %>"
                          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl btn-soft font-bold">
                    <span class="material-symbols-outlined text-[18px]">content_copy</span>
                    نسخ الرابط
                  </button>
                </div>

                <p id="copyMsg" class="hidden mt-3 text-sm font-bold text-primary dark:text-accent">
                  تم نسخ رابط الخبر.
                </p>
              </div>
            </div>

            <div class="mt-12 pt-8 border-t border-gray-200 dark:border-white/10">
              <div class="flex items-center gap-3 mb-5">
                <span class="w-11 h-11 rounded-xl bg-primary/10 dark:bg-accent/10 text-primary dark:text-accent flex items-center justify-center">
                  <span class="material-symbols-outlined">forum</span>
                </span>
                <h3 class="text-3xl font-display font-bold text-primary dark:text-white">التعليقات</h3>
              </div>

              <form method="post"
                    action="/news/<%= post.id %>/comment"
                    class="soft-card rounded-[8px] p-4 sm:p-6 mb-7">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
                  <input name="name"
                         required
                         maxlength="80"
                         placeholder="اسمك"
                         class="luxury-input w-full px-4 py-3 rounded-xl text-sm font-bold text-gray-900 dark:text-white placeholder-gray-400"/>

                  <input value="<%= post.title || '' %>"
                         disabled
                         class="luxury-input w-full px-4 py-3 rounded-xl text-sm font-bold text-gray-500 dark:text-gray-400"/>
                </div>

                <textarea name="content"
                          required
                          maxlength="1000"
                          rows="4"
                          placeholder="اكتب تعليقك..."
                          class="luxury-input w-full px-4 py-3 rounded-xl text-sm font-bold leading-relaxed text-gray-900 dark:text-white placeholder-gray-400"></textarea>

                <div class="mt-3 flex justify-end">
                  <button type="submit"
                          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl btn-primary font-bold">
                    <span class="material-symbols-outlined text-[18px]">send</span>
                    إرسال التعليق
                  </button>
                </div>
              </form>

              <% if (!commentList || commentList.length === 0) { %>
                <div class="soft-card rounded-[8px] p-7 text-center text-gray-500 dark:text-gray-400 font-bold">
                  <span class="material-symbols-outlined text-4xl text-accent mb-2">chat_bubble</span>
                  <p>لا توجد تعليقات بعد. كن أول من يعلّق.</p>
                </div>
              <% } else { %>
                <div class="space-y-3">
                  <% commentList.forEach(function(c) { %>
                    <div class="soft-card rounded-[8px] p-5">
                      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                        <div class="font-bold text-primary dark:text-accent inline-flex items-center gap-2">
                          <span class="material-symbols-outlined text-[20px]">account_circle</span>
                          <%= c.name || 'زائر' %>
                        </div>
                        <div class="text-xs text-gray-500 dark:text-gray-400 font-bold">
                          <%= c.created_at || '' %>
                        </div>
                      </div>
                      <p class="text-sm sm:text-base leading-relaxed whitespace-pre-line text-gray-700 dark:text-gray-300 font-medium">
                        <%= c.content || '' %>
                      </p>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>

            <div class="mt-10 pt-6 border-t border-gray-200 dark:border-white/10 flex flex-col sm:flex-row justify-between gap-3">
              <a href="/news" class="inline-flex justify-center items-center px-6 py-3 rounded-xl btn-primary font-bold">
                العودة للأخبار
              </a>

              <a href="/" class="inline-flex justify-center items-center px-6 py-3 rounded-xl btn-soft font-bold">
                العودة للشجرة
              </a>
            </div>
          </div>
        </article>

        <% if (typeof relatedPosts !== "undefined" && relatedPosts && relatedPosts.length) { %>
          <section class="mt-12">
            <div class="flex items-center justify-between gap-3 mb-5">
              <h2 class="text-3xl font-display font-bold text-primary dark:text-white">أخبار مشابهة</h2>
              <a href="/news" class="text-sm font-bold text-primary dark:text-accent hover:text-accent transition-colors">كل الأخبار</a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              <% relatedPosts.forEach(function(p) {
                const relImg = p.image_url || p.person_photo_url || "/images/default.png";
              %>
                <article class="related-card group">
                  <a href="/news/<%= p.id %>" class="block h-48 bg-gray-100 dark:bg-black/20 overflow-hidden">
                    <img src="<%= relImg %>"
                         alt="<%= p.title || 'خبر' %>"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                         loading="lazy"
                         decoding="async"
                         onerror="this.src='/images/default.png'">
                  </a>

                  <div class="p-5 relative z-10">
                    <div class="text-xs text-gray-500 dark:text-gray-400 mb-2 font-bold inline-flex items-center gap-1">
                      <span class="material-symbols-outlined text-[15px] text-accent">calendar_month</span>
                      <%= p.event_date || p.published_at || '' %>
                    </div>

                    <h3 class="font-display text-xl font-bold text-primary dark:text-white line-clamp-2 mb-2 leading-tight">
                      <a href="/news/<%= p.id %>" class="hover:text-accent dark:hover:text-accent transition-colors">
                        <%= p.title %>
                      </a>
                    </h3>

                    <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2 leading-relaxed font-medium">
                      <%= p.summary || p.content || '' %>
                    </p>
                  </div>
                </article>
              <% }) %>
            </div>
          </section>
        <% } %>
      </div>
    </section>
  </main>

  <footer class="bg-background-light dark:bg-[#050505] border-t border-gray-200 dark:border-white/5 mt-auto py-8 relative z-10">
    <div class="max-w-[90rem] mx-auto px-6 text-center flex flex-col items-center gap-3">
      <p class="text-[11px] font-sans font-semibold text-gray-400 dark:text-gray-600 uppercase tracking-widest">
        © ٢٠٢٦ وقف عائلة خاشقجي. جميع الحقوق محفوظة. حفظ الأنساب والاحتفاء بالتراث.
      </p>
    </div>
  </footer>

  <script>
    (function () {
      const btn = document.getElementById("uiThemeBtn");
      function applyTheme(next) {
        document.documentElement.setAttribute("data-theme", next);
        document.documentElement.classList.toggle("dark", next === "dark");
        localStorage.setItem("theme", next);
      }
      btn?.addEventListener("click", () => {
        const current = document.documentElement.getAttribute("data-theme") || "dark";
        applyTheme(current === "dark" ? "light" : "dark");
      });
      applyTheme(localStorage.getItem("theme") || "dark");
    })();

    (function(){
      const likeBtn = document.getElementById("likeBtn");
      const likeCount = document.getElementById("likeCount");
      const likeUrl = "/news/<%= post.id %>/like";

      function toNumber(value){
        const n = Number(String(value || "0").replace(/[^0-9]/g, ""));
        return Number.isFinite(n) ? n : 0;
      }

      function setCount(nextCount){
        if (!likeCount) return;
        likeCount.textContent = String(Math.max(0, toNumber(nextCount)));
      }

      function markLiked(){
        likeBtn?.classList.add("is-liked", "like-pulse");
        setTimeout(() => likeBtn?.classList.remove("like-pulse"), 500);
      }

      function submitFallback(){
        const form = document.createElement("form");
        form.method = "POST";
        form.action = likeUrl;
        form.style.display = "none";
        document.body.appendChild(form);
        form.submit();
      }

      likeBtn?.addEventListener("click", async () => {
        const oldCount = toNumber(likeCount?.textContent);

        try {
          likeBtn.disabled = true;
          likeBtn.classList.add("is-loading");

          const res = await fetch(likeUrl, {
            method: "POST",
            credentials: "same-origin",
            headers: {
              "Accept": "application/json, text/html;q=0.9, */*;q=0.8",
              "X-Requested-With": "XMLHttpRequest"
            }
          });

          const contentType = res.headers.get("content-type") || "";

          if (contentType.includes("application/json")) {
            const data = await res.json();
            if (data && (data.ok === true || typeof data.count !== "undefined")) {
              setCount(typeof data.count !== "undefined" ? data.count : oldCount + 1);
              markLiked();
              return;
            }
          }

          if (res.ok || res.redirected) {
            setCount(oldCount + 1);
            markLiked();
            return;
          }

          throw new Error("Like request failed with status " + res.status);
        } catch (e) {
          console.error("likeBtn error:", e);
          submitFallback();
        } finally {
          setTimeout(() => {
            likeBtn.disabled = false;
            likeBtn.classList.remove("is-loading");
          }, 450);
        }
      });
    })();

    (function(){
      const copyBtn = document.getElementById("copyLinkBtn");
      const copyMsg = document.getElementById("copyMsg");

      copyBtn?.addEventListener("click", async () => {
        const url = copyBtn.getAttribute("data-url") || window.location.href;

        try {
          await navigator.clipboard.writeText(url);
          copyMsg?.classList.remove("hidden");
          setTimeout(() => copyMsg?.classList.add("hidden"), 2500);
        } catch (e) {
          window.prompt("انسخ الرابط:", url);
        }
      });
    })();

    (function mobileNavInit(){
      const btn = document.getElementById("mobileNavBtn");
      const navDrawer = document.getElementById("mobileNavDrawer");
      const overlay = document.getElementById("mobileNavOverlay");
      const closeBtn = document.getElementById("mobileNavClose");

      function setOpenState(isOpen){
        btn?.setAttribute("data-open", isOpen ? "true" : "false");
        btn?.setAttribute("aria-expanded", isOpen ? "true" : "false");
      }

      function openNav(){
        overlay?.classList.remove("hidden");
        overlay?.style.setProperty('display', 'block', 'important');
        navDrawer?.classList.add("isOpen");
        setOpenState(true);
        document.body.classList.add('overflow-hidden');
      }
      function closeNav(){
        navDrawer?.classList.remove("isOpen");
        overlay?.classList.add("hidden");
        overlay?.style.setProperty('display', 'none', 'important');
        setOpenState(false);
        document.body.classList.remove('overflow-hidden');
      }

      btn?.addEventListener("click", () => {
        const open = btn.getAttribute("data-open") === "true";
        open ? closeNav() : openNav();
      });

      closeBtn?.addEventListener("click", closeNav);
      overlay?.addEventListener("click", closeNav);
      navDrawer?.querySelectorAll("a").forEach(a => a.addEventListener("click", closeNav));
      window.addEventListener("keydown", (e) => { if (e.key === "Escape") closeNav(); });

      setOpenState(false);
    })();
  </script>

  <script src="/site-assistant.js"></script>
</body>
</html>
