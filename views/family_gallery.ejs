<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>معرض العائلة</title><script src="/theme.js"></script><script src="https://cdn.tailwindcss.com?plugins=forms"></script><link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&family=Aref+Ruqaa:wght@700&display=swap" rel="stylesheet"><script>tailwind.config={darkMode:'class',theme:{extend:{colors:{primary:'#005A2B',accent:'#E5B869'},fontFamily:{sans:['Tajawal','sans-serif'],display:["'Aref Ruqaa'",'serif']}}}}</script></head><body class="bg-gray-50 dark:bg-[#050505] text-gray-900 dark:text-white font-sans min-h-screen">
<%- include('partials/header', {active, siteUser, pageTitle:'معرض العائلة', pageSubtitle:'صور قديمة، مناسبات، وثائق عائلية'}) %>
<main class="max-w-7xl mx-auto p-5 space-y-6">
  <% if (success) { %><div class="p-4 rounded-2xl bg-green-50 text-green-700 font-black"><%= success %></div><% } %><% if (error) { %><div class="p-4 rounded-2xl bg-red-50 text-red-700 font-black"><%= error %></div><% } %>
  <section class="bg-white dark:bg-white/5 rounded-[2rem] p-6 border border-gray-200 dark:border-white/10"><h2 class="font-black text-xl text-primary dark:text-accent mb-4">رفع صورة للمراجعة</h2><form method="post" action="/gallery" enctype="multipart/form-data" class="grid md:grid-cols-5 gap-3"><input name="title" placeholder="العنوان" class="h-12 rounded-2xl border-gray-200 dark:bg-black/30"><select name="category" class="h-12 rounded-2xl border-gray-200 dark:bg-black/30"><option>صور قديمة</option><option>صور مناسبات</option><option>صور شخصيات</option><option>وثائق عائلية</option></select><input name="image_file" required type="file" accept="image/*" class="rounded-2xl border-gray-200 dark:bg-black/30"><input name="description" placeholder="وصف مختصر" class="h-12 rounded-2xl border-gray-200 dark:bg-black/30"><button class="h-12 rounded-2xl bg-primary text-white dark:bg-accent dark:text-black font-black">إرسال</button></form></section>
  <section class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
    <% if (!items.length) { %><div class="col-span-full bg-white dark:bg-white/5 rounded-[2rem] p-8 text-center text-gray-500 font-bold border border-gray-200 dark:border-white/10">لا توجد صور منشورة بعد.</div><% } %>
    <% items.forEach(i => { %><article class="bg-white dark:bg-white/5 rounded-[2rem] overflow-hidden border border-gray-200 dark:border-white/10 shadow-sm"><img src="<%= i.image_url %>" class="w-full h-56 object-cover"><div class="p-4"><span class="text-xs font-black text-primary dark:text-accent"><%= i.category || 'صورة' %></span><h2 class="font-black mt-1"><%= i.title || 'صورة عائلية' %></h2><p class="text-sm text-gray-500 mt-2 leading-6"><%= i.description || '' %></p></div></article><% }) %>
  </section>
</main><script src="/chat-notifications.js"></script></body></html>
