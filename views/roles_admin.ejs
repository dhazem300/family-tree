      <form method="post" action="/admin/logout" class="m-0 mt-4"><button type="submit" class="w-full flex items-center justify-center gap-2 px-4 py-4 rounded-2xl border border-red-200 dark:border-red-900/30 text-red-600 dark:text-red-400 bg-red-50/50 dark:bg-red-500/10 hover:bg-red-50 transition-colors"><span class="material-symbols-outlined">logout</span> تسجيل خروج</button></form>
