    <div class="h-1.5 w-full bg-primary"></div>
    <div class="flex items-center justify-between p-6 border-b border-border-light dark:border-border-dark shrink-0"><div><h1 class="font-display font-bold text-xl leading-none text-primary dark:text-white">عائلة خاشقجي</h1><p class="text-[10px] font-bold text-gray-500 dark:text-accent uppercase tracking-widest mt-1.5">نظام الإدارة</p></div><button id="mobileNavClose" class="w-10 h-10 rounded-full bg-gray-100 dark:bg-white/5 flex items-center justify-center text-gray-500 hover:text-primary dark:hover:text-accent transition-colors" type="button"><span class="material-symbols-outlined text-[24px]">close</span></button></div>
