<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= page?.title || "مشجرة العائلة" %> - شجرة العائلة</title>

  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/styles.css"/>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@300;400;500;700;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries,line-clamp"></script>

  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#005A2B",
            primaryDark: "#003D1D",
            accent: "#E5B869",
            "accent-gold": "#E5B869",
            "background-light": "#F8F8F6",
            "background-dark": "#050505",
            "bg-charcoal": "#050505",
            "card-light": "#FFFFFF",
            "card-dark": "#0A0A0A",
            "bg-card": "#0A0A0A",
            "text-cream": "#FAFAFA",
            "text-dark": "#111827",
            "text-muted": "#71717A",
            "muted-slate": "#71717A",
            gold: "#E5B869",
            "accent-gold-dark": "#D4A353",
          },
          fontFamily: {
            display: ["'Aref Ruqaa'", "serif"],
            sans: ["Tajawal", "sans-serif"],
          },
          backgroundImage: {
            "islamic-pattern": "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E5B869' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")",
            "islamic-pattern-dark": "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E5B869' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")"
          },
          boxShadow: {
            'luxury': '0 20px 40px -10px rgba(0,0,0,0.05), 0 0 20px rgba(229,184,105,0.03)',
            'luxury-dark': '0 20px 40px -10px rgba(0,0,0,0.4), 0 0 20px rgba(229,184,105,0.05)',
          }
        }
      }
    };
  </script>

  <style type="text/tailwindcss">
    @layer utilities {
      .scrollbar-hide::-webkit-scrollbar { display: none; }
      .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
      .glass-panel {
        @apply bg-white/85 dark:bg-[#080808]/85 backdrop-blur-xl border border-accent-gold/20 shadow-luxury dark:shadow-luxury-dark;
      }
    }
  </style>

  <style>
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(229, 184, 105, 0.4); border-radius: 4px; transition: background 0.3s; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(229, 184, 105, 0.8); }

    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { border-radius: 4px; }
    .dark .custom-scrollbar::-webkit-scrollbar-track { background: #050505; }
    .dark .custom-scrollbar::-webkit-scrollbar-thumb { background: #E5B869; }

    html.dark .dark-toggle-icon-moon { display: none; }
    html:not(.dark) .dark-toggle-icon-sun { display: none; }

    #pdfInner {
      transform-origin: center center;
      transition: transform 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      will-change: transform;
    }
  </style>

  <script>
    (function () {
      const saved = localStorage.getItem("theme") || "dark";
      document.documentElement.setAttribute("data-theme", saved);
      document.documentElement.classList.toggle("dark", saved === "dark");

      const obs = new MutationObserver(() => {
        const t = document.documentElement.getAttribute("data-theme") || "dark";
        document.documentElement.classList.toggle("dark", t === "dark");
      });
      obs.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    })();
  </script>
</head>

<body class="bg-background-light dark:bg-bg-charcoal text-gray-900 dark:text-text-cream font-sans min-h-screen flex flex-col overflow-x-hidden selection:bg-accent/30 selection:text-gray-900 dark:selection:text-white transition-colors duration-400">

  <% const pdfUrl = (page && page.pdf_url) ? page.pdf_url : ""; %>

  <%- include('partials/header', {
    active: 'tree-pdf',
    siteUser,
    pageTitle: page?.title || 'مشجرة العائلة',
    pageSubtitle: 'النسخة الرسمية'
  }) %>

  <main class="flex-grow relative">

    <section class="pt-16 pb-12 px-6 max-w-[90rem] mx-auto text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-islamic-pattern opacity-40 dark:opacity-10 pointer-events-none"></div>

      <img src="/assets/logo-dark.svg" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] md:w-[600px] opacity-[0.02] pointer-events-none hidden dark:block" alt="">
      <img src="/assets/logo-light.svg" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] md:w-[600px] opacity-[0.02] pointer-events-none block dark:hidden" alt="">

      <div class="w-px h-10 bg-gradient-to-b from-transparent via-accent to-transparent mx-auto mb-5 relative z-10"></div>
      
      <p class="text-[10px] md:text-xs font-sans font-bold tracking-[0.2em] uppercase text-gray-400 dark:text-gray-500 mb-2 relative z-10">النسخة الرسمية</p>

      <h1 class="text-4xl md:text-6xl font-display leading-tight mb-4 relative z-10 font-bold">
        <span class="text-primary dark:text-white transition-colors duration-300">مشجرة</span> <span class="text-accent">العائلة</span>
      </h1>
      
      <p class="text-[14px] md:text-base font-sans text-gray-500 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed relative z-10 font-medium mb-10">
        <%= page?.subtitle || "النسخة الرقمية المعتمدة لشجرة العائلة، مصممة للحفظ والطباعة عالية الدقة." %>
      </p>

      <% if (pdfUrl) { %>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 relative z-10">
          <a href="<%= pdfUrl %>" target="_blank" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-accent text-[#050505] font-sans font-bold hover:bg-accent-gold-dark transition-all shadow-md hover:-translate-y-0.5">
            <span class="material-symbols-outlined text-[20px]">fullscreen</span> عرض الشجرة كاملة
          </a>
          <button id="downloadBig" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl border border-gray-200 dark:border-white/10 bg-white/80 dark:bg-[#111]/80 text-gray-900 dark:text-white font-sans font-bold hover:border-accent dark:hover:border-accent transition-all backdrop-blur-md shadow-sm hover:-translate-y-0.5">
            <span class="material-symbols-outlined text-[20px]">download</span> تحميل النسخة الأصلية
          </button>
        </div>
      <% } %>
    </section>

    <section class="px-4 sm:px-6 lg:px-8 pb-20 relative z-10">
      
      <% if (page?.content) { %>
        <div class="max-w-4xl mx-auto mb-10 text-center font-sans text-[15px] md:text-base leading-relaxed text-gray-700 dark:text-gray-300 relative z-10 font-medium">
          <%- page.content.replace(/\n/g, "<br>") %>
        </div>
      <% } %>

      <div id="pdfCanvas" class="relative mx-auto flex justify-center w-full relative z-10">
        <% if (pdfUrl) { %>
          <div class="relative group rounded-[24px] border border-accent-gold/20 bg-white dark:bg-[#0A0A0A] overflow-hidden w-full shadow-luxury dark:shadow-luxury-dark p-3 md:p-4 glass-panel" style="max-width: 65vh;">
            
            <a href="<%= pdfUrl %>" target="_blank" class="absolute inset-0 z-20 bg-black/0 hover:bg-black/40 backdrop-blur-0 hover:backdrop-blur-sm transition-all duration-500 cursor-pointer flex items-center justify-center">
              <div class="opacity-0 group-hover:opacity-100 bg-accent text-[#050505] px-8 py-4 rounded-xl font-sans font-bold shadow-[0_10px_30px_rgba(229,184,105,0.4)] flex items-center gap-2 transform translate-y-4 group-hover:translate-y-0 transition-all duration-500">
                <span class="material-symbols-outlined text-[24px]">open_in_new</span> انقر لعرض المشجرة كاملة
              </div>
            </a>

            <div id="pdfInner" class="w-full pointer-events-none flex justify-center bg-white rounded-xl overflow-hidden shadow-inner border border-gray-100 dark:border-white/5">
              <iframe id="pdfFrame" src="<%= pdfUrl %>#toolbar=0&navpanes=0&scrollbar=0&view=Fit" class="w-full bg-white border-none block" style="height: 80vh;" title="شجرة العائلة PDF"></iframe>
            </div>

          </div>
        <% } else { %>
          <div class="w-full max-w-4xl h-[50vh] flex flex-col items-center justify-center border-2 border-dashed border-gray-300 dark:border-white/10 bg-white/50 dark:bg-black/20 backdrop-blur-md text-center p-8 rounded-[24px] shadow-sm">
            <div class="w-20 h-20 mx-auto rounded-full bg-primary/5 dark:bg-white/5 border border-primary/10 dark:border-white/10 text-primary dark:text-accent flex items-center justify-center mb-6">
              <span class="material-symbols-outlined text-[40px]">picture_as_pdf</span>
            </div>
            <h3 class="text-3xl font-display text-primary dark:text-white mb-3 font-bold">لا يوجد ملف متاح</h3>
            <p class="text-gray-500 dark:text-gray-400 font-sans text-lg font-medium">سيقوم مدير الموقع بإرفاق المشجرة قريباً.</p>
          </div>
        <% } %>
      </div>

    </section>

  </main>

  <footer class="bg-background-light dark:bg-[#050505] border-t border-gray-200 dark:border-white/5 mt-auto py-8 relative z-10">
    <div class="max-w-[90rem] mx-auto px-6 text-center flex flex-col items-center gap-3">
      <p class="text-[11px] font-sans font-semibold text-gray-400 dark:text-gray-600 uppercase tracking-widest">
        © ٢٠٢٦ وقف عائلة خاشقجي. جميع الحقوق محفوظة. حفظ الأنساب والاحتفاء بالتراث.
      </p>
    </div>
  </footer>
<script>
    (function(){
      const inner = document.getElementById("pdfInner");
      const canvas = document.getElementById("pdfCanvas");
      const zl = document.getElementById("zoomLabel");
      const btnIn = document.getElementById("zoomIn");
      const btnOut = document.getElementById("zoomOut");
      const btnFull = document.getElementById("fullBtn");
      const btnDownload = document.getElementById("downloadBtn");
      const btnPrint = document.getElementById("printBtn"); 
      const btnDownloadBig = document.getElementById("downloadBig"); 
      const pdfFrame = document.getElementById("pdfFrame");
      if (!pdfFrame) return;

      let zoom = 1;
      function clamp(v, a, b){ return Math.max(a, Math.min(b, v)); }
      function applyZoom(){
        zoom = clamp(zoom, 0.6, 2.2);
        if(inner) inner.style.transform = `scale(${zoom})`;
        if(zl) zl.textContent = `${Math.round(zoom*100)}%`;
      }

      btnIn?.addEventListener("click", () => { zoom += 0.1; applyZoom(); });
      btnOut?.addEventListener("click", () => { zoom -= 0.1; applyZoom(); });

      btnFull?.addEventListener("click", async () => {
        const el = canvas;
        if (!el) return;
        try {
          if (!document.fullscreenElement) await el.requestFullscreen();
          else await document.exitFullscreen();
        } catch(e) {}
      });

      let isDown = false, startX = 0, startY = 0, scrollLeft = 0, scrollTop = 0;
      canvas?.addEventListener("mousedown", (e) => {
        isDown = true;
        startX = e.pageX;
        startY = e.pageY;
        scrollLeft = canvas.scrollLeft;
        scrollTop = canvas.scrollTop;
      });
      window.addEventListener("mouseup", () => { isDown = false; });
      window.addEventListener("mousemove", (e) => {
        if(!isDown || !canvas) return;
        const dx = e.pageX - startX;
        const dy = e.pageY - startY;
        canvas.scrollLeft = scrollLeft - dx;
        canvas.scrollTop = scrollTop - dy;
      });

      function downloadPdfFromFrame() {
        const src = pdfFrame.getAttribute("src");
        if (!src) return;

        const cleanSrc = src.split('#')[0];
        const absoluteUrl = cleanSrc.startsWith("http") ? cleanSrc : (location.origin + cleanSrc);
        const safeTitle = (document.title || "tree-pdf")
          .replace(/[^\w\u0600-\u06FF\- ]+/g, "")
          .trim()
          .replace(/\s+/g, "-");
        const filename = `${safeTitle || "tree-pdf"}.pdf`;

        try {
          const a = document.createElement("a");
          a.href = absoluteUrl;
          a.download = filename;
          a.rel = "noopener";
          document.body.appendChild(a);
          a.click();
          a.remove();
        } catch (e) {
          window.open(absoluteUrl, "_blank", "noopener");
        }
      }

      btnDownload?.addEventListener("click", downloadPdfFromFrame);
      btnDownloadBig?.addEventListener("click", downloadPdfFromFrame);

      btnPrint?.addEventListener("click", () => {
        if(pdfFrame && pdfFrame.contentWindow) {
          pdfFrame.contentWindow.print();
        }
      });

      applyZoom();
    })();
  </script>
  <script src="/site-assistant.js"></script>
</body>
</html>