<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= user.full_name || 'عضو العائلة' %></title>

  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/styles.css" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@300;400;500;700;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries,line-clamp"></script>

  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#005A2B",     /* اللون الأخضر الملكي الفاخر */
            primaryDark: "#003D1D", /* أخضر داكن للتحويم */
            accent: "#E5B869",      /* ذهب سائل */
            "accent-gold": "#E5B869",
            "background-light": "#F8F8F6",
            "background-dark": "#050505",
            "bg-charcoal": "#050505",
            "card-light": "#FFFFFF",
            "card-dark": "#0A0A0A",
            "bg-card": "#0A0A0A",
            "text-cream": "#FAFAFA",
            "text-dark": "#111827",
            "text-muted": "#71717A",
            "muted-slate": "#71717A",
            gold: "#E5B869",
            "accent-gold-dark": "#D4A353",
          },
          fontFamily: {
            display: ["'Aref Ruqaa'", "serif"],
            sans: ["Tajawal", "sans-serif"],
          },
          backgroundImage: {
            "islamic-pattern": "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E5B869' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")",
            "islamic-pattern-dark": "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E5B869' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")"
          },
          boxShadow: {
            'luxury': '0 20px 40px -10px rgba(0,0,0,0.05), 0 0 20px rgba(229,184,105,0.03)',
            'luxury-dark': '0 20px 40px -10px rgba(0,0,0,0.4), 0 0 20px rgba(229,184,105,0.05)',
          }
        }
      }
    };
  </script>

  <style type="text/tailwindcss">
    @layer utilities {
      .scrollbar-hide::-webkit-scrollbar { display: none; }
      .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
      .glass-panel {
        @apply bg-white/85 dark:bg-[#080808]/85 backdrop-blur-xl border border-accent-gold/20 shadow-luxury dark:shadow-luxury-dark;
      }
    }
  </style>

  <style>
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(229, 184, 105, 0.4); border-radius: 4px; transition: background 0.3s; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(229, 184, 105, 0.8); }

    /* حقل الإدخال الزجاجي */
    .field-glass {
      background: rgba(255,255,255,0.5);
      border: 1px solid rgba(229,184,105,0.2);
      transition: all 0.3s ease;
      box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
    }
    html.dark .field-glass {
      background: rgba(10,10,10,0.5);
      border-color: rgba(255,255,255,0.05);
      box-shadow: inset 0 2px 4px rgba(0,0,0,0.2);
    }
    .field-glass:focus {
      background: #FFFFFF;
      border-color: #E5B869;
      box-shadow: 0 0 0 2px rgba(229,184,105,0.1);
    }
    html.dark .field-glass:focus {
      background: #0A0A0A;
      border-color: #E5B869;
      box-shadow: 0 0 0 2px rgba(229,184,105,0.15);
    }
  </style>

  <script>
    (function () {
      const saved = localStorage.getItem("theme") || "dark";
      document.documentElement.setAttribute("data-theme", saved);
      document.documentElement.classList.toggle("dark", saved === "dark");
    })();
  </script>
</head>

<body class="bg-background-light dark:bg-bg-charcoal text-gray-900 dark:text-text-cream font-sans min-h-screen flex flex-col overflow-x-hidden selection:bg-accent/30 selection:text-gray-900 dark:selection:text-white transition-colors duration-400">

  <%- include('partials/header', {active, siteUser, pageTitle:user.full_name || 'عضو العائلة', pageSubtitle:'الملف الشخصي'}) %>

  <main class="flex-grow relative z-10 py-10 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto w-full space-y-8">

    <section class="glass-panel rounded-[24px] overflow-hidden shadow-luxury dark:shadow-luxury-dark border border-gray-100 dark:border-white/5 relative flex flex-col">

      <!-- صورة الغلاف -->
      <div class="h-40 sm:h-48 md:h-56 bg-primary/10 dark:bg-[#111] relative overflow-hidden shrink-0 border-b border-gray-100 dark:border-white/5 bg-cover bg-center" style="background-image:url('<%= user.cover_url || '' %>')">
         <div class="absolute inset-0 bg-islamic-pattern opacity-30 pointer-events-none mix-blend-overlay"></div>
         <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent opacity-70 pointer-events-none"></div>
      </div>

      <!-- منطقة البيانات: الصورة وحدها هي التي تتداخل مع الغلاف، أمّا الاسم والأزرار فينزلون تحت الغلاف -->
      <div class="px-6 md:px-10 pb-7">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5">

          <!-- يمين: الصورة الشخصية + الاسم -->
          <div class="flex flex-col md:flex-row md:items-end items-center gap-5 min-w-0">

            <!-- الصورة الشخصية (هي وحدها التي ترتفع فوق الغلاف) -->
            <div class="relative w-28 h-28 md:w-36 md:h-36 shrink-0 -mt-14 md:-mt-20 rounded-[2rem] border-[4px] md:border-[5px] border-white dark:border-[#0A0A0A] bg-gray-50 dark:bg-[#111] overflow-hidden shadow-xl ring-1 ring-black/5 dark:ring-white/10 flex items-center justify-center z-20">
              <img src="<%= avatar %>" onerror="this.src='/assets/default-avatar.svg'" class="w-full h-full object-cover" alt="<%= user.full_name || 'عضو' %>">
            </div>

            <!-- الاسم والشارات (في منطقة الكارت البيضاء، بدون تداخل) -->
            <div class="flex flex-col gap-1 min-w-0 text-center md:text-right pt-1 md:pb-1">
              <h1 class="text-2xl md:text-3xl font-display font-bold text-primary dark:text-white leading-snug truncate">
                <%= user.full_name || 'عضو' %> بن <%= user.father_name || '—' %>
              </h1>

              <div class="mt-2.5 flex gap-2 flex-wrap justify-center md:justify-start">
                <span class="px-3 py-1 rounded-full text-[12px] font-bold flex items-center gap-1.5 shadow-sm <%= user.verification_status==='verified' || user.matched_person_id ? 'bg-[#E8F5ED] dark:bg-[#003D1D]/30 text-primary dark:text-emerald-400 border border-primary/20 dark:border-primary/40' : 'bg-gray-50 dark:bg-[#111] text-gray-500 dark:text-gray-400 border border-gray-200 dark:border-white/10' %>">
                  <span class="material-symbols-outlined text-[15px]"><%= user.verification_status==='verified' || user.matched_person_id ? 'verified' : 'link_off' %></span>
                  <%= user.verification_status==='verified' || user.matched_person_id ? 'موثق داخل الشجرة' : 'غير موثق' %>
                </span>
                <span class="px-3 py-1 rounded-full text-[12px] font-bold flex items-center gap-1.5 bg-primary/5 dark:bg-white/5 text-primary dark:text-accent border border-primary/10 dark:border-white/10 shadow-sm">
                  <span class="material-symbols-outlined text-[15px]">visibility</span>
                  <%= stats.profileViews || 0 %> مشاهدة
                </span>
              </div>
            </div>
          </div>

          <!-- يسار: أزرار مدمجة (pills أصغر) -->
          <div class="flex flex-wrap items-center gap-2.5 shrink-0 justify-center md:justify-end">
            <% if(!isMe && canMessageResult.ok){ %>
              <a href="/chat/private/<%= user.id %>" class="px-4 py-2 rounded-full bg-primary hover:bg-primaryDark text-white dark:bg-white dark:text-[#050505] dark:hover:bg-accent font-sans font-bold text-[13px] shadow-sm hover:shadow-md transition-all flex items-center justify-center gap-1.5">
                <span class="material-symbols-outlined text-[16px]">chat</span> مراسلة العضو
              </a>
            <% } else if(!isMe){ %>
              <div class="px-4 py-2 rounded-full bg-gray-50 dark:bg-black/30 border border-gray-200 dark:border-white/5 text-[12px] text-gray-500 font-bold text-center flex items-center justify-center gap-1.5">
                <span class="material-symbols-outlined text-[16px]">info</span> <%= canMessageResult.message %>
              </div>
            <% } %>

            <% if(treePerson){ %>
              <a href="/?focus=<%= treePerson.id %>" class="px-4 py-2 rounded-full bg-gray-50 dark:bg-black/30 border border-gray-200 dark:border-white/5 hover:border-primary dark:hover:border-accent text-primary dark:text-accent font-sans font-bold text-[13px] transition-all shadow-sm flex items-center justify-center gap-1.5">
                <span class="material-symbols-outlined text-[16px]">account_tree</span> موقعي في الشجرة
              </a>
            <% } %>

            <% if(honorItem){ %>
              <a href="/honor" class="px-4 py-2 rounded-full bg-gray-50 dark:bg-black/30 border border-gray-200 dark:border-white/5 hover:border-primary dark:hover:border-accent text-primary dark:text-accent font-sans font-bold text-[13px] transition-all shadow-sm flex items-center justify-center gap-1.5">
                <span class="material-symbols-outlined text-[16px]">military_tech</span> السيرة الذاتية
              </a>
            <% } %>
          </div>

        </div>
      </div>
    </section>

    <% const canSeeContact = !isMe; %>
    <section class="grid lg:grid-cols-2 gap-6 lg:gap-8 items-start">

      <div class="glass-panel rounded-[24px] p-6 md:p-8 shadow-sm">
        <h2 class="font-display font-bold text-2xl text-primary dark:text-white mb-6 flex items-center gap-2 border-b border-gray-100 dark:border-white/5 pb-4">
          <span class="material-symbols-outlined text-accent text-[28px]">assignment_ind</span> المعلومات الشخصية
        </h2>

        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-y-5 gap-x-6 text-[14px]">
          <div class="flex flex-col gap-1">
            <dt class="text-gray-500 dark:text-gray-400 font-bold text-[12px] uppercase tracking-wide">اسم الأم</dt>
            <dd class="font-sans font-bold text-gray-900 dark:text-gray-200"><%= user.mother_name || '—' %></dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="text-gray-500 dark:text-gray-400 font-bold text-[12px] uppercase tracking-wide">عدد الأبناء</dt>
            <dd class="font-sans font-bold text-gray-900 dark:text-gray-200"><%= user.children_count ?? '—' %></dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="text-gray-500 dark:text-gray-400 font-bold text-[12px] uppercase tracking-wide">تاريخ الميلاد</dt>
            <dd class="font-sans font-bold text-gray-900 dark:text-gray-200"><%= (Number(user.show_birth_date ?? 0) || isMe) ? (user.birth_date || '—') : 'مخفي' %></dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="text-gray-500 dark:text-gray-400 font-bold text-[12px] uppercase tracking-wide">النشأة</dt>
            <dd class="font-sans font-bold text-gray-900 dark:text-gray-200"><%= user.origin_place || '—' %></dd>
          </div>
          <div class="flex flex-col gap-1 sm:col-span-2">
            <dt class="text-gray-500 dark:text-gray-400 font-bold text-[12px] uppercase tracking-wide">الإقامة</dt>
            <dd class="font-sans font-bold text-gray-900 dark:text-gray-200"><%= user.current_residence || '—' %></dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="text-gray-500 dark:text-gray-400 font-bold text-[12px] uppercase tracking-wide">العمل</dt>
            <dd class="font-sans font-bold text-gray-900 dark:text-gray-200"><%= user.work || '—' %></dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="text-gray-500 dark:text-gray-400 font-bold text-[12px] uppercase tracking-wide">المؤهل</dt>
            <dd class="font-sans font-bold text-gray-900 dark:text-gray-200"><%= user.qualification || '—' %></dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="text-gray-500 dark:text-gray-400 font-bold text-[12px] uppercase tracking-wide">اسم الزوجة</dt>
            <dd class="font-sans font-bold text-gray-900 dark:text-gray-200"><%= user.spouse_name || '—' %></dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="text-gray-500 dark:text-gray-400 font-bold text-[12px] uppercase tracking-wide">النسب</dt>
            <dd class="font-sans font-bold text-gray-900 dark:text-gray-200"><%= user.spouse_family || '—' %></dd>
          </div>
        </dl>
      </div>

      <div class="flex flex-col gap-6 lg:gap-8">
        <div class="glass-panel rounded-[24px] p-6 md:p-8 shadow-sm">
          <h2 class="font-display font-bold text-2xl text-primary dark:text-white mb-6 flex items-center gap-2 border-b border-gray-100 dark:border-white/5 pb-4">
            <span class="material-symbols-outlined text-accent text-[28px]">contact_phone</span> التواصل
          </h2>

          <div class="space-y-4 text-[14px]">
            <div class="flex items-center justify-between p-3 rounded-xl bg-gray-50 dark:bg-black/30 border border-gray-200 dark:border-white/5">
              <span class="font-bold text-gray-500 dark:text-gray-400 flex items-center gap-2"><span class="material-symbols-outlined text-[18px]">call</span> الجوال</span>
              <span class="font-sans font-bold text-gray-900 dark:text-white" dir="ltr"><%= (Number(user.show_phone ?? 1) || isMe) ? (user.phone || '—') : 'مخفي' %></span>
            </div>
            <div class="flex items-center justify-between p-3 rounded-xl bg-gray-50 dark:bg-black/30 border border-gray-200 dark:border-white/5">
              <span class="font-bold text-gray-500 dark:text-gray-400 flex items-center gap-2"><span class="material-symbols-outlined text-[18px]">mail</span> البريد</span>
              <span class="font-sans font-bold text-gray-900 dark:text-white truncate max-w-[60%]" dir="ltr"><%= (Number(user.show_email ?? 1) || isMe) ? (user.email || '—') : 'مخفي' %></span>
            </div>

            <% if(Number(user.show_social_links ?? 1) || isMe){ %>
              <div class="grid grid-cols-2 gap-3 mt-5">
                <% [['Facebook',user.facebook_url, 'public'],['Instagram',user.instagram_url, 'photo_camera'],['X',user.x_url, 'alternate_email'],['LinkedIn',user.linkedin_url, 'work']].forEach(([label,url, icon])=>{ if(url){ %>
                  <a href="<%= url %>" target="_blank" class="h-11 rounded-xl bg-gray-50 hover:bg-gray-100 dark:bg-black/30 dark:hover:bg-white/5 border border-gray-200 dark:border-white/5 flex items-center justify-center gap-2 font-bold text-gray-700 dark:text-gray-300 transition-colors shadow-sm" dir="ltr">
                    <span class="material-symbols-outlined text-[18px] text-accent"><%= icon %></span>
                    <%= label %>
                  </a>
                <% } }) %>
              </div>
            <% } else { %>
              <p class="text-sm font-medium text-gray-500 mt-5 text-center bg-gray-50 dark:bg-black/20 p-3 rounded-xl border border-gray-100 dark:border-white/5">روابط التواصل مخفية</p>
            <% } %>
          </div>
        </div>

        <% if(!isMe){ %>
          <div class="glass-panel rounded-[24px] p-6 md:p-8 shadow-sm">
            <h2 class="font-display font-bold text-xl text-red-600 dark:text-red-400 mb-4 flex items-center gap-2">
              <span class="material-symbols-outlined text-[24px]">report</span> بلاغ عن الحساب
            </h2>

            <% if (typeof reported !== 'undefined'){} %>
            <form method="post" action="/family-members/<%= user.id %>/report" class="flex flex-col gap-3">
              <div class="grid sm:grid-cols-2 gap-3">
                <select name="reason" class="field-glass h-12 rounded-xl text-[14px] appearance-none bg-no-repeat bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%239CA3AF%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpolyline%20points%3D%226%209%2012%2015%2018%209%22%3E%3C%2Fpolyline%3E%3C%2Fsvg%3E')] bg-[position:left_12px_center] bg-[length:16px_16px]">
                  <option>حساب مزيف</option>
                  <option>بيانات غير صحيحة</option>
                  <option>صورة غير مناسبة</option>
                  <option>محتوى مخالف</option>
                </select>
                <input name="details" placeholder="تفاصيل البلاغ" class="field-glass h-12 rounded-xl text-[14px] px-4">
              </div>
              <button class="w-full h-12 rounded-xl bg-red-50 hover:bg-red-100 dark:bg-red-500/10 dark:hover:bg-red-500/20 text-red-600 dark:text-red-400 font-sans font-bold text-[14px] border border-red-100 dark:border-red-500/20 transition-colors flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-[18px]">flag</span> إرسال بلاغ
              </button>
            </form>
          </div>
        <% } %>
      </div>

    </section>

  </main>

  <footer class="bg-background-light dark:bg-[#050505] border-t border-gray-200 dark:border-white/5 mt-auto py-8 relative z-10">
    <div class="max-w-[90rem] mx-auto px-6 text-center flex flex-col items-center gap-3">
      <p class="text-[11px] font-sans font-semibold text-gray-400 dark:text-gray-600 uppercase tracking-widest">
        © ٢٠٢٦ وقف عائلة خاشقجي. جميع الحقوق محفوظة. حفظ الأنساب والاحتفاء بالتراث.
      </p>
    </div>
  </footer>

  <script src="/chat-notifications.js"></script>
</body>
</html>
