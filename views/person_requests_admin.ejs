<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<script src="/theme.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@300;400;500;700;900&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries,line-clamp"></script>
<script>
  tailwind.config={darkMode:'class',theme:{extend:{colors:{primary:'#005A2B',accent:'#E5B869','bg-light':'#F5F3F7','bg-dark':'#050505','card-light':'rgba(255,255,255,.84)','card-dark':'rgba(15,12,25,.84)','border-light':'rgba(0,90,43,.10)','border-dark':'rgba(229,184,105,.12)'},fontFamily:{display:["'Aref Ruqaa'",'serif'],sans:['Tajawal','sans-serif']}}}}
</script>
<style type="text/tailwindcss">@layer utilities{.glass-panel{@apply backdrop-blur-2xl shadow-xl}}    html.theme-switching, html.theme-switching *, html.theme-switching *::before, html.theme-switching *::after { transition: none !important; animation: none !important; }
</style>
<style>
  ::-webkit-scrollbar{width:6px;height:6px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:#005A2B;border-radius:999px}html.dark ::-webkit-scrollbar-thumb{background:#E5B869}
  html.dark .dark-toggle-icon-moon{display:none} html:not(.dark) .dark-toggle-icon-sun{display:none}
  #nexusCanvas{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events: none}.admin-bg-layer{position:fixed;inset:0;z-index:1;pointer-events:none;background:linear-gradient(to bottom,rgba(255,255,255,.45),rgba(255,255,255,.86))}html.dark .admin-bg-layer{background:linear-gradient(to bottom,rgba(0,0,0,.45),rgba(5,5,5,.92))}
  .field{width:100%;border-radius:16px;border:1px solid rgba(0,0,0,.10);padding:12px 14px;font-weight:800;background:#fff;color:#111827;outline:none;transition:.2s}.dark .field{background:rgba(255,255,255,.055);border-color:rgba(255,255,255,.12);color:#fff}.field:focus{border-color:#005A2B;box-shadow:0 0 0 4px rgba(0,90,43,.10)}html.dark .field:focus{border-color:#E5B869;box-shadow:0 0 0 4px rgba(229,184,105,.12)}
  #adminMobileToggle:checked ~ #adminMobileOverlay{display:block}#adminMobileToggle:checked ~ #adminMobileDrawer{transform:translateX(0)}#adminMobileOverlay{display:none}.admin-mobile-drawer{transform:translateX(-115%);transition:transform .35s cubic-bezier(.16,1,.3,1)}
</style>
<script>(function(){const saved=localStorage.getItem('theme')||'dark';document.documentElement.classList.toggle('dark',saved==='dark');document.documentElement.setAttribute('data-theme',saved);})();</script>
<title>طلبات الأفراد - لوحة الإدارة</title>
</head>
<body class="bg-bg-light dark:bg-bg-dark text-gray-800 dark:text-gray-200 font-sans h-screen flex overflow-hidden selection:bg-accent selection:text-black">
  <canvas id="nexusCanvas"></canvas><div class="admin-bg-layer"></div>
<input id="adminMobileToggle" type="checkbox" class="hidden">
<label id="adminMobileOverlay" for="adminMobileToggle" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[80]"></label>
<aside id="adminMobileDrawer" class="admin-mobile-drawer fixed top-0 left-0 h-full w-[320px] max-w-[86vw] bg-white dark:bg-[#050505] border-r border-gray-200 dark:border-white/10 shadow-2xl z-[90] flex flex-col">
  <div class="h-1.5 w-full bg-gradient-to-r from-gray-300 via-accent to-gray-300 dark:from-gray-800 dark:via-accent dark:to-gray-800"></div>
  <div class="flex items-center justify-between p-6 border-b border-gray-100 dark:border-white/10"><div><h1 class="font-display font-bold text-xl text-primary dark:text-white">عائلة خاشقجي</h1><p class="text-[10px] font-bold text-gray-500 dark:text-accent uppercase tracking-widest mt-1">نظام الإدارة</p></div><label for="adminMobileToggle" class="w-10 h-10 rounded-full bg-gray-100 dark:bg-white/5 flex items-center justify-center text-gray-500 cursor-pointer"><span class="material-symbols-outlined text-[24px]">close</span></label></div>
  <nav class="flex-1 overflow-y-auto p-6 space-y-3 text-sm font-bold text-gray-700 dark:text-gray-300"><a href="/admin" class="flex items-center gap-3 px-4 py-4 rounded-2xl hover:bg-gray-50 dark:hover:bg-white/5"><span class="material-symbols-outlined text-gray-400">group</span> إدارة الأفراد</a><a href="/admin/pages" class="flex items-center gap-3 px-4 py-4 rounded-2xl hover:bg-gray-50 dark:hover:bg-white/5"><span class="material-symbols-outlined text-gray-400">history_edu</span> إدارة الصفحات</a><a href="/admin/honor" class="flex items-center gap-3 px-4 py-4 rounded-2xl hover:bg-gray-50 dark:hover:bg-white/5"><span class="material-symbols-outlined text-gray-400">workspace_premium</span> السير الذاتية</a><a href="/admin/news" class="flex items-center gap-3 px-4 py-4 rounded-2xl hover:bg-gray-50 dark:hover:bg-white/5"><span class="material-symbols-outlined text-gray-400">newspaper</span> الأخبار</a><a href="/admin/person-requests" class="flex items-center gap-3 px-4 py-4 rounded-2xl bg-primary/10 dark:bg-accent/10 text-primary dark:text-accent border border-primary/20 dark:border-accent/20"><span class="material-symbols-outlined">pending_actions</span> طلبات الأفراد</a><a href="/admin/dashboard" class="flex items-center gap-3 px-4 py-4 rounded-2xl hover:bg-gray-50 dark:hover:bg-white/5"><span class="material-symbols-outlined text-gray-400">dashboard</span> لوحة الإحصائيات</a><a href="/admin/activity" class="flex items-center gap-3 px-4 py-4 rounded-2xl hover:bg-gray-50 dark:hover:bg-white/5"><span class="material-symbols-outlined text-gray-400">manage_history</span> سجل النشاطات</a><a href="/admin/maintenance" class="flex items-center gap-3 px-4 py-4 rounded-2xl hover:bg-gray-50 dark:hover:bg-white/5"><span class="material-symbols-outlined text-gray-400">construction</span> وضع الصيانة</a><a href="/admin/support-messages" class="flex items-center gap-3 px-4 py-4 rounded-2xl hover:bg-gray-50 dark:hover:bg-white/5"><span class="material-symbols-outlined text-gray-400">mail</span> رسائل الدعم</a><div class="my-4 border-t border-gray-200 dark:border-white/10"></div><a href="/" class="flex items-center gap-3 px-4 py-4 rounded-2xl hover:bg-gray-50 dark:hover:bg-white/5"><span class="material-symbols-outlined text-gray-400">account_tree</span> العودة للموقع</a></nav>
  <div class="p-6 border-t border-gray-100 dark:border-white/10"><form method="post" action="/admin/logout"><button type="submit" class="w-full flex items-center justify-center gap-2 px-4 py-4 rounded-2xl border border-red-200 dark:border-red-900/30 text-red-600 dark:text-red-400 bg-red-50/50 dark:bg-red-500/10 font-bold"><span class="material-symbols-outlined">logout</span> تسجيل خروج</button></form></div>
</aside>
<aside class="relative z-20 hidden lg:flex flex-col w-[280px] h-[calc(100vh-2rem)] my-4 mx-4 bg-card-light dark:bg-card-dark glass-panel rounded-3xl border border-border-light dark:border-border-dark overflow-hidden shrink-0">
  <div class="flex items-center gap-3 p-6 border-b border-border-light dark:border-border-dark shrink-0"><div class="w-12 h-12 flex items-center justify-center rounded-2xl bg-primary dark:bg-accent text-white dark:text-black shadow-lg"><span class="material-symbols-outlined text-[28px]">shield_person</span></div><div><h1 class="font-display font-bold text-xl leading-none text-primary dark:text-white">عائلة خاشقجي</h1><p class="text-[10px] font-bold text-gray-500 dark:text-accent uppercase tracking-widest mt-1.5">نظام الإدارة المركزية</p></div></div>
  <nav class="flex-1 overflow-y-auto p-4 space-y-6">
    <div class="space-y-2"><p class="px-3 text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-3">البيانات الرئيسية</p><a href="/admin" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors"><span class="material-symbols-outlined text-[22px]">group</span> إدارة الأفراد</a><a href="/admin/pages" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors"><span class="material-symbols-outlined text-[22px]">history_edu</span> إدارة الصفحات</a><a href="/admin/honor" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors"><span class="material-symbols-outlined text-[22px]">workspace_premium</span> السير الذاتية</a><a href="/admin/news" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors"><span class="material-symbols-outlined text-[22px]">newspaper</span> الأخبار والمناسبات</a><a href="/admin/person-requests" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl bg-primary/10 dark:bg-accent/10 text-primary dark:text-accent font-bold text-sm border border-primary/20 dark:border-accent/20 relative overflow-hidden"><div class="absolute right-0 top-1/2 -translate-y-1/2 w-1.5 h-6 rounded-l-full bg-primary dark:bg-accent"></div><span class="material-symbols-outlined text-[22px]">pending_actions</span> طلبات الأفراد</a></div>
    <div class="space-y-2"><p class="px-3 text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-3">النظام والموقع</p><a href="/admin/dashboard" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors"><span class="material-symbols-outlined text-[22px]">dashboard</span> لوحة الإحصائيات</a><a href="/admin/activity" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors"><span class="material-symbols-outlined text-[22px]">manage_history</span> سجل النشاطات</a><a href="/admin/maintenance" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors"><span class="material-symbols-outlined text-[22px]">construction</span> وضع الصيانة</a><a href="/admin/support-messages" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors"><span class="material-symbols-outlined text-[22px]">mail</span> رسائل الدعم</a><a href="/" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors"><span class="material-symbols-outlined text-[22px]">account_tree</span> عرض الشجرة</a></div>
  </nav>
  <div class="p-4 border-t border-border-light dark:border-border-dark shrink-0 m-2 rounded-2xl bg-white/50 dark:bg-black/30"><div class="flex items-center gap-3"><div class="w-10 h-10 rounded-full bg-primary/10 dark:bg-accent/10 flex items-center justify-center text-primary dark:text-accent"><span class="material-symbols-outlined text-[20px]">person</span></div><div class="flex-1 min-w-0"><p class="text-sm font-bold text-gray-900 dark:text-white truncate"><%= admin?.username || 'مدير النظام' %></p><p class="text-[10px] text-primary dark:text-accent uppercase tracking-widest mt-0.5 font-bold">Admin</p></div><form method="post" action="/admin/logout"><button type="submit" class="w-9 h-9 flex items-center justify-center rounded-xl bg-red-50 dark:bg-red-500/10 text-red-500 hover:bg-red-500 hover:text-white transition-all"><span class="material-symbols-outlined text-[18px]">logout</span></button></form></div></div>
</aside>
  <main class="flex-1 flex flex-col min-w-0 h-full relative z-10">
    <header class="flex items-center justify-between gap-4 p-4 lg:p-8 shrink-0">
      <div class="flex items-center gap-3 min-w-0">
        <label for="adminMobileToggle" class="lg:hidden flex items-center justify-center w-12 h-12 rounded-2xl bg-card-light dark:bg-card-dark glass-panel border border-border-light dark:border-border-dark text-primary dark:text-accent shadow-sm cursor-pointer shrink-0"><span class="material-symbols-outlined text-[26px]">menu</span></label>
        <div class="min-w-0"><h2 class="text-2xl md:text-3xl font-display font-bold text-primary dark:text-white tracking-tight leading-none mb-1.5 truncate">طلبات الأفراد</h2><div class="flex items-center gap-1.5 text-gray-500 text-[11px] font-bold uppercase tracking-widest flex-wrap"><span>لوحة الإدارة</span><span class="material-symbols-outlined text-[14px]">chevron_left</span><span class="text-accent">طلبات إضافة الأفراد</span></div></div>
      </div>
      <div class="flex items-center gap-2 sm:gap-3 shrink-0"><button id="themeBtn" class="flex items-center justify-center w-12 h-12 rounded-2xl bg-card-light dark:bg-card-dark glass-panel border border-border-light dark:border-border-dark text-gray-600 dark:text-accent shadow-sm" type="button"><span class="material-symbols-outlined text-[22px] dark-toggle-icon-moon">dark_mode</span><span class="material-symbols-outlined dark-toggle-icon-sun text-[24px]">light_mode</span></button><a href="/" class="hidden sm:flex items-center gap-2 px-5 h-12 rounded-2xl font-bold text-sm bg-primary dark:bg-accent text-white dark:text-black shadow-sm"><span class="material-symbols-outlined text-[21px]">account_tree</span><span>عرض الموقع</span></a></div>
    </header>
    <div class="flex-1 overflow-y-auto px-4 lg:px-8 pb-12">
      <div class="max-w-[100rem] mx-auto space-y-6">
        <section class="bg-card-light dark:bg-card-dark glass-panel rounded-3xl border border-border-light dark:border-border-dark p-5 md:p-6 shadow-sm"><div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4"><div><h3 class="font-black text-xl text-primary dark:text-white">مراجعة طلبات الزوار قبل النشر</h3><p class="text-sm text-gray-500 dark:text-gray-400 mt-2 leading-7">كل طلب يتم إرساله من الصفحة العامة يظهر هنا، ويمكن للإدارة اعتماده وإضافته للشجرة أو رفضه مع ملاحظة.</p></div><div class="flex flex-wrap gap-2"><a href="/submit-person" class="px-4 py-3 rounded-2xl bg-white/70 dark:bg-white/5 border border-black/5 dark:border-white/10 text-primary dark:text-accent font-bold">عرض صفحة الإرسال</a><a href="/admin" class="px-4 py-3 rounded-2xl bg-primary dark:bg-accent text-white dark:text-black font-bold">إدارة الأفراد</a></div></div></section>

        <section class="bg-card-light dark:bg-card-dark glass-panel rounded-3xl border border-border-light dark:border-border-dark p-5 md:p-6 shadow-sm"><div class="flex flex-col lg:flex-row lg:items-end gap-4 lg:justify-between"><div><h3 class="font-black text-lg text-primary dark:text-white flex items-center gap-2"><span class="material-symbols-outlined text-accent">manage_search</span>البحث بالرقم المرجعي</h3><p class="text-sm text-gray-500 dark:text-gray-400 mt-2 leading-7">اكتب الرقم المرجعي الخاص بطلب المستخدم لعرض بيانات الطلب مباشرة بغض النظر عن حالته.</p></div><form method="get" action="/admin/person-requests" class="flex flex-col sm:flex-row gap-3 w-full lg:w-auto"><input name="reference" value="<%= searchReference || '' %>" class="field min-w-0 sm:min-w-[280px]" placeholder="مثال: FAM-2026-ABC123"><button class="px-5 py-3 rounded-2xl bg-primary dark:bg-accent text-white dark:text-black font-black flex items-center justify-center gap-2" type="submit"><span class="material-symbols-outlined">search</span>بحث</button><% if (isReferenceSearch) { %><a href="/admin/person-requests" class="px-5 py-3 rounded-2xl bg-white/70 dark:bg-white/5 border border-black/5 dark:border-white/10 text-primary dark:text-accent font-black text-center">إلغاء البحث</a><% } %></form></div><% if (isReferenceSearch) { %><div class="mt-4 p-4 rounded-2xl <%= requests.length ? 'bg-green-50 dark:bg-green-500/10 text-green-800 dark:text-green-200 border-green-200 dark:border-green-500/20' : 'bg-red-50 dark:bg-red-500/10 text-red-800 dark:text-red-200 border-red-200 dark:border-red-500/20' %> border font-bold"><%= requests.length ? 'تم العثور على طلب مطابق للرقم المرجعي.' : 'لا يوجد طلب بهذا الرقم المرجعي. تأكد من كتابة الرمز بشكل صحيح.' %></div><% } %></section>

        <% if (saved) { %><div class="p-4 rounded-2xl bg-green-50 dark:bg-green-500/10 text-green-800 dark:text-green-200 border border-green-200 dark:border-green-500/20 font-bold">تم اعتماد الطلب وإضافة الفرد للشجرة.</div><% } %>
        <% if (rejected) { %><div class="p-4 rounded-2xl bg-amber-50 dark:bg-amber-500/10 text-amber-800 dark:text-amber-200 border border-amber-200 dark:border-amber-500/20 font-bold">تم رفض الطلب.</div><% } %>
        <% if (deleted) { %><div class="p-4 rounded-2xl bg-red-50 dark:bg-red-500/10 text-red-800 dark:text-red-200 border border-red-200 dark:border-red-500/20 font-bold">تم حذف الطلب من قائمة طلبات الأفراد.</div><% } %>
        <% if (error) { %><div class="p-4 rounded-2xl bg-red-50 dark:bg-red-500/10 text-red-800 dark:text-red-200 border border-red-200 dark:border-red-500/20 font-bold"><%= error %></div><% } %>

        <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
          <a href="/admin/person-requests?status=pending" class="rounded-3xl p-5 border transition <%= status==='pending'?'border-primary dark:border-accent bg-primary/10 dark:bg-accent/10':'border-border-light dark:border-border-dark bg-card-light dark:bg-card-dark' %> glass-panel"><div class="flex items-center justify-between"><div><div class="text-sm font-bold text-gray-500 dark:text-gray-400">قيد المراجعة</div><div class="text-3xl font-black text-primary dark:text-accent mt-2"><%= counts.pending %></div></div><span class="material-symbols-outlined text-primary dark:text-accent text-[32px]">pending_actions</span></div></a>
          <a href="/admin/person-requests?status=approved" class="rounded-3xl p-5 border transition <%= status==='approved'?'border-primary dark:border-accent bg-primary/10 dark:bg-accent/10':'border-border-light dark:border-border-dark bg-card-light dark:bg-card-dark' %> glass-panel"><div class="flex items-center justify-between"><div><div class="text-sm font-bold text-gray-500 dark:text-gray-400">المعتمدة</div><div class="text-3xl font-black text-primary dark:text-accent mt-2"><%= counts.approved %></div></div><span class="material-symbols-outlined text-primary dark:text-accent text-[32px]">verified</span></div></a>
          <a href="/admin/person-requests?status=rejected" class="rounded-3xl p-5 border transition <%= status==='rejected'?'border-primary dark:border-accent bg-primary/10 dark:bg-accent/10':'border-border-light dark:border-border-dark bg-card-light dark:bg-card-dark' %> glass-panel"><div class="flex items-center justify-between"><div><div class="text-sm font-bold text-gray-500 dark:text-gray-400">المرفوضة</div><div class="text-3xl font-black text-primary dark:text-accent mt-2"><%= counts.rejected %></div></div><span class="material-symbols-outlined text-primary dark:text-accent text-[32px]">block</span></div></a>
          <div class="rounded-3xl p-5 border border-border-light dark:border-border-dark bg-card-light dark:bg-card-dark glass-panel"><div class="flex items-center justify-between"><div><div class="text-sm font-bold text-gray-500 dark:text-gray-400">الإجمالي</div><div class="text-3xl font-black text-primary dark:text-accent mt-2"><%= counts.total %></div></div><span class="material-symbols-outlined text-primary dark:text-accent text-[32px]">summarize</span></div></div>
        </section>

        <section class="bg-card-light dark:bg-card-dark glass-panel border border-border-light dark:border-border-dark rounded-3xl shadow-sm overflow-hidden">
          <div class="p-5 border-b border-border-light dark:border-border-dark flex items-center justify-between gap-3 flex-wrap"><div><h3 class="font-black text-lg text-primary dark:text-white">قائمة الطلبات</h3><p class="text-xs text-gray-500 dark:text-gray-400 mt-1">تظهر البطاقات على الهاتف، والجدول على الشاشات الأكبر.</p></div></div>
          <div class="p-4 space-y-3 md:hidden">
            <% if (requests.length) { requests.forEach(r => { %>
              <article class="rounded-2xl bg-white/70 dark:bg-white/5 border border-black/5 dark:border-white/10 p-4 space-y-3"><div class="flex items-start justify-between gap-3"><div><p class="font-black text-primary dark:text-white text-lg"><%= r.name %></p><p class="text-xs text-gray-500 mt-1">الرقم المرجعي: <span class="font-black text-primary dark:text-accent"><%= r.reference_code || '-' %></span></p><p class="text-xs text-gray-500 mt-1">رقم الطلب الداخلي: <%= r.id %></p></div><span class="px-3 py-1 rounded-full text-xs font-black bg-primary/10 dark:bg-accent/10 text-primary dark:text-accent"><%= r.status %></span></div><div class="grid grid-cols-1 gap-2 text-sm text-gray-600 dark:text-gray-300"><p><b>الجوال:</b> <%= r.mobile_phone || '-' %></p><p><b>العمل:</b> <%= r.job || '-' %></p><p><b>تاريخ الإرسال:</b> <%= r.created_at || '-' %></p><% if (r.created_person_name) { %><p><b>الفرد المنشأ:</b> <%= r.created_person_name %></p><% } %></div><div class="flex flex-col sm:flex-row gap-2"><a href="/admin/person-requests/<%= r.id %>" class="flex-1 flex items-center justify-center px-4 py-3 rounded-xl bg-primary dark:bg-accent text-white dark:text-black font-black">مراجعة الطلب</a><form method="post" action="/admin/person-requests/<%= r.id %>/delete" class="flex-1"><button class="w-full flex items-center justify-center px-4 py-3 rounded-xl bg-red-600 text-white font-black" type="submit" onclick="return confirm('هل أنت متأكد من حذف هذا الطلب؟ سيتم حذف سجل الطلب فقط ولن يتم حذف الفرد من الشجرة إذا كان الطلب معتمدًا.')">حذف</button></form></div></article>
            <% }) } else { %><div class="p-8 text-center text-gray-500 font-bold">لا توجد طلبات في هذا القسم.</div><% } %>
          </div>
          <div class="hidden md:block overflow-x-auto"><table class="w-full min-w-[1050px] text-right text-sm border-separate border-spacing-y-2 p-2"><thead><tr><th class="py-3 px-5 text-[11px] font-black text-gray-400 uppercase tracking-widest">#</th><th class="py-3 px-5 text-[11px] font-black text-gray-400 uppercase tracking-widest">الرقم المرجعي</th><th class="py-3 px-5 text-[11px] font-black text-gray-400 uppercase tracking-widest">الاسم</th><th class="py-3 px-5 text-[11px] font-black text-gray-400 uppercase tracking-widest">الجوال</th><th class="py-3 px-5 text-[11px] font-black text-gray-400 uppercase tracking-widest">العمل</th><th class="py-3 px-5 text-[11px] font-black text-gray-400 uppercase tracking-widest">تاريخ الإرسال</th><th class="py-3 px-5 text-[11px] font-black text-gray-400 uppercase tracking-widest">الحالة</th><th class="py-3 px-5 text-[11px] font-black text-gray-400 uppercase tracking-widest">الإجراءات</th></tr></thead><tbody><% if (requests.length) { requests.forEach(r => { %><tr class="bg-white/60 dark:bg-white/5"><td class="p-4 rounded-r-2xl font-black"><%= r.id %></td><td class="p-4"><span class="inline-flex px-3 py-1 rounded-xl bg-primary/10 dark:bg-accent/10 text-primary dark:text-accent font-black"><%= r.reference_code || '-' %></span></td><td class="p-4 font-black text-primary dark:text-white"><%= r.name %></td><td class="p-4"><%= r.mobile_phone || '-' %></td><td class="p-4"><%= r.job || '-' %></td><td class="p-4"><%= r.created_at || '-' %></td><td class="p-4"><span class="px-3 py-1 rounded-full bg-primary/10 dark:bg-accent/10 text-primary dark:text-accent font-black text-xs"><%= r.status %></span></td><td class="p-4 rounded-l-2xl"><div class="flex items-center gap-2"><a href="/admin/person-requests/<%= r.id %>" class="inline-flex px-4 py-2 rounded-xl bg-primary dark:bg-accent text-white dark:text-black font-black">مراجعة</a><form method="post" action="/admin/person-requests/<%= r.id %>/delete" class="inline-flex"><button class="inline-flex px-4 py-2 rounded-xl bg-red-600 text-white font-black" type="submit" onclick="return confirm('هل أنت متأكد من حذف هذا الطلب؟ سيتم حذف سجل الطلب فقط ولن يتم حذف الفرد من الشجرة إذا كان الطلب معتمدًا.')">حذف</button></form></div></td></tr><% }) } else { %><tr><td colspan="8" class="p-10 text-center text-gray-500 font-bold">لا توجد طلبات مطابقة.</td></tr><% } %></tbody></table></div>
        </section>
      </div>
    </div>
  </main>
  <script>(function(){const btn=document.getElementById('themeBtn');function setTheme(n){document.documentElement.classList.toggle('dark',n==='dark');document.documentElement.setAttribute('data-theme',n);localStorage.setItem('theme',n);if(window.initNexus)window.initNexus()}btn?.addEventListener('click',()=>{const cur=document.documentElement.classList.contains('dark')?'dark':'light';setTheme(cur==='dark'?'light':'dark')});})();(function(){const c=document.getElementById('nexusCanvas');if(!c)return;const x=c.getContext('2d');let w,h,p=[];const n=innerWidth>1024?120:65;let dc,lc;window.initNexus=function(){const d=document.documentElement.classList.contains('dark');dc=d?'rgba(229,184,105,.38)':'rgba(0,90,43,.25)';lc=d?'rgba(229,184,105,.09)':'rgba(0,90,43,.08)'};function r(){w=c.width=innerWidth;h=c.height=innerHeight}function init(){p=[];for(let i=0;i<n;i++)p.push({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.45,vy:(Math.random()-.5)*.45,rr:Math.random()*1.8+1})}function a(){x.clearRect(0,0,w,h);p.forEach((q,i)=>{q.x+=q.vx;q.y+=q.vy;if(q.x<0||q.x>w)q.vx*=-1;if(q.y<0||q.y>h)q.vy*=-1;x.beginPath();x.arc(q.x,q.y,q.rr,0,Math.PI*2);x.fillStyle=dc;x.fill();for(let j=i+1;j<p.length;j++){const e=p[j],d=Math.hypot(q.x-e.x,q.y-e.y);if(d<120){x.beginPath();x.moveTo(q.x,q.y);x.lineTo(e.x,e.y);x.strokeStyle=lc;x.stroke()}}});requestAnimationFrame(a)}window.initNexus();r();init();a();addEventListener('resize',()=>{r();init()})})();</script>
</body>
</html>
