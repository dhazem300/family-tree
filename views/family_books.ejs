<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>دفتر العائلة الرقمي</title><script src="/theme.js"></script><script src="https://cdn.tailwindcss.com?plugins=forms"></script><link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&family=Aref+Ruqaa:wght@700&display=swap" rel="stylesheet"><script>tailwind.config={darkMode:'class',theme:{extend:{colors:{primary:'#005A2B',accent:'#E5B869'},fontFamily:{sans:['Tajawal','sans-serif'],display:["'Aref Ruqaa'",'serif']}}}}</script></head><body class="bg-gray-50 dark:bg-[#050505] text-gray-900 dark:text-white font-sans min-h-screen"><%- include('partials/header', {active, siteUser, pageTitle:'دفتر العائلة الرقمي', pageSubtitle:'فروع العائلة الرئيسية'}) %><main class="max-w-6xl mx-auto p-5 grid sm:grid-cols-2 lg:grid-cols-3 gap-5"><% roots.forEach(r => { %><a href="/family-books/<%= r.id %>" class="bg-white dark:bg-white/5 rounded-[2rem] p-6 border border-gray-200 dark:border-white/10 shadow-sm hover:shadow-lg transition"><div class="font-black text-2xl text-primary dark:text-accent"><%= r.name %></div><p class="mt-3 text-sm text-gray-500">عدد الأبناء المباشرين: <%= r.children_count || 0 %></p></a><% }) %></main><script src="/chat-notifications.js"></script></body></html>
