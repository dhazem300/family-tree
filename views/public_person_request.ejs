      <!-- قسم التتبع الموحد -->
      <section id="track-request" class="mt-16 section-card rounded-[24px] p-6 sm:p-10 lg:p-12 scroll-mt-32">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-8">
          <div>
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent/10 border border-accent/20 text-primary dark:text-accent font-bold text-[12px] mb-4 shadow-sm">
              <span class="material-symbols-outlined text-[16px]">manage_search</span> تتبع الطلب
            </span>
            <h3 class="font-display font-bold text-2xl md:text-3xl text-primary dark:text-white">تابع حالة طلبك</h3>
            <p class="text-gray-600 dark:text-gray-400 mt-2 font-sans text-[14px] md:text-[15px] font-medium leading-relaxed max-w-xl">اكتب الرقم المرجعي الذي ظهر لك بعد الإرسال لمعرفة حالة المراجعة.</p>
          </div>
          
          <form method="get" action="/track-person-request" class="w-full lg:w-auto flex flex-col sm:flex-row gap-3">
            <input name="reference" class="field text-center sm:text-right tracking-[0.1em] sm:w-[280px]" value="<%= trackReference || '' %>" placeholder="مثال: FAM-2026-ABC123" required>
            <button type="submit" class="shrink-0 px-8 py-3 rounded-xl bg-primary hover:bg-primaryDark text-white dark:bg-white dark:text-[#050505] dark:hover:bg-accent font-sans font-bold text-[14px] shadow-sm transition-all hover:-translate-y-0.5 flex items-center justify-center gap-2">
              <span class="material-symbols-outlined text-[18px]">search</span> بحث
            </button>
          </form>
        </div>

        <% if (trackingSearched) { %>
          <% if (!trackingResult) { %>
            <div class="mt-8 rounded-[16px] bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 p-5 text-red-800 dark:text-red-300 font-sans font-bold text-center flex items-center justify-center gap-2 text-[14px] shadow-sm">
              <span class="material-symbols-outlined text-[20px]">error</span>
              لم يتم العثور على طلب بهذا الرقم المرجعي. تأكد من كتابة الرمز بشكل صحيح.
            </div>
          <% } else if (trackingResult.status === 'pending') { %>
            <div class="mt-8 rounded-[20px] bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 p-6 sm:p-8 text-amber-800 dark:text-amber-200 shadow-sm">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 shrink-0 rounded-full bg-amber-100 dark:bg-amber-900/40 text-amber-600 dark:text-amber-400 flex items-center justify-center border border-amber-200 dark:border-amber-500/30">
                  <span class="material-symbols-outlined text-[24px]">hourglass_top</span>
                </div>
                <div>
                  <p class="font-display font-bold text-2xl mb-1">حالة الطلب: قيد المراجعة</p>
                  <p class="text-[15px] font-sans font-medium opacity-90 leading-relaxed">طلب <strong class="text-amber-900 dark:text-amber-100"><%= trackingResult.name %></strong> وصل للإدارة وجاري مراجعته.</p>
                  <p class="text-[13px] font-sans font-bold mt-4 opacity-80 border-t border-amber-200/50 dark:border-amber-500/20 pt-4 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[16px]">tag</span> الرقم المرجعي: <span class="font-mono tracking-widest bg-white/50 dark:bg-black/20 px-2 py-0.5 rounded border border-amber-200/30 dark:border-amber-500/20"><%= trackingResult.reference_code %></span>
                  </p>
                </div>
              </div>
            </div>
          <% } else if (trackingResult.status === 'rejected') { %>
            <div class="mt-8 rounded-[20px] bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 p-6 sm:p-8 text-red-800 dark:text-red-200 shadow-sm">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 shrink-0 rounded-full bg-red-100 dark:bg-red-900/40 text-red-600 dark:text-red-400 flex items-center justify-center border border-red-200 dark:border-red-500/30">
                  <span class="material-symbols-outlined text-[24px]">cancel</span>
                </div>
                <div class="flex-grow">
                  <p class="font-display font-bold text-2xl mb-1">حالة الطلب: تم الرفض</p>
                  <p class="text-[15px] font-sans font-medium opacity-90">طلب <strong class="text-red-900 dark:text-red-100"><%= trackingResult.name %></strong> تم رفضه.</p>
                  <div class="mt-5 p-5 rounded-xl bg-white/50 dark:bg-black/20 border border-red-200/50 dark:border-red-500/20">
                     <p class="font-bold font-sans text-[13px] mb-2 flex items-center gap-1.5"><span class="material-symbols-outlined text-[16px]">info</span> سبب الرفض:</p>
                     <p class="text-[14px] font-medium leading-relaxed"><%= trackingResult.admin_note || 'لم يتم ذكر سبب محدد.' %></p>
                  </div>
                </div>
              </div>
            </div>
          <% } else if (trackingResult.status === 'approved') { %>
            <div class="mt-8 rounded-[20px] bg-[#E8F5ED] dark:bg-[#003D1D]/30 border border-primary/20 dark:border-primary/40 p-6 sm:p-8 text-gray-900 dark:text-white shadow-sm">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 shrink-0 rounded-full bg-primary/10 dark:bg-emerald-500/10 text-primary dark:text-emerald-400 flex items-center justify-center border border-primary/20 dark:border-emerald-500/20">
                    <span class="material-symbols-outlined text-[24px]">verified</span>
                  </div>
                  <div>
                    <p class="font-display font-bold text-2xl text-primary dark:text-emerald-400 mb-1">حالة الطلب: تمت الموافقة</p>
                    <p class="text-[15px] font-sans font-medium opacity-90 leading-relaxed text-gray-700 dark:text-gray-300">تمت إضافة <strong class="text-gray-900 dark:text-white"><%= trackingResult.created_person_name || trackingResult.name %></strong> إلى الشجرة التفاعلية.</p>
                    <% if (trackingResult.reviewed_at) { %>
                      <p class="text-[13px] font-sans font-bold mt-4 opacity-70 border-t border-primary/10 dark:border-white/10 pt-4 text-gray-600 dark:text-gray-400">تاريخ المراجعة: <%= trackingResult.reviewed_at %></p>
                    <% } %>
                  </div>
                </div>
                <% if (trackingResult.created_person_id) { %>
                  <a href="/?focus=<%= trackingResult.created_person_id %>" class="w-full md:w-auto px-8 py-3.5 rounded-xl bg-primary hover:bg-primaryDark text-white dark:bg-white dark:text-[#050505] dark:hover:bg-accent font-sans font-bold text-[14px] text-center whitespace-nowrap flex items-center justify-center gap-2 shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all">
                    <span class="material-symbols-outlined text-[18px]">account_tree</span> موقعي في الشجرة
                  </a>
                <% } %>
              </div>
            </div>
          <% } %>
        <% } %>
      </section>
      
    </section>
  </main>

  <footer class="bg-background-light dark:bg-[#050505] border-t border-gray-200 dark:border-white/5 mt-auto py-8 relative z-10">
    <div class="max-w-[90rem] mx-auto px-6 text-center">
      <p class="text-[11px] font-sans font-bold text-gray-500 uppercase tracking-[0.1em]">© ٢٠٢٦ وقف عائلة خاشقجي. جميع الحقوق محفوظة.</p>
    </div>
  </footer>

  <script>
    (function(){const btn=document.getElementById('themeBtn');function setTheme(next){document.documentElement.classList.toggle('dark',next==='dark');document.documentElement.setAttribute('data-theme',next);localStorage.setItem('theme',next)}btn?.addEventListener('click',()=>{const cur=document.documentElement.classList.contains('dark')?'dark':'light';setTheme(cur==='dark'?'light':'dark')});})();
    
    (function mobileNavInit(){
      const btn = document.getElementById("mobileNavBtn");
      const navDrawer = document.getElementById("mobileNavDrawer");
      const overlay = document.getElementById("mobileNavOverlay");
      const closeBtn = document.getElementById("mobileNavClose");

      function setOpenState(isOpen){
        btn?.setAttribute("data-open", isOpen ? "true" : "false");
        btn?.setAttribute("aria-expanded", isOpen ? "true" : "false");
      }

      function openNav(){
        overlay?.classList.remove("hidden");
        overlay?.style.setProperty('display', 'block', 'important');
        navDrawer?.classList.add("isOpen");
        setOpenState(true);
        document.body.classList.add('overflow-hidden');
      }
      function closeNav(){
        navDrawer?.classList.remove("isOpen");
        overlay?.classList.add("hidden");
        overlay?.style.setProperty('display', 'none', 'important');
        setOpenState(false);
        document.body.classList.remove('overflow-hidden');
      }

      btn?.addEventListener("click", () => {
        const open = btn.getAttribute("data-open") === "true";
        open ? closeNav() : openNav();
      });

      closeBtn?.addEventListener("click", closeNav);
      overlay?.addEventListener("click", closeNav);
      navDrawer?.querySelectorAll("a").forEach(a => a.addEventListener("click", closeNav));
      window.addEventListener("keydown", (e) => { if (e.key === "Escape") closeNav(); });

      setOpenState(false);
    })();

    (function referenceCopyInit(){
      const btn = document.getElementById('copyReferenceBtn');
      const input = document.getElementById('referenceCodeInput');
      const msg = document.getElementById('copyReferenceMsg');
      if (!btn || !input) return;

      function showMessage(text, isError = false) {
        if (!msg) return;
        msg.textContent = text;
        msg.classList.remove('hidden', 'text-green-600', 'dark:text-green-400', 'text-red-600', 'dark:text-red-400');
        msg.classList.add(isError ? 'text-red-600' : 'text-green-600');
        msg.classList.add(isError ? 'dark:text-red-400' : 'dark:text-green-400');
        clearTimeout(msg.__copyTimer);
        msg.__copyTimer = setTimeout(() => msg.classList.add('hidden'), 2500);
      }

      async function copyText(text) {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          return true;
        }

        input.removeAttribute('readonly');
        input.focus();
        input.select();
        input.setSelectionRange(0, text.length);
        const ok = document.execCommand('copy');
        input.setAttribute('readonly', 'readonly');
        window.getSelection?.().removeAllRanges?.();
        return ok;
      }

      btn.addEventListener('click', async function () {
        const code = (input.value || '').trim();
        if (!code) return showMessage('لا يوجد رقم مرجعي لنسخه.', true);

        try {
          const copied = await copyText(code);
          if (copied) {
            btn.classList.add('opacity-90');
            showMessage('تم نسخ الرقم المرجعي بنجاح.');
            setTimeout(() => btn.classList.remove('opacity-90'), 500);
          } else {
            showMessage('لم يتم النسخ تلقائيًا، برجاء تحديد الرقم ونسخه يدويًا.', true);
          }
        } catch (error) {
          console.error('copy reference error:', error);
          showMessage('لم يتم النسخ تلقائيًا، برجاء تحديد الرقم ونسخه يدويًا.', true);
        }
      });
    })();

    (function lineageResolverInit(){
      const inputs=document.querySelectorAll('[data-lineage-resolver]');
      if(!inputs.length)return;
      const timers=new Map();
      function setFeedback(type,msg,state){
        const el=document.querySelector(`[data-lineage-feedback="${type}"]`); if(!el)return;
        el.textContent=msg;
        el.className='lineage-feedback block mt-2 text-[11px] font-sans font-semibold leading-relaxed '+(state==='ok'?'text-green-600 dark:text-green-400':state==='warn'?'text-amber-600 dark:text-amber-400':state==='bad'?'text-red-600 dark:text-red-400':'text-gray-500 dark:text-gray-400');
      }
      inputs.forEach(input=>input.addEventListener('input',()=>{
        const type=input.getAttribute('data-lineage-resolver');
        clearTimeout(timers.get(input));
        const q=input.value.trim();
        if(!q)return setFeedback(type,type==='father'?'اكتب الاسم الثلاثي للأب حتى يتم ربط بياناتك بموقعه في الشجرة تلقائيًا.':'اختياري: إذا كانت الأم موجودة في الشجرة سيتم ربطها تلقائيًا، وإذا لم تكن موجودة سيظل الطلب قابلًا للمراجعة.','normal');
        timers.set(input,setTimeout(async()=>{
          try{
            const res=await fetch('/api/person-lineage/resolve?q='+encodeURIComponent(q));
            const data=await res.json(); const result=data.result||{};
            if(result.status==='matched')setFeedback(type,'تم العثور على: '+(result.match?.name||q)+' وسيتم الربط تلقائيًا.','ok');
            else if(result.status==='multiple')setFeedback(type,'يوجد أكثر من شخص بنفس التسلسل. الإدارة ستراجع الطلب قبل الاعتماد.','warn');
            else setFeedback(type,result.message||'لم يتم العثور على هذا التسلسل داخل الشجرة.',type==='father'?'bad':'warn');
          }catch(e){setFeedback(type,'تعذر التحقق الآن، سيتم التحقق عند إرسال الطلب.','warn')}
        },350));
      }));
    })();
  </script>
  
  <script src="/address-fields.js"></script>
  <script src="/dual-calendar.js"></script>
  <script src="/site-assistant.js"></script>
</body>
</html>