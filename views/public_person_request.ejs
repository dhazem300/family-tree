              <span class="font-sans font-bold text-gray-600 dark:text-gray-400 mb-2 block text-[13px]">مكان الوفاة</span>
              <input name="death_place" class="field !bg-white/50 dark:!bg-black/20" placeholder="مكان الوفاة إن وجد">
