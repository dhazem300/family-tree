<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>إرسال بيانات فرد للمراجعة - شجرة العائلة</title>
  
  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/styles.css" />
  <link rel="stylesheet" href="/address-fields.css" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@300;400;500;700;900&family=Amiri:wght@400;700&family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries,line-clamp"></script>
  
  <!-- توحيد إعدادات Tailwind لتتطابق مع المرجع -->
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#005A2B",      /* اللون الأخضر الملكي الفاخر */
            primaryDark: "#003D1D",  /* أخضر داكن للتحويم */
            accent: "#E5B869",       /* ذهب سائل */
            "accent-gold": "#E5B869", /* إبقاء الاسم المتغير لعدم كسر أي كود */
            "background-light": "#F8F8F6",
            "background-dark": "#050505",
            "card-light": "#FFFFFF",
            "card-dark": "#0A0A0A",
            "bg-charcoal": "#050505",
            "bg-card": "#0A0A0A",
            "text-cream": "#FAFAFA",
            "muted-slate": "#71717A",
            gold: "#E5B869",
          },
          fontFamily: {
            display: ["'Aref Ruqaa'", "serif"],
            sans: ["Tajawal", "sans-serif"],
            amiri: ["Amiri", "serif"],
            cairo: ["Cairo", "sans-serif"]
          },
          backgroundImage: {
            "islamic-pattern": "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E5B869' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")",
            "islamic-pattern-dark": "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E5B869' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")"
          },
          boxShadow: {
            'luxury': '0 20px 40px -10px rgba(0,0,0,0.05), 0 0 20px rgba(229,184,105,0.03)',
            'luxury-dark': '0 20px 40px -10px rgba(0,0,0,0.4), 0 0 20px rgba(229,184,105,0.05)',
          }
        }
      }
    };
  </script>

  <!-- توحيد الستايلات المخصصة -->
  <style type="text/tailwindcss">
    @layer utilities {
      .scrollbar-hide::-webkit-scrollbar { display: none; }
      .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
      .glass-panel {
        @apply bg-white/85 dark:bg-[#080808]/85 backdrop-blur-xl border border-accent-gold/20 shadow-luxury dark:shadow-luxury-dark;
      }
    }
  </style>

  <style>
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(229, 184, 105, 0.4); border-radius: 4px; transition: background 0.3s; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(229, 184, 105, 0.8); }

    html.dark .dark-toggle-icon-moon { display: none; } 
    html:not(.dark) .dark-toggle-icon-sun { display: none; }
    
    #mobileNavOverlay.hidden { display: none; }
    #mobileNavOverlay { display: block; }
    #mobileNavDrawer { transform: translateX(-110%); transition: transform .3s cubic-bezier(.2,.9,.2,1); }
    #mobileNavDrawer.isOpen { transform: translateX(0); }
    #mobileNavBtn[data-open="true"] .ico-open { display: none; }
    #mobileNavBtn[data-open="true"] .ico-close { display: inline; }
    #mobileNavBtn[data-open="false"] .ico-open { display: inline; }
    #mobileNavBtn[data-open="false"] .ico-close { display: none; }

    /* توحيد حقول الإدخال لتلائم الهوية الفاخرة */
    .field {
      width: 100%; border-radius: 12px; border: 1px solid rgba(229, 184, 105, 0.2); background: rgba(255, 255, 255, 0.5); 
      padding: 12px 16px; font-weight: 500; font-family: "Tajawal", sans-serif; outline: none; color: #111827; transition: all 0.3s ease;
      box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
    }
    .field::placeholder { color: #9CA3AF; }
    .field:focus { background: #FFFFFF; border-color: #E5B869; box-shadow: 0 0 0 2px rgba(229, 184, 105, 0.1); }
    
    html.dark .field { background: rgba(10, 10, 10, 0.5); border-color: rgba(255, 255, 255, 0.05); color: #FAFAFA; box-shadow: inset 0 2px 4px rgba(0,0,0,0.2); }
    html.dark .field::placeholder { color: #6B7280; }
    html.dark .field:focus { background: #0A0A0A; border-color: #E5B869; box-shadow: 0 0 0 2px rgba(229, 184, 105, 0.15); }

    /* توحيد كروت الأقسام (Glassmorphism) */
    .section-card {
      background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(229, 184, 105, 0.2); box-shadow: 0 20px 40px -10px rgba(0,0,0,0.05), 0 0 20px rgba(229,184,105,0.03);
    }
    html.dark .section-card {
      background: rgba(10, 10, 10, 0.85); border-color: rgba(255, 255, 255, 0.05);
      box-shadow: 0 20px 40px -10px rgba(0,0,0,0.4), 0 0 20px rgba(229,184,105,0.05);
    }

    /* Scroll fix: الصفحة العامة طويلة */
    html, body {
      height: auto !important; min-height: 100% !important; overflow-x: hidden !important; 
      overflow-y: auto !important; overscroll-behavior-y: auto !important; 
      touch-action: auto !important; -webkit-overflow-scrolling: touch;
    }
    body { position: relative !important; }
    main { min-height: auto !important; height: auto !important; overflow: visible !important; }
  </style>

  <script>
    (function(){const saved=localStorage.getItem('theme')||'dark';document.documentElement.classList.toggle('dark',saved==='dark');document.documentElement.setAttribute('data-theme',saved);})();
  </script>
</head>

<body class="bg-background-light dark:bg-bg-charcoal text-gray-900 dark:text-text-cream font-sans min-h-screen flex flex-col relative overflow-x-hidden selection:bg-accent/30 selection:text-gray-900 dark:selection:text-white transition-colors duration-400">
  
  <div id="mobileNavOverlay" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-[80] hidden" aria-hidden="true"></div>
  <aside id="mobileNavDrawer" class="fixed top-0 left-0 h-full w-[320px] max-w-[85vw] bg-white dark:bg-bg-charcoal border-r border-gray-100 dark:border-white/5 shadow-2xl z-[90] flex flex-col">
    <div class="h-1.5 w-full bg-gradient-to-r from-gray-300 via-accent to-gray-300 dark:from-gray-800 dark:via-accent dark:to-gray-800"></div>
    <div class="flex items-center justify-between p-6 border-b border-gray-100 dark:border-white/5">
      <img class="h-10 w-auto hidden dark:block drop-shadow-[0_0_2px_rgba(255,255,255,0.5)] brightness-110" src="/assets/logo-dark.svg" alt="شعار العائلة" />
      <img class="h-10 w-auto block dark:hidden" src="/assets/logo-light.svg" alt="شعار العائلة" />
      <button id="mobileNavClose" class="text-gray-400 hover:text-accent transition-colors" type="button" aria-label="إغلاق القائمة">
        <span class="material-symbols-outlined text-[26px]">close</span>
      </button>
    </div>
    <nav class="p-6 flex flex-col gap-2 text-base font-semibold flex-grow text-gray-600 dark:text-gray-400 overflow-y-auto" aria-label="قائمة الجوال">
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/">الشجرة</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/about">نبذة عن العائلة</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/honor">السير الذاتية</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/news">أخبار العائلة</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/tree-pdf">المشجرة</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/kinship">صلة القرابة</a>
      
      <div class="my-3 h-px bg-gray-100 dark:bg-white/5"></div>
      
      <a class="px-4 py-3 rounded-xl text-primary dark:text-accent bg-primary/5 dark:bg-accent/10 border-r-2 border-primary dark:border-accent" href="/submit-person">إضافة بياناتك</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/family-members">أعضاء العائلة</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/family-books">كتب العائلة</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/family-gallery">معرض العائلة</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/family-events">مناسبات العائلة</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/chat">الشات العام</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/notifications">الإشعارات</a>
      <%- include('partials/user_profile_chip', { siteUser }) %>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors" href="/support">الدعم</a>
    </nav>
    <div class="p-6 border-t border-gray-100 dark:border-white/5 bg-white/50 dark:bg-black/20">
      <div class="grid grid-cols-1 gap-3">
        <a href="/admin/login" class="flex items-center justify-center gap-2 py-3 bg-primary text-white dark:bg-white dark:text-primary rounded-xl hover:opacity-90 transition-all shadow-sm font-bold text-sm" title="لوحة الإدارة">
          <span class="material-symbols-outlined text-[20px]">admin_panel_settings</span>
          <span>لوحة الإدارة</span>
        </a>
      </div>
    </div>
  </aside>

  <header class="sticky top-0 z-50 w-full glass-panel border-b-0 transition-colors duration-400">
    <div class="max-w-[90rem] mx-auto px-5 sm:px-8 py-3 flex justify-between items-center h-20 md:h-24">
      <div class="flex items-center gap-3 xl:gap-4 shrink-0">
        <a href="/" class="block shrink-0 transition-transform hover:scale-105 duration-300">
          <img class="h-10 md:h-12 w-auto hidden dark:block drop-shadow-[0_0_2px_rgba(255,255,255,0.5)] brightness-110" src="/assets/logo-dark.svg" alt="شعار العائلة" />
          <img class="h-10 md:h-12 w-auto block dark:hidden" src="/assets/logo-light.svg" alt="شعار العائلة" />
        </a>
        <div class="h-7 w-px bg-gray-200 dark:bg-white/10 hidden sm:block"></div>
        <div class="hidden sm:flex flex-col justify-center min-w-0">
           <h1 class="text-lg md:text-xl font-display text-primary dark:text-accent font-bold leading-tight pt-1">شجرة العائلة</h1>
           <span class="text-[10px] font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-widest mt-0.5 truncate">حفظ الأنساب</span>
        </div>
      </div>

      <nav class="hidden lg:flex flex-1 justify-center gap-2 lg:gap-3 xl:gap-5 items-center font-sans font-semibold text-[11px] xl:text-[13px] tracking-wide text-gray-500 dark:text-gray-400 overflow-x-auto scrollbar-hide px-2 xl:px-4 flex-nowrap" aria-label="التنقل الرئيسي">
        <a class="whitespace-nowrap shrink-0 hover:text-primary dark:hover:text-accent transition-colors duration-200" href="/">الشجرة</a>
        <a class="whitespace-nowrap shrink-0 hover:text-primary dark:hover:text-accent transition-colors duration-200" href="/about">نبذة عن العائلة</a>
        <a class="whitespace-nowrap shrink-0 hover:text-primary dark:hover:text-accent transition-colors duration-200" href="/honor">السير الذاتية</a>
        <a class="whitespace-nowrap shrink-0 hover:text-primary dark:hover:text-accent transition-colors duration-200" href="/news">أخبار العائلة</a>
        <a class="whitespace-nowrap shrink-0 hover:text-primary dark:hover:text-accent transition-colors duration-200" href="/tree-pdf">المشجرة</a>
        <a class="whitespace-nowrap shrink-0 hover:text-primary dark:hover:text-accent transition-colors duration-200" href="/kinship">صلة القرابة</a>
        
        <a class="whitespace-nowrap shrink-0 text-primary dark:text-accent border-b-[1.5px] border-primary dark:border-accent pb-1 transition-colors duration-200" href="/submit-person">إضافة بياناتك</a>
        
        <a class="whitespace-nowrap shrink-0 hover:text-primary dark:hover:text-accent transition-colors duration-200" href="/family-members">أعضاء العائلة</a>
        <a class="whitespace-nowrap shrink-0 hover:text-primary dark:hover:text-accent transition-colors duration-200" href="/chat">الشات العام</a>
        <%- include('partials/user_profile_chip', { siteUser }) %>
      </nav>

      <div class="flex items-center justify-end gap-2 shrink-0">
        <button id="themeBtn" aria-label="تبديل المظهر" class="flex items-center justify-center w-10 h-10 rounded-full border border-transparent text-gray-400 dark:text-gray-500 hover:text-accent dark:hover:text-accent hover:bg-accent/5 transition-all duration-300" type="button" title="تبديل المظهر">
          <span class="material-symbols-outlined text-[22px] dark:hidden">dark_mode</span>
          <span class="material-symbols-outlined text-[22px] hidden dark:inline">light_mode</span>
        </button>
        <a href="/admin/login" class="hidden sm:flex w-10 h-10 rounded-full border border-transparent text-gray-400 dark:text-gray-500 hover:text-primary dark:hover:text-accent hover:bg-primary/5 dark:hover:bg-accent/5 transition-all duration-300 items-center justify-center" title="لوحة الإدارة">
          <span class="material-symbols-outlined text-[22px]">admin_panel_settings</span>
        </a>
        <button id="mobileNavBtn" data-open="false" class="lg:hidden flex items-center justify-center w-10 h-10 rounded-full border border-gray-200 dark:border-white/10 text-primary dark:text-accent hover:bg-gray-50 dark:hover:bg-white/5 transition-all duration-200" type="button" aria-label="فتح القائمة">
          <span class="material-symbols-outlined text-[24px] ico-open">menu</span>
          <span class="material-symbols-outlined text-[24px] ico-close hidden">close</span>
        </button>
      </div>
    </div>
  </header>

  <main class="flex-grow relative overflow-visible">
    
    <section class="pt-16 pb-12 px-6 max-w-[90rem] mx-auto text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-islamic-pattern opacity-40 dark:opacity-10 pointer-events-none"></div>
      
      <img src="/assets/logo-dark.svg" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] md:w-[600px] opacity-[0.02] pointer-events-none hidden dark:block" alt="">
      <img src="/assets/logo-light.svg" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] md:w-[600px] opacity-[0.02] pointer-events-none block dark:hidden" alt="">

      <div class="w-px h-10 bg-gradient-to-b from-transparent via-accent to-transparent mx-auto mb-5 relative z-10"></div>
      
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent/5 border border-accent/20 text-primary dark:text-accent font-sans font-bold text-[12px] mb-4 relative z-10 shadow-sm">
        <span class="material-symbols-outlined text-[16px]">edit_document</span> إرسال بيانات للمراجعة
      </span>

      <h1 class="text-4xl md:text-6xl font-display leading-tight mb-4 relative z-10 font-bold">
        <span class="text-primary dark:text-white transition-colors duration-300">إضافة بيانات فرد</span> <span class="text-accent">للعائلة</span>
      </h1>
      
      <p class="text-[14px] md:text-base font-sans text-gray-500 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed relative z-10 font-medium">
        املأ البيانات التالية، وسيتم إرسالها إلى إدارة الموقع للمراجعة. لن تظهر البيانات في الشجرة إلا بعد موافقة الإدارة.
      </p>
    </section>

    <section class="relative z-10 max-w-[64rem] mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      
      <% if (submitted) { %>
        <div class="mb-8 rounded-2xl bg-green-50/80 dark:bg-green-500/10 border border-green-200 dark:border-green-500/20 p-8 text-green-800 dark:text-green-200 font-sans font-bold text-center shadow-sm">
          <div class="flex flex-col items-center gap-4">
            <span class="material-symbols-outlined text-[48px] text-green-600 dark:text-green-400">verified</span>
            <div>
              <p class="text-2xl font-display text-primary dark:text-emerald-400">تم استلام طلبك بنجاح</p>
              <p class="text-[15px] mt-2 text-gray-600 dark:text-gray-300 font-medium leading-relaxed">سيتم مراجعة البيانات من الإدارة قبل الظهور في الشجرة.</p>
            </div>
            <% if (referenceCode) { %>
              <div class="w-full max-w-xl mt-6 rounded-[16px] bg-white dark:bg-[#050505] border border-gray-200 dark:border-white/10 p-6 shadow-sm">
                <p class="text-[13px] font-sans font-bold text-gray-500 dark:text-gray-400 mb-3">رقم الطلب المرجعي</p>
                <input id="referenceCodeInput" class="w-full text-center tracking-[0.2em] font-sans font-bold text-xl bg-gray-50 dark:bg-[#111] border border-gray-200 dark:border-white/10 rounded-xl py-3 focus:outline-none focus:border-accent dark:focus:border-accent text-gray-900 dark:text-white" value="<%= referenceCode %>" readonly>
                <button id="copyReferenceBtn" type="button" class="mt-5 w-full px-6 py-3.5 rounded-xl bg-primary hover:bg-primaryDark text-white dark:bg-white dark:text-[#050505] dark:hover:bg-accent font-sans font-bold flex items-center justify-center gap-2 transition-all shadow-sm">
                  <span class="material-symbols-outlined text-[18px]">content_copy</span>
                  نسخ الرقم المرجعي
                </button>
                <p id="copyReferenceMsg" class="hidden mt-3 text-[12px] font-sans font-bold text-green-600 dark:text-green-400">تم نسخ الرقم المرجعي بنجاح.</p>
              </div>
            <% } %>
          </div>
        </div>
      <% } %>
      
      <% if (error) { %>
        <div class="mb-8 rounded-2xl bg-red-50/80 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 p-6 text-red-800 dark:text-red-200 font-sans font-bold text-center flex items-center justify-center gap-3 shadow-sm text-[15px]">
          <span class="material-symbols-outlined text-red-600 dark:text-red-400 text-[24px]">error</span>
          <%= error %>
        </div>
      <% } %>

      <form method="post" action="/submit-person" enctype="multipart/form-data" class="section-card rounded-[24px] p-6 sm:p-10 lg:p-12 space-y-12">
        
        <section class="space-y-8">
          <div class="flex items-center gap-3 mb-8 border-b border-gray-100 dark:border-white/5 pb-4">
            <span class="material-symbols-outlined text-accent text-[32px]">person</span>
            <h3 class="font-display font-bold text-2xl md:text-3xl text-primary dark:text-white">البيانات الأساسية</h3>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
            <label class="block group">
              <span class="font-sans font-bold text-gray-700 dark:text-gray-300 mb-2.5 block text-[14px]">الاسم الكامل <span class="text-red-500">*</span></span>
              <input name="name" required class="field" placeholder="اكتب الاسم الكامل">
            </label>
            <label class="block group">
              <span class="font-sans font-bold text-gray-700 dark:text-gray-300 mb-2.5 block text-[14px]">النوع</span>
