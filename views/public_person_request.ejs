            <input type="checkbox" name="is_deceased" value="1" class="w-5 h-5 rounded border-gray-300 dark:border-gray-600 bg-white dark:bg-black text-primary focus:ring-accent transition-colors cursor-pointer"> 
            <span class="text-[15px]">الفرد متوفى</span>
