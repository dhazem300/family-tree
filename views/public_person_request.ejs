<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>إرسال بيانات فرد للمراجعة</title>
  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/styles.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@300;400;500;700;900&family=Amiri:wght@400;700&family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries,line-clamp"></script>
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: { extend: {
        colors: {
          primary: "#005A2B",
          primaryDark: "#003D1D",
          accent: "#E5B869",
          "accent-gold": "#E5B869",
          "background-light": "#F8F8F6",
          "bg-charcoal": "#050505",
          "text-cream": "#FAFAFA"
        },
        fontFamily: {
          display: ["'Aref Ruqaa'", "serif"],
          sans: ["Tajawal", "sans-serif"],
          amiri: ["Amiri", "serif"],
          cairo: ["Cairo", "sans-serif"]
        },
        backgroundImage: {
          "islamic-pattern": "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E5B869' fill-opacity='0.035'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")"
        }
      }}
    };
  </script>
  <style>
    html.dark .dark-toggle-icon-moon{display:none} html:not(.dark) .dark-toggle-icon-sun{display:none}
    .mobile-nav-hidden{display:none}.mobile-nav-open{display:block}
    #mobileNavDrawer{transform:translateX(-115%);transition:transform .35s cubic-bezier(.16,1,.3,1)}
    #mobileNavDrawer.isOpen{transform:translateX(0)}
    .field{width:100%;border-radius:18px;border:1px solid rgba(0,90,43,.14);background:rgba(255,255,255,.92);padding:13px 15px;font-weight:800;outline:none;color:#111827;transition:.2s}
    .field::placeholder{color:rgba(17,24,39,.45)}
    html.dark .field{background:rgba(255,255,255,.055);border-color:rgba(229,184,105,.18);color:#fff}
    html.dark .field::placeholder{color:rgba(255,255,255,.38)}
    .field:focus{border-color:#005A2B;box-shadow:0 0 0 4px rgba(0,90,43,.10)} html.dark .field:focus{border-color:#E5B869;box-shadow:0 0 0 4px rgba(229,184,105,.12)}
    .section-card{border:1px solid rgba(0,0,0,.07);background:rgba(255,255,255,.9);box-shadow:0 22px 65px rgba(0,0,0,.08);backdrop-filter:blur(16px)}
    html.dark .section-card{border-color:rgba(255,255,255,.10);background:rgba(10,10,10,.88);box-shadow:0 22px 70px rgba(0,0,0,.55)}

    /* Scroll fix: الصفحة العامة طويلة، لذلك لا يجب حبسها داخل main أو body */
    html,
    body{
      height:auto !important;
      min-height:100% !important;
      overflow-x:hidden !important;
      overflow-y:auto !important;
      overscroll-behavior-y:auto !important;
      touch-action:auto !important;
      -webkit-overflow-scrolling:touch;
    }
    body{
      position:relative !important;
    }
    main{
      min-height:auto !important;
      height:auto !important;
      overflow:visible !important;
    }
  </style>
  <script>
    (function(){const saved=localStorage.getItem('theme')||'dark';document.documentElement.classList.toggle('dark',saved==='dark');document.documentElement.setAttribute('data-theme',saved);})();
  </script>
</head>
<body class="bg-background-light dark:bg-bg-charcoal text-gray-900 dark:text-text-cream font-sans min-h-screen flex flex-col relative overflow-x-hidden selection:bg-accent-gold selection:text-bg-charcoal transition-colors duration-300">
  <div id="mobileNavOverlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[80] mobile-nav-hidden" aria-hidden="true"></div>
  <aside id="mobileNavDrawer" class="fixed top-0 left-0 h-full w-[320px] max-w-[85vw] bg-white dark:bg-bg-charcoal border-r border-gray-200 dark:border-white/10 shadow-2xl z-[90] flex flex-col">
    <div class="h-1.5 w-full bg-gradient-to-r from-gray-300 via-accent-gold to-gray-300 dark:from-gray-800 dark:via-accent-gold dark:to-gray-800"></div>
    <div class="flex items-center justify-between p-6 border-b border-gray-100 dark:border-white/5">
      <img class="h-10 w-auto hidden dark:block" src="/assets/logo-dark.svg" alt="شعار العائلة" />
      <img class="h-10 w-auto block dark:hidden" src="/assets/logo-light.svg" alt="شعار العائلة" />
      <button id="mobileNavClose" class="text-gray-500 hover:text-accent-gold transition-colors" type="button" aria-label="إغلاق القائمة"><span class="material-symbols-outlined text-[28px]">close</span></button>
    </div>
    <nav class="p-6 flex flex-col gap-3 font-bold text-base flex-grow text-gray-700 dark:text-gray-300" aria-label="قائمة الجوال">
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 transition-colors" href="/">الشجرة</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 transition-colors" href="/about">نبذة</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 transition-colors" href="/honor">قائمة السير الذاتية</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 transition-colors" href="/news">أخبار العائلة</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 transition-colors" href="/tree-pdf">مشجرة العائلة</a>
      <a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5 transition-colors" href="/support">الدعم</a>
      <a class="px-4 py-3 rounded-xl text-accent-gold bg-accent-gold/5 border-r-2 border-accent-gold" href="/submit-person">إضافة بياناتك</a>
    </nav>
    <div class="p-6 border-t border-gray-100 dark:border-white/5">
      <a href="/admin/login" class="flex items-center justify-center gap-2 py-3 bg-primary text-white dark:bg-white dark:text-primary rounded-xl hover:opacity-90 transition-colors font-bold"><span class="material-symbols-outlined">login</span><span>تسجيل الدخول</span></a>
    </div>
  </aside>

  <header class="sticky top-0 z-50 w-full bg-white/95 dark:bg-[#050505]/95 backdrop-blur-md border-b border-gray-200 dark:border-white/10">
    <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8 py-3 flex justify-between items-center h-20 md:h-24">
      <div class="flex items-center gap-4 min-w-0">
        <a href="/" class="block shrink-0"><img class="h-14 md:h-20 w-auto hidden dark:block" src="/assets/logo-dark.svg" alt="شعار العائلة" /><img class="h-14 md:h-20 w-auto block dark:hidden" src="/assets/logo-light.svg" alt="شعار العائلة" /></a>
        <div class="h-10 w-px bg-gray-300 dark:bg-white/20 hidden sm:block"></div>
        <div class="flex flex-col justify-center min-w-0"><h1 class="text-2xl md:text-3xl font-display text-primary dark:text-accent-gold font-bold leading-none tracking-wide pt-1 truncate">شجرة العائلة</h1><span class="hidden sm:block text-[10px] font-bold text-gray-500 dark:text-gray-500 uppercase tracking-[0.25em] mt-2">استكشاف الأنساب والروابط العائلية</span></div>
      </div>
      <nav class="hidden lg:flex gap-6 xl:gap-8 items-center text-sm font-bold text-gray-600 dark:text-gray-300">
        <a href="/" class="hover:text-primary dark:hover:text-accent-gold">الشجرة</a><a href="/about" class="hover:text-primary dark:hover:text-accent-gold">نبذة</a><a href="/honor" class="hover:text-primary dark:hover:text-accent-gold">السير الذاتية</a><a href="/news" class="hover:text-primary dark:hover:text-accent-gold">الأخبار</a><a href="/tree-pdf" class="hover:text-primary dark:hover:text-accent-gold">المشجرة</a><a href="/support" class="hover:text-primary dark:hover:text-accent-gold">الدعم</a><a href="/submit-person" class="text-accent-gold">إضافة بياناتك</a>
      </nav>
      <div class="flex items-center gap-2 sm:gap-3">
        <button id="themeBtn" class="flex items-center justify-center w-11 h-11 rounded-2xl bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-600 dark:text-accent-gold shadow-sm" type="button" title="تبديل المظهر"><span class="material-symbols-outlined text-[22px] dark-toggle-icon-moon">dark_mode</span><span class="material-symbols-outlined dark-toggle-icon-sun">light_mode</span></button>
        <a href="/admin/login" class="hidden sm:flex p-2.5 rounded-full bg-primary text-white dark:bg-white dark:text-black hover:opacity-90 transition-all shadow-md items-center justify-center" title="تسجيل الدخول"><span class="material-symbols-outlined text-[22px]">login</span></a>
        <button id="mobileNavBtn" class="lg:hidden p-2.5 text-primary dark:text-accent-gold bg-gray-50 dark:bg-white/5 rounded-full" type="button" aria-label="فتح القائمة"><span class="material-symbols-outlined text-[28px]">menu</span></button>
      </div>
    </div>
  </header>

  <main class="flex-1 relative overflow-visible">
    <div class="absolute inset-0 bg-islamic-pattern opacity-70 dark:opacity-20 pointer-events-none"></div>
    <div class="absolute -top-40 -left-40 w-[520px] h-[520px] rounded-full bg-primary/10 dark:bg-accent-gold/10 blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 right-0 w-[420px] h-[420px] rounded-full bg-accent-gold/10 blur-3xl pointer-events-none"></div>

    <section class="relative z-10 max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8 pt-10 md:pt-14 pb-8 text-center">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 dark:bg-accent-gold/10 text-primary dark:text-accent-gold font-black text-sm mb-5"><span class="material-symbols-outlined text-[18px]">edit_document</span> إرسال بيانات للمراجعة</span>
      <h2 class="font-display text-4xl md:text-6xl font-bold text-primary dark:text-white mb-4">إضافة بيانات فرد للعائلة</h2>
      <p class="text-gray-600 dark:text-gray-400 max-w-3xl mx-auto leading-8 font-medium">املأ البيانات التالية، وسيتم إرسالها إلى إدارة الموقع للمراجعة. لن تظهر البيانات في الشجرة إلا بعد موافقة الإدارة.</p>
    </section>

    <section class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <% if (submitted) { %>
        <div class="mb-6 rounded-3xl bg-green-50 dark:bg-green-500/10 border border-green-200 dark:border-green-500/20 p-5 sm:p-6 text-green-800 dark:text-green-200 font-bold text-center">
          <div class="flex items-center justify-center gap-2 mb-3">
            <span class="material-symbols-outlined text-[26px]">check_circle</span>
            <span>تم إرسال البيانات بنجاح. سيتم مراجعتها من الإدارة قبل الظهور في الشجرة.</span>
          </div>
          <% if (referenceCode) { %>
            <div class="mt-4 max-w-xl mx-auto rounded-2xl bg-white/80 dark:bg-black/25 border border-green-200 dark:border-green-500/20 p-4">
              <p class="text-sm text-green-700 dark:text-green-300 mb-2">الرقم المرجعي الخاص بطلبك</p>
              <div class="flex flex-col sm:flex-row items-stretch gap-3">
                <input id="referenceCodeInput" class="field text-center tracking-[0.18em] font-black" value="<%= referenceCode %>" readonly>
                <button id="copyReferenceBtn" type="button" class="px-5 py-3 rounded-2xl bg-primary dark:bg-accent-gold text-white dark:text-black font-black whitespace-nowrap flex items-center justify-center gap-2">
                  <span class="material-symbols-outlined text-[20px]">content_copy</span>
                  نسخ الرمز
                </button>
              </div>
              <p id="copyReferenceMsg" class="text-xs mt-2 text-green-700 dark:text-green-300 hidden">تم نسخ الرقم المرجعي.</p>
            </div>
          <% } %>
        </div>
      <% } %>
      <% if (error) { %><div class="mb-6 rounded-3xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 p-5 text-red-800 dark:text-red-200 font-bold text-center"><%= error %></div><% } %>

      <form method="post" action="/submit-person" enctype="multipart/form-data" class="section-card rounded-[2rem] p-4 sm:p-6 md:p-8 space-y-8">
        <section class="space-y-4"><h3 class="font-display font-bold text-2xl text-primary dark:text-accent-gold">البيانات الأساسية</h3><div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <label class="block"><span class="font-bold mb-2 block">الاسم الكامل *</span><input name="name" required class="field" placeholder="اكتب الاسم الكامل"></label>
          <label class="block"><span class="font-bold mb-2 block">النوع</span><select name="gender" class="field"><option value="">غير محدد</option><option value="male">ذكر</option><option value="female">أنثى</option></select></label>
          <label class="block"><span class="font-bold mb-2 block">الأب داخل الشجرة</span><select name="father_id" class="field"><option value="">غير محدد</option><% persons.forEach(p => { %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></label>
          <label class="block"><span class="font-bold mb-2 block">الأم داخل الشجرة</span><select name="mother_id" class="field"><option value="">غير محدد</option><% persons.forEach(p => { %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></label>
          <label class="block"><span class="font-bold mb-2 block">تاريخ الميلاد</span><input name="birth_date" class="field" placeholder="مثال: 1980-01-01"></label>
          <label class="block"><span class="font-bold mb-2 block">مكان الميلاد</span><input name="birth_place" class="field" placeholder="مكان الميلاد"></label>
          <label class="block"><span class="font-bold mb-2 block">العمل</span><input name="job" class="field" placeholder="الوظيفة أو العمل"></label>
          <label class="block"><span class="font-bold mb-2 block">الصورة الشخصية</span><input name="photo_file" type="file" accept="image/*" class="field"></label>
        </div></section>

        <section class="space-y-4"><h3 class="font-display font-bold text-2xl text-primary dark:text-accent-gold">بيانات التواصل الخاصة بالإدارة</h3><div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <label class="block"><span class="font-bold mb-2 block">رقم الجوال</span><input name="mobile_phone" class="field" placeholder="رقم الجوال"></label>
          <label class="block"><span class="font-bold mb-2 block">البريد الإلكتروني</span><input name="personal_email" type="email" class="field" placeholder="email@example.com"></label>
          <label class="block"><span class="font-bold mb-2 block">العنوان</span><input name="national_address" class="field" placeholder="العنوان"></label>
        </div></section>

        <section class="space-y-4"><h3 class="font-display font-bold text-2xl text-primary dark:text-accent-gold">الزوجة / الزوج والأبناء</h3><div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <label class="block"><span class="font-bold mb-2 block">أسماء الزوجة / الزوج</span><textarea name="spouse_names" rows="5" class="field" placeholder="اكتب كل اسم في سطر مستقل"></textarea></label>
          <label class="block"><span class="font-bold mb-2 block">أسماء الأبناء</span><textarea name="children_names" rows="5" class="field" placeholder="اكتب كل ابن/ابنة في سطر مستقل"></textarea></label>
        </div></section>

        <section class="space-y-4"><h3 class="font-display font-bold text-2xl text-primary dark:text-accent-gold">النبذة والملاحظات</h3><div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <label class="block"><span class="font-bold mb-2 block">نبذة مختصرة</span><textarea name="short_bio" rows="5" class="field" placeholder="نبذة مختصرة عن الفرد"></textarea></label>
          <label class="block"><span class="font-bold mb-2 block">ملاحظات إضافية</span><textarea name="notes" rows="5" class="field" placeholder="أي ملاحظات تريد إرسالها للإدارة"></textarea></label>
        </div></section>

        <section class="rounded-3xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 p-4 sm:p-5">
          <label class="inline-flex items-center gap-3 font-bold"><input type="checkbox" name="is_deceased" value="1" class="rounded text-primary"> الفرد متوفى</label>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4"><input name="death_date" class="field" placeholder="تاريخ الوفاة إن وجد"><input name="death_place" class="field" placeholder="مكان الوفاة إن وجد"></div>
        </section>

        <div class="flex flex-col sm:flex-row justify-center gap-3"><button class="px-8 py-4 rounded-full bg-primary dark:bg-accent-gold text-white dark:text-black font-black shadow-lg hover:opacity-95" type="submit">إرسال للمراجعة</button><a href="/" class="px-8 py-4 rounded-full bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 text-primary dark:text-accent-gold font-black">العودة للشجرة</a></div>
      </form>

      <section id="track-request" class="mt-8 section-card rounded-[2rem] p-4 sm:p-6 md:p-8 scroll-mt-28">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6">
          <div>
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent-gold/10 text-primary dark:text-accent-gold font-black text-sm mb-3">
              <span class="material-symbols-outlined text-[18px]">manage_search</span>
              تتبع الطلب
            </span>
            <h3 class="font-display font-bold text-3xl text-primary dark:text-white">تابع حالة طلبك</h3>
            <p class="text-gray-600 dark:text-gray-400 mt-2 font-medium leading-7">اكتب الرقم المرجعي الذي ظهر لك بعد الإرسال لمعرفة حالة المراجعة.</p>
          </div>
        </div>

        <form method="get" action="/track-person-request" class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-3">
          <input name="reference" class="field text-center md:text-right tracking-[0.08em]" value="<%= trackReference || '' %>" placeholder="مثال: FAM-2026-ABC123" required>
          <button type="submit" class="px-8 py-4 rounded-2xl bg-primary dark:bg-accent-gold text-white dark:text-black font-black shadow-lg flex items-center justify-center gap-2">
            <span class="material-symbols-outlined">search</span>
            بحث
          </button>
        </form>

        <% if (trackingSearched) { %>
          <% if (!trackingResult) { %>
            <div class="mt-5 rounded-2xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 p-5 text-red-800 dark:text-red-200 font-bold text-center">
              لم يتم العثور على طلب بهذا الرقم المرجعي. تأكد من كتابة الرمز بشكل صحيح.
            </div>
          <% } else if (trackingResult.status === 'pending') { %>
            <div class="mt-5 rounded-2xl bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 p-5 text-amber-800 dark:text-amber-200">
              <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-[28px]">hourglass_top</span>
                <div>
                  <p class="font-black text-lg">حالة الطلب: قيد المراجعة</p>
                  <p class="text-sm mt-1 opacity-90">طلب <strong><%= trackingResult.name %></strong> وصل للإدارة وجاري مراجعته.</p>
                  <p class="text-xs mt-2 opacity-80">الرقم المرجعي: <%= trackingResult.reference_code %></p>
                </div>
              </div>
            </div>
          <% } else if (trackingResult.status === 'rejected') { %>
            <div class="mt-5 rounded-2xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 p-5 text-red-800 dark:text-red-200">
              <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-[28px]">cancel</span>
                <div>
                  <p class="font-black text-lg">حالة الطلب: تم الرفض</p>
                  <p class="text-sm mt-1 opacity-90">طلب <strong><%= trackingResult.name %></strong> تم رفضه.</p>
                  <p class="mt-3 font-bold">سبب الرفض:</p>
                  <p class="text-sm mt-1 leading-7"><%= trackingResult.admin_note || 'لم يتم ذكر سبب محدد.' %></p>
                </div>
              </div>
            </div>
          <% } else if (trackingResult.status === 'approved') { %>
            <div class="mt-5 rounded-2xl bg-green-50 dark:bg-green-500/10 border border-green-200 dark:border-green-500/20 p-5 text-green-800 dark:text-green-200">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div class="flex items-start gap-3">
                  <span class="material-symbols-outlined text-[28px]">verified</span>
                  <div>
                    <p class="font-black text-lg">حالة الطلب: تمت الموافقة</p>
                    <p class="text-sm mt-1 opacity-90">تمت إضافة <strong><%= trackingResult.created_person_name || trackingResult.name %></strong> إلى الشجرة التفاعلية.</p>
                    <% if (trackingResult.reviewed_at) { %><p class="text-xs mt-2 opacity-80">تاريخ المراجعة: <%= trackingResult.reviewed_at %></p><% } %>
                  </div>
                </div>
                <% if (trackingResult.created_person_id) { %>
                  <a href="/?focus=<%= trackingResult.created_person_id %>" class="px-6 py-3 rounded-2xl bg-primary dark:bg-accent-gold text-white dark:text-black font-black text-center whitespace-nowrap flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined">account_tree</span>
                    شاهد موقعك في الشجرة
                  </a>
                <% } %>
              </div>
            </div>
          <% } %>
        <% } %>
      </section>
    </section>
  </main>

  <footer class="bg-background-light dark:bg-bg-charcoal border-t border-gray-200 dark:border-white/10 mt-auto py-8 relative z-10"><div class="max-w-[90rem] mx-auto px-6 text-center"><p class="text-[11px] font-bold text-gray-500 uppercase tracking-[0.1em]">© ٢٠٢٦ وقف عائلة خاشقجي. جميع الحقوق محفوظة.</p></div></footer>

  <script>
    (function(){const btn=document.getElementById('themeBtn');function setTheme(next){document.documentElement.classList.toggle('dark',next==='dark');document.documentElement.setAttribute('data-theme',next);localStorage.setItem('theme',next)}btn?.addEventListener('click',()=>{const cur=document.documentElement.classList.contains('dark')?'dark':'light';setTheme(cur==='dark'?'light':'dark')});})();
    (function(){
      const copyBtn=document.getElementById('copyReferenceBtn');
      const input=document.getElementById('referenceCodeInput');
      const msg=document.getElementById('copyReferenceMsg');
      copyBtn?.addEventListener('click', async ()=>{
        const value=input?.value || '';
        try { await navigator.clipboard.writeText(value); }
        catch(e){ input?.select(); document.execCommand('copy'); }
        msg?.classList.remove('hidden');
        setTimeout(()=>msg?.classList.add('hidden'),2200);
      });
    })();
    (function(){
      const btn=document.getElementById('mobileNavBtn'),drawer=document.getElementById('mobileNavDrawer'),overlay=document.getElementById('mobileNavOverlay'),close=document.getElementById('mobileNavClose');
      function lockPage(){document.documentElement.style.overflowY='hidden';document.body.style.overflowY='hidden'}
      function unlockPage(){document.documentElement.style.overflowY='auto';document.body.style.overflowY='auto';document.body.style.overflowX='hidden'}
      function open(){drawer?.classList.add('isOpen');overlay?.classList.remove('mobile-nav-hidden');overlay?.classList.add('mobile-nav-open');lockPage()}
      function shut(){drawer?.classList.remove('isOpen');overlay?.classList.add('mobile-nav-hidden');overlay?.classList.remove('mobile-nav-open');unlockPage()}
      unlockPage();
      btn?.addEventListener('click',open);
      close?.addEventListener('click',shut);
      overlay?.addEventListener('click',shut);
      drawer?.querySelectorAll('a').forEach(a=>a.addEventListener('click',shut));
    })();
  </script>
</body>
</html>
