<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>الرسائل - شجرة العائلة</title>

  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/styles.css" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@300;400;500;700;900&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries,line-clamp"></script>

  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#005A2B",
            primaryDark: "#003D1D",
            accent: "#E5B869",
            "accent-gold": "#E5B869",
            "background-light": "#F8F8F6",
            "background-dark": "#050505",
            "bg-charcoal": "#050505",
            "card-light": "#FFFFFF",
            "card-dark": "#0A0A0A",
            "bg-card": "#0A0A0A",
            "text-cream": "#FAFAFA",
            "text-dark": "#111827",
            "text-muted": "#71717A",
            "muted-slate": "#71717A",
            gold: "#E5B869",
            "accent-gold-dark": "#D4A353",
          },
          fontFamily: {
            display: ["'Aref Ruqaa'", "serif"],
            sans: ["Tajawal", "sans-serif"],
          },
          backgroundImage: {
            "islamic-pattern": "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E5B869' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")",
            "islamic-pattern-dark": "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E5B869' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")"
          },
          boxShadow: {
            luxury: "0 20px 40px -10px rgba(0,0,0,0.05), 0 0 20px rgba(229,184,105,0.03)",
            "luxury-dark": "0 20px 40px -10px rgba(0,0,0,0.4), 0 0 20px rgba(229,184,105,0.05)",
          }
        }
      }
    };
  </script>

  <style type="text/tailwindcss">
    @layer utilities {
      .scrollbar-hide::-webkit-scrollbar { display: none; }
      .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }

      .glass-panel {
        @apply bg-white/85 dark:bg-[#080808]/85 backdrop-blur-xl border border-accent-gold/20 shadow-luxury dark:shadow-luxury-dark;
      }
    }
  </style>

  <style>
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb {
      background: rgba(229, 184, 105, 0.4);
      border-radius: 4px;
      transition: background 0.3s;
    }
    ::-webkit-scrollbar-thumb:hover { background: rgba(229, 184, 105, 0.8); }

    #mobileNavOverlay.hidden { display: none; }
    #mobileNavOverlay { display: block; }

    #mobileNavDrawer {
      transform: translateX(-110%);
      transition: transform .3s cubic-bezier(.2,.9,.2,1);
    }
    #mobileNavDrawer.isOpen { transform: translateX(0); }

    #mobileNavBtn[data-open="true"] .ico-open { display: none; }
    #mobileNavBtn[data-open="true"] .ico-close { display: inline; }
    #mobileNavBtn[data-open="false"] .ico-open { display: inline; }
    #mobileNavBtn[data-open="false"] .ico-close { display: none; }

    .chat-hero {
      position: relative;
      overflow: hidden;
      border-radius: 8px;
      border: 1px solid rgba(229,184,105,.24);
      background:
        linear-gradient(135deg, rgba(0,90,43,.98), rgba(0,61,29,.96)),
        radial-gradient(circle at top left, rgba(229,184,105,.28), transparent 42%);
      box-shadow: 0 24px 70px rgba(0,0,0,.14);
      isolation: isolate;
    }

    .dark .chat-hero {
      background:
        linear-gradient(135deg, rgba(10,10,10,.96), rgba(5,5,5,.98)),
        radial-gradient(circle at top left, rgba(229,184,105,.18), transparent 42%);
      box-shadow: 0 28px 90px rgba(0,0,0,.55);
    }

    .chat-hero-frame {
      position: absolute;
      inset: 14px;
      border: 1px solid rgba(229,184,105,.35);
      border-radius: 6px;
      pointer-events: none;
      z-index: 2;
    }

    .chat-panel {
      position: relative;
      overflow: hidden;
      border-radius: 8px;
      border: 1px solid rgba(229,184,105,.20);
      background:
        linear-gradient(180deg, rgba(255,255,255,.94), rgba(255,255,255,.82)),
        radial-gradient(circle at top right, rgba(229,184,105,.12), transparent 40%);
      box-shadow: 0 18px 50px rgba(0,0,0,.06);
    }

    .dark .chat-panel {
      border-color: rgba(255,255,255,.10);
      background:
        linear-gradient(180deg, rgba(15,15,15,.94), rgba(7,7,7,.97)),
        radial-gradient(circle at top right, rgba(229,184,105,.10), transparent 40%);
      box-shadow: 0 18px 55px rgba(0,0,0,.42);
    }

    .gold-line {
      width: 42px;
      height: 2px;
      background: linear-gradient(to left, #E5B869, rgba(229,184,105,0));
    }

    .luxury-btn {
      position: relative;
      overflow: hidden;
      transition: transform .35s cubic-bezier(.19,1,.22,1), box-shadow .35s ease;
    }

    .luxury-btn::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(120deg, transparent, rgba(255,255,255,.22), transparent);
      transform: translateX(120%);
      transition: transform .7s cubic-bezier(.19,1,.22,1);
      pointer-events: none;
    }

    .luxury-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(0,0,0,.12);
    }

    .luxury-btn:hover::after {
      transform: translateX(-120%);
    }

    .message-card {
      position: relative;
      display: flex;
      align-items: center;
      gap: 16px;
      margin: 12px;
      padding: 16px;
      border-radius: 8px;
      border: 1px solid rgba(229,184,105,.16);
      background:
        linear-gradient(135deg, rgba(255,255,255,.92), rgba(255,255,255,.72)),
        radial-gradient(circle at top right, rgba(229,184,105,.13), transparent 42%);
      box-shadow: 0 12px 32px rgba(0,0,0,.045);
      overflow: hidden;
      isolation: isolate;
      transition:
        transform .45s cubic-bezier(.19,1,.22,1),
        box-shadow .45s ease,
        border-color .45s ease,
        background-color .45s ease;
    }

    .dark .message-card {
      border-color: rgba(255,255,255,.09);
      background:
        linear-gradient(135deg, rgba(16,16,16,.96), rgba(8,8,8,.94)),
        radial-gradient(circle at top right, rgba(229,184,105,.10), transparent 42%);
      box-shadow: 0 14px 36px rgba(0,0,0,.35);
    }

    .message-card::before {
      content: "";
      position: absolute;
      inset-block: 12px;
      right: 0;
      width: 3px;
      border-radius: 999px 0 0 999px;
      background: linear-gradient(to bottom, transparent, #E5B869, transparent);
      opacity: .45;
      transition: opacity .45s ease, inset-block .45s ease;
      z-index: 2;
    }

    .message-card::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(120deg, transparent 20%, rgba(229,184,105,.09), transparent 80%);
      transform: translateX(120%);
      transition: transform .8s cubic-bezier(.19,1,.22,1);
      pointer-events: none;
      z-index: 1;
    }

    .message-card:hover {
      transform: translateY(-4px);
      border-color: rgba(229,184,105,.48);
      box-shadow: 0 22px 55px rgba(0,0,0,.10), 0 0 18px rgba(229,184,105,.07);
    }

    .dark .message-card:hover {
      box-shadow: 0 24px 60px rgba(0,0,0,.55), 0 0 22px rgba(229,184,105,.10);
    }

    .message-card:hover::before {
      opacity: 1;
      inset-block: 8px;
    }

    .message-card:hover::after {
      transform: translateX(-120%);
    }

    .message-avatar-wrap {
      position: relative;
      width: 66px;
      height: 66px;
      flex: 0 0 auto;
      border-radius: 8px;
      padding: 3px;
      background:
        linear-gradient(135deg, rgba(229,184,105,.95), rgba(0,90,43,.28), rgba(229,184,105,.45));
      box-shadow: 0 14px 28px rgba(0,0,0,.12);
      z-index: 3;
    }

    .dark .message-avatar-wrap {
      box-shadow: 0 14px 30px rgba(0,0,0,.45), 0 0 16px rgba(229,184,105,.08);
    }

    .message-avatar {
      width: 100%;
      height: 100%;
      border-radius: 6px;
      object-fit: cover;
      background: #f3f4f6;
      display: block;
    }

    .dark .message-avatar {
      background: #111;
    }

    .message-online-dot {
      position: absolute;
      left: -2px;
      bottom: -2px;
      width: 16px;
      height: 16px;
      border-radius: 999px;
      background: #E5B869;
      border: 3px solid #FFFFFF;
      box-shadow: 0 0 0 2px rgba(229,184,105,.25);
    }

    .dark .message-online-dot {
      border-color: #080808;
    }

    .message-title {
      font-weight: 900;
      color: #005A2B;
      transition: color .3s ease;
    }

    .dark .message-title {
      color: #E5B869;
    }

    .message-card:hover .message-title {
      color: #003D1D;
    }

    .dark .message-card:hover .message-title {
      color: #FFFFFF;
    }

    .message-preview {
      margin-top: 8px;
      width: fit-content;
      max-width: 100%;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 12px;
      border-radius: 8px;
      border: 1px solid rgba(0,90,43,.08);
      background: rgba(0,90,43,.045);
      color: #71717A;
      font-size: 13px;
      font-weight: 700;
      line-height: 1.7;
    }

    .dark .message-preview {
      border-color: rgba(229,184,105,.12);
      background: rgba(229,184,105,.055);
      color: rgba(255,255,255,.62);
    }

    .message-unread {
      min-width: 28px;
      height: 28px;
      padding: 0 9px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #E5B869;
      color: #050505;
      font-size: 12px;
      font-weight: 900;
      box-shadow: 0 10px 20px rgba(229,184,105,.25);
    }

    .message-action {
      width: 38px;
      height: 38px;
      border-radius: 999px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #005A2B;
      background: rgba(0,90,43,.055);
      border: 1px solid rgba(0,90,43,.08);
      transition: transform .35s ease, color .35s ease, background .35s ease, border-color .35s ease;
      z-index: 3;
      flex: 0 0 auto;
    }

    .dark .message-action {
      color: #E5B869;
      background: rgba(229,184,105,.06);
      border-color: rgba(229,184,105,.12);
    }

    .message-card:hover .message-action {
      transform: translateX(-3px);
      color: #050505;
      background: #E5B869;
      border-color: #E5B869;
    }

    .member-card {
      margin: 10px;
      padding: 13px;
      border-radius: 8px;
      border: 1px solid rgba(229,184,105,.13);
      background: rgba(255,255,255,.58);
      transition: transform .35s cubic-bezier(.19,1,.22,1), border-color .35s ease, background .35s ease;
    }

    .dark .member-card {
      border-color: rgba(255,255,255,.08);
      background: rgba(255,255,255,.025);
    }

    .member-card:hover {
      transform: translateY(-2px);
      border-color: rgba(229,184,105,.38);
      background: rgba(0,90,43,.04);
    }

    .dark .member-card:hover {
      background: rgba(229,184,105,.045);
    }

    @media (max-width: 640px) {
      .message-card {
        align-items: flex-start;
        gap: 12px;
        margin: 10px;
        padding: 14px;
      }

      .message-avatar-wrap {
        width: 56px;
        height: 56px;
      }

      .message-action {
        width: 34px;
        height: 34px;
      }
    }
  </style>

  <script>
    (function () {
      const saved = localStorage.getItem("theme") || "dark";
      document.documentElement.setAttribute("data-theme", saved);
      document.documentElement.classList.toggle("dark", saved === "dark");

      const obs = new MutationObserver(() => {
        const t = document.documentElement.getAttribute("data-theme") || "dark";
        document.documentElement.classList.toggle("dark", t === "dark");
      });
      obs.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    })();
  </script>
</head>

<body class="bg-background-light dark:bg-bg-charcoal text-gray-900 dark:text-text-cream font-sans min-h-screen flex flex-col overflow-x-hidden selection:bg-accent/30 selection:text-gray-900 dark:selection:text-white transition-colors duration-400">

