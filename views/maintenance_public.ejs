<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>الموقع تحت الصيانة</title>
  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/styles.css"/>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@300;400;500;700;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#005A2B",
            primaryDark: "#003D1D",
            accent: "#E5B869",
            "background-light": "#F8F8F6",
            "background-dark": "#050505",
            "card-light": "#FFFFFF",
            "card-dark": "#0A0A0A",
            "bg-charcoal": "#050505",
            "text-cream": "#FAFAFA",
          },
          fontFamily: {
            display: ["'Aref Ruqaa'", "serif"],
            sans: ["Tajawal", "sans-serif"],
          }
        }
      }
    };
  </script>

  <style type="text/tailwindcss">
    @layer utilities {
      .glass-premium { @apply backdrop-blur-xl border border-white/20 dark:border-white/5; }
    }
  </style>

  <style>
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #E5B869; border-radius: 4px; }

    .ambient-glow-wrapper { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
    .ambient-glow {
      position: absolute; width: 80vw; height: 80vw; max-width: 600px; max-height: 600px;
      background: radial-gradient(circle, rgba(0,90,43,0.12) 0%, transparent 70%);
      border-radius: 50%; top: -10%; left: -10%;
    }
    .ambient-glow-2 {
      position: absolute; width: 70vw; height: 70vw; max-width: 500px; max-height: 500px;
      background: radial-gradient(circle, rgba(229,184,105,0.10) 0%, transparent 70%);
      border-radius: 50%; bottom: 10%; right: -10%;
    }

    html.dark .dark-toggle-icon-moon { display: none; }
    html:not(.dark) .dark-toggle-icon-sun { display: none; }
  </style>

  <script>
    (function () {
      const saved = localStorage.getItem("theme") || "dark";
      document.documentElement.setAttribute("data-theme", saved);
      document.documentElement.classList.toggle("dark", saved === "dark");
    })();
  </script>
</head>

<body class="bg-background-light dark:bg-bg-charcoal text-gray-900 dark:text-text-cream font-sans min-h-screen flex flex-col selection:bg-accent selection:text-background-dark transition-colors duration-300">
  <div class="relative min-h-screen overflow-hidden">
    <div class="ambient-glow-wrapper">
      <div class="ambient-glow"></div>
      <div class="ambient-glow-2"></div>
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-white/70 to-white/90 dark:from-black/50 dark:to-[#050505]/95 pointer-events-none"></div>

    <header class="relative z-20 sticky top-0 w-full bg-white/95 dark:bg-[#050505]/95 backdrop-blur-md border-b border-gray-200 dark:border-white/10">
      <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8 py-3 flex justify-between items-center h-20">
        <div class="flex items-center gap-4">
          <a href="/" class="block shrink-0">
            <img class="h-12 w-auto hidden dark:block" src="/assets/logo-dark.svg" alt="شعار العائلة" />
            <img class="h-12 w-auto block dark:hidden" src="/assets/logo-light.svg" alt="شعار العائلة" />
          </a>
          <div>
            <h1 class="font-display text-2xl font-bold text-primary dark:text-white leading-none">شجرة العائلة</h1>
            <p class="text-[11px] text-gray-500 dark:text-gray-400 font-bold tracking-widest uppercase mt-1">رسالة الصيانة العامة</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <button id="themeBtn" class="flex items-center justify-center w-12 h-12 rounded-2xl bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-600 dark:text-accent shadow-sm" type="button" title="تبديل المظهر">
            <span class="material-symbols-outlined text-[22px] dark-toggle-icon-moon">dark_mode</span>
            <span class="material-symbols-outlined hidden dark:block text-[24px]">light_mode</span>
          </button>
          <a href="/admin/login" class="flex items-center gap-2 px-5 h-12 rounded-2xl font-bold text-sm bg-primary text-white dark:bg-white dark:text-primary shadow-sm hover:-translate-y-1 transition-transform">
            <span class="material-symbols-outlined text-[20px]">login</span>
            <span class="hidden sm:inline">دخول الإدارة</span>
          </a>
        </div>
      </div>
    </header>

    <main class="relative z-10 flex-1 flex items-center justify-center px-4 py-10">
      <section class="w-full max-w-4xl rounded-[2rem] bg-white/90 dark:bg-[#0A0A0A]/90 glass-premium shadow-[0_24px_80px_rgba(0,0,0,0.12)] dark:shadow-[0_24px_80px_rgba(0,0,0,0.45)] overflow-hidden">
        <div class="h-1.5 w-full bg-gradient-to-r from-primary via-accent to-primary"></div>
        <div class="p-6 sm:p-8 lg:p-10 text-center">
          <div class="mx-auto w-20 h-20 rounded-[1.6rem] bg-primary/10 dark:bg-accent/10 text-primary dark:text-accent flex items-center justify-center mb-6"><span class="material-symbols-outlined text-[40px]">construction</span></div>
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent/15 text-primary dark:text-accent text-xs sm:text-sm font-black mb-4"><span class="material-symbols-outlined text-[18px]">schedule</span>الموقع تحت الصيانة مؤقتاً</span>
          <h2 class="font-display text-3xl sm:text-4xl font-bold text-primary dark:text-white mb-4">نعمل الآن على تحسين الموقع</h2>
          <p class="text-base sm:text-lg leading-8 text-gray-700 dark:text-gray-300 font-medium max-w-2xl mx-auto"><%= message %></p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-8 text-right">
            <div class="rounded-2xl p-5 bg-white/60 dark:bg-white/5 border border-black/5 dark:border-white/10">
              <p class="font-black text-primary dark:text-accent mb-2">ما الذي يحدث؟</p>
              <p class="text-sm leading-7 text-gray-600 dark:text-gray-300">يتم تنفيذ تحديثات أو تحسينات على الموقع العام، لذلك تم تفعيل وضع الصيانة مؤقتاً لضمان تجربة أفضل عند العودة.</p>
            </div>
            <div class="rounded-2xl p-5 bg-white/60 dark:bg-white/5 border border-black/5 dark:border-white/10">
              <p class="font-black text-primary dark:text-accent mb-2">هل يمكن دخول الإدارة؟</p>
              <p class="text-sm leading-7 text-gray-600 dark:text-gray-300">نعم، يمكن للمسؤولين الدخول إلى لوحة التحكم بشكل طبيعي من خلال زر دخول الإدارة أعلى الصفحة.</p>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <script>
    (function () {
      const btn = document.getElementById("themeBtn");
      function setTheme(next) {
        document.documentElement.setAttribute("data-theme", next);
        document.documentElement.classList.toggle("dark", next === "dark");
        localStorage.setItem("theme", next);
      }
      btn?.addEventListener("click", () => {
        const cur = document.documentElement.getAttribute("data-theme") || "dark";
        setTheme(cur === "dark" ? "light" : "dark");
      });
    })();
  </script>
</body>
</html>
