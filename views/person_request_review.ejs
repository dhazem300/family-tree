<style type="text/tailwindcss">@layer utilities{.glass-panel{@apply backdrop-blur-2xl shadow-xl}}
  /* صفحة المراجعة طويلة، لذلك نترك التمرير للصفحة نفسها بدل حبسها داخل h-screen */
  body{min-height:100vh;overflow-y:auto!important;}
  main{min-height:100vh;}
  @supports (min-height:100dvh){body,main{min-height:100dvh;}}


  /* FINAL WHEEL/TOUCH SCROLL FIX: نثبت التمرير داخل main ونمنع أي طبقة من تعطيل عجلة الماوس */
  html, body{
    height:100%!important;
    max-height:100%!important;
    overflow:hidden!important;
  }
  body{
    position:relative!important;
  }
  #personReviewMain{
    display:flex!important;
    flex-direction:column!important;
    height:100vh!important;
    max-height:100vh!important;
    min-height:0!important;
    overflow-y:scroll!important;
    overflow-x:hidden!important;
    -webkit-overflow-scrolling:touch!important;
    scrollbar-gutter:stable!important;
    overscroll-behavior-y:contain!important;
    touch-action:pan-y!important;
  }
  @supports (height:100dvh){
    #personReviewMain{height:100dvh!important;max-height:100dvh!important;}
  }
  #personReviewContent{
    flex:0 0 auto!important;
    min-height:auto!important;
    padding-bottom:120px!important;
  }
  #nexusCanvas, .admin-bg-layer{
    pointer-events:none!important;
  }

    html.theme-switching, html.theme-switching *, html.theme-switching *::before, html.theme-switching *::after { transition: none !important; animation: none !important; }
</style>
<style>
  ::-webkit-scrollbar{width:6px;height:6px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:#005A2B;border-radius:999px}html.dark ::-webkit-scrollbar-thumb{background:#E5B869}
  html.dark .dark-toggle-icon-moon{display:none} html:not(.dark) .dark-toggle-icon-sun{display:none}
  #nexusCanvas{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events: none}.admin-bg-layer{position:fixed;inset:0;z-index:1;pointer-events:none;background:linear-gradient(to bottom,rgba(255,255,255,.45),rgba(255,255,255,.86))}html.dark .admin-bg-layer{background:linear-gradient(to bottom,rgba(0,0,0,.45),rgba(5,5,5,.92))}
  .field{width:100%;border-radius:16px;border:1px solid rgba(0,0,0,.10);padding:12px 14px;font-weight:800;background:#fff;color:#111827;outline:none;transition:.2s}.dark .field{background:rgba(255,255,255,.055);border-color:rgba(255,255,255,.12);color:#fff}.field:focus{border-color:#005A2B;box-shadow:0 0 0 4px rgba(0,90,43,.10)}html.dark .field:focus{border-color:#E5B869;box-shadow:0 0 0 4px rgba(229,184,105,.12)}
  #adminMobileToggle:checked ~ #adminMobileOverlay{display:block}#adminMobileToggle:checked ~ #adminMobileDrawer{transform:translateX(0)}#adminMobileOverlay{display:none}.admin-mobile-drawer{transform:translateX(-115%);transition:transform .35s cubic-bezier(.16,1,.3,1)}

  /* صفحة المراجعة طويلة، لذلك نترك التمرير للصفحة نفسها بدل حبسها داخل h-screen */
  body{min-height:100vh;overflow-y:auto!important;}
  main{min-height:100vh;}
  @supports (min-height:100dvh){body,main{min-height:100dvh;}}


  /* HARD FIX: صفحة مراجعة الطلب طويلة، لذلك التمرير يكون داخل main نفسه وليس على body */
  html, body{
    width:100%!important;
    height:100%!important;
    min-height:100%!important;
    overflow:hidden!important;
    overscroll-behavior:none;
  }
  body{
    margin:0!important;
  }
  #personReviewMain{
    height:100vh!important;
    min-height:100vh!important;
    max-height:100vh!important;
    overflow-y:auto!important;
    overflow-x:hidden!important;
    -webkit-overflow-scrolling:touch!important;
    overscroll-behavior-y:contain;
    touch-action:pan-y!important;
    padding-bottom:calc(48px + env(safe-area-inset-bottom));
  }
  @supports (height:100dvh){
    #personReviewMain{
      height:100dvh!important;
      min-height:100dvh!important;
      max-height:100dvh!important;
    }
  }
  #personReviewContent{
    min-height:max-content;
  }
  #nexusCanvas{
    pointer-events:none!important;
  }
</style>
<script>(function(){const saved=localStorage.getItem('theme')||'dark';document.documentElement.classList.toggle('dark',saved==='dark');document.documentElement.setAttribute('data-theme',saved);})();</script>
