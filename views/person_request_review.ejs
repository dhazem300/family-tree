11px] font-black flex items-center justify-center"><%= adminPendingCounts.personRequests %></span><% } %></a></div>
    <div class="space-y-2"><p class="px-3 text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-3">النظام والموقع</p><a href="/admin/dashboard" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors"><span class="material-symbols-outlined text-[22px]">dashboard</span> لوحة الإحصائيات</a><a href="/admin/activity" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors"><span class="material-symbols-outlined text-[22px]">manage_history</span> سجل النشاطات</a><a href="/admin/maintenance" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors"><span class="material-symbols-outlined text-[22px]">construction</span> وضع الصيانة</a><a href="/admin/support-messages" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors"><span class="material-symbols-outlined text-[22px]">mail</span> رسائل الدعم <% if ((adminPendingCounts?.support || 0) > 0) { %><span class="mr-auto ms-2 min-w-[22px] h-[22px] px-2 rounded-full bg-red-600 text-white text-[11px] font-black flex items-center justify-center"><%= adminPendingCounts.support %></span><% } %></a><a href="/" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors"><span class="material-symbols-outlined text-[22px]">account_tree</span> عرض الشجرة</a></div>
  </nav>
  <div class="p-4 border-t border-border-light dark:border-border-dark shrink-0 m-2 rounded-2xl bg-white/50 dark:bg-black/30"><div class="flex items-center gap-3"><div class="w-10 h-10 rounded-full bg-primary/10 dark:bg-accent/10 flex items-center justify-center text-primary dark:text-accent"><span class="material-symbols-outlined text-[20px]">person</span></div><div class="flex-1 min-w-0"><p class="text-sm font-bold text-gray-900 dark:text-white truncate"><%= admin?.username || 'مدير النظام' %></p><p class="text-[10px] text-primary dark:text-accent uppercase tracking-widest mt-0.5 font-bold">Admin</p></div><form method="post" action="/admin/logout"><button type="submit" class="w-9 h-9 flex items-center justify-center rounded-xl bg-red-50 dark:bg-red-500/10 text-red-500 hover:bg-red-500 hover:text-white transition-all"><span class="material-symbols-outlined text-[18px]">logout</span></button></form></div></div>
</aside>
  <main id="personReviewMain" class="flex-1 flex flex-col min-w-0 relative z-10">
    <header class="flex items-center justify-between gap-4 p-4 lg:p-8 shrink-0">
      <div class="flex items-center gap-3 min-w-0">
        <label for="adminMobileToggle" class="lg:hidden flex items-center justify-center w-12 h-12 rounded-2xl bg-card-light dark:bg-card-dark glass-panel border border-border-light dark:border-border-dark text-primary dark:text-accent shadow-sm cursor-pointer shrink-0"><span class="material-symbols-outlined text-[26px]">menu</span></label>
        <div class="min-w-0"><h2 class="text-2xl md:text-3xl font-display font-bold text-primary dark:text-white tracking-tight leading-none mb-1.5 truncate">مراجعة طلب رقم <%= request.id %></h2><div class="flex items-center gap-1.5 text-gray-500 text-[11px] font-bold uppercase tracking-widest flex-wrap"><span>لوحة الإدارة</span><span class="material-symbols-outlined text-[14px]">chevron_left</span><span>طلبات الأفراد</span><span class="material-symbols-outlined text-[14px]">chevron_left</span><span class="text-accent">مراجعة</span></div></div>
      </div>
      <div class="flex items-center gap-2 sm:gap-3 shrink-0"><button id="themeBtn" class="flex items-center justify-center w-12 h-12 rounded-2xl bg-card-light dark:bg-card-dark glass-panel border border-border-light dark:border-border-dark text-gray-600 dark:text-accent shadow-sm" type="button"><span class="material-symbols-outlined text-[22px] dark-toggle-icon-moon">dark_mode</span><span class="material-symbols-outlined dark-toggle-icon-sun text-[24px]">light_mode</span></button><a href="/admin/person-requests" class="hidden sm:flex items-center gap-2 px-5 h-12 rounded-2xl font-bold text-sm bg-primary dark:bg-accent text-white dark:text-black shadow-sm"><span class="material-symbols-outlined text-[21px]">arrow_back</span><span>رجوع للطلبات</span></a></div>
    </header>
    <div id="personReviewContent" class="w-full px-4 lg:px-8 pb-20 overflow-visible">
      <div class="max-w-[100rem] mx-auto space-y-6">
        <section class="bg-card-light dark:bg-card-dark glass-panel rounded-3xl border border-border-light dark:border-border-dark p-5 md:p-6 shadow-sm"><div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4"><div><h3 class="font-black text-xl text-primary dark:text-white">راجع البيانات قبل اعتمادها</h3><p class="text-sm text-gray-500 dark:text-gray-400 mt-2 leading-7">يمكنك تعديل البيانات القادمة من المستخدم قبل إضافتها رسميًا داخل الشجرة التفاعلية.</p></div><div class="flex flex-wrap gap-2"><a href="/admin/person-requests" class="px-4 py-3 rounded-2xl bg-white/70 dark:bg-white/5 border border-black/5 dark:border-white/10 text-primary dark:text-accent font-bold">رجوع للطلبات</a><a href="/admin" class="px-4 py-3 rounded-2xl bg-primary dark:bg-accent text-white dark:text-black font-bold">إدارة الأفراد</a></div></div></section>
        <% if (error) { %><div class="p-4 rounded-2xl bg-red-50 dark:bg-red-500/10 text-red-800 dark:text-red-200 border border-red-200 dark:border-red-500/20 font-bold"><%= error %></div><% } %>

        <form method="post" action="/admin/person-requests/<%= request.id %>/approve" class="bg-card-light dark:bg-card-dark glass-panel border border-border-light dark:border-border-dark rounded-3xl shadow-sm p-4 sm:p-6 md:p-8 space-y-8">
          <section class="grid grid-cols-1 xl:grid-cols-[220px_1fr] gap-6 items-start">
            <div class="rounded-3xl overflow-hidden border border-black/10 dark:border-white/10 bg-gray-100 dark:bg-black/30 aspect-square max-w-[220px] w-full mx-auto xl:mx-0 shadow-lg"><img loading="lazy" decoding="async" src="<%= request.photo_url || '/assets/default-avatar.svg' %>" onerror="this.src='/assets/default-avatar.svg'" class="w-full h-full object-cover" alt=""></div>
            <div class="space-y-4"><h3 class="font-display text-2xl font-bold text-primary dark:text-accent">البيانات الأساسية</h3><div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <label><span class="font-bold mb-2 block">الاسم *</span><input name="name" required class="field" value="<%= request.name || '' %>"></label>
              <label><span class="font-bold mb-2 block">النوع</span><select name="gender" class="field"><option value="">غير محدد</option><option value="male" <%= request.gender==='male'?'selected':'' %>>ذكر</option><option value="female" <%= request.gender==='female'?'selected':'' %>>أنثى</option></select></label>
              <label><span class="font-bold mb-2 block">اسم الأب الثلاثي داخل الشجرة</span><input name="father_lineage_name" data-lineage-resolver="father" class="field" value="<%= fatherLineageName || '' %>" placeholder="برجاء كتابة اسم الاب ثلاثي"><small class="lineage-feedback block mt-2 text-xs font-bold text-gray-500 dark:text-gray-400" data-lineage-feedback="father">يتم مطابقة الاسم الثلاثي وربط الطلب بالأب تلقائيًا عند الاعتماد.</small></label>
              <label><span class="font-bold mb-2 block">اسم الأم الثلاثي داخل الشجرة</span><input name="mother_lineage_name" data-lineage-resolver="mother" class="field" value="<%= motherLineageName || '' %>" placeholder="برجاء كتابة اسم الام ثلاثي"><small class="lineage-feedback block mt-2 text-xs font-bold text-gray-500 dark:text-gray-400" data-lineage-feedback="mother">اختياري: إذا كانت الأم موجودة في الشجرة سيتم ربطها تلقائيًا عند الاعتماد.</small></label>
              <input type="hidden" name="photo_url" value="<%= request.photo_url || '' %>">
            </div></div>
          </section>

          <section class="space-y-4"><h3 class="font-display text-2xl font-bold text-primary dark:text-accent">بيانات الميلاد والعمل والتواصل</h3><div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
            <label><span class="font-bold mb-2 block">تاريخ الميلاد</span><input name="birth_date" data-dual-date class="field" value="<%= request.birth_date || '' %>" placeholder="اختر التاريخ الميلادي أو اكتب التاريخ الهجري"></label>
