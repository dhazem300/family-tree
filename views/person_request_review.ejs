="material-symbols-outlined text-gray-400">construction</span> وضع الصيانة</a><a href="/admin/support-messages" class="flex items-center gap-3 px-4 py-4 rounded-2xl hover:bg-gray-50 dark:hover:bg-white/5"><span class="material-symbols-outlined text-gray-400">mail</span> رسائل الدعم <% if ((adminPendingCounts?.support || 0) > 0) { %><span class="mr-auto ms-2 min-w-[22px] h-[22px] px-2 rounded-full bg-red-600 text-white text-[11px] font-black flex items-center justify-center"><%= adminPendingCounts.support %></span><% } %></a><div class="my-4 border-t border-gray-200 dark:border-white/10"></div><a href="/" class="flex items-center gap-3 px-4 py-4 rounded-2xl hover:bg-gray-50 dark:hover:bg-white/5"><span class="material-symbols-outlined text-gray-400">account_tree</span> العودة للموقع</a></nav>
  <div class="p-6 border-t border-gray-100 dark:border-white/10"><form method="post" action="/admin/logout"><button type="submit" class="w-full flex items-center justify-center gap-2 px-4 py-4 rounded-2xl border border-red-200 dark:border-red-900/30 text-red-600 dark:text-red-400 bg-red-50/50 dark:bg-red-500/10 font-bold"><span class="material-symbols-outlined">logout</span> تسجيل خروج</button></form></div>
