  <script>
    // FINAL SCROLL FIX: بعض الطبقات الثابتة كانت تمنع عجلة الماوس من تحريك صفحة مراجعة الطلب.
    // هنا نوجه أي Wheel أو Touch Drag إلى main مباشرة.
    (function personReviewScrollFix(){
      const scroller = document.getElementById('personReviewMain');
      if (!scroller) return;

      function menuIsOpen(){
        const toggle = document.getElementById('adminMobileToggle');
        return Boolean(toggle && toggle.checked);
      }

      function shouldIgnore(target){
        if (!target) return false;
        if (target.closest && target.closest('#adminMobileDrawer')) return true;
        if (target.closest && target.closest('select')) return true;
        return false;
      }

      document.addEventListener('wheel', function(e){
        if (menuIsOpen() || shouldIgnore(e.target)) return;
        const delta = Math.abs(e.deltaY) >= Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
        if (!delta) return;
        scroller.scrollTop += delta;
        e.preventDefault();
      }, { passive:false, capture:true });

      let startY = 0;
      let startTop = 0;
      document.addEventListener('touchstart', function(e){
        if (menuIsOpen() || shouldIgnore(e.target)) return;
        if (!e.touches || !e.touches.length) return;
        startY = e.touches[0].clientY;
        startTop = scroller.scrollTop;
      }, { passive:true, capture:true });

      document.addEventListener('touchmove', function(e){
        if (menuIsOpen() || shouldIgnore(e.target)) return;
        if (!e.touches || !e.touches.length) return;
        const y = e.touches[0].clientY;
        scroller.scrollTop = startTop + (startY - y);
        e.preventDefault();
      }, { passive:false, capture:true });

      // ضمان أن PageDown/Space/Home/End تتحرك داخل نفس الكونتينر
      document.addEventListener('keydown', function(e){
        if (menuIsOpen()) return;
        const tag = (e.target && e.target.tagName || '').toLowerCase();
        if (['input','textarea','select'].includes(tag)) return;
        const step = Math.max(260, Math.floor(scroller.clientHeight * 0.85));
        if (e.key === 'PageDown' || e.key === ' ') { scroller.scrollTop += step; e.preventDefault(); }
        if (e.key === 'PageUp') { scroller.scrollTop -= step; e.preventDefault(); }
        if (e.key === 'Home') { scroller.scrollTop = 0; e.preventDefault(); }
        if (e.key === 'End') { scroller.scrollTop = scroller.scrollHeight; e.preventDefault(); }
      }, { capture:true });
    })();
  </script>
  <script>(function(){const btn=document.getElementById('themeBtn');function setTheme(n){document.documentElement.classList.toggle('dark',n==='dark');document.documentElement.setAttribute('data-theme',n);localStorage.setItem('theme',n);if(window.initNexus)window.initNexus()}btn?.addEventListener('click',()=>{const cur=document.documentElement.classList.contains('dark')?'dark':'light';setTheme(cur==='dark'?'light':'dark')});})();(function(){const c=document.getElementById('nexusCanvas');if(!c)return;const x=c.getContext('2d');let w,h,p=[];const n=innerWidth>1024?120:65;let dc,lc;window.initNexus=function(){const d=document.documentElement.classList.contains('dark');dc=d?'rgba(229,184,105,.38)':'rgba(0,90,43,.25)';lc=d?'rgba(229,184,105,.09)':'rgba(0,90,43,.08)'};function r(){w=c.width=innerWidth;h=c.height=innerHeight}function init(){p=[];for(let i=0;i<n;i++)p.push({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.45,vy:(Math.random()-.5)*.45,rr:Math.random()*1.8+1})}function a(){x.clearRect(0,0,w,h);p.forEach((q,i)=>{q.x+=q.vx;q.y+=q.vy;if(q.x<0||q.x>w)q.vx*=-1;if(q.y<0||q.y>h)q.vy*=-1;x.beginPath();x.arc(q.x,q.y,q.rr,0,Math.PI*2);x.fillStyle=dc;x.fill();for(let j=i+1;j<p.length;j++){const e=p[j],d=Math.hypot(q.x-e.x,q.y-e.y);if(d<120){x.beginPath();x.moveTo(q.x,q.y);x.lineTo(e.x,e.y);x.strokeStyle=lc;x.stroke()}}});requestAnimationFrame(a)}window.initNexus();r();init();a();addEventListener('resize',()=>{r();init()})})();</script>

  <script>
    (function lineageResolverInit(){
      const inputs=document.querySelectorAll('[data-lineage-resolver]');
      if(!inputs.length)return;
      const timers=new Map();
      function setFeedback(type,msg,state){
        const el=document.querySelector(`[data-lineage-feedback="${type}"]`); if(!el)return;
        el.textContent=msg;
        el.className='lineage-feedback block mt-2 text-xs font-bold '+(state==='ok'?'text-green-700 dark:text-green-300':state==='warn'?'text-amber-700 dark:text-amber-300':state==='bad'?'text-red-700 dark:text-red-300':'text-gray-500 dark:text-gray-400');
      }
      inputs.forEach(input=>input.addEventListener('input',()=>{
        const type=input.getAttribute('data-lineage-resolver'); clearTimeout(timers.get(input)); const q=input.value.trim();
        if(!q)return setFeedback(type,type==='father'?'يتم مطابقة الاسم الثلاثي وربط الطلب بالأب تلقائيًا عند الاعتماد.':'اختياري: إذا كانت الأم موجودة في الشجرة سيتم ربطها تلقائيًا عند الاعتماد.','normal');
        timers.set(input,setTimeout(async()=>{
          try{const res=await fetch('/api/person-lineage/resolve?q='+encodeURIComponent(q)); const data=await res.json(); const result=data.result||{};
            if(result.status==='matched')setFeedback(type,'تم العثور على: '+(result.match?.name||q)+' وسيتم الربط تلقائيًا.','ok');
            else if(result.status==='multiple')setFeedback(type,'يوجد أكثر من شخص بنفس التسلسل. يلزم مراجعة البيانات قبل الاعتماد.','warn');
            else setFeedback(type,result.message||'لم يتم العثور على هذا التسلسل داخل الشجرة.',type==='father'?'bad':'warn');
          }catch(e){setFeedback(type,'تعذر التحقق الآن، سيتم التحقق عند الاعتماد.','warn')}
        },350));
      }));
    })();
  </script>
  <script src="/address-fields.js"></script>
  <script src="/dual-calendar.js"></script>
