  <div class="flex items-center gap-3 p-6 border-b border-border-light dark:border-border-dark shrink-0"><div class="w-12 h-12 flex items-center justify-center rounded-2xl bg-primary dark:bg-accent text-white dark:text-black shadow-lg"><span class="material-symbols-outlined text-[28px]">shield_person</span></div><div><h1 class="font-display font-bold text-xl leading-none text-primary dark:text-white">عائلة خاشقجي</h1><p class="text-[10px] font-bold text-gray-500 dark:text-accent uppercase tracking-widest mt-1.5">نظام الإدارة المركزية</p></div></div>
  <nav class="flex-1 overflow-y-auto p-4 space-y-6">
