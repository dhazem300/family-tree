<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>لوحة الإدارة - تفاصيل مستخدم</title>

  <script src="/theme.js"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@300;400;500;700;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries,line-clamp"></script>

  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#005A2B",
            primaryDark: "#00361A",
            accent: "#E5B869",
            "bg-light": "#F5F3F7",
            "bg-dark": "#050505",
            "card-light": "rgba(255, 255, 255, 0.8)",
            "card-dark": "rgba(15, 12, 25, 0.8)",
            "border-light": "rgba(0, 90, 43, 0.1)",
            "border-dark": "rgba(229, 184, 105, 0.1)",
          },
          fontFamily: {
            display: ["'Aref Ruqaa'", "serif"],
            sans: ["Tajawal", "sans-serif"],
          },
        }
      }
    };
  </script>

  <style type="text/tailwindcss">
    @layer utilities {
      .scrollbar-hide::-webkit-scrollbar { display: none; }
      .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
      .glass-panel { @apply backdrop-blur-2xl shadow-xl; }
    }
  </style>

  <style>
    :root { color-scheme: light; }
    html.dark { color-scheme: dark; }
    html.theme-switching, html.theme-switching *, html.theme-switching *::before, html.theme-switching *::after {
      transition: none !important;
      animation-duration: 0s !important;
      animation-delay: 0s !important;
    }

    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #005A2B; border-radius: 10px; }
    html.dark ::-webkit-scrollbar-thumb { background: #E5B869; }

    #nexusCanvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
    }
    @media (max-width: 1023px) { #nexusCanvas { pointer-events: none !important; } }

    html.dark .dark-toggle-icon-moon { display: none; }
    html:not(.dark) .dark-toggle-icon-sun { display: none; }

    .admin-menu-toggle {
      position: fixed !important;
      width: 1px !important;
      height: 1px !important;
      opacity: 0 !important;
      pointer-events: none !important;
      clip: rect(0 0 0 0) !important;
    }
    #mobileNavBtn {
      cursor: pointer !important;
      -webkit-tap-highlight-color: transparent !important;
      touch-action: manipulation !important;
      position: relative !important;
      z-index: 10002 !important;
      pointer-events: auto !important;
    }
    #mobileNavOverlay {
      display: none !important;
      opacity: 0 !important;
      pointer-events: none !important;
      z-index: 10000 !important;
    }
    #mobileNavDrawer {
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      right: auto !important;
      transform: translateX(-115%) !important;
      pointer-events: none !important;
      z-index: 10001 !important;
      transition: transform .32s cubic-bezier(0.16, 1, 0.3, 1) !important;
      display: flex !important;
      visibility: visible !important;
      opacity: 1 !important;
      height: 100vh !important;
      max-height: 100vh !important;
    }
    #adminMenuToggle:checked ~ #mobileNavDrawer {
      transform: translateX(0) !important;
      pointer-events: auto !important;
    }
    #adminMenuToggle:checked ~ #mobileNavOverlay {
      display: block !important;
      opacity: 1 !important;
      pointer-events: auto !important;
    }
    @media (min-width: 1024px) {
      #adminMenuToggle,
      #mobileNavDrawer,
      #mobileNavOverlay { display: none !important; }
    }

    .bg-primary,
    a.bg-primary,
    button.bg-primary {
      background-color: #005A2B !important;
      background-image: none !important;
    }
    .dark .dark\:bg-accent,
    html.dark .dark\:bg-accent {
      background-color: #E5B869 !important;
      background-image: none !important;
    }
    [class*="bg-gradient"] { background-image: none !important; }

    .export-card {
      transition: transform .25s cubic-bezier(0.16, 1, 0.3, 1), border-color .25s ease, box-shadow .25s ease;
    }
    .export-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 18px 36px rgba(0, 90, 43, 0.08);
      border-color: rgba(0, 90, 43, 0.18) !important;
    }
    html.dark .export-card:hover {
      box-shadow: 0 18px 44px rgba(0, 0, 0, 0.65);
      border-color: rgba(229, 184, 105, 0.18) !important;
    }
    .interactive-row {
      transition: all .25s ease;
      border-right: 3px solid transparent;
    }
    .interactive-row:hover {
      background: #ffffff !important;
      border-right-color: #005A2B;
      transform: translateX(-3px);
      box-shadow: 0 10px 30px rgba(0, 90, 43, 0.08);
    }
    html.dark .interactive-row:hover {
      background: rgba(255,255,255,.04) !important;
      border-right-color: #E5B869;
      box-shadow: 0 10px 30px rgba(0,0,0,.55);
    }
    .export-panel {
      border: 1px solid rgba(0,90,43,0.10);
      background: rgba(255,255,255,0.82);
      -webkit-backdrop-filter: blur(24px);
      backdrop-filter: blur(24px);
      box-shadow: 0 18px 44px rgba(0,0,0,0.04);
    }
    html.dark .export-panel {
      border-color: rgba(229,184,105,0.10);
      background: rgba(15, 12, 25, 0.80);
      box-shadow: 0 18px 44px rgba(0,0,0,0.45);
    }
  </style>

  <script>
    (function () {
      const saved = localStorage.getItem("theme") || "dark";
      document.documentElement.setAttribute("data-theme", saved);
      document.documentElement.classList.toggle("dark", saved === "dark");
    })();
  </script>
</head>

<body class="bg-bg-light dark:bg-bg-dark text-gray-800 dark:text-gray-200 font-sans h-screen flex overflow-hidden selection:bg-accent selection:text-primaryDark">

  <%
    const adminUser = (typeof admin !== "undefined" && admin) ? admin : {};
    const isSuperAdmin = Number(adminUser?.is_super_admin || 0) === 1;
    const canUsers = typeof userCan === "function" && userCan("users");
    const canChats = typeof userCan === "function" && userCan("chats");
    const canRoles = typeof userCan === "function" && userCan("roles");
    const canBackups = typeof userCan === "function" && (userCan("backups") || isSuperAdmin);
    const canPersonRequests = typeof userCan === "function" && userCan("person_requests");
    const canTreeExports = typeof userCan === "function" && (userCan("persons") || userCan("backups") || isSuperAdmin);

    const detailUser = (typeof user !== "undefined" && user) ? user : {};
    const userStats = (typeof stats !== "undefined" && stats) ? stats : {};
    const activityLogs = (typeof activity !== "undefined" && Array.isArray(activity)) ? activity : [];
    const isChatBlocked = typeof chatBlock !== "undefined" && chatBlock;
    const linkedTreePerson = (typeof treePerson !== "undefined" && treePerson) ? treePerson : null;
    const linkedHonorItem = (typeof honorItem !== "undefined" && honorItem) ? honorItem : null;
    const approvalStatus = detailUser.approval_status || "approved";
    const verificationStatus = detailUser.verification_status || "unverified";
    const providerName = detailUser.provider || "email";
    const isActiveUser = Number(detailUser.is_active || 0) === 1;
    const displayName = detailUser.full_name || detailUser.email || "مستخدم";
    const avatarUrl = detailUser.avatar_url || "/assets/default-avatar.svg";
  %>

  <input id="adminMenuToggle" type="checkbox" class="admin-menu-toggle" aria-hidden="true" />

  <canvas id="nexusCanvas"></canvas>
  <div class="fixed inset-0 bg-gradient-to-b from-white/40 to-white/80 dark:from-black/40 dark:to-[#050505]/90 pointer-events-none z-[1]"></div>

  <aside class="relative z-20 hidden lg:flex flex-col w-[280px] h-[calc(100vh-2rem)] my-4 mx-4 bg-card-light dark:bg-card-dark glass-panel rounded-3xl border border-border-light dark:border-border-dark overflow-hidden shrink-0">
    <div class="flex items-center gap-3 p-6 border-b border-border-light dark:border-border-dark shrink-0">
      <div class="w-12 h-12 flex items-center justify-center rounded-2xl bg-primary dark:bg-accent text-white dark:text-black shadow-lg">
        <span class="material-symbols-outlined text-[28px]">shield_person</span>
      </div>
      <div>
        <h1 class="font-display font-bold text-xl leading-none text-primary dark:text-white">عائلة خاشقجي</h1>
        <p class="text-[10px] font-bold text-gray-500 dark:text-accent uppercase tracking-widest mt-1.5">نظام الإدارة المركزية</p>
      </div>
    </div>

    <nav class="flex-1 overflow-y-auto custom-scrollbar p-4 space-y-6">
      <div class="space-y-2">
        <p class="px-3 text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-3">نظرة عامة</p>
        <a href="/admin/dashboard" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          <span class="material-symbols-outlined text-[22px]">dashboard</span> لوحة الإحصائيات
        </a>
      </div>

      <div class="space-y-2">
        <p class="px-3 text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-3">إدارة العائلة والبيانات</p>
        <a href="/admin" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          <span class="material-symbols-outlined text-[22px]">group</span> إدارة الأفراد
        </a>
        <% if (canPersonRequests) { %>
        <a href="/admin/person-requests" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          <span class="material-symbols-outlined text-[22px]">fact_check</span> طلبات الأفراد
        </a>
        <% } %>
        <a href="/admin/pages" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          <span class="material-symbols-outlined text-[22px]">history_edu</span> إدارة الصفحات
        </a>
        <a href="/admin/honor" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          <span class="material-symbols-outlined text-[22px]">workspace_premium</span> السير الذاتية
        </a>
        <a href="/admin/news" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          <span class="material-symbols-outlined text-[22px]">newspaper</span> الأخبار والمناسبات
        </a>
      </div>

      <div class="space-y-2">
        <p class="px-3 text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-3">المستخدمون والتواصل</p>
        <% if (canUsers) { %>
        <a href="/admin/users" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl bg-primary/10 dark:bg-accent/10 text-primary dark:text-accent font-bold text-sm border border-primary/20 dark:border-accent/20 transition-all relative overflow-hidden shadow-sm">
          <div class="absolute right-0 top-1/2 -translate-y-1/2 w-1.5 h-6 rounded-l-full bg-primary dark:bg-accent shadow-[0_0_10px_rgba(229,184,105,0.8)]"></div>
          <span class="material-symbols-outlined text-[22px]">groups</span> مستخدمي الموقع
        </a>
        <% } %>
        <% if (canChats) { %>
        <a href="/admin/chats" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          <span class="material-symbols-outlined text-[22px]">forum</span> إدارة المحادثات
        </a>
        <% } %>
        <% if (canTreeExports) { %>
        <a href="/admin/tree-exports" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          <span class="material-symbols-outlined text-[22px]">file_export</span> سجل تصدير الشجرة
        </a>
        <% } %>
        <a href="/admin/support-messages" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          <span class="material-symbols-outlined text-[22px]">mail</span> رسائل الدعم
        </a>
      </div>

      <div class="space-y-2">
        <p class="px-3 text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-3">النظام والصلاحيات</p>
        <% if (canRoles) { %>
        <a href="/admin/roles" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          <span class="material-symbols-outlined text-[22px]">manage_accounts</span> وظائف الأفراد
        </a>
        <% } %>
        <% if (isSuperAdmin) { %>
        <a href="/admin/activity" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          <span class="material-symbols-outlined text-[22px]">manage_history</span> سجل النشاط
        </a>
        <% } %>
        <a href="/admin/approvals" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          <span class="material-symbols-outlined text-[22px]">verified_user</span> مركز الموافقة
        </a>
        <% if (isSuperAdmin) { %>
        <a href="/admin/maintenance" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          <span class="material-symbols-outlined text-[22px]">construction</span> وضع الصيانة
        </a>
        <% } %>
        <% if (canBackups) { %>
        <a href="/admin/backups" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          <span class="material-symbols-outlined text-[22px]">backup</span> النسخ الاحتياطي
        </a>
        <% } %>
      </div>
    </nav>

    <div class="p-4 border-t border-border-light dark:border-border-dark shrink-0 m-2 rounded-2xl bg-white/50 dark:bg-black/30">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-cover bg-center border border-gray-200 dark:border-white/10 shadow-sm" style="background-image:url('/assets/default-avatar.svg'); background-color: #ddd;"></div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-bold text-gray-900 dark:text-white truncate"><%= adminUser?.username || "مدير النظام" %></p>
          <p class="text-[10px] text-primary dark:text-accent uppercase tracking-widest mt-0.5 font-bold">Admin</p>
        </div>
        <form method="post" action="/admin/logout" class="m-0">
          <button type="submit" class="w-9 h-9 flex items-center justify-center rounded-xl bg-red-50 dark:bg-red-500/10 text-red-500 hover:bg-red-500 hover:text-white transition-all shadow-sm" title="تسجيل خروج">
            <span class="material-symbols-outlined text-[18px]">logout</span>
          </button>
        </form>
      </div>
    </div>
  </aside>

  <main class="flex-1 flex flex-col min-w-0 h-full relative z-10">
    <header class="flex items-center justify-between p-4 lg:p-8 shrink-0 gap-4">
      <div class="flex items-center gap-3 min-w-0">
        <label id="mobileNavBtn" for="adminMenuToggle" class="lg:hidden flex items-center justify-center w-12 h-12 rounded-2xl bg-card-light dark:bg-card-dark glass-panel border border-border-light dark:border-border-dark text-primary dark:text-accent shadow-sm cursor-pointer" aria-controls="mobileNavDrawer" aria-label="فتح القائمة">
          <span class="material-symbols-outlined text-[24px]">menu</span>
        </label>

        <div class="min-w-0">
          <h2 class="text-2xl md:text-3xl font-display font-bold text-primary dark:text-white tracking-tight leading-none mb-1.5">تفاصيل مستخدم</h2>
          <div class="flex items-center gap-1.5 text-gray-500 text-[11px] font-bold uppercase tracking-widest">
            <span>لوحة الإدارة</span>
            <span class="material-symbols-outlined text-[14px]">chevron_left</span>
            <span>المستخدمون والتواصل</span>
            <span class="material-symbols-outlined text-[14px]">chevron_left</span>
            <span class="text-accent">مستخدمي الموقع</span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3 shrink-0 overflow-x-auto scrollbar-hide max-w-full">
        <button id="themeBtn" class="flex items-center justify-center w-12 h-12 rounded-2xl bg-card-light dark:bg-card-dark glass-panel border border-border-light dark:border-border-dark text-gray-600 dark:text-accent shadow-sm hover:-translate-y-1 transition-transform shrink-0" type="button" title="تبديل المظهر">
          <span class="material-symbols-outlined text-[22px] dark-toggle-icon-moon">dark_mode</span>
          <span class="material-symbols-outlined hidden dark:block text-[24px] dark-toggle-icon-sun">light_mode</span>
        </button>
        <a href="/admin/users" class="flex items-center gap-2 px-6 h-12 rounded-2xl font-bold text-sm bg-card-light dark:bg-card-dark glass-panel border border-border-light dark:border-border-dark text-primary dark:text-accent shadow-sm hover:-translate-y-1 transition-transform shrink-0">
          <span class="material-symbols-outlined text-[22px]">arrow_back</span>
          <span class="hidden sm:inline">رجوع للمستخدمين</span>
        </a>
        <a href="/admin/dashboard" class="hidden sm:flex items-center gap-2 px-6 h-12 rounded-2xl font-bold text-sm bg-primary dark:bg-accent text-white dark:text-black shadow-sm hover:-translate-y-1 transition-transform shrink-0">
          <span class="material-symbols-outlined text-[22px]">dashboard</span>
          <span class="hidden sm:inline">الإحصائيات</span>
        </a>
      </div>
    </header>

    <div class="flex-1 overflow-y-auto custom-scrollbar px-4 lg:px-8 pb-12">
      <div class="max-w-[100rem] mx-auto space-y-8">

        <section class="export-panel rounded-[2rem] overflow-hidden">
          <div class="p-6 md:p-8 flex flex-col xl:flex-row xl:items-center justify-between gap-6">
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5 min-w-0">
              <div class="relative shrink-0">
                <img loading="lazy" decoding="async" src="<%= avatarUrl %>" onerror="this.src='/assets/default-avatar.svg'" class="w-24 h-24 rounded-[1.75rem] object-cover border-2 border-accent shadow-lg bg-white dark:bg-black" alt="صورة المستخدم">
                <span class="absolute -bottom-2 -left-2 w-10 h-10 rounded-2xl flex items-center justify-center <%= isActiveUser ? 'bg-green-600 text-white' : 'bg-red-600 text-white' %> shadow-lg">
                  <span class="material-symbols-outlined text-[21px]"><%= isActiveUser ? 'check_circle' : 'block' %></span>
                </span>
              </div>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2 mb-3">
                  <span class="px-3 py-1 rounded-full bg-primary/10 dark:bg-accent/10 text-primary dark:text-accent text-xs font-black"><%= approvalStatus %></span>
                  <span class="px-3 py-1 rounded-full bg-white/70 dark:bg-white/5 border border-black/5 dark:border-white/10 text-xs font-black"><%= verificationStatus %></span>
                  <span class="px-3 py-1 rounded-full <%= isChatBlocked ? 'bg-red-100 text-red-700 dark:bg-red-500/10 dark:text-red-300' : 'bg-green-100 text-green-700 dark:bg-green-500/10 dark:text-green-300' %> text-xs font-black"><%= isChatBlocked ? 'محظور من الشات' : 'الشات متاح' %></span>
                </div>
                <h1 class="font-display text-3xl md:text-5xl text-primary dark:text-accent font-bold leading-tight truncate"><%= displayName %></h1>
                <p class="mt-2 text-gray-500 dark:text-gray-400 font-bold" dir="ltr"><%= detailUser.email || '—' %></p>
              </div>
            </div>

            <div class="flex flex-wrap gap-2 shrink-0">
              <% if (approvalStatus !== 'approved') { %>
                <form method="post" action="/admin/users/<%= detailUser.id %>/approval" class="m-0">
                  <input type="hidden" name="action" value="approve">
                  <button class="inline-flex items-center gap-2 px-5 h-12 rounded-2xl bg-green-600 text-white font-black shadow-sm hover:-translate-y-1 transition-transform">
                    <span class="material-symbols-outlined text-[20px]">verified</span> قبول الحساب
                  </button>
                </form>
              <% } %>
              <form method="post" action="/admin/users/<%= detailUser.id %>/toggle" class="m-0" onsubmit="return confirm('تأكيد تغيير حالة المستخدم؟')">
                <button class="inline-flex items-center gap-2 px-5 h-12 rounded-2xl font-black shadow-sm hover:-translate-y-1 transition-transform <%= isActiveUser ? 'bg-red-600 text-white' : 'bg-green-600 text-white' %>">
                  <span class="material-symbols-outlined text-[20px]"><%= isActiveUser ? 'person_off' : 'person_check' %></span>
                  <%= isActiveUser ? 'إيقاف الحساب' : 'تفعيل الحساب' %>
                </button>
              </form>
              <% if (isChatBlocked) { %>
