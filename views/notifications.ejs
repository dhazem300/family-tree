<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>الإشعارات | شجرة العائلة</title>

  <script src="/theme.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=Aref+Ruqaa:wght@400;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries,line-clamp"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            primary: '#005A2B',
            primaryDark: '#003D1D',
            accent: '#E5B869',
            'accent-gold': '#E5B869',
            'background-light': '#F8F8F6',
            'bg-charcoal': '#050505',
            'text-cream': '#FAFAFA'
          },
          fontFamily: {
            sans: ['Tajawal','sans-serif'],
            display: ["'Aref Ruqaa'", 'serif']
          },
          boxShadow: {
            luxury: '0 20px 40px -10px rgba(0,0,0,0.06), 0 0 20px rgba(229,184,105,0.04)',
            'luxury-dark': '0 24px 50px -10px rgba(0,0,0,0.50), 0 0 24px rgba(229,184,105,0.05)',
            glow: '0 0 18px rgba(229,184,105,0.35)'
          },
          backgroundImage: {
            'islamic-pattern': "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E5B869' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")"
          }
        }
      }
    };
  </script>

  <style type="text/tailwindcss">
    @layer utilities {
      .glass-panel { @apply bg-white/85 dark:bg-[#080808]/85 backdrop-blur-xl border border-accent-gold/20 shadow-luxury dark:shadow-luxury-dark; }
      .lux-card { @apply bg-white/90 dark:bg-[#0A0A0A]/90 border border-accent-gold/15 shadow-luxury dark:shadow-luxury-dark; }
    }
  </style>

  <style>
    ::-webkit-scrollbar{width:5px;height:5px}
    ::-webkit-scrollbar-track{background:transparent}
    ::-webkit-scrollbar-thumb{background:rgba(229,184,105,.45);border-radius:999px}
    .notification-row{transition:transform .28s cubic-bezier(.16,1,.3,1), border-color .28s, background .28s, box-shadow .28s;}
    .notification-row:hover{transform:translateY(-2px);box-shadow:0 16px 34px rgba(0,0,0,.07)}
    html.dark .notification-row:hover{box-shadow:0 18px 42px rgba(0,0,0,.55)}
    .notification-row.unread{position:relative;}
    .notification-row.unread:before{content:"";position:absolute;inset-inline-start:0;top:18px;bottom:18px;width:4px;border-radius:999px;background:#E5B869;box-shadow:0 0 18px rgba(229,184,105,.45)}
  </style>
</head>

<body class="bg-background-light dark:bg-bg-charcoal text-gray-900 dark:text-text-cream font-sans min-h-screen relative overflow-x-hidden selection:bg-accent-gold/30 selection:text-gray-900 dark:selection:text-white transition-colors duration-400">
  <%- include('partials/header', {active, siteUser, pageTitle:'الإشعارات', pageSubtitle:'كل تنبيهات حسابك داخل الموقع'}) %>

  <main class="relative z-10 max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 space-y-8">
    <section class="relative overflow-hidden rounded-[2rem] lux-card p-6 md:p-8">
      <div class="absolute inset-0 bg-islamic-pattern opacity-40 dark:opacity-10 pointer-events-none"></div>
      <div class="absolute -top-24 -left-24 w-72 h-72 rounded-full bg-accent-gold/10 blur-3xl pointer-events-none"></div>
      <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
        <div class="flex items-start gap-4">
          <div class="w-16 h-16 rounded-2xl bg-primary dark:bg-accent-gold text-white dark:text-[#050505] flex items-center justify-center shadow-glow shrink-0">
            <span class="material-symbols-outlined text-[34px]">notifications</span>
          </div>
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/5 dark:bg-accent-gold/10 text-primary dark:text-accent-gold font-black text-[11px] mb-3">
              <span class="material-symbols-outlined text-[16px]">verified</span>
              مركز التنبيهات
            </div>
            <h1 class="font-display text-4xl md:text-5xl font-bold text-primary dark:text-accent-gold leading-tight">الإشعارات</h1>
            <p class="mt-3 text-gray-500 dark:text-gray-400 font-semibold leading-7 max-w-2xl">
              تابع رسائل النظام، قبول الطلبات، تنبيهات الحساب، وتحديثات العائلة من مكان واحد.
            </p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <a href="/account" class="inline-flex items-center justify-center gap-2 h-12 px-5 rounded-2xl border border-accent-gold/25 text-primary dark:text-accent-gold bg-white/70 dark:bg-white/5 hover:border-accent-gold font-black transition-all hover:-translate-y-0.5">
            <span class="material-symbols-outlined text-[20px]">account_circle</span>
            حسابي
          </a>
          <form method="post" action="/notifications/read-all" class="m-0">
            <button class="w-full sm:w-auto inline-flex items-center justify-center gap-2 h-12 px-6 rounded-2xl bg-primary dark:bg-accent-gold text-white dark:text-[#050505] font-black shadow-lg hover:scale-[1.02] active:scale-[0.98] transition-transform" type="submit">
              <span class="material-symbols-outlined text-[20px]">done_all</span>
              تحديد الكل كمقروء
            </button>
          </form>
        </div>
      </div>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="rounded-[1.5rem] lux-card p-5 flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-primary/10 dark:bg-accent-gold/10 text-primary dark:text-accent-gold flex items-center justify-center">
          <span class="material-symbols-outlined">mark_email_unread</span>
        </div>
        <div>
          <p class="text-[11px] text-gray-400 font-black uppercase tracking-widest">غير مقروء</p>
          <p class="text-3xl font-black text-primary dark:text-accent-gold leading-none mt-1"><%= notifications.filter(n => !Number(n.is_read)).length %></p>
        </div>
      </div>
      <div class="rounded-[1.5rem] lux-card p-5 flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-accent-gold/15 text-[#9A6A12] dark:text-accent-gold flex items-center justify-center">
          <span class="material-symbols-outlined">notifications_active</span>
        </div>
        <div>
          <p class="text-[11px] text-gray-400 font-black uppercase tracking-widest">إجمالي الإشعارات</p>
          <p class="text-3xl font-black text-gray-900 dark:text-white leading-none mt-1"><%= notifications.length %></p>
        </div>
      </div>
      <div class="rounded-[1.5rem] lux-card p-5 flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-green-100 dark:bg-green-500/10 text-green-700 dark:text-green-400 flex items-center justify-center">
          <span class="material-symbols-outlined">task_alt</span>
        </div>
        <div>
          <p class="text-[11px] text-gray-400 font-black uppercase tracking-widest">مقروء</p>
          <p class="text-3xl font-black text-gray-900 dark:text-white leading-none mt-1"><%= notifications.filter(n => Number(n.is_read)).length %></p>
        </div>
      </div>
    </section>

    <section class="rounded-[2rem] lux-card overflow-hidden">
      <div class="px-5 md:px-7 py-5 border-b border-accent-gold/15 flex items-center justify-between gap-3 bg-white/50 dark:bg-white/[0.03]">
        <div>
          <h2 class="font-display text-2xl font-bold text-primary dark:text-accent-gold">آخر التنبيهات</h2>
          <p class="text-sm text-gray-500 dark:text-gray-400 font-semibold mt-1">اضغط على أي إشعار للانتقال إلى الصفحة المرتبطة به.</p>
        </div>
        <% if (notifications.length) { %>
          <span class="hidden sm:inline-flex items-center gap-2 px-4 h-10 rounded-full bg-primary/5 dark:bg-accent-gold/10 text-primary dark:text-accent-gold font-black text-xs">
            <span class="material-symbols-outlined text-[18px]">update</span>
            <%= notifications.length %> إشعار
          </span>
        <% } %>
      </div>

      <% if (!notifications.length) { %>
        <div class="p-10 md:p-14 text-center">
          <div class="mx-auto w-20 h-20 rounded-[1.5rem] bg-primary/5 dark:bg-accent-gold/10 text-primary dark:text-accent-gold flex items-center justify-center mb-5">
            <span class="material-symbols-outlined text-[42px]">notifications_off</span>
          </div>
          <h3 class="font-display text-3xl font-bold text-primary dark:text-accent-gold">لا توجد إشعارات حاليًا</h3>
          <p class="mt-3 text-gray-500 dark:text-gray-400 font-semibold leading-7">عند وصول تنبيهات جديدة ستظهر هنا بشكل مرتب وواضح.</p>
        </div>
      <% } else { %>
        <div class="divide-y divide-gray-100 dark:divide-white/10">
          <% notifications.forEach(n => { 
               const isRead = Number(n.is_read) === 1;
               const href = n.url || '#';
          %>
            <a href="<%= href %>" class="notification-row <%= isRead ? '' : 'unread bg-primary/5 dark:bg-accent-gold/10' %> block p-5 md:p-6 hover:bg-white dark:hover:bg-white/[0.04]">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-2xl <%= isRead ? 'bg-gray-100 dark:bg-white/5 text-gray-400' : 'bg-primary dark:bg-accent-gold text-white dark:text-[#050505]' %> flex items-center justify-center shrink-0 shadow-sm">
                  <span class="material-symbols-outlined text-[24px]"><%= isRead ? 'notifications' : 'notification_important' %></span>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2">
                    <h3 class="font-black text-lg <%= isRead ? 'text-gray-900 dark:text-white' : 'text-primary dark:text-accent-gold' %> leading-7">
                      <%= n.title || 'إشعار' %>
                    </h3>
                    <div class="flex items-center gap-2 shrink-0">
                      <% if (!isRead) { %>
                        <span class="inline-flex items-center px-2.5 h-7 rounded-full bg-accent-gold text-[#050505] font-black text-[11px]">جديد</span>
                      <% } %>
                      <span class="text-xs text-gray-400 font-bold" dir="ltr"><%= n.created_at || '' %></span>
                    </div>
                  </div>
                  <p class="mt-2 text-sm md:text-[15px] text-gray-600 dark:text-gray-300 leading-7 line-clamp-3"><%= n.body || '' %></p>
                </div>
                <span class="material-symbols-outlined text-gray-300 dark:text-gray-600 mt-3 shrink-0">chevron_left</span>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>

  <script src="/chat-notifications.js"></script>
</body>
</html>
