  </main>

  <footer class="bg-background-light dark:bg-[#050505] border-t border-gray-200 dark:border-white/5 mt-auto py-8 relative z-10">
    <div class="max-w-[90rem] mx-auto px-6 text-center flex flex-col items-center gap-3">
      <p class="text-[11px] font-sans font-semibold text-gray-400 dark:text-gray-600 uppercase tracking-widest">
        © ٢٠٢٦ وقف عائلة خاشقجي. جميع الحقوق محفوظة. حفظ الأنساب والاحتفاء بالتراث.
      </p>
    </div>
  </footer>

  <script>
    (function () {
      const btn = document.getElementById("uiThemeBtn");
      function applyTheme(next) {
        document.documentElement.setAttribute("data-theme", next);
        document.documentElement.classList.toggle("dark", next === "dark");
        localStorage.setItem("theme", next);
      }
      btn?.addEventListener("click", () => {
        const current = document.documentElement.getAttribute("data-theme") || "dark";
        applyTheme(current === "dark" ? "light" : "dark");
      });
      applyTheme(localStorage.getItem("theme") || "dark");
    })();

    (function mobileNavInit(){
      const btn = document.getElementById("mobileNavBtn");
      const navDrawer = document.getElementById("mobileNavDrawer");
      const overlay = document.getElementById("mobileNavOverlay");
      const closeBtn = document.getElementById("mobileNavClose");

      function setOpenState(isOpen){
        btn?.setAttribute("data-open", isOpen ? "true" : "false");
        btn?.setAttribute("aria-expanded", isOpen ? "true" : "false");
      }

      function openNav(){
        overlay?.classList.remove("hidden");
        overlay?.style.setProperty('display', 'block', 'important');
        navDrawer?.classList.add("isOpen");
        setOpenState(true);
        document.body.classList.add('overflow-hidden');
      }
      function closeNav(){
        navDrawer?.classList.remove("isOpen");
        overlay?.classList.add("hidden");
        overlay?.style.setProperty('display', 'none', 'important');
        setOpenState(false);
        document.body.classList.remove('overflow-hidden');
      }

      btn?.addEventListener("click", () => {
        const open = btn.getAttribute("data-open") === "true";
        open ? closeNav() : openNav();
      });

      closeBtn?.addEventListener("click", closeNav);
      overlay?.addEventListener("click", closeNav);
      navDrawer?.querySelectorAll("a").forEach(a => a.addEventListener("click", closeNav));
      window.addEventListener("keydown", (e) => { if (e.key === "Escape") closeNav(); });

      setOpenState(false);
    })();
  </script>

  <script>
    const THREAD_ID = <%= Number(thread.id) %>;
    const ME_ID = <%= Number(siteUser.id) %>;
    const API_URL = `/api/chat/threads/${THREAD_ID}/messages`;
    let sending = false;
    let recorder = null;
    let chunks = [];
    let recordedBlob = null;
    let recordedName = '';
    let editingMessageId = null;
    let lastRenderedSignature = '';
    let recTimerInt = null;

    const messagesEl = document.getElementById('messages');
    const form = document.getElementById('chatForm');
    const bodyEl = document.getElementById('body');
    const fileEl = document.getElementById('chatFile');
    const filePreview = document.getElementById('filePreview');
    const filePreviewText = document.getElementById('filePreviewText').querySelector('span:last-child');
    const clearFileBtn = document.getElementById('clearFile');
    const errorBox = document.getElementById('errorBox');
    const recordBtn = document.getElementById('recordBtn');
    const attachBtn = document.getElementById('attachBtn');
    const emojiBtn = document.getElementById('emojiBtn');
    const emojiBar = document.getElementById('emojiBar');
    const editBox = document.getElementById('editBox');
    const cancelEditBtn = document.getElementById('cancelEdit');
    const scrollDownBtn = document.getElementById('scrollDownBtn');
    const recordingIndicator = document.getElementById('recordingIndicator');
    const recTimerEl = document.getElementById('recTimer');

    function escapeHtml(v){return String(v ?? '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));}
    function showError(msg){errorBox.textContent = msg || 'حدث خطأ'; errorBox.classList.remove('hidden'); setTimeout(()=>errorBox.classList.add('hidden'), 5000);}
    function bottom(){messagesEl.scrollTop = messagesEl.scrollHeight;}
    function messageSignature(messages){return messages.map(m => `${m.id}:${m.body || ''}:${m.edited_at || ''}:${m.attachment_url || ''}:${m.read_by_others || 0}`).join('|');}

    function renderAttachment(m){
      if(!m.attachment_url) return '';
      if(m.message_type === 'image') return `<a href="${escapeHtml(m.attachment_url)}" target="_blank"><img src="${escapeHtml(m.attachment_url)}" class="mt-2.5 max-h-72 rounded-lg object-contain border border-black/5 dark:border-white/5 bg-black/5" /></a>`;
      if(m.message_type === 'audio') return `<audio controls src="${escapeHtml(m.attachment_url)}" class="mt-2.5 w-full min-w-[240px] rounded-full"></audio>`;
      return `<a href="${escapeHtml(m.attachment_url)}" target="_blank" class="mt-2.5 inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-black/5 dark:bg-white/5 hover:bg-black/10 dark:hover:bg-white/10 transition-colors font-sans font-bold text-[13px] border border-black/5 dark:border-white/5"><span class="material-symbols-outlined text-[18px] text-accent">draft</span>${escapeHtml(m.attachment_name || 'ملف مرفق')}</a>`;
    }

    function emptyState(){
      const div = document.createElement('div');
      div.className = 'h-full w-full flex flex-col items-center justify-center text-center px-6 select-none relative z-10';
      div.innerHTML = `
        <div class="w-px h-12 bg-gradient-to-b from-transparent via-accent to-transparent mb-6"></div>
        <div class="w-20 h-20 rounded-full bg-white dark:bg-[#111] border border-gray-200 dark:border-white/5 text-primary dark:text-accent flex items-center justify-center mb-5 shadow-luxury dark:shadow-luxury-dark">
          <span class="material-symbols-outlined text-[40px]">forum</span>
        </div>
        <p class="font-display text-2xl md:text-3xl font-bold text-primary dark:text-white mb-2">ابدأ المحادثة</p>
        <p class="mt-2 text-[14px] md:text-[15px] font-sans font-medium text-gray-500 dark:text-gray-400 max-w-sm leading-relaxed">لا توجد رسائل بعد. اكتب أول رسالة وافتح باب الكلام بين أفراد العائلة.</p>`;
      return div;
    }

    function addMessage(m, grouped){
      const isMe = Number(m.sender_user_id) === ME_ID;
      const canEdit = isMe && !m.is_deleted;
      const canReport = !isMe && !m.is_deleted;
      
      const wrap = document.createElement('div');
      // في RTL: justify-start = اليمين (الآخرون) ، justify-end = اليسار (أنا)
      wrap.className = `msg-row flex w-full ${grouped ? 'mt-1' : 'mt-4'} ${isMe ? 'justify-end msg-me' : 'justify-start msg-other'}`;
      wrap.dataset.messageId = m.id;

      const showName = !isMe && !grouped;
      const showAvatar = !isMe;

      // إضافة الصورة الشخصية للمتحدث بدعم Fallback موثوق
      const imgUrl = escapeHtml(m.sender_photo_url || m.sender_avatar || '/assets/default-avatar.svg');
      const avatarHtml = showAvatar
        ? `<div class="shrink-0 ml-3 w-9 h-9 sm:w-10 sm:h-10 relative flex items-center justify-center">
             ${!grouped ? `
               <div class="absolute inset-0 flex items-center justify-center bg-gray-100 dark:bg-[#111] rounded-full z-0 border border-gray-200 dark:border-white/5 shadow-sm">
                 <span class="material-symbols-outlined text-[18px] text-gray-400">person</span>
               </div>
               <img title="${escapeHtml(m.sender_name)}" src="${imgUrl}" class="w-full h-full rounded-full object-cover relative z-10 border border-white dark:border-[#0A0A0A] shadow-sm" onerror="this.style.display='none';">
             ` : ''}
           </div>`
        : '';

      wrap.innerHTML = `
        <div class="bubble flex items-start ${isMe ? 'flex-row-reverse' : 'flex-row'} max-w-[88%] sm:max-w-[75%]">
          ${avatarHtml}
          <div class="flex flex-col min-w-0">
            <div class="wa-bubble ${isMe ? 'wa-bubble-me' : 'wa-bubble-other'} ${grouped ? 'is-grouped' : ''}">
              ${showName ? `<div class="text-[13px] font-bold text-primary dark:text-accent mb-1 tracking-wide">${escapeHtml(m.sender_name)}</div>` : ''}
              ${m.body ? `<div class="message-body whitespace-pre-wrap leading-relaxed text-[15px] break-words">${escapeHtml(m.body)}</div>` : ''}
              ${renderAttachment(m)}
              <div class="msg-meta-inline">
                <span>${escapeHtml(m.created_at || 'الآن')}</span>
                ${m.edited_at ? '<span>• معدلة</span>' : ''}
                ${isMe ? `<span class="material-symbols-outlined text-[16px] ${m.read_by_others ? 'wa-tick-read' : 'wa-tick-unread'}">${m.read_by_others ? 'done_all' : 'check'}</span>` : ''}
              </div>
              <div class="clear-both"></div>
              ${canEdit || canReport ? `
                <div class="mt-2 pt-2 border-t ${isMe ? 'border-primary/10 dark:border-white/10' : 'border-gray-100 dark:border-white/5'} flex gap-3 text-[11px] font-bold opacity-70 transition-opacity hover:opacity-100">
                  ${canEdit ? `<button type="button" data-edit-id="${Number(m.id)}" data-edit-body="${escapeHtml(m.body || '')}" class="hover:text-accent transition-colors flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">edit</span>تعديل</button>` : ''}
                  ${canReport ? `<button type="button" data-report-id="${Number(m.id)}" class="hover:text-red-500 transition-colors flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">flag</span>إبلاغ</button>` : ''}
                </div>
              ` : ''}
            </div>
          </div>
        </div>`;
      messagesEl.appendChild(wrap);
    }

    function renderMessages(messages){
      const sig = messageSignature(messages);
      if(sig === lastRenderedSignature) return;
      const shouldScroll = messagesEl.scrollTop + messagesEl.clientHeight >= messagesEl.scrollHeight - 140;
      messagesEl.innerHTML = '';

      if(!messages.length){
        messagesEl.appendChild(emptyState());
        lastRenderedSignature = sig;
        updateScrollBtn();
        return;
      }

      let prevSender = null;
      for(const m of messages){
        const grouped = Number(m.sender_user_id) === prevSender;
        addMessage(m, grouped);
        prevSender = Number(m.sender_user_id);
      }
      lastRenderedSignature = sig;
      if(shouldScroll) bottom();
      updateScrollBtn();
    }

    async function loadMessages(){
      try{
        const r = await fetch(`${API_URL}?refresh=1&limit=300`, {cache:'no-store'});
        const data = await r.json();
        if(!data.ok) return;
        if(data.locked){bodyEl.placeholder='الشات مغلق مؤقتًا بواسطة الإدارة'; bodyEl.disabled=true;}
        renderMessages(data.messages || []);
      }catch(e){}
    }

    function updatePreview(){
      if(editingMessageId){filePreview.classList.add('hidden'); return;}
      if(recordedBlob){filePreviewText.textContent = 'تم تسجيل رسالة صوتية جاهزة للإرسال'; filePreview.classList.remove('hidden'); return;}
      if(fileEl.files && fileEl.files[0]){filePreviewText.textContent = `ملف مرفق: ${fileEl.files[0].name}`; filePreview.classList.remove('hidden'); return;}
      filePreview.classList.add('hidden');
    }

    function clearAttachment(){
      fileEl.value=''; recordedBlob=null; recordedName=''; updatePreview();
    }

    function startEdit(id, currentBody){
      editingMessageId = Number(id);
      bodyEl.value = currentBody || '';
      bodyEl.focus();
      bodyEl.style.height='auto'; bodyEl.style.height=Math.min(bodyEl.scrollHeight,128)+'px';
      editBox.classList.remove('hidden');
      attachBtn.disabled = true; recordBtn.disabled = true;
      attachBtn.classList.add('opacity-40','cursor-not-allowed'); recordBtn.classList.add('opacity-40','cursor-not-allowed');
      fileEl.value=''; recordedBlob=null; recordedName=''; updatePreview();
    }
    function cancelEdit(){
      editingMessageId = null;
      bodyEl.value=''; bodyEl.style.height='auto';
      editBox.classList.add('hidden');
      attachBtn.disabled = false; recordBtn.disabled = false;
      attachBtn.classList.remove('opacity-40','cursor-not-allowed'); recordBtn.classList.remove('opacity-40','cursor-not-allowed');
    }

    document.addEventListener('click', (e)=>{
      const btn = e.target.closest('[data-edit-id]');
      if(!btn) return;
      startEdit(btn.dataset.editId, btn.dataset.editBody || '');
    });
    document.addEventListener('click', async (e)=>{
      const btn = e.target.closest('[data-report-id]');
      if(!btn) return;
      const reason = prompt('اكتب سبب البلاغ للإدارة:', 'محتوى غير مناسب');
      if(reason === null) return;
      try{
        const r = await fetch(`/api/chat/messages/${btn.dataset.reportId}/report`, {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({reason})});
        const data = await r.json();
        showError(data.message || (data.ok ? 'تم إرسال البلاغ' : 'تعذر إرسال البلاغ'));
      }catch(err){ showError('تعذر إرسال البلاغ.'); }
    });

    cancelEditBtn.addEventListener('click', cancelEdit);
    clearFileBtn.addEventListener('click', clearAttachment);
    attachBtn.addEventListener('click',()=>{ if(!editingMessageId) fileEl.click(); });
    fileEl.addEventListener('change',()=>{recordedBlob=null; recordedName=''; updatePreview();});

    emojiBtn.addEventListener('click',()=>{ emojiBar.classList.toggle('hidden'); });
    document.querySelectorAll('.emoji').forEach(btn=>btn.addEventListener('click',()=>{ bodyEl.value += btn.textContent; bodyEl.focus(); }));

    bodyEl.addEventListener('input',()=>{bodyEl.style.height='auto'; bodyEl.style.height=Math.min(bodyEl.scrollHeight,128)+'px';});

    function startRecTimer(){
      let s = 0;
      recTimerEl.textContent = '0:00';
      recordingIndicator.classList.remove('hidden');
      recTimerInt = setInterval(()=>{
        s++;
        const mm = Math.floor(s/60), ss = String(s%60).padStart(2,'0');
        recTimerEl.textContent = `${mm}:${ss}`;
      }, 1000);
    }
    function stopRecTimer(){
      if(recTimerInt){ clearInterval(recTimerInt); recTimerInt = null; }
      recordingIndicator.classList.add('hidden');
    }

    recordBtn.addEventListener('click', async ()=>{
      if(editingMessageId) return;
      try{
        if(recorder && recorder.state === 'recording') { recorder.stop(); recordBtn.classList.remove('text-red-500', 'bg-red-50', 'dark:bg-red-500/10'); stopRecTimer(); return; }
        const stream = await navigator.mediaDevices.getUserMedia({audio:true});
        chunks=[]; recorder = new MediaRecorder(stream);
        recorder.ondataavailable = e => { if(e.data.size) chunks.push(e.data); };
        recorder.onstop = () => { recordedBlob = new Blob(chunks, {type:'audio/webm'}); recordedName = `voice-${Date.now()}.webm`; stream.getTracks().forEach(t=>t.stop()); fileEl.value=''; updatePreview(); };
        recorder.start(); recordBtn.classList.add('text-red-500', 'bg-red-50', 'dark:bg-red-500/10'); startRecTimer();
      }catch(e){ showError('المتصفح لم يسمح باستخدام الميكروفون.'); stopRecTimer(); }
    });

    form.addEventListener('submit', async (e)=>{
      e.preventDefault(); if(sending) return; sending=true;
      try{
        if(editingMessageId){
          const r = await fetch(`/api/chat/messages/${editingMessageId}/edit`, {
            method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({body: bodyEl.value || ''})
          });
          const data = await r.json();
          if(!data.ok){ showError(data.message); return; }
          cancelEdit();
          lastRenderedSignature = '';
          await loadMessages();
          return;
        }
        const fd = new FormData(); fd.append('body', bodyEl.value || '');
        if(recordedBlob) fd.append('chat_file', recordedBlob, recordedName || 'voice.webm'); else if(fileEl.files && fileEl.files[0]) fd.append('chat_file', fileEl.files[0]);
        const r = await fetch(API_URL, {method:'POST', body:fd}); const data = await r.json();
        if(!data.ok){ showError(data.message); return; }
        bodyEl.value=''; bodyEl.style.height='auto'; fileEl.value=''; recordedBlob=null; recordedName=''; updatePreview();
        emojiBar.classList.add('hidden');
        lastRenderedSignature = '';
        await loadMessages(); bottom();
      }catch(err){ showError('تعذر حفظ الرسالة.'); }
      finally{ sending=false; }
    });

    function updateScrollBtn(){
      if(!scrollDownBtn) return;
      const nearBottom = messagesEl.scrollTop + messagesEl.clientHeight >= messagesEl.scrollHeight - 140;
      scrollDownBtn.classList.toggle('is-hidden', nearBottom);
    }
    messagesEl.addEventListener('scroll', updateScrollBtn);
    scrollDownBtn?.addEventListener('click', ()=>{ bottom(); updateScrollBtn(); });

    loadMessages();
    let socketConnected = false;
    if(window.io){
      try{
        const socket = io({path:'/socket.io'});
        socket.on('connect',()=>{ socketConnected = true; socket.emit('join-chat-thread', THREAD_ID); });
        socket.on('chat-thread-updated',()=>{ lastRenderedSignature=''; loadMessages(); });
      }catch(e){}
    }
    setInterval(loadMessages, socketConnected ? 12000 : 3500);
  </script>
  <script src="/chat-notifications.js"></script>
</body>
</html>