  <style type="text/tailwindcss">
    @layer utilities {
      .scrollbar-hide::-webkit-scrollbar { display: none; }
      .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
      .glass-panel {
        @apply bg-white/85 dark:bg-[#080808]/85 backdrop-blur-xl border border-accent-gold/20 shadow-luxury dark:shadow-luxury-dark;
      }
    }
  </style>

  <style>
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(229, 184, 105, 0.4); border-radius: 4px; transition: background 0.3s; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(229, 184, 105, 0.8); }

    #mobileNavOverlay.hidden { display: none; }
    #mobileNavOverlay { display: block; }
    #mobileNavDrawer{
      transform: translateX(-110%);
      transition: transform .3s cubic-bezier(.2,.9,.2,1);
    }
    #mobileNavDrawer.isOpen{ transform: translateX(0); }
    #mobileNavBtn[data-open="true"] .ico-open { display: none; }
    #mobileNavBtn[data-open="true"] .ico-close { display: inline; }
    #mobileNavBtn[data-open="false"] .ico-open { display: inline; }
    #mobileNavBtn[data-open="false"] .ico-close { display: none; }

    .chat-card {
      position: relative;
      border-radius: 12px;
    }

    /* ===== هيكل ومظهر محادثة راقي ===== */
    .chat-shell {
      height: calc(100vh - 280px);
      min-height: 520px;
      max-height: 860px;
    }

    /* خلفية متوافقة مع الهوية */
    .chat-bg-wrapper {
      background-color: #F8F8F6;
    }
    .dark .chat-bg-wrapper {
      background-color: #050505;
    }

    .chat-scroll {
      scroll-behavior: smooth;
    }

    .msg-row { position: relative; z-index: 10; animation: bubbleIn .18s ease-out both; }
    
    .bubble { max-width: min(85%, 600px); }
    .wa-bubble {
      position: relative;
      box-shadow: 0 2px 5px rgba(0,0,0,0.05);
      border-radius: 12px;
      padding: 8px 12px;
      transition: all 0.3s ease;
    }
    .dark .wa-bubble { box-shadow: 0 2px 5px rgba(0,0,0,0.3); }

    /* المرسل - أنا (RTL: اليسار الفيزيائي) */
    .wa-bubble-me {
      background-color: #E8F5ED;
      color: #111827;
      border-top-left-radius: 0;
      border: 1px solid rgba(0, 90, 43, 0.1);
    }
    .dark .wa-bubble-me {
      background-color: #003D1D;
      color: #FAFAFA;
      border: 1px solid rgba(229, 184, 105, 0.1);
    }
    .wa-bubble-me.is-grouped { border-top-left-radius: 12px; }
    .wa-bubble-me::after {
      content: ""; position: absolute; top: 0; left: -8px; width: 8px; height: 12px;
      background: inherit; clip-path: polygon(100% 0, 0 0, 100% 100%);
      border-top: 1px solid rgba(0, 90, 43, 0.1);
    }
    .dark .wa-bubble-me::after { border-top: 1px solid rgba(229, 184, 105, 0.1); }
    .wa-bubble-me.is-grouped::after { display: none; }

    /* المرسل - الآخرون (RTL: اليمين الفيزيائي) */
    .wa-bubble-other {
      background-color: #FFFFFF;
      color: #111827;
      border-top-right-radius: 0;
      border: 1px solid rgba(0,0,0,0.05);
    }
    .dark .wa-bubble-other {
      background-color: #0A0A0A;
      color: #FAFAFA;
      border: 1px solid rgba(255,255,255,0.05);
    }
    .wa-bubble-other.is-grouped { border-top-right-radius: 12px; }
    .wa-bubble-other::after {
      content: ""; position: absolute; top: 0; right: -8px; width: 8px; height: 12px;
      background: inherit; clip-path: polygon(0 0, 100% 0, 0 100%);
      border-top: 1px solid rgba(0,0,0,0.05);
    }
    .dark .wa-bubble-other::after { border-top: 1px solid rgba(255,255,255,0.05); }
    .wa-bubble-other.is-grouped::after { display: none; }

    /* الوقت وعلامات القراءة بداخل الفقاعة */
    .msg-meta-inline {
      float: left;
      margin-right: 12px;
      margin-top: 6px;
      margin-bottom: -2px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 10.5px;
      font-weight: 600;
    }
    .wa-bubble-me .msg-meta-inline, .wa-bubble-other .msg-meta-inline { color: #71717A; }
    .dark .wa-bubble-me .msg-meta-inline, .dark .wa-bubble-other .msg-meta-inline { color: rgba(255,255,255,0.5); }
    .clear-both { clear: both; }

    /* علامات القراءة - ذهبي للهوية */
    .wa-tick-read { color: #E5B869 !important; }
    .wa-tick-unread { color: #71717A !important; }
    .dark .wa-tick-unread { color: rgba(255,255,255,0.3) !important; }

    /* خلفية صندوق الإرسال */
    .composer-glass {
      background: #FFFFFF;
    }
    .dark .composer-glass {
      background: #0A0A0A;
    }

    #scrollDownBtn { transition: opacity .3s cubic-bezier(0.19, 1, 0.22, 1), transform .3s cubic-bezier(0.19, 1, 0.22, 1); }
    #scrollDownBtn.is-hidden {
      opacity: 0;
      transform: translateY(12px) scale(.92);
      pointer-events: none;
    }

    @keyframes recPulse { 0%,100% { opacity: 1; } 50% { opacity: .35; } }
    .rec-dot { animation: recPulse 1s ease-in-out infinite; }

    @keyframes bubbleIn {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @media (prefers-reduced-motion: reduce) {
      .msg-row { animation: none; }
      .chat-scroll { scroll-behavior: auto; }
    }

    @media (max-width: 1024px) { .chat-shell { height: calc(100vh - 380px); min-height: 480px; } }
    @media (max-width: 640px) {
      .chat-shell { height: calc(100vh - 320px); min-height: 460px; border-radius: 12px; }
      .bubble { max-width: 92%; }
    }
  </style>

  <script>
    (function () {
      const saved = localStorage.getItem("theme") || "dark";
      document.documentElement.setAttribute("data-theme", saved);
      document.documentElement.classList.toggle("dark", saved === "dark");

      const obs = new MutationObserver(() => {
        const t = document.documentElement.getAttribute("data-theme") || "dark";
        document.documentElement.classList.toggle("dark", t === "dark");
      });
      obs.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    })();
  </script>

  <script src="/socket.io/socket.io.js"></script>
</head>

