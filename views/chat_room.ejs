        <span class="text-primary dark:text-white transition-colors duration-300"><%= roomTitle %></span>
      </h1>
      
      <% if (mode === 'public' && Number(thread.is_locked) === 1) { %>
        <div class="mt-6 flex justify-center relative z-10">
          <span class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-red-50 dark:bg-red-500/10 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-500/20 font-sans font-bold text-[13px] shadow-sm">
            <span class="material-symbols-outlined text-[18px]">lock</span> مغلق بواسطة الإدارة
          </span>
        </div>
      <% } %>
    </section>

    <!-- ===== مساحة الشات والشريط الجانبي ===== -->
    <section class="px-4 sm:px-6 lg:px-8 pb-16 max-w-[96rem] mx-auto relative z-10 flex flex-col lg:flex-row gap-6 lg:gap-8 items-start">
      
      <!-- الشريط الجانبي (مخفي على الموبايل، يظهر على الديسكتوب يميناً) -->
