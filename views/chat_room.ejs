                <div class="flex-1 relative">
                  <textarea id="body" name="body" rows="1" placeholder="اكتب رسالتك هنا..." class="block w-full min-h-[48px] max-h-32 rounded-2xl border border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-[#111] focus:bg-white dark:focus:bg-[#1A1A1A] resize-none px-5 py-3.5 font-sans font-medium text-[15px] text-gray-800 dark:text-white placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent shadow-inner transition-all duration-300 leading-relaxed scrollbar-hide"></textarea>
                </div>

                <button type="button" id="recordBtn" class="h-12 w-12 shrink-0 rounded-full text-gray-500 hover:text-primary hover:bg-primary/5 dark:hover:bg-white/5 dark:hover:text-accent flex items-center justify-center transition-colors" title="تسجيل صوت">
                  <span class="material-symbols-outlined text-[24px]">mic</span>
                </button>
                <button class="h-12 w-12 shrink-0 rounded-full bg-primary hover:bg-primaryDark text-white dark:bg-white dark:text-[#050505] dark:hover:bg-accent font-sans font-bold flex items-center justify-center shadow-md hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5" title="إرسال">
                  <span class="material-symbols-outlined text-[20px] rtl:-scale-x-100">send</span>
                </button>
              </div>

              <input id="chatFile" name="chat_file" type="file" accept="image/*,audio/*" class="hidden" />
            </form>
          </div>
        </div>
