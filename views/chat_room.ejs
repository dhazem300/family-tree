  <main class="flex-grow relative">

    <% 
      let avatarImg = '/assets/default-avatar.svg';
      let dispName = '';
      
      if (typeof targetUser !== 'undefined' && targetUser) {
         avatarImg = targetUser.photo_url || targetUser.avatar_url || targetUser.avatar || '/assets/default-avatar.svg';
         dispName = targetUser.name || targetUser.full_name || '';
      }
      
      if (!dispName && typeof roomTitle !== 'undefined') {
         dispName = roomTitle.replace('محادثة مع ', '').trim();
      }
    %>

    <!-- ===== الهيرو ===== -->
    <section class="pt-16 pb-12 px-6 max-w-[90rem] mx-auto text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-islamic-pattern opacity-40 dark:opacity-10 pointer-events-none"></div>

