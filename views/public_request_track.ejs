<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>تتبع طلب إضافة فرد</title>
  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/styles.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@300;400;500;700;900&family=Amiri:wght@400;700&family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries,line-clamp"></script>
  <script>
    tailwind.config = { darkMode: "class", theme: { extend: { colors: { primary: "#005A2B", accent: "#E5B869", "accent-gold": "#E5B869", "background-light": "#F8F8F6", "bg-charcoal": "#050505", "text-cream": "#FAFAFA" }, fontFamily: { display: ["'Aref Ruqaa'", "serif"], sans: ["Tajawal", "sans-serif"] }, backgroundImage: { "islamic-pattern": "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E5B869' fill-opacity='0.035'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")" } } } };
  </script>
  <style>
    html.dark .dark-toggle-icon-moon{display:none} html:not(.dark) .dark-toggle-icon-sun{display:none}
    .mobile-nav-hidden{display:none}.mobile-nav-open{display:block}
    #mobileNavDrawer{transform:translateX(-115%);transition:transform .35s cubic-bezier(.16,1,.3,1)} #mobileNavDrawer.isOpen{transform:translateX(0)}
    .field{width:100%;border-radius:18px;border:1px solid rgba(0,90,43,.14);background:rgba(255,255,255,.92);padding:14px 16px;font-weight:900;outline:none;color:#111827;transition:.2s}
    html.dark .field{background:rgba(255,255,255,.055);border-color:rgba(229,184,105,.18);color:#fff}.field:focus{border-color:#005A2B;box-shadow:0 0 0 4px rgba(0,90,43,.10)} html.dark .field:focus{border-color:#E5B869;box-shadow:0 0 0 4px rgba(229,184,105,.12)}
    html,body{height:auto!important;min-height:100%!important;overflow-x:hidden!important;overflow-y:auto!important;-webkit-overflow-scrolling:touch}
  </style>
  <script>(function(){const saved=localStorage.getItem('theme')||'dark';document.documentElement.classList.toggle('dark',saved==='dark');document.documentElement.setAttribute('data-theme',saved);})();</script>
</head>
<body class="bg-background-light dark:bg-bg-charcoal text-gray-900 dark:text-text-cream font-sans min-h-screen flex flex-col relative overflow-x-hidden selection:bg-accent-gold selection:text-bg-charcoal transition-colors duration-300">
  <div id="mobileNavOverlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[80] mobile-nav-hidden" aria-hidden="true"></div>
  <aside id="mobileNavDrawer" class="fixed top-0 left-0 h-full w-[320px] max-w-[85vw] bg-white dark:bg-bg-charcoal border-r border-gray-200 dark:border-white/10 shadow-2xl z-[90] flex flex-col">
    <div class="h-1.5 w-full bg-gradient-to-r from-gray-300 via-accent-gold to-gray-300 dark:from-gray-800 dark:via-accent-gold dark:to-gray-800"></div>
    <div class="flex items-center justify-between p-6 border-b border-gray-100 dark:border-white/5"><img class="h-10 w-auto hidden dark:block" src="/assets/logo-dark.svg" alt="شعار العائلة" /><img class="h-10 w-auto block dark:hidden" src="/assets/logo-light.svg" alt="شعار العائلة" /><button id="mobileNavClose" class="text-gray-500 hover:text-accent-gold transition-colors" type="button"><span class="material-symbols-outlined text-[28px]">close</span></button></div>
    <nav class="p-6 flex flex-col gap-3 font-bold text-base flex-grow text-gray-700 dark:text-gray-300"><a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5" href="/">الشجرة</a><a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5" href="/about">نبذة</a><a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5" href="/honor">السير الذاتية</a><a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5" href="/news">الأخبار</a><a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5" href="/tree-pdf">المشجرة</a><a class="px-4 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-white/5" href="/support">الدعم</a><a class="px-4 py-3 rounded-xl text-accent-gold bg-accent-gold/5 border-r-2 border-accent-gold" href="/submit-person">إضافة بياناتك</a></nav>
    <div class="p-6 border-t border-gray-100 dark:border-white/5"><a href="/admin/login" class="flex items-center justify-center gap-2 py-3 bg-primary text-white dark:bg-white dark:text-primary rounded-xl hover:opacity-90 transition-colors font-bold"><span class="material-symbols-outlined">login</span><span>تسجيل الدخول</span></a></div>
  </aside>

  <header class="sticky top-0 z-50 w-full bg-white/95 dark:bg-[#050505]/95 backdrop-blur-md border-b border-gray-200 dark:border-white/10">
    <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8 py-3 flex justify-between items-center h-20 md:h-24">
      <div class="flex items-center gap-4 min-w-0"><a href="/" class="block shrink-0"><img class="h-14 md:h-20 w-auto hidden dark:block" src="/assets/logo-dark.svg" alt="شعار العائلة" /><img class="h-14 md:h-20 w-auto block dark:hidden" src="/assets/logo-light.svg" alt="شعار العائلة" /></a><div class="h-10 w-px bg-gray-300 dark:bg-white/20 hidden sm:block"></div><div class="flex flex-col justify-center min-w-0"><h1 class="text-2xl md:text-3xl font-display text-primary dark:text-accent-gold font-bold leading-none tracking-wide pt-1 truncate">شجرة العائلة</h1><span class="hidden sm:block text-[10px] font-bold text-gray-500 dark:text-gray-500 uppercase tracking-[0.25em] mt-2">استكشاف الأنساب والروابط العائلية</span></div></div>
      <nav class="hidden lg:flex gap-6 xl:gap-8 items-center text-sm font-bold text-gray-600 dark:text-gray-300"><a href="/" class="hover:text-primary dark:hover:text-accent-gold">الشجرة</a><a href="/about" class="hover:text-primary dark:hover:text-accent-gold">نبذة</a><a href="/honor" class="hover:text-primary dark:hover:text-accent-gold">السير الذاتية</a><a href="/news" class="hover:text-primary dark:hover:text-accent-gold">الأخبار</a><a href="/tree-pdf" class="hover:text-primary dark:hover:text-accent-gold">المشجرة</a><a href="/support" class="hover:text-primary dark:hover:text-accent-gold">الدعم</a><a href="/submit-person" class="text-accent-gold">إضافة بياناتك</a></nav>
      <div class="flex items-center gap-2 sm:gap-3"><button id="themeBtn" class="flex items-center justify-center w-11 h-11 rounded-2xl bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-600 dark:text-accent-gold shadow-sm" type="button"><span class="material-symbols-outlined text-[22px] dark-toggle-icon-moon">dark_mode</span><span class="material-symbols-outlined dark-toggle-icon-sun">light_mode</span></button><a href="/admin/login" class="hidden sm:flex p-2.5 rounded-full bg-primary text-white dark:bg-white dark:text-black hover:opacity-90 transition-all shadow-md items-center justify-center"><span class="material-symbols-outlined text-[22px]">login</span></a><button id="mobileNavBtn" class="lg:hidden p-2.5 text-primary dark:text-accent-gold bg-gray-50 dark:bg-white/5 rounded-full" type="button"><span class="material-symbols-outlined text-[28px]">menu</span></button></div>
    </div>
  </header>

  <main class="flex-1 relative overflow-visible">
    <div class="absolute inset-0 bg-islamic-pattern opacity-70 dark:opacity-20 pointer-events-none"></div>
    <section class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
      <div class="text-center mb-8"><span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 dark:bg-accent-gold/10 text-primary dark:text-accent-gold font-black text-sm mb-5"><span class="material-symbols-outlined text-[18px]">track_changes</span> تتبع طلبك</span><h2 class="font-display text-4xl md:text-6xl font-bold text-primary dark:text-white mb-4">تتبع طلب إضافة فرد</h2><p class="text-gray-600 dark:text-gray-400 leading-8 font-medium">اكتب الرقم المرجعي الذي ظهر بعد إرسال البيانات لمعرفة حالة المراجعة.</p></div>
      <div class="rounded-[2rem] border border-black/10 dark:border-white/10 bg-white/90 dark:bg-[#0A0A0A]/90 shadow-2xl p-5 sm:p-8 backdrop-blur-xl">
        <form method="get" action="/track-request" class="grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-3 mb-6"><input name="ref" value="<%= ref || '' %>" class="field" placeholder="مثال: FAM-XXXX-XXXXX"><button class="px-7 py-4 rounded-2xl bg-primary dark:bg-accent-gold text-white dark:text-black font-black" type="submit">بحث</button></form>
        <% if (error) { %><div class="rounded-2xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 p-4 text-red-700 dark:text-red-200 font-bold text-center"><%= error %></div><% } %>
        <% if (request) { %>
          <% const isApproved = request.status === 'approved'; const isRejected = request.status === 'rejected'; %>
          <div class="rounded-3xl border <%= isApproved ? 'border-green-200 dark:border-green-500/20 bg-green-50 dark:bg-green-500/10' : isRejected ? 'border-red-200 dark:border-red-500/20 bg-red-50 dark:bg-red-500/10' : 'border-amber-200 dark:border-amber-500/20 bg-amber-50 dark:bg-amber-500/10' %> p-5 sm:p-6 text-center">
            <p class="text-sm font-black text-gray-500 dark:text-gray-300 mb-2">حالة الطلب رقم <%= request.ref_code %></p>
            <h3 class="text-3xl font-black <%= isApproved ? 'text-green-700 dark:text-green-300' : isRejected ? 'text-red-700 dark:text-red-300' : 'text-amber-700 dark:text-amber-300' %>"><%= statusLabel %></h3>
            <p class="mt-3 font-bold text-gray-700 dark:text-gray-200">الاسم: <%= request.name %></p>
            <% if (isRejected && request.admin_note) { %><div class="mt-4 rounded-2xl bg-white/70 dark:bg-black/20 p-4 text-red-800 dark:text-red-200 font-bold">سبب الرفض: <%= request.admin_note %></div><% } %>
            <% if (isApproved) { %>
              <p class="mt-4 text-green-800 dark:text-green-200 font-bold">تمت الموافقة على الطلب وإضافة الاسم إلى الشجرة.</p>
              <% if (request.created_person_id) { %><a href="/?focus=<%= request.created_person_id %>" class="mt-5 inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full bg-primary dark:bg-accent-gold text-white dark:text-black font-black shadow-lg"><span class="material-symbols-outlined">account_tree</span> شاهد موقعك في الشجرة</a><% } %>
            <% } %>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <footer class="bg-background-light dark:bg-bg-charcoal border-t border-gray-200 dark:border-white/10 mt-auto py-8 relative z-10"><div class="max-w-[90rem] mx-auto px-6 text-center"><p class="text-[11px] font-bold text-gray-500 uppercase tracking-[0.1em]">© ٢٠٢٦ وقف عائلة خاشقجي. جميع الحقوق محفوظة.</p></div></footer>
  <script>
    (function(){const btn=document.getElementById('themeBtn');function setTheme(next){document.documentElement.classList.toggle('dark',next==='dark');document.documentElement.setAttribute('data-theme',next);localStorage.setItem('theme',next)}btn?.addEventListener('click',()=>{const cur=document.documentElement.classList.contains('dark')?'dark':'light';setTheme(cur==='dark'?'light':'dark')});})();
    (function(){const btn=document.getElementById('mobileNavBtn'),drawer=document.getElementById('mobileNavDrawer'),overlay=document.getElementById('mobileNavOverlay'),close=document.getElementById('mobileNavClose');function lockPage(){document.documentElement.style.overflowY='hidden';document.body.style.overflowY='hidden'}function unlockPage(){document.documentElement.style.overflowY='auto';document.body.style.overflowY='auto';document.body.style.overflowX='hidden'}function open(){drawer?.classList.add('isOpen');overlay?.classList.remove('mobile-nav-hidden');overlay?.classList.add('mobile-nav-open');lockPage()}function shut(){drawer?.classList.remove('isOpen');overlay?.classList.add('mobile-nav-hidden');overlay?.classList.remove('mobile-nav-open');unlockPage()}unlockPage();btn?.addEventListener('click',open);close?.addEventListener('click',shut);overlay?.addEventListener('click',shut);drawer?.querySelectorAll('a').forEach(a=>a.addEventListener('click',shut));})();
  </script>
</body>
</html>
