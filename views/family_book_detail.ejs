<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= root.name %></title><script src="/theme.js"></script><script src="https://cdn.tailwindcss.com?plugins=forms"></script><link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&family=Aref+Ruqaa:wght@700&display=swap" rel="stylesheet"><script>tailwind.config={darkMode:'class',theme:{extend:{colors:{primary:'#005A2B',accent:'#E5B869'},fontFamily:{sans:['Tajawal','sans-serif'],display:["'Aref Ruqaa'",'serif']}}}}</script></head><body class="bg-gray-50 dark:bg-[#050505] text-gray-900 dark:text-white font-sans min-h-screen"><%- include('partials/header', {active, siteUser, pageTitle:'دفتر فرع ' + root.name, pageSubtitle:'الأفراد المرتبطون بهذا الفرع'}) %><main class="max-w-5xl mx-auto p-5"><a href="/family-books" class="font-black text-primary dark:text-accent">← كل الفروع</a><section class="mt-5 bg-white dark:bg-white/5 rounded-[2rem] border border-gray-200 dark:border-white/10 overflow-hidden"><table class="w-full text-sm"><thead class="bg-gray-50 dark:bg-white/5"><tr><th class="p-4 text-right">الاسم</th><th class="p-4 text-right">العمل</th><th class="p-4 text-right">الميلاد</th><th class="p-4 text-right">موقعه</th></tr></thead><tbody><% members.forEach(m => { %><tr class="border-t border-gray-100 dark:border-white/10"><td class="p-4 font-black"><%= m.name %></td><td class="p-4"><%= m.job || '—' %></td><td class="p-4"><%= m.birth_date || '—' %></td><td class="p-4"><a href="/?focus=<%= m.id %>" class="text-primary dark:text-accent font-black">شاهد موقعي</a></td></tr><% }) %></tbody></table></section></main><script src="/chat-notifications.js"></script></body></html>
