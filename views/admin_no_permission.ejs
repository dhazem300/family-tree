<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>لا توجد صلاحية - لوحة الإدارة</title>

  <script src="/theme.js"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@300;400;500;700;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries,line-clamp"></script>

  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#005A2B",
            primaryDark: "#00361A",
            accent: "#E5B869",
            "bg-light": "#F5F3F7",
            "bg-dark": "#050505",
            "card-light": "rgba(255, 255, 255, 0.82)",
            "card-dark": "rgba(15, 12, 25, 0.82)",
            "border-light": "rgba(0, 90, 43, 0.10)",
            "border-dark": "rgba(229, 184, 105, 0.12)"
          },
          fontFamily: {
            display: ["'Aref Ruqaa'", "serif"],
            sans: ["Tajawal", "sans-serif"]
          }
        }
      }
    };
  </script>

  <style type="text/tailwindcss">
    @layer utilities {
      .scrollbar-hide::-webkit-scrollbar { display: none; }
      .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
      .glass-panel { @apply backdrop-blur-2xl shadow-xl; }
    }
      html.theme-switching, html.theme-switching *, html.theme-switching *::before, html.theme-switching *::after { transition: none !important; animation: none !important; }
</style>

  <style>
    :root { color-scheme: light; }
    html.dark { color-scheme: dark; }

    html.admin-theme-switching *,
    html.admin-theme-switching *::before,
    html.admin-theme-switching *::after {
      transition: none !important;
      animation-duration: 0.001ms !important;
      animation-delay: 0ms !important;
    }

    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #005A2B; border-radius: 10px; }
    html.dark ::-webkit-scrollbar-thumb { background: #E5B869; }

    #nexusCanvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
    }

    html.dark .dark-toggle-icon-moon { display: none; }
    html:not(.dark) .dark-toggle-icon-sun { display: none; }

    .admin-menu-toggle {
      position: fixed !important;
      width: 1px !important;
      height: 1px !important;
      opacity: 0 !important;
      pointer-events: none !important;
      clip: rect(0 0 0 0) !important;
    }

    #mobileNavBtn {
      position: relative !important;
      z-index: 10002 !important;
      pointer-events: auto !important;
      cursor: pointer !important;
      -webkit-tap-highlight-color: transparent !important;
      touch-action: manipulation !important;
    }

    #mobileNavOverlay {
      display: none !important;
      opacity: 0 !important;
      pointer-events: none !important;
      z-index: 10000 !important;
    }

    #mobileNavDrawer {
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      right: auto !important;
      transform: translateX(-115%) !important;
      pointer-events: none !important;
      z-index: 10001 !important;
      transition: transform .32s cubic-bezier(0.16, 1, 0.3, 1) !important;
      display: flex !important;
      visibility: visible !important;
      opacity: 1 !important;
    }

    #adminMenuToggle:checked ~ #mobileNavDrawer {
      transform: translateX(0) !important;
      pointer-events: auto !important;
    }

    #adminMenuToggle:checked ~ #mobileNavOverlay {
      display: block !important;
      opacity: 1 !important;
      pointer-events: auto !important;
    }

    @media (min-width: 1024px) {
      #adminMenuToggle,
      #mobileNavDrawer,
      #mobileNavOverlay { display: none !important; }
    }

    @media (max-width: 1023px) {
      body {
        height: auto !important;
        min-height: 100dvh !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
        display: block !important;
      }
      main {
        width: 100% !important;
        min-height: 100dvh !important;
        display: block !important;
      }
      main > header {
        position: sticky !important;
        top: 0 !important;
        z-index: 60 !important;
        padding: 12px !important;
        gap: 10px !important;
        flex-wrap: wrap !important;
        align-items: flex-start !important;
        background: rgba(245, 243, 247, 0.88) !important;
        backdrop-filter: blur(18px) !important;
        border-bottom: 1px solid rgba(0, 90, 43, 0.08) !important;
      }
      html.dark main > header {
        background: rgba(5, 5, 5, 0.86) !important;
        border-bottom-color: rgba(229, 184, 105, 0.12) !important;
      }
      main > header h2 {
        font-size: 1.25rem !important;
        line-height: 1.25 !important;
      }
      main > header > div:first-child {
        min-width: 0 !important;
        flex: 1 1 auto !important;
      }
      main > header > div:last-child {
        width: 100% !important;
        justify-content: flex-start !important;
        overflow-x: auto !important;
        padding-bottom: 2px !important;
      }
      #nexusCanvas { pointer-events: none !important; }
    }
  </style>

  <script>
    (function () {
      const saved = localStorage.getItem("theme") || "dark";
      document.documentElement.setAttribute("data-theme", saved);
      document.documentElement.classList.toggle("dark", saved === "dark");
    })();
  </script>
</head>

<body class="bg-bg-light dark:bg-bg-dark text-gray-800 dark:text-gray-200 font-sans h-screen flex overflow-hidden selection:bg-accent selection:text-primaryDark">
  <%
    const can = (permission) => (typeof userCan === "function" && userCan(permission));
    const isSuperAdmin = Number(admin?.is_super_admin || 0) === 1;
    const adminName = admin?.username || admin?.full_name || "مدير النظام";
    const returnTo = typeof returnUrl !== "undefined" && returnUrl ? returnUrl : "/admin/dashboard";
  %>

  <input id="adminMenuToggle" type="checkbox" class="admin-menu-toggle" aria-hidden="true" />

  <canvas id="nexusCanvas"></canvas>
  <div class="fixed inset-0 bg-gradient-to-b from-white/40 to-white/80 dark:from-black/40 dark:to-[#050505]/90 pointer-events-none z-[1]"></div>

  <aside class="relative z-20 hidden lg:flex flex-col w-[280px] h-[calc(100vh-2rem)] my-4 mx-4 bg-card-light dark:bg-card-dark glass-panel rounded-3xl border border-border-light dark:border-border-dark overflow-hidden shrink-0">
    <div class="flex items-center gap-3 p-6 border-b border-border-light dark:border-border-dark shrink-0">
      <div class="w-12 h-12 flex items-center justify-center rounded-2xl bg-primary dark:bg-accent text-white dark:text-black shadow-lg">
        <span class="material-symbols-outlined text-[28px]">shield_person</span>
      </div>
      <div>
        <h1 class="font-display font-bold text-xl leading-none text-primary dark:text-white">عائلة خاشقجي</h1>
        <p class="text-[10px] font-bold text-gray-500 dark:text-accent uppercase tracking-widest mt-1.5">نظام الإدارة المركزية</p>
      </div>
    </div>

    <nav class="flex-1 overflow-y-auto p-4 space-y-6">
      <div class="space-y-2">
        <p class="px-3 text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-3">نظرة عامة</p>
        <a href="/admin/dashboard" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          <span class="material-symbols-outlined text-[22px]">dashboard</span> لوحة الإحصائيات
        </a>
      </div>

      <div class="space-y-2">
        <p class="px-3 text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-3">إدارة العائلة والبيانات</p>
        <a href="/admin" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent"><span class="material-symbols-outlined text-[22px]">group</span> إدارة الأفراد</a>
        <% if (can("person_requests")) { %><a href="/admin/person-requests" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent"><span class="material-symbols-outlined text-[22px]">fact_check</span> طلبات الأفراد <% if ((adminPendingCounts?.personRequests || 0) > 0) { %><span class="mr-auto ms-2 min-w-[22px] h-[22px] px-2 rounded-full bg-red-600 text-white text-[11px] font-black flex items-center justify-center"><%= adminPendingCounts.personRequests %></span><% } %></a><% } %>
        <a href="/admin/honor" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent"><span class="material-symbols-outlined text-[22px]">workspace_premium</span> السير الذاتية</a>
        <a href="/admin/news" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent"><span class="material-symbols-outlined text-[22px]">newspaper</span> الأخبار والمناسبات</a>
      </div>

      <div class="space-y-2">
        <p class="px-3 text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-3">المستخدمون والتواصل</p>
        <% if (can("users")) { %><a href="/admin/users" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent"><span class="material-symbols-outlined text-[22px]">groups</span> مستخدمي الموقع <% if ((adminPendingCounts?.pendingUsers || 0) > 0) { %><span class="mr-auto ms-2 min-w-[22px] h-[22px] px-2 rounded-full bg-red-600 text-white text-[11px] font-black flex items-center justify-center"><%= adminPendingCounts.pendingUsers %></span><% } %></a><% } %>
        <% if (can("chats")) { %><a href="/admin/chats" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent"><span class="material-symbols-outlined text-[22px]">forum</span> إدارة المحادثات</a><% } %>
        <% if (can("persons") || can("backups") || isSuperAdmin) { %><a href="/admin/tree-exports" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent"><span class="material-symbols-outlined text-[22px]">file_export</span> سجل تصدير الشجرة</a><% } %>
        <a href="/admin/support-messages" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent"><span class="material-symbols-outlined text-[22px]">mail</span> رسائل الدعم <% if ((adminPendingCounts?.support || 0) > 0) { %><span class="mr-auto ms-2 min-w-[22px] h-[22px] px-2 rounded-full bg-red-600 text-white text-[11px] font-black flex items-center justify-center"><%= adminPendingCounts.support %></span><% } %></a>
      </div>

      <div class="space-y-2">
        <p class="px-3 text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-3">النظام والصلاحيات</p>
        <% if (can("roles")) { %><a href="/admin/roles" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent"><span class="material-symbols-outlined text-[22px]">manage_accounts</span> وظائف الأفراد</a><% } %>
        <% if (isSuperAdmin) { %><a href="/admin/activity" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent"><span class="material-symbols-outlined text-[22px]">manage_history</span> سجل النشاط</a><% } %>
        <a href="/admin/approvals" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent"><span class="material-symbols-outlined text-[22px]">fact_check</span> مركز الموافقة <% if ((adminPendingCounts?.approvalsTotal || 0) > 0) { %><span class="mr-auto ms-2 min-w-[22px] h-[22px] px-2 rounded-full bg-red-600 text-white text-[11px] font-black flex items-center justify-center"><%= adminPendingCounts.approvalsTotal %></span><% } %></a>
        <% if (isSuperAdmin) { %><a href="/admin/maintenance" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent"><span class="material-symbols-outlined text-[22px]">construction</span> وضع الصيانة</a><% } %>
        <% if (can("backups") || isSuperAdmin) { %><a href="/admin/backups" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent"><span class="material-symbols-outlined text-[22px]">backup</span> النسخ الاحتياطي</a><% } %>
      </div>
    </nav>

    <div class="p-4 border-t border-border-light dark:border-border-dark shrink-0 m-2 rounded-2xl bg-white/50 dark:bg-black/30">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-primary/10 dark:bg-accent/10 flex items-center justify-center text-primary dark:text-accent border border-gray-200 dark:border-white/10 shadow-sm"><span class="material-symbols-outlined text-[20px]">person</span></div>
        <div class="flex-1 min-w-0"><p class="text-sm font-bold text-gray-900 dark:text-white truncate"><%= adminName %></p><p class="text-[10px] text-primary dark:text-accent uppercase tracking-widest mt-0.5 font-bold">Admin</p></div>
        <form method="post" action="/admin/logout" class="m-0"><button type="submit" class="w-9 h-9 flex items-center justify-center rounded-xl bg-red-50 dark:bg-red-500/10 text-red-500 hover:bg-red-500 hover:text-white transition-all shadow-sm" title="تسجيل خروج"><span class="material-symbols-outlined text-[18px]">logout</span></button></form>
      </div>
    </div>
  </aside>

  <main class="flex-1 flex flex-col min-w-0 h-full relative z-10">
    <header class="flex items-center justify-between p-4 lg:p-8 shrink-0">
      <div class="flex items-center gap-3">
        <label id="mobileNavBtn" for="adminMenuToggle" class="lg:hidden flex items-center justify-center w-12 h-12 rounded-2xl bg-card-light dark:bg-card-dark glass-panel border border-border-light dark:border-border-dark text-primary dark:text-accent shadow-sm cursor-pointer" aria-controls="mobileNavDrawer" aria-label="فتح القائمة"><span class="material-symbols-outlined text-[24px]">menu</span></label>
        <div>
          <h2 class="text-2xl md:text-3xl font-display font-bold text-primary dark:text-white tracking-tight leading-none mb-1.5">لا توجد صلاحية</h2>
          <div class="flex items-center gap-1.5 text-gray-500 text-[11px] font-bold uppercase tracking-widest"><span>لوحة الإدارة</span><span class="material-symbols-outlined text-[14px]">chevron_left</span><span class="text-accent">رفض الوصول</span></div>
        </div>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <button id="themeBtn" class="flex items-center justify-center w-12 h-12 rounded-2xl bg-card-light dark:bg-card-dark glass-panel border border-border-light dark:border-border-dark text-gray-600 dark:text-accent shadow-sm hover:-translate-y-1 transition-transform" type="button" title="تبديل المظهر"><span class="material-symbols-outlined text-[22px] dark-toggle-icon-moon">dark_mode</span><span class="material-symbols-outlined hidden dark:block text-[24px]">light_mode</span></button>
        <a href="/admin/dashboard" class="flex items-center gap-2 px-6 h-12 rounded-2xl font-bold text-sm bg-card-light dark:bg-card-dark glass-panel border border-border-light dark:border-border-dark text-primary dark:text-accent shadow-sm hover:-translate-y-1 transition-transform"><span class="material-symbols-outlined text-[22px]">dashboard</span><span class="hidden sm:inline">الإحصائيات</span></a>
      </div>
    </header>

    <div class="flex-1 overflow-y-auto px-4 lg:px-8 pb-12">
      <div class="max-w-[100rem] mx-auto space-y-8">
        <section class="relative overflow-hidden rounded-[2rem] border border-red-500/10 dark:border-red-400/10 bg-card-light dark:bg-card-dark glass-panel p-6 md:p-8">
          <div class="absolute -left-20 -top-20 w-64 h-64 rounded-full bg-red-500/10 blur-3xl pointer-events-none"></div>
          <div class="absolute -right-20 -bottom-20 w-72 h-72 rounded-full bg-accent/10 blur-3xl pointer-events-none"></div>
          <div class="relative z-10 grid lg:grid-cols-[1.1fr_.9fr] gap-8 items-center">
            <div>
              <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-red-50 dark:bg-red-500/10 text-red-700 dark:text-red-300 border border-red-100 dark:border-red-500/20 font-black text-xs mb-5">
                <span class="material-symbols-outlined text-[18px]">lock</span>
                وصول مرفوض
              </div>
              <h1 class="font-display text-4xl md:text-5xl font-bold text-primary dark:text-accent leading-tight">هذا القسم يحتاج صلاحية إضافية</h1>
              <p class="mt-4 text-base md:text-lg text-gray-600 dark:text-gray-300 leading-9 font-medium max-w-3xl">
                هذا الحساب لا يملك صلاحية الوصول إلى هذا القسم. تواصل مع مدير النظام لتعديل وظيفة الفرد أو إضافة الصلاحية المناسبة، أو اختر أحد الأقسام المتاحة لحسابك من القائمة.
              </p>
              <div class="mt-6 flex flex-wrap gap-3">
                <a href="<%= returnTo %>" class="inline-flex items-center justify-center gap-2 h-12 px-6 rounded-2xl bg-primary dark:bg-accent text-white dark:text-black font-black shadow-sm hover:-translate-y-1 transition-transform"><span class="material-symbols-outlined text-[22px]">arrow_back</span> العودة للوحة الإدارة</a>
                <a href="/" class="inline-flex items-center justify-center gap-2 h-12 px-6 rounded-2xl bg-white/70 dark:bg-white/5 border border-border-light dark:border-border-dark text-primary dark:text-accent font-black shadow-sm hover:-translate-y-1 transition-transform"><span class="material-symbols-outlined text-[22px]">account_tree</span> عرض الموقع</a>
              </div>
            </div>
            <div class="relative">
              <div class="rounded-[2rem] bg-white/70 dark:bg-black/20 border border-black/5 dark:border-white/10 p-6 shadow-sm">
                <div class="w-24 h-24 rounded-[2rem] bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-300 flex items-center justify-center mx-auto mb-5 border border-red-100 dark:border-red-500/20">
                  <span class="material-symbols-outlined text-[54px]">lock_person</span>
                </div>
                <h2 class="text-center text-xl font-black text-gray-900 dark:text-white">مراجعة الصلاحيات مطلوبة</h2>
                <p class="mt-3 text-center text-sm text-gray-500 dark:text-gray-400 leading-7 font-bold">الحماية تمنع فتح الصفحات الحساسة إلا للأدوار المصرح لها داخل النظام.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-6">
          <div class="bg-card-light dark:bg-card-dark glass-panel rounded-[2rem] border border-border-light dark:border-border-dark p-5 shadow-sm">
            <div class="w-14 h-14 rounded-2xl bg-primary/10 dark:bg-accent/10 text-primary dark:text-accent flex items-center justify-center mb-4"><span class="material-symbols-outlined text-[28px]">badge</span></div>
            <p class="text-[11px] font-bold text-gray-500 uppercase tracking-widest mb-1">الحساب الحالي</p>
            <p class="text-xl font-black text-primary dark:text-white leading-tight"><%= adminName %></p>
          </div>
          <div class="bg-card-light dark:bg-card-dark glass-panel rounded-[2rem] border border-border-light dark:border-border-dark p-5 shadow-sm">
            <div class="w-14 h-14 rounded-2xl bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-300 flex items-center justify-center mb-4"><span class="material-symbols-outlined text-[28px]">gpp_bad</span></div>
            <p class="text-[11px] font-bold text-gray-500 uppercase tracking-widest mb-1">سبب المنع</p>
            <p class="text-xl font-black text-primary dark:text-white leading-tight">الصلاحية غير مفعلة</p>
          </div>
          <div class="bg-card-light dark:bg-card-dark glass-panel rounded-[2rem] border border-border-light dark:border-border-dark p-5 shadow-sm">
            <div class="w-14 h-14 rounded-2xl bg-amber-100 dark:bg-amber-500/10 text-amber-700 dark:text-amber-300 flex items-center justify-center mb-4"><span class="material-symbols-outlined text-[28px]">support_agent</span></div>
            <p class="text-[11px] font-bold text-gray-500 uppercase tracking-widest mb-1">الخطوة التالية</p>
            <p class="text-xl font-black text-primary dark:text-white leading-tight">مراجعة مدير النظام</p>
          </div>
        </section>

        <section class="bg-card-light dark:bg-card-dark glass-panel rounded-3xl shadow-sm border border-border-light dark:border-border-dark overflow-hidden">
          <div class="p-5 border-b border-border-light dark:border-border-dark flex items-center justify-between gap-4 flex-wrap">
            <div>
              <h3 class="font-black text-lg text-primary dark:text-white">الأقسام المتاحة لحسابك</h3>
