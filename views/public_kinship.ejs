<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>صلة القرابة - شجرة العائلة</title>
  
  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/styles.css" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@300;400;500;700;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#005A2B",      /* اللون الأخضر الملكي الفاخر */
            primaryDark: "#003D1D",  /* أخضر داكن للتحويم */
            accent: "#E5B869",       /* ذهب سائل */
            "background-light": "#F8F8F6",
            "background-dark": "#050505",
            "card-light": "#FFFFFF",
            "card-dark": "#0A0A0A",
            "bg-charcoal": "#050505",
            "bg-card": "#0A0A0A",
            "text-cream": "#FAFAFA",
            "muted-slate": "#71717A",
            gold: "#E5B869",
            "bg-light": "#F8F8F6",   /* تم الإبقاء عليه لعدم كسر أي اعتماد محتمل */
            "bg-dark": "#050505"     /* تم الإبقاء عليه لعدم كسر أي اعتماد محتمل */
          },
          fontFamily: {
            display: ["'Aref Ruqaa'", "serif"],
            sans: ["Tajawal", "sans-serif"],
          },
          backgroundImage: {
            "islamic-pattern": "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E5B869' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")",
          }
        }
      }
    };
  </script>

  <style>
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #E5B869; border-radius: 4px; }

    #mobileNavOverlay.hidden { display: none; }
    #mobileNavOverlay { display: block; }
    #mobileNavDrawer {
      transform: translateX(-110%);
      transition: transform .3s cubic-bezier(.2,.9,.2,1);
    }
    #mobileNavDrawer.isOpen { transform: translateX(0); }
  </style>

  <script>
    (function(){
      const saved=localStorage.getItem('theme')||'dark';
      document.documentElement.classList.toggle('dark',saved==='dark');
      document.documentElement.setAttribute('data-theme',saved);
    })();
  </script>
</head>

<body class="bg-background-light dark:bg-bg-charcoal text-gray-900 dark:text-text-cream font-sans min-h-screen flex flex-col overflow-x-hidden selection:bg-accent selection:text-background-dark transition-colors duration-300">

  <div id="mobileNavOverlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[80] hidden" aria-hidden="true"></div>
  <aside id="mobileNavDrawer" class="fixed top-0 left-0 h-full w-[320px] max-w-[85vw] bg-white dark:bg-bg-charcoal border-r border-gray-200 dark:border-white/10 shadow-2xl z-[90] flex flex-col">
    <div class="h-1.5 w-full bg-gradient-to-r from-gray-300 via-accent to-gray-300 dark:from-gray-800 dark:via-accent dark:to-gray-800"></div>
    <div class="flex items-center justify-between p-6 border-b border-gray-100 dark:border-white/5">
      <img class="h-10 w-auto hidden dark:block" src="/assets/logo-dark.svg" alt="شعار" />
      <img class="h-10 w-auto block dark:hidden" src="/assets/logo-light.svg" alt="شعار" />
      <button id="mobileNavClose" class="text-gray-500 hover:text-accent transition-colors" type="button" aria-label="إغلاق">
        <span class="material-symbols-outlined text-[28px]">close</span>
      </button>
    </div>
    <nav class="p-6 flex flex-col gap-4 font-bold text-lg flex-grow text-gray-700 dark:text-gray-300">
      <a class="px-4 py-3 rounded-lg hover:bg-gray-50 dark:hover:bg-white/5 transition-colors" href="/">الشجرة</a>
      <a class="px-4 py-3 rounded-lg hover:bg-gray-50 dark:hover:bg-white/5 transition-colors" href="/about">نبذة</a>
      <a class="px-4 py-3 rounded-lg hover:bg-gray-50 dark:hover:bg-white/5 transition-colors" href="/honor">قائمة السير الذاتية</a>
      <a class="px-4 py-3 rounded-lg hover:bg-gray-50 dark:hover:bg-white/5 transition-colors" href="/news">أخبار العائلة</a>
      <a class="px-4 py-3 rounded-lg text-accent bg-accent/5 border-r-2 border-accent" href="/kinship">صلة القرابة</a>
      <a class="px-4 py-3 rounded-lg hover:bg-gray-50 dark:hover:bg-white/5 transition-colors" href="/tree-pdf">مشجرة العائلة</a>
      <a class="px-4 py-3 rounded-lg hover:bg-gray-50 dark:hover:bg-white/5 transition-colors" href="/support">الدعم</a>
      <a class="px-4 py-3 rounded-lg hover:bg-gray-50 dark:hover:bg-white/5 transition-colors" href="/submit-person">إضافة بياناتك</a>
    </nav>
    <div class="p-6 border-t border-gray-100 dark:border-white/5">
      <a href="/admin/login" class="flex items-center justify-center gap-2 py-3 bg-primary text-white dark:bg-white dark:text-primary rounded-lg hover:opacity-90 transition-colors font-bold">
        <span class="material-symbols-outlined">login</span>
      </a>
    </div>
  </aside>

  <header class="sticky top-0 z-50 w-full bg-white/95 dark:bg-[#050505]/95 backdrop-blur-md border-b border-gray-200 dark:border-white/10">
    <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8 py-3 flex justify-between items-center h-20 md:h-24">
      <div class="flex items-center gap-4">
        <a href="/" class="block shrink-0">
          <img class="h-14 md:h-20 w-auto hidden dark:block" src="/assets/logo-dark.svg" alt="شعار العائلة" />
          <img class="h-14 md:h-20 w-auto block dark:hidden" src="/assets/logo-light.svg" alt="شعار العائلة" />
        </a>
        <div class="h-10 w-px bg-gray-300 dark:bg-white/20"></div>
        <div class="flex items-center justify-center">
           <h1 class="text-2xl md:text-3xl font-display text-primary dark:text-accent font-bold leading-none tracking-wide pt-1">صلة القرابة</h1>
        </div>
      </div>

      <nav class="hidden lg:flex gap-6 xl:gap-8 items-center font-sans font-bold text-sm tracking-wide uppercase text-gray-600 dark:text-gray-400">
        <a class="hover:text-accent transition-colors" href="/">الشجرة</a>
        <a class="hover:text-accent transition-colors" href="/about">نبذة</a>
        <a class="hover:text-accent transition-colors" href="/honor">قائمة السير الذاتية</a>
        <a class="hover:text-accent transition-colors" href="/news">أخبار العائلة</a>
        <a class="text-primary dark:text-white border-b-2 border-accent pb-1" href="/kinship">صلة القرابة</a>
        <a class="hover:text-accent transition-colors" href="/tree-pdf">مشجرة العائلة</a>
        <a class="hover:text-accent transition-colors" href="/support">الدعم</a>
        <a class="hover:text-accent transition-colors" href="/submit-person">إضافة بياناتك</a>
      </nav>

      <div class="flex items-center gap-3 shrink-0">
        <button id="themeBtn" class="flex items-center justify-center w-10 h-10 rounded-full border border-gray-200 dark:border-white/10 text-gray-600 dark:text-gray-400 hover:text-accent dark:hover:text-accent hover:bg-gray-50 dark:hover:bg-white/5 transition-all">
          <span class="material-symbols-outlined dark:hidden">dark_mode</span>
          <span class="material-symbols-outlined hidden dark:inline">light_mode</span>
        </button>
        <a href="/admin/login" class="hidden sm:flex p-2.5 rounded-full bg-primary text-white dark:bg-white dark:text-black hover:opacity-90 transition-all shadow-md items-center justify-center">
          <span class="material-symbols-outlined text-[22px]">login</span>
        </a>
        <button id="mobileNavBtn" class="lg:hidden flex items-center justify-center w-10 h-10 rounded-full bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 text-primary dark:text-accent hover:bg-gray-200 dark:hover:bg-white/10 transition-colors">
          <span class="material-symbols-outlined text-[24px]">menu</span>
        </button>
      </div>
    </div>
  </header>

  <main class="flex-grow relative">
    
    <section class="pt-20 pb-12 px-6 max-w-[90rem] mx-auto text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-islamic-pattern opacity-100 dark:opacity-30 pointer-events-none"></div>
      
      <img src="/assets/logo-dark.svg" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] md:w-[600px] opacity-[0.03] pointer-events-none hidden dark:block" alt="">
      <img src="/assets/logo-light.svg" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] md:w-[600px] opacity-[0.03] pointer-events-none block dark:hidden" alt="">

      <div class="w-px h-12 bg-accent mx-auto mb-6 relative z-10"></div>
      
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent/10 border border-accent/20 text-primary dark:text-accent font-bold text-sm mb-6 relative z-10">
        <span class="material-symbols-outlined text-[18px]">family_restroom</span> هذه قريبي
      </span>

      <h1 class="text-5xl md:text-7xl font-display leading-tight mb-4 relative z-10 font-bold drop-shadow-sm dark:drop-shadow-none">
        <span class="text-primary dark:text-white transition-colors duration-300">صلة</span> <span class="text-accent">القرابة</span>
      </h1>
      
      <p class="text-base md:text-lg font-sans text-gray-500 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed relative z-10">
        اكتب اسم الشخص الأول واسم الشخص الثاني ثلاثي أو رباعي، وسيقوم النظام بالبحث داخل الشجرة وحساب أقرب صلة قرابة بينهما.
      </p>
    </section>

    <section class="py-6 px-4 md:px-8 max-w-4xl mx-auto relative z-10 mb-16">
      <div class="bg-white/80 dark:bg-bg-card/80 backdrop-blur-xl border border-gray-200 dark:border-white/10 shadow-2xl rounded-[2rem] p-6 sm:p-10">
        
        <form method="get" action="/kinship" class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <label class="block">
            <span class="block font-sans font-bold text-gray-700 dark:text-gray-300 mb-2">اسم الشخص الأول</span>
            <input name="person_a" value="<%= personA || '' %>" class="w-full rounded-xl border border-gray-300 dark:border-gray-700 bg-transparent dark:bg-black/50 px-4 py-3.5 font-sans font-bold text-gray-900 dark:text-white focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-colors placeholder-gray-400 dark:placeholder-gray-500" placeholder="اكتب الاسم ثلاثي أو رباعي" required>
          </label>
          <label class="block">
            <span class="block font-sans font-bold text-gray-700 dark:text-gray-300 mb-2">اسم الشخص الثاني</span>
            <input name="person_b" value="<%= personB || '' %>" class="w-full rounded-xl border border-gray-300 dark:border-gray-700 bg-transparent dark:bg-black/50 px-4 py-3.5 font-sans font-bold text-gray-900 dark:text-white focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-colors placeholder-gray-400 dark:placeholder-gray-500" placeholder="اكتب الاسم ثلاثي أو رباعي" required>
          </label>
          <div class="md:col-span-2 flex flex-col sm:flex-row gap-4 justify-center mt-4">
            <button class="px-10 py-3.5 rounded-full bg-primary dark:bg-accent text-white dark:text-black font-sans font-bold hover:opacity-90 transition-colors shadow-md" type="submit">إظهار صلة القرابة</button>
            <a href="/kinship" class="px-10 py-3.5 rounded-full bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 text-primary dark:text-accent font-sans font-bold text-center hover:bg-gray-200 dark:hover:bg-white/10 transition-colors">مسح</a>
          </div>
        </form>

        <% if (result) { %>
          <div class="mt-10 rounded-2xl border p-6 sm:p-8 <%= result.ok ? 'bg-green-50 dark:bg-green-500/10 border-green-200 dark:border-green-500/20 text-green-900 dark:text-green-100' : 'bg-amber-50 dark:bg-amber-500/10 border-amber-200 dark:border-amber-500/20 text-amber-900 dark:text-amber-100' %>">
            <div class="flex items-center gap-3 mb-4">
              <span class="material-symbols-outlined text-[28px] <%= result.ok ? 'text-green-600 dark:text-green-400' : 'text-amber-600 dark:text-amber-400' %>">
                <%= result.ok ? 'check_circle' : 'info' %>
              </span>
              <h2 class="font-display font-bold text-3xl"><%= result.ok ? 'نتيجة صلة القرابة' : 'تنبيه' %></h2>
            </div>
            
            <p class="font-sans font-bold leading-relaxed text-lg whitespace-pre-wrap"><%= result.message %></p>
            
            <% if (result.path && result.path.length) { %>
              <div class="mt-6 pt-6 border-t <%= result.ok ? 'border-green-200 dark:border-green-500/20' : 'border-amber-200 dark:border-amber-500/20' %> flex flex-wrap gap-2">
                <% result.path.forEach(function(x){ %>
                  <a class="px-4 py-2 rounded-full bg-white/80 dark:bg-black/40 border border-black/5 dark:border-white/10 text-sm font-sans font-bold text-primary dark:text-accent hover:scale-105 transition-transform" href="/?focus=<%= x.id %>"><%= x.name %></a>
                <% }) %>
              </div>
            <% } %>
          </div>
        <% } %>
        
      </div>
    </section>

  </main>

  <footer class="bg-background-light dark:bg-bg-charcoal border-t border-gray-200 dark:border-white/10 mt-auto py-8 relative z-10">
    <div class="max-w-[90rem] mx-auto px-6 text-center flex flex-col items-center gap-3">
      <p class="text-[11px] font-sans font-bold text-gray-500 uppercase tracking-[0.1em]">
        © ٢٠٢٦ وقف عائلة خاشقجي. جميع الحقوق محفوظة.
      </p>
    </div>
  </footer>

  <script>
    document.getElementById('themeBtn')?.addEventListener('click',()=>{
      const d=document.documentElement.classList.contains('dark');
      document.documentElement.classList.toggle('dark',!d);
      localStorage.setItem('theme',!d?'dark':'light');
    });
    
    (function(){
      const b=document.getElementById('mobileNavBtn'),
            d=document.getElementById('mobileNavDrawer'),
            o=document.getElementById('mobileNavOverlay'),
            c=document.getElementById('mobileNavClose');
            
      function open(){
        d.classList.add('isOpen');
        o.classList.remove('hidden');
        document.body.style.overflow='hidden'
      }
      function close(){
        d.classList.remove('isOpen');
        o.classList.add('hidden');
        document.body.style.overflow=''
      }
      
      b?.addEventListener('click',open);
      c?.addEventListener('click',close);
      o?.addEventListener('click',close);
      d?.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));
    })();
  </script>
  
  <script src="/site-assistant.js"></script>
</body>
</html>