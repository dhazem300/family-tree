<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>أعضاء العائلة</title>

  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/styles.css"/>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@300;400;500;700;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries,line-clamp"></script>

  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#005A2B",     /* اللون الأخضر الملكي الفاخر */
            primaryDark: "#003D1D", /* أخضر داكن للتحويم */
            accent: "#E5B869",      /* ذهب سائل */
            "accent-gold": "#E5B869",
            "background-light": "#F8F8F6",
            "background-dark": "#050505",
            "bg-charcoal": "#050505",
            "card-light": "#FFFFFF",
            "card-dark": "#0A0A0A",
            "bg-card": "#0A0A0A",
            "text-cream": "#FAFAFA",
            "text-dark": "#111827",
            "text-muted": "#71717A",
            "muted-slate": "#71717A",
            gold: "#E5B869",
            "accent-gold-dark": "#D4A353",
          },
          fontFamily: {
            display: ["'Aref Ruqaa'", "serif"],
            sans: ["Tajawal", "sans-serif"],
          },
          backgroundImage: {
            "islamic-pattern": "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E5B869' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")",
            "islamic-pattern-dark": "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23E5B869' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")"
          },
          boxShadow: {
            'luxury': '0 20px 40px -10px rgba(0,0,0,0.05), 0 0 20px rgba(229,184,105,0.03)',
            'luxury-dark': '0 20px 40px -10px rgba(0,0,0,0.4), 0 0 20px rgba(229,184,105,0.05)',
          }
        }
      }
    };
  </script>

  <style type="text/tailwindcss">
    @layer utilities {
      .scrollbar-hide::-webkit-scrollbar { display: none; }
      .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
      .glass-panel {
        @apply bg-white/85 dark:bg-[#080808]/85 backdrop-blur-xl border border-accent-gold/20 shadow-luxury dark:shadow-luxury-dark;
      }
    }
  </style>

  <style>
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(229, 184, 105, 0.4); border-radius: 4px; transition: background 0.3s; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(229, 184, 105, 0.8); }

    /* حقل البحث الزجاجي */
    .search-glass {
      background: rgba(255,255,255,0.7);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(229,184,105,0.3);
      transition: all 0.4s cubic-bezier(0.19, 1, 0.22, 1);
      box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }
    html.dark .search-glass {
      background: rgba(10,10,10,0.6);
      border-color: rgba(229,184,105,0.2);
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }
    .search-glass:focus-within {
      background: rgba(255,255,255,0.98);
      border-color: #E5B869;
      box-shadow: 0 10px 30px -5px rgba(229,184,105,0.2);
      transform: translateY(-1px);
    }
    html.dark .search-glass:focus-within {
      background: rgba(10,10,10,0.95);
      box-shadow: 0 10px 30px -5px rgba(229,184,105,0.25);
    }
  </style>

  <script>
    (function () {
      const saved = localStorage.getItem("theme") || "dark";
      document.documentElement.setAttribute("data-theme", saved);
      document.documentElement.classList.toggle("dark", saved === "dark");
    })();
  </script>
</head>

<body class="bg-background-light dark:bg-bg-charcoal text-gray-900 dark:text-text-cream font-sans min-h-screen flex flex-col overflow-x-hidden selection:bg-accent/30 selection:text-gray-900 dark:selection:text-white transition-colors duration-400">

  <%- include('partials/header', {active, siteUser, pageTitle:'أعضاء العائلة', pageSubtitle:'الحسابات المقبولة داخل الموقع'}) %>

  <main class="flex-grow relative z-10">

    <section class="pt-16 pb-12 px-6 max-w-[90rem] mx-auto text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-islamic-pattern opacity-40 dark:opacity-10 pointer-events-none"></div>

      <img src="/assets/logo-dark.svg" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] md:w-[600px] opacity-[0.02] pointer-events-none hidden dark:block" alt="">
      <img src="/assets/logo-light.svg" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] md:w-[600px] opacity-[0.02] pointer-events-none block dark:hidden" alt="">

      <div class="w-px h-10 bg-gradient-to-b from-transparent via-accent to-transparent mx-auto mb-5 relative z-10"></div>
      
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent/5 border border-accent/20 text-primary dark:text-accent font-sans font-bold text-[12px] mb-4 relative z-10 shadow-sm">
        <span class="material-symbols-outlined text-[16px]">groups</span> دليل العائلة
      </span>

      <h1 class="text-4xl md:text-6xl font-display leading-tight mb-4 relative z-10 font-bold">
        <span class="text-primary dark:text-white transition-colors duration-300">أعضاء</span> <span class="text-accent">العائلة</span>
      </h1>
      
      <p class="text-[14px] md:text-base font-sans text-gray-500 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed relative z-10 font-medium">
        الحسابات المقبولة داخل الموقع، تواصل وتعرف على أبناء العمومة.
      </p>
    </section>

    <section class="px-4 sm:px-6 lg:px-8 pb-20 relative z-10">
      <div class="max-w-[90rem] mx-auto">
        
        <div class="max-w-3xl mx-auto mb-12 relative z-10">
          <form method="get" action="/family-members" class="search-glass rounded-full flex items-center p-2">
             <span class="material-symbols-outlined text-gray-400 ml-3 mr-2">search</span>
             <input name="q" value="<%= q || '' %>" class="flex-1 bg-transparent border-0 focus:ring-0 text-[15px] font-sans font-medium text-gray-800 dark:text-white placeholder-gray-400 py-3 outline-none" placeholder="ابحث بالاسم، الأب، الإقامة، العمل..." type="text" autocomplete="off" />
             <button type="submit" class="shrink-0 px-8 py-3 rounded-full bg-primary hover:bg-primaryDark text-white dark:bg-white dark:text-[#050505] dark:hover:bg-accent font-sans font-bold text-[14px] transition-all shadow-sm flex items-center gap-2">
               بحث
             </button>
          </form>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 md:gap-8">
          <% if(!members.length){ %>
            <div class="col-span-full text-center py-20 border border-dashed border-gray-300 dark:border-white/10 max-w-2xl mx-auto p-12 rounded-[24px] bg-white/50 dark:bg-black/20 backdrop-blur-sm shadow-sm">
              <div class="w-16 h-16 mx-auto rounded-full bg-primary/5 dark:bg-white/5 border border-primary/10 dark:border-white/10 text-primary dark:text-accent flex items-center justify-center mb-5">
                <span class="material-symbols-outlined text-[32px]">group_off</span>
              </div>
              <h2 class="text-2xl font-display font-bold text-primary dark:text-white mb-2">لا توجد نتائج</h2>
              <p class="font-sans text-[15px] font-medium text-gray-500">لم يتم العثور على أعضاء يطابقون بحثك.</p>
            </div>
          <% } %>

          <% members.forEach(m=>{ %>
            <a href="/family-members/<%= m.id %>" class="group relative overflow-hidden rounded-[24px] border border-gray-100 dark:border-white/5 bg-white dark:bg-[#0A0A0A] shadow-sm hover:shadow-luxury dark:hover:shadow-luxury-dark transition-all duration-500 flex flex-col">
              
              <div class="h-32 bg-primary/10 dark:bg-[#111] relative overflow-hidden shrink-0 border-b border-gray-100 dark:border-white/5 bg-cover bg-center" style="background-image:url('<%= m.cover_url || '' %>')">
                 <div class="absolute inset-0 bg-islamic-pattern opacity-20 pointer-events-none mix-blend-overlay"></div>
                 <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
              </div>
              
              <div class="px-6 flex flex-col items-center text-center -mt-12 z-20 flex-grow relative">
                
                <div class="relative w-24 h-24 rounded-2xl border-4 border-white dark:border-[#0A0A0A] bg-gray-50 dark:bg-[#111] overflow-hidden shadow-md flex items-center justify-center shrink-0 group-hover:-translate-y-1 transition-transform duration-500">
                  <img src="<%= m.avatar_url || '/assets/default-avatar.svg' %>" onerror="this.src='/assets/default-avatar.svg'" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" alt="<%= m.full_name || 'عضو' %>">
                </div>
                
                <h2 class="mt-4 font-display font-bold text-xl md:text-2xl text-primary dark:text-white leading-tight group-hover:text-accent transition-colors">
                  <%= m.full_name || 'عضو' %>
                </h2>
                <p class="text-[13px] text-accent font-sans font-bold tracking-widest mt-1">بن <%= m.father_name || '—' %></p>
                
                <% if (m.work || m.current_residence || m.origin_place) { %>
                  <p class="mt-3 text-[14px] font-medium text-gray-500 dark:text-gray-400 line-clamp-2 leading-relaxed">
                    <%= m.work || m.current_residence || m.origin_place || '' %>
                  </p>
                <% } %>
                
                <div class="mt-auto pt-6 pb-6 w-full flex flex-wrap justify-center gap-2">
                  <span class="px-3 py-1.5 rounded-lg text-[11px] font-bold flex items-center gap-1.5 shadow-sm <%= m.matched_person_id ? 'bg-[#E8F5ED] dark:bg-[#003D1D]/30 text-primary dark:text-emerald-400 border border-primary/20 dark:border-primary/40' : 'bg-gray-50 dark:bg-[#111] text-gray-500 dark:text-gray-400 border border-gray-200 dark:border-white/10' %>">
                    <span class="material-symbols-outlined text-[14px]"><%= m.matched_person_id ? 'link' : 'link_off' %></span>
                    <%= m.matched_person_id ? 'مرتبط بالشجرة' : 'غير مرتبط' %>
                  </span>
                  
                  <span class="px-3 py-1.5 rounded-lg text-[11px] font-bold flex items-center gap-1.5 bg-primary/5 dark:bg-white/5 text-primary dark:text-accent border border-primary/10 dark:border-white/10 shadow-sm">
                    <span class="material-symbols-outlined text-[14px]">visibility</span>
                    <%= m.profile_views || 0 %> مشاهدة
                  </span>
                </div>
                
              </div>
            </a>
          <% }) %>
        </div>

      </div>
    </section>

  </main>

  <footer class="bg-background-light dark:bg-[#050505] border-t border-gray-200 dark:border-white/5 mt-auto py-8 relative z-10">
    <div class="max-w-[90rem] mx-auto px-6 text-center flex flex-col items-center gap-3">
      <p class="text-[11px] font-sans font-semibold text-gray-400 dark:text-gray-600 uppercase tracking-widest">
        © ٢٠٢٦ وقف عائلة خاشقجي. جميع الحقوق محفوظة. حفظ الأنساب والاحتفاء بالتراث.
      </p>
    </div>
  </footer>

  <script src="/chat-notifications.js"></script>
</body>
</html>