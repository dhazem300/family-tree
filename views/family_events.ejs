<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>مناسبات العائلة</title><script src="/theme.js"></script><script src="https://cdn.tailwindcss.com?plugins=forms"></script><link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&family=Aref+Ruqaa:wght@700&display=swap" rel="stylesheet"><script>tailwind.config={darkMode:'class',theme:{extend:{colors:{primary:'#005A2B',accent:'#E5B869'},fontFamily:{sans:['Tajawal','sans-serif'],display:["'Aref Ruqaa'",'serif']}}}}</script></head><body class="bg-gray-50 dark:bg-[#050505] text-gray-900 dark:text-white font-sans min-h-screen">
<%- include('partials/header', {active, siteUser, pageTitle:'مناسبات العائلة', pageSubtitle:'أفراح، عزاء، مواليد، تخرج وتكريم'}) %>
<main class="max-w-6xl mx-auto p-5 grid lg:grid-cols-[1fr_380px] gap-6">
  <section class="space-y-4">
    <% if (success) { %><div class="p-4 rounded-2xl bg-green-50 text-green-700 font-black"><%= success %></div><% } %><% if (error) { %><div class="p-4 rounded-2xl bg-red-50 text-red-700 font-black"><%= error %></div><% } %>
    <% if (!events.length) { %><div class="bg-white dark:bg-white/5 rounded-[2rem] p-8 text-center text-gray-500 font-bold border border-gray-200 dark:border-white/10">لا توجد مناسبات منشورة بعد.</div><% } %>
    <% events.forEach(e => { %>
      <article class="bg-white dark:bg-white/5 rounded-[2rem] overflow-hidden border border-gray-200 dark:border-white/10 shadow-sm">
        <% if (e.image_url) { %><img src="<%= e.image_url %>" class="w-full h-64 object-cover"><% } %>
        <div class="p-6"><div class="flex flex-wrap gap-2 mb-3"><span class="px-3 py-1 rounded-full bg-primary/10 text-primary dark:bg-accent/10 dark:text-accent text-xs font-black"><%= e.event_type || 'مناسبة' %></span><span class="text-xs text-gray-500" dir="ltr"><%= e.event_date || e.created_at || '' %></span></div><h2 class="text-2xl font-black text-primary dark:text-accent"><%= e.title %></h2><p class="mt-2 text-sm text-gray-500 font-bold"><%= e.location || '' %></p><p class="mt-4 leading-8 text-gray-700 dark:text-gray-300"><%= e.description || '' %></p></div>
      </article>
    <% }) %>
  </section>
  <aside class="bg-white dark:bg-white/5 rounded-[2rem] p-6 border border-gray-200 dark:border-white/10 h-fit sticky top-24">
    <h2 class="font-black text-xl text-primary dark:text-accent mb-4">إضافة مناسبة</h2>
    <form method="post" action="/events" enctype="multipart/form-data" class="space-y-3">
      <input name="title" required placeholder="عنوان المناسبة" class="w-full h-12 rounded-2xl border-gray-200 dark:border-white/10 dark:bg-black/30">
      <select name="event_type" class="w-full h-12 rounded-2xl border-gray-200 dark:border-white/10 dark:bg-black/30"><option>فرح</option><option>عزاء</option><option>مولود</option><option>تخرج</option><option>تكريم</option><option>اجتماع عائلي</option></select>
      <input name="event_date" type="date" class="w-full h-12 rounded-2xl border-gray-200 dark:border-white/10 dark:bg-black/30">
      <input name="location" placeholder="المكان" class="w-full h-12 rounded-2xl border-gray-200 dark:border-white/10 dark:bg-black/30">
      <textarea name="description" rows="5" placeholder="التفاصيل" class="w-full rounded-2xl border-gray-200 dark:border-white/10 dark:bg-black/30"></textarea>
      <input name="image_file" type="file" accept="image/*" class="w-full rounded-2xl border-gray-200 dark:border-white/10 dark:bg-black/30">
      <button class="w-full h-12 rounded-2xl bg-primary text-white dark:bg-accent dark:text-black font-black">إرسال للمراجعة</button>
    </form>
  </aside>
</main><script src="/chat-notifications.js"></script></body></html>
