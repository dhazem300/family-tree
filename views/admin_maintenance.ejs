<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>لوحة الإدارة - وضع الصيانة</title>

  <script src="/theme.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@300;400;500;700;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries,line-clamp"></script>

  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#005A2B",
            primaryDark: "#00361A",
            accent: "#E5B869",
            "bg-light": "#F5F3F7",
            "bg-dark": "#050505",
            "card-light": "rgba(255, 255, 255, 0.8)",
            "card-dark": "rgba(15, 12, 25, 0.8)",
            "border-light": "rgba(0, 90, 43, 0.1)",
            "border-dark": "rgba(229, 184, 105, 0.1)",
          },
          fontFamily: {
            display: ["'Aref Ruqaa'", "serif"],
            sans: ["Tajawal", "sans-serif"],
          },
        }
      }
    };
  </script>

  <style type="text/tailwindcss">
    @layer utilities {
      .scrollbar-hide::-webkit-scrollbar { display: none; }
      .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
      .glass-panel { @apply backdrop-blur-2xl shadow-xl; }
    }
  </style>

  <style>
    :root { color-scheme: light; }
    html.dark { color-scheme: dark; }
    html.theme-switching,
    html.theme-switching *,
    html.theme-switching *::before,
    html.theme-switching *::after {
      transition: none !important;
      animation-duration: 0s !important;
      animation-delay: 0s !important;
    }

    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #005A2B; border-radius: 10px; }
    html.dark ::-webkit-scrollbar-thumb { background: #E5B869; }

    #nexusCanvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
    }

    html.dark .dark-toggle-icon-moon { display: none; }
    html:not(.dark) .dark-toggle-icon-sun { display: none; }

    .admin-menu-toggle {
      position: fixed !important;
      width: 1px !important;
      height: 1px !important;
      opacity: 0 !important;
      pointer-events: none !important;
      clip: rect(0 0 0 0) !important;
    }

    #mobileNavOverlay {
      display: none !important;
      opacity: 0 !important;
      pointer-events: none !important;
      z-index: 10000 !important;
    }

    #mobileNavDrawer {
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      right: auto !important;
      transform: translateX(-115%) !important;
      pointer-events: none !important;
      z-index: 10001 !important;
      transition: transform .32s cubic-bezier(0.16, 1, 0.3, 1) !important;
      display: flex !important;
      visibility: visible !important;
      opacity: 1 !important;
    }

    #adminMenuToggle:checked ~ #mobileNavDrawer {
      transform: translateX(0) !important;
      pointer-events: auto !important;
    }

    #adminMenuToggle:checked ~ #mobileNavOverlay {
      display: block !important;
      opacity: 1 !important;
      pointer-events: auto !important;
    }

    @media (max-width: 1023px) {
      body {
        height: auto !important;
        min-height: 100dvh !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
        display: block !important;
      }
      main {
        width: 100% !important;
        min-height: 100dvh !important;
        display: block !important;
      }
      main > header {
        position: sticky !important;
        top: 0 !important;
        z-index: 60 !important;
        padding: 12px !important;
        gap: 10px !important;
        flex-wrap: wrap !important;
        align-items: flex-start !important;
        background: rgba(245, 243, 247, 0.88) !important;
        backdrop-filter: blur(18px) !important;
        border-bottom: 1px solid rgba(0, 90, 43, 0.08) !important;
      }
      html.dark main > header {
        background: rgba(5, 5, 5, 0.86) !important;
        border-bottom-color: rgba(229, 184, 105, 0.12) !important;
      }
      main > header h2 { font-size: 1.25rem !important; line-height: 1.25 !important; }
      main > header > div:first-child { min-width: 0 !important; flex: 1 1 auto !important; }
      main > header > div:last-child {
        width: 100% !important;
        justify-content: flex-start !important;
        overflow-x: auto !important;
        padding-bottom: 2px !important;
      }
      .flex-1.overflow-y-auto {
        overflow: visible !important;
        padding-inline: 12px !important;
        padding-bottom: 28px !important;
      }
      #nexusCanvas { pointer-events: none !important; }
      #mobileNavBtn {
        position: relative !important;
        z-index: 10002 !important;
        pointer-events: auto !important;
        touch-action: manipulation !important;
      }
      #mobileNavDrawer { width: min(340px, 88vw) !important; max-width: 88vw !important; height: 100dvh !important; }
    }

    @media (max-width: 640px) {
      main > header { padding: 10px !important; }
      main > header h2 { font-size: 1.15rem !important; }
      main > header .uppercase { display: none !important; }
      .w-12.h-12 { width: 44px !important; height: 44px !important; }
    }

    .field-box:focus { box-shadow: 0 0 0 4px rgba(0, 90, 43, .10); }
    html.dark .field-box:focus { box-shadow: 0 0 0 4px rgba(229, 184, 105, .12); }
  </style>

  <script>
    (function () {
      const saved = localStorage.getItem("theme") || "dark";
      document.documentElement.setAttribute("data-theme", saved);
      document.documentElement.classList.toggle("dark", saved === "dark");
    })();
  </script>
</head>

<body class="bg-bg-light dark:bg-bg-dark text-gray-800 dark:text-gray-200 font-sans h-screen flex overflow-hidden selection:bg-accent selection:text-primaryDark">
  <%
    const activeAdminPage = "maintenance";
    const isSuperAdmin = Number(admin?.is_super_admin || 0) === 1;
    const canPerm = (permission) => (typeof userCan !== "function" ? true : userCan(permission));
    const canPersonRequests = canPerm("person_requests");
    const canUsers = canPerm("users");
    const canChats = canPerm("chats");
    const canRoles = canPerm("roles");
    const canBackups = canPerm("backups") || isSuperAdmin;
    const canTreeExports = canPerm("persons") || canPerm("backups") || isSuperAdmin;
    const isMaintenanceEnabled = (typeof enabled !== "undefined") && (Number(enabled || 0) === 1 || enabled === true || enabled === "true" || enabled === "1");
    const maintenanceMessage = (typeof message !== "undefined" && message) ? message : "الموقع تحت التحديث وسيعود قريبًا.";
    const savedOk = (typeof saved !== "undefined" && saved);

    const normalNavClass = "flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent";
    const activeNavClass = "flex items-center gap-3 px-4 py-3.5 rounded-2xl bg-primary/10 dark:bg-accent/10 text-primary dark:text-accent font-bold text-sm border border-primary/20 dark:border-accent/20 transition-all relative overflow-hidden shadow-sm";
    const mobileNormalNavClass = "flex items-center gap-3 px-4 py-4 rounded-2xl border border-transparent hover:bg-gray-50 dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent transition-colors";
    const mobileActiveNavClass = "flex items-center gap-3 px-4 py-4 rounded-2xl bg-primary/10 dark:bg-accent/10 text-primary dark:text-accent transition-colors border border-primary/20 dark:border-accent/20";

    const menuGroups = [
      {
        title: "نظرة عامة",
        items: [
          { key: "dashboard", href: "/admin/dashboard", icon: "dashboard", label: "لوحة الإحصائيات", show: true }
        ]
      },
      {
        title: "إدارة العائلة والبيانات",
        items: [
          { key: "persons", href: "/admin", icon: "group", label: "إدارة الأفراد", show: true },
          { key: "person_requests", href: "/admin/person-requests", icon: "fact_check", label: "طلبات الأفراد", show: canPersonRequests },
          { key: "pages", href: "/admin/pages", icon: "history_edu", label: "إدارة الصفحات", show: true },
          { key: "honor", href: "/admin/honor", icon: "workspace_premium", label: "السير الذاتية", show: true },
          { key: "news", href: "/admin/news", icon: "newspaper", label: "الأخبار والمناسبات", show: true }
        ]
      },
      {
        title: "المستخدمون والتواصل",
        items: [
          { key: "users", href: "/admin/users", icon: "groups", label: "مستخدمي الموقع", show: canUsers },
          { key: "chats", href: "/admin/chats", icon: "forum", label: "إدارة المحادثات", show: canChats },
          { key: "tree_exports", href: "/admin/tree-exports", icon: "file_export", label: "سجل تصدير الشجرة", show: canTreeExports },
          { key: "support", href: "/admin/support-messages", icon: "mail", label: "رسائل الدعم", show: true }
        ]
      },
      {
        title: "النظام والصلاحيات",
        items: [
          { key: "roles", href: "/admin/roles", icon: "manage_accounts", label: "وظائف الأفراد", show: canRoles },
          { key: "activity", href: "/admin/activity", icon: "manage_history", label: "سجل النشاط", show: isSuperAdmin },
          { key: "approvals", href: "/admin/approvals", icon: "verified_user", label: "مركز الموافقة", show: true },
          { key: "maintenance", href: "/admin/maintenance", icon: "construction", label: "وضع الصيانة", show: isSuperAdmin },
          { key: "backups", href: "/admin/backups", icon: "backup", label: "النسخ الاحتياطي", show: canBackups }
        ]
      }
    ];
  %>

  <input id="adminMenuToggle" type="checkbox" class="admin-menu-toggle" aria-hidden="true" />
  <canvas id="nexusCanvas"></canvas>
  <div class="fixed inset-0 bg-gradient-to-b from-white/40 to-white/80 dark:from-black/40 dark:to-[#050505]/90 pointer-events-none z-[1]"></div>

  <aside class="relative z-20 hidden lg:flex flex-col w-[280px] h-[calc(100vh-2rem)] my-4 mx-4 bg-card-light dark:bg-card-dark glass-panel rounded-3xl border border-border-light dark:border-border-dark overflow-hidden shrink-0">
    <div class="flex items-center gap-3 p-6 border-b border-border-light dark:border-border-dark shrink-0">
      <div class="w-12 h-12 flex items-center justify-center rounded-2xl bg-primary dark:bg-accent text-white dark:text-black shadow-lg">
        <span class="material-symbols-outlined text-[28px]">shield_person</span>
      </div>
      <div>
        <h1 class="font-display font-bold text-xl leading-none text-primary dark:text-white">عائلة خاشقجي</h1>
        <p class="text-[10px] font-bold text-gray-500 dark:text-accent uppercase tracking-widest mt-1.5">نظام الإدارة المركزية</p>
      </div>
    </div>

    <nav class="flex-1 overflow-y-auto p-4 space-y-6">
      <% menuGroups.forEach(function(group){ %>
        <div class="space-y-2">
          <p class="px-3 text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-3"><%= group.title %></p>
          <% group.items.filter(item => item.show).forEach(function(item){ %>
            <% const isActive = item.key === activeAdminPage; %>
            <a href="<%= item.href %>" class="<%= isActive ? activeNavClass : normalNavClass %>">
              <% if (isActive) { %><div class="absolute right-0 top-1/2 -translate-y-1/2 w-1.5 h-6 rounded-l-full bg-primary dark:bg-accent shadow-[0_0_10px_rgba(229,184,105,0.8)]"></div><% } %>
              <span class="material-symbols-outlined text-[22px]"><%= item.icon %></span>
              <span><%= item.label %></span>
            </a>
          <% }) %>
        </div>
      <% }) %>
    </nav>

    <div class="p-4 border-t border-border-light dark:border-border-dark shrink-0 m-2 rounded-2xl bg-white/50 dark:bg-black/30">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-cover bg-center border border-gray-200 dark:border-white/10 shadow-sm" style="background-image:url('/assets/default-avatar.svg'); background-color:#ddd;"></div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-bold text-gray-900 dark:text-white truncate"><%= admin?.username || "مدير النظام" %></p>
          <p class="text-[10px] text-primary dark:text-accent uppercase tracking-widest mt-0.5 font-bold">Admin</p>
        </div>
        <form method="post" action="/admin/logout" class="m-0">
          <button type="submit" class="w-9 h-9 flex items-center justify-center rounded-xl bg-red-50 dark:bg-red-500/10 text-red-500 hover:bg-red-500 hover:text-white transition-all shadow-sm" title="تسجيل خروج">
            <span class="material-symbols-outlined text-[18px]">logout</span>
          </button>
        </form>
      </div>
    </div>
  </aside>

  <main class="flex-1 flex flex-col min-w-0 h-full relative z-10">
    <header class="flex items-center justify-between p-4 lg:p-8 shrink-0 gap-4">
      <div class="flex items-center gap-3 min-w-0">
        <label id="mobileNavBtn" for="adminMenuToggle" class="lg:hidden flex items-center justify-center w-12 h-12 rounded-2xl bg-card-light dark:bg-card-dark glass-panel border border-border-light dark:border-border-dark text-primary dark:text-accent shadow-sm cursor-pointer" aria-controls="mobileNavDrawer" aria-label="فتح القائمة">
          <span class="material-symbols-outlined text-[24px]">menu</span>
        </label>

        <div class="min-w-0">
          <h2 class="text-2xl md:text-3xl font-display font-bold text-primary dark:text-white tracking-tight leading-none mb-1.5">وضع الصيانة</h2>
          <div class="flex items-center gap-1.5 text-gray-500 text-[11px] font-bold uppercase tracking-widest">
            <span>لوحة الإدارة</span>
            <span class="material-symbols-outlined text-[14px]">chevron_left</span>
            <span>النظام والصلاحيات</span>
            <span class="material-symbols-outlined text-[14px]">chevron_left</span>
            <span class="text-accent">وضع الصيانة</span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3 shrink-0 overflow-x-auto scrollbar-hide">
        <button id="themeBtn" class="flex items-center justify-center w-12 h-12 rounded-2xl bg-card-light dark:bg-card-dark glass-panel border border-border-light dark:border-border-dark text-gray-600 dark:text-accent shadow-sm hover:-translate-y-1 transition-transform" type="button" title="تبديل المظهر">
          <span class="material-symbols-outlined text-[22px] dark-toggle-icon-moon">dark_mode</span>
          <span class="material-symbols-outlined hidden dark:block text-[24px] dark-toggle-icon-sun">light_mode</span>
        </button>

        <a href="/admin/dashboard" class="hidden sm:flex items-center gap-2 px-5 h-12 rounded-2xl font-bold text-sm bg-card-light dark:bg-card-dark glass-panel border border-border-light dark:border-border-dark text-primary dark:text-accent shadow-sm hover:-translate-y-1 transition-transform">
          <span class="material-symbols-outlined text-[22px]">dashboard</span>
          <span class="hidden md:inline">لوحة الإحصائيات</span>
        </a>

        <a href="/admin/backups" class="hidden md:flex items-center gap-2 px-5 h-12 rounded-2xl font-bold text-sm bg-card-light dark:bg-card-dark glass-panel border border-border-light dark:border-border-dark text-primary dark:text-accent shadow-sm hover:-translate-y-1 transition-transform">
          <span class="material-symbols-outlined text-[22px]">backup</span>
          <span class="hidden lg:inline">النسخ الاحتياطي</span>
        </a>
      </div>
    </header>

    <div class="flex-1 overflow-y-auto px-4 lg:px-8 pb-12">
      <div class="max-w-[100rem] mx-auto space-y-8">
        <% if (savedOk) { %>
          <div class="bg-green-100 dark:bg-green-500/10 text-green-800 dark:text-green-300 border border-green-200 dark:border-green-500/20 rounded-2xl px-5 py-4 font-bold flex items-center gap-3">
            <span class="material-symbols-outlined">check_circle</span>
            <span>تم حفظ إعدادات الصيانة بنجاح.</span>
          </div>
        <% } %>

        <section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 lg:gap-6">
          <div class="xl:col-span-2 bg-card-light dark:bg-card-dark glass-panel rounded-[2rem] border border-border-light dark:border-border-dark p-6 flex items-center gap-5 shadow-sm">
            <div class="w-16 h-16 rounded-2xl <%= isMaintenanceEnabled ? 'bg-amber-100 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300' : 'bg-green-100 dark:bg-green-500/20 text-green-700 dark:text-green-300' %> flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[32px]"><%= isMaintenanceEnabled ? 'engineering' : 'verified' %></span>
            </div>
            <div class="min-w-0">
              <p class="text-[11px] font-bold text-gray-500 uppercase tracking-widest mb-1">حالة الموقع العامة</p>
              <p class="text-2xl font-black text-primary dark:text-white leading-tight"><%= isMaintenanceEnabled ? 'وضع الصيانة مفعل حالياً' : 'الموقع يعمل بشكل طبيعي' %></p>
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-2 leading-7">يمكن للإدارة متابعة العمل والدخول للوحة التحكم أثناء تفعيل وضع الصيانة.</p>
            </div>
          </div>

          <div class="bg-card-light dark:bg-card-dark glass-panel rounded-[2rem] border border-border-light dark:border-border-dark p-5 flex items-center gap-4 shadow-sm">
            <div class="w-14 h-14 rounded-2xl bg-primary/10 dark:bg-accent/10 flex items-center justify-center text-primary dark:text-accent">
              <span class="material-symbols-outlined text-[28px]">visibility</span>
            </div>
            <div>
              <p class="text-[11px] font-bold text-gray-500 uppercase tracking-widest mb-0.5">ما يراه الزائر</p>
              <p class="text-xl font-black text-primary dark:text-white leading-none"><%= isMaintenanceEnabled ? 'رسالة صيانة' : 'الموقع كامل' %></p>
            </div>
          </div>

          <div class="bg-card-light dark:bg-card-dark glass-panel rounded-[2rem] border border-border-light dark:border-border-dark p-5 flex items-center gap-4 shadow-sm">
            <div class="w-14 h-14 rounded-2xl bg-blue-100 dark:bg-blue-500/15 flex items-center justify-center text-blue-700 dark:text-blue-300">
              <span class="material-symbols-outlined text-[28px]">admin_panel_settings</span>
            </div>
            <div>
              <p class="text-[11px] font-bold text-gray-500 uppercase tracking-widest mb-0.5">وصول الإدارة</p>
              <p class="text-xl font-black text-primary dark:text-white leading-none">مسموح</p>
            </div>
          </div>
        </section>

        <section class="grid grid-cols-1 xl:grid-cols-3 gap-4 lg:gap-6">
          <div class="xl:col-span-2 bg-card-light dark:bg-card-dark glass-panel rounded-3xl shadow-sm border border-border-light dark:border-border-dark overflow-hidden">
            <div class="p-5 border-b border-border-light dark:border-border-dark flex items-center justify-between gap-4 flex-wrap">
              <div>
                <h3 class="font-black text-lg text-primary dark:text-white">إعدادات وضع الصيانة</h3>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">تحكم مباشر في تفعيل الصيانة وتعديل الرسالة الظاهرة للزوار.</p>
              </div>
              <span class="px-4 py-2 rounded-xl text-xs font-black <%= isMaintenanceEnabled ? 'bg-amber-100 text-amber-800 dark:bg-amber-500/10 dark:text-amber-200' : 'bg-green-100 text-green-800 dark:bg-green-500/10 dark:text-green-200' %>">
                <%= isMaintenanceEnabled ? 'الصيانة مفعلة' : 'الصيانة متوقفة' %>
              </span>
            </div>

            <form method="post" action="/admin/maintenance" class="p-5 space-y-5">
              <label class="flex items-start gap-4 p-4 rounded-2xl bg-white/50 dark:bg-white/5 border border-black/5 dark:border-white/10 cursor-pointer hover:border-primary/20 dark:hover:border-accent/20 transition-colors">
                <input type="checkbox" name="maintenance_enabled" value="1" class="mt-1 w-5 h-5 rounded text-primary border-gray-300 dark:border-white/20 dark:bg-black/30" <%= isMaintenanceEnabled ? 'checked' : '' %>>
                <span>
                  <span class="block font-black text-lg text-gray-900 dark:text-white">تفعيل وضع الصيانة للموقع العام</span>
                  <span class="block text-sm text-gray-500 dark:text-gray-400 mt-1 leading-7">عند التفعيل، سيتم إخفاء الواجهة العامة وإظهار صفحة الصيانة فقط للزوار مع استمرار دخول الإدارة.</span>
                </span>
              </label>

              <div>
                <label class="block font-black mb-2 text-gray-900 dark:text-white">رسالة الصيانة</label>
                <textarea name="maintenance_message" rows="7" class="field-box w-full rounded-2xl border border-gray-200 dark:border-white/10 bg-white/80 dark:bg-black/20 p-4 font-bold text-gray-800 dark:text-white outline-none leading-8" placeholder="اكتب رسالة واضحة للزوار..."><%= maintenanceMessage %></textarea>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">يفضل كتابة رسالة مختصرة وواضحة مثل: الموقع تحت التحديث وسيعود قريباً.</p>
              </div>

              <div class="flex flex-wrap gap-3">
                <button class="flex items-center gap-2 px-6 h-12 rounded-2xl font-bold text-sm bg-primary dark:bg-accent text-white dark:text-black shadow-[0_5px_20px_rgba(0,90,43,0.25)] dark:shadow-[0_5px_20px_rgba(229,184,105,0.20)] hover:-translate-y-1 transition-transform" type="submit">
                  <span class="material-symbols-outlined text-[22px]">save</span>
                  <span>حفظ الإعدادات</span>
                </button>
                <a href="/" class="flex items-center gap-2 px-6 h-12 rounded-2xl font-bold text-sm bg-card-light dark:bg-card-dark glass-panel border border-border-light dark:border-border-dark text-primary dark:text-accent shadow-sm hover:-translate-y-1 transition-transform">
                  <span class="material-symbols-outlined text-[22px]">preview</span>
                  <span>معاينة الموقع</span>
                </a>
              </div>
            </form>
          </div>

          <div class="space-y-4">
            <section class="bg-card-light dark:bg-card-dark glass-panel rounded-3xl shadow-sm border border-border-light dark:border-border-dark overflow-hidden">
              <div class="p-5 border-b border-border-light dark:border-border-dark">
                <h3 class="font-black text-lg text-primary dark:text-white">ملخص الحالة</h3>
              </div>
              <div class="p-5 space-y-4">
                <div class="rounded-2xl p-4 <%= isMaintenanceEnabled ? 'bg-amber-100 dark:bg-amber-500/10 text-amber-900 dark:text-amber-200 border border-amber-200 dark:border-amber-500/20' : 'bg-green-100 dark:bg-green-500/10 text-green-900 dark:text-green-200 border border-green-200 dark:border-green-500/20' %>">
                  <p class="font-black mb-1"><%= isMaintenanceEnabled ? 'الصيانة مفعلة' : 'الصيانة متوقفة' %></p>
                  <p class="text-sm opacity-90 leading-7"><%= isMaintenanceEnabled ? 'سيشاهد الزوار صفحة الصيانة حالياً.' : 'الموقع العام متاح للزوار بشكل طبيعي.' %></p>
                </div>
                <div class="rounded-2xl p-4 bg-white/50 dark:bg-white/5 border border-black/5 dark:border-white/10">
                  <p class="font-black text-primary dark:text-white mb-2">نصيحة تشغيل</p>
                  <p class="text-sm text-gray-600 dark:text-gray-300 leading-7">قبل تفعيل الصيانة، تأكد من انتهاء العمليات الحساسة مثل رفع الأخبار أو تحديث بيانات الأفراد حتى لا يتم قطع تجربة الزائر أثناء التصفح.</p>
                </div>
              </div>
            </section>

            <section class="bg-card-light dark:bg-card-dark glass-panel rounded-3xl shadow-sm border border-border-light dark:border-border-dark p-5">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-11 h-11 rounded-2xl bg-primary/10 dark:bg-accent/10 flex items-center justify-center text-primary dark:text-accent">
                  <span class="material-symbols-outlined">security</span>
                </div>
                <h3 class="font-black text-primary dark:text-white">صلاحيات الصيانة</h3>
              </div>
              <p class="text-sm text-gray-600 dark:text-gray-300 leading-7">هذه الصفحة مخصصة للإدارة العليا، وتؤثر على الواجهة العامة للموقع فقط دون إيقاف لوحة الإدارة.</p>
            </section>
          </div>
        </section>
      </div>
    </div>
  </main>

  <aside id="mobileNavDrawer" class="fixed top-0 left-0 h-full w-[320px] max-w-[85vw] bg-card-light dark:bg-card-dark glass-panel border-r border-border-light dark:border-border-dark z-[90] flex flex-col lg:hidden">
    <div class="h-1.5 w-full bg-primary dark:bg-accent"></div>
    <div class="flex items-center justify-between p-6 border-b border-border-light dark:border-border-dark shrink-0">
      <div>
        <h1 class="font-display font-bold text-xl leading-none text-primary dark:text-white">عائلة خاشقجي</h1>
        <p class="text-[10px] font-bold text-gray-500 dark:text-accent uppercase tracking-widest mt-1.5">نظام الإدارة</p>
      </div>
      <label id="mobileNavClose" for="adminMenuToggle" class="w-10 h-10 rounded-full bg-gray-100 dark:bg-white/5 flex items-center justify-center text-gray-500 hover:text-primary dark:hover:text-accent transition-colors cursor-pointer" aria-label="إغلاق القائمة">
        <span class="material-symbols-outlined text-[24px]">close</span>
      </label>
    </div>

    <nav class="flex-1 overflow-y-auto p-6 space-y-5 text-sm font-bold text-gray-700 dark:text-gray-300">
      <% menuGroups.forEach(function(group){ %>
        <div class="space-y-2">
          <p class="px-3 text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-3"><%= group.title %></p>
          <% group.items.filter(item => item.show).forEach(function(item){ %>
            <% const isActive = item.key === activeAdminPage; %>
            <a href="<%= item.href %>" class="<%= isActive ? mobileActiveNavClass : mobileNormalNavClass %>">
              <span class="material-symbols-outlined <%= isActive ? '' : 'text-gray-400' %>"><%= item.icon %></span>
              <span><%= item.label %></span>
            </a>
          <% }) %>
        </div>
      <% }) %>

      <div class="my-4 border-t border-border-light dark:border-border-dark"></div>
      <form method="post" action="/admin/logout" class="m-0 mt-4">
        <button type="submit" class="w-full flex items-center justify-center gap-2 px-4 py-4 rounded-2xl border border-red-200 dark:border-red-900/30 text-red-600 dark:text-red-400 bg-red-50/50 dark:bg-red-500/10 hover:bg-red-50 transition-colors">
          <span class="material-symbols-outlined">logout</span>
          <span>تسجيل خروج</span>
        </button>
      </form>
    </nav>
  </aside>
  <label id="mobileNavOverlay" for="adminMenuToggle" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[80] hidden" aria-hidden="true"></label>

  <script>
    (function () {
      const btn = document.getElementById("themeBtn");
      function setTheme(next) {
        document.documentElement.classList.add("theme-switching");
        document.documentElement.setAttribute("data-theme", next);
        document.documentElement.classList.toggle("dark", next === "dark");
        localStorage.setItem("theme", next);
        if (window.initNexus) window.initNexus();
        requestAnimationFrame(() => {
          requestAnimationFrame(() => document.documentElement.classList.remove("theme-switching"));
        });
      }
      btn?.addEventListener("click", () => {
        const cur = document.documentElement.getAttribute("data-theme") || "dark";
        setTheme(cur === "dark" ? "light" : "dark");
      });
    })();

    (function() {
      const canvas = document.getElementById('nexusCanvas');
      if(!canvas) return;
      const ctx = canvas.getContext('2d');
      let width, height, particles = [];
      const numParticles = window.innerWidth > 1024 ? 42 : 18;
      let mouseX = -1000, mouseY = -1000;
      let dotColor, lineColor, connectionColor;

      function setColors() {
        const isDark = document.documentElement.classList.contains('dark');
        dotColor = isDark ? 'rgba(229, 184, 105, 0.35)' : 'rgba(0, 90, 43, 0.28)';
        lineColor = isDark ? 'rgba(229, 184, 105, 0.08)' : 'rgba(0, 90, 43, 0.08)';
        connectionColor = isDark ? 'rgba(229, 184, 105, 0.18)' : 'rgba(0, 90, 43, 0.16)';
      }

      function resize() {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      }

      function initParticles() {
        particles = [];
        for (let i = 0; i < numParticles; i++) {
          particles.push({
            x: Math.random() * width,
            y: Math.random() * height,
            vx: (Math.random() - 0.5) * 0.45,
            vy: (Math.random() - 0.5) * 0.45,
            radius: Math.random() * 1.8 + 1.2
          });
        }
      }

      function animate() {
        ctx.clearRect(0, 0, width, height);
        particles.forEach((p, i) => {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0 || p.x > width) p.vx *= -1;
          if (p.y < 0 || p.y > height) p.vy *= -1;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
          ctx.fillStyle = dotColor;
          ctx.fill();

          for (let j = i + 1; j < particles.length; j++) {
            const p2 = particles[j];
            const dist = Math.hypot(p.x - p2.x, p.y - p2.y);
            if (dist < 110) {
              ctx.beginPath();
              ctx.moveTo(p.x, p.y);
              ctx.lineTo(p2.x, p2.y);
              ctx.strokeStyle = lineColor;
              ctx.lineWidth = 1;
              ctx.stroke();
            }
          }

          const mouseDist = Math.hypot(p.x - mouseX, p.y - mouseY);
          if (mouseDist < 140) {
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(mouseX, mouseY);
            ctx.strokeStyle = connectionColor;
            ctx.lineWidth = 1.2;
            ctx.stroke();
          }
        });
        requestAnimationFrame(animate);
      }

      window.initNexus = function() { setColors(); };
      resize();
      setColors();
      initParticles();
      animate();
      window.addEventListener('resize', () => { resize(); initParticles(); });
      window.addEventListener('mousemove', e => { mouseX = e.clientX; mouseY = e.clientY; });
      window.addEventListener('mouseleave', () => { mouseX = -1000; mouseY = -1000; });
    })();
  </script>
</body>
</html>
