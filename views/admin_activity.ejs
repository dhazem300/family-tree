  <script>
    (function () { const btn = document.getElementById("themeBtn"); function setTheme(next) { document.documentElement.setAttribute("data-theme", next); document.documentElement.classList.toggle("dark", next === "dark"); localStorage.setItem("theme", next); if (window.initNexus) window.initNexus(); } btn?.addEventListener("click", () => { const cur = document.documentElement.getAttribute("data-theme") || "dark"; setTheme(cur === "dark" ? "light" : "dark"); }); })();
    (function() { const canvas = document.getElementById('nexusCanvas'); if(!canvas) return; const ctx = canvas.getContext('2d'); let width, height, particles = []; const numParticles = window.innerWidth > 1024 ? 110 : 60; let mouseX = -1000, mouseY = -1000; let dotColor, lineColor, connectionColor; function setColors() { const isDark = document.documentElement.classList.contains('dark'); dotColor = isDark ? 'rgba(229, 184, 105, 0.35)' : 'rgba(0, 90, 43, 0.28)'; lineColor = isDark ? 'rgba(229, 184, 105, 0.08)' : 'rgba(0, 90, 43, 0.08)'; connectionColor = isDark ? 'rgba(229, 184, 105, 0.18)' : 'rgba(0, 90, 43, 0.16)'; } function resize() { width = canvas.width = window.innerWidth; height = canvas.height = window.innerHeight; } function initParticles() { particles = []; for (let i=0;i<numParticles;i++) particles.push({ x: Math.random()*width, y: Math.random()*height, vx:(Math.random()-0.5)*0.45, vy:(Math.random()-0.5)*0.45, radius: Math.random()*1.8+1.2 }); } function animate() { ctx.clearRect(0,0,width,height); particles.forEach((p,i)=>{ p.x+=p.vx; p.y+=p.vy; if(p.x<0||p.x>width) p.vx*=-1; if(p.y<0||p.y>height) p.vy*=-1; ctx.beginPath(); ctx.arc(p.x,p.y,p.radius,0,Math.PI*2); ctx.fillStyle=dotColor; ctx.fill(); for(let j=i+1;j<particles.length;j++){ const p2=particles[j]; const dist=Math.hypot(p.x-p2.x,p.y-p2.y); if(dist<110){ ctx.beginPath(); ctx.moveTo(p.x,p.y); ctx.lineTo(p2.x,p2.y); ctx.strokeStyle=lineColor; ctx.lineWidth=1; ctx.stroke(); } } const mouseDist = Math.hypot(p.x-mouseX,p.y-mouseY); if(mouseDist<140){ ctx.beginPath(); ctx.moveTo(p.x,p.y); ctx.lineTo(mouseX,mouseY); ctx.strokeStyle=connectionColor; ctx.lineWidth=1.2; ctx.stroke(); } }); requestAnimationFrame(animate); } window.initNexus = function() { setColors(); }; resize(); setColors(); initParticles(); animate(); window.addEventListener('resize',()=>{ resize(); initParticles(); }); window.addEventListener('mousemove', e => { mouseX=e.clientX; mouseY=e.clientY; }); window.addEventListener('mouseleave',()=>{ mouseX=-1000; mouseY=-1000; }); })();
  </script>

<script>
  (function finalAdminMenuFix() {
    function ready(fn) {
      if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", fn);
      else fn();
    }

    function getParts() {
      return {
        btn: document.getElementById("mobileNavBtn"),
        drawer: document.getElementById("mobileNavDrawer"),
        overlay: document.getElementById("mobileNavOverlay"),
        closeBtn: document.getElementById("mobileNavClose")
      };
    }

    window.openAdminMobileMenu = function (event) {
      if (event) {
        event.preventDefault();
        event.stopPropagation();
      }
      const { drawer, overlay } = getParts();
      if (!drawer || !overlay) return false;

      drawer.classList.add("admin-menu-open", "isOpen", "mobile-menu-open");
      overlay.classList.add("admin-menu-open");
      overlay.classList.remove("hidden");
      document.body.classList.add("admin-menu-lock");

      drawer.style.setProperty("left", "0", "important");
      drawer.style.setProperty("right", "auto", "important");
      drawer.style.setProperty("display", "flex", "important");
      drawer.style.setProperty("visibility", "visible", "important");
      drawer.style.setProperty("opacity", "1", "important");
      drawer.style.setProperty("pointer-events", "auto", "important");
      drawer.style.setProperty("transform", "translate3d(0,0,0)", "important");

      overlay.style.setProperty("display", "block", "important");
      return false;
    };

    window.closeAdminMobileMenu = function (event) {
      if (event) {
        event.preventDefault();
        event.stopPropagation();
      }
      const { drawer, overlay } = getParts();
      if (!drawer || !overlay) return false;

      drawer.classList.remove("admin-menu-open", "isOpen", "mobile-menu-open");
      overlay.classList.remove("admin-menu-open");
      overlay.classList.add("hidden");
      document.body.classList.remove("admin-menu-lock");

      drawer.style.setProperty("transform", "translate3d(-120%,0,0)", "important");
      drawer.style.setProperty("pointer-events", "none", "important");
      overlay.style.setProperty("display", "none", "important");
      return false;
    };

    ready(function () {
      const { btn, drawer, overlay, closeBtn } = getParts();
      if (!btn || !drawer || !overlay) return;

      btn.setAttribute("onclick", "return window.openAdminMobileMenu(event)");
      btn.style.setProperty("pointer-events", "auto", "important");
      btn.style.setProperty("z-index", "100002", "important");

      drawer.style.setProperty("left", "0", "important");
      drawer.style.setProperty("right", "auto", "important");
      drawer.style.setProperty("transform", "translate3d(-120%,0,0)", "important");
      drawer.style.setProperty("pointer-events", "none", "important");
      overlay.style.setProperty("display", "none", "important");

      ["click", "pointerup", "touchend"].forEach(function (evt) {
        btn.addEventListener(evt, window.openAdminMobileMenu, { capture: true, passive: false });
        closeBtn && closeBtn.addEventListener(evt, window.closeAdminMobileMenu, { capture: true, passive: false });
        overlay.addEventListener(evt, window.closeAdminMobileMenu, { capture: true, passive: false });
      });

      drawer.querySelectorAll("a").forEach(function (link) {
        link.addEventListener("click", function () {
          const { drawer, overlay } = getParts();
          drawer && drawer.classList.remove("admin-menu-open", "isOpen", "mobile-menu-open");
          overlay && overlay.classList.remove("admin-menu-open");
          overlay && overlay.classList.add("hidden");
          document.body.classList.remove("admin-menu-lock");
        }, { capture: false });
      });
    });
  })();
</script>

