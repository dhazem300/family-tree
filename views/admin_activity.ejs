<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>لوحة الإدارة - سجل النشاطات</title>
  <script src="/theme.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@300;400;500;700;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script>
    tailwind.config = { darkMode: "class", theme: { extend: {
      colors: { primary: "#005A2B", primaryDark: "#00361A", accent: "#E5B869", "bg-light": "#F5F3F7", "bg-dark": "#050505", "card-light": "rgba(255, 255, 255, 0.8)", "card-dark": "rgba(15, 12, 25, 0.8)", "border-light": "rgba(0, 90, 43, 0.1)", "border-dark": "rgba(229, 184, 105, 0.1)" },
      fontFamily: { display: ["'Aref Ruqaa'", "serif"], sans: ["Tajawal", "sans-serif"] }
    }}};
  </script>
  <style type="text/tailwindcss">@layer utilities { .glass-panel { @apply backdrop-blur-2xl shadow-xl; } }

    /* ===== Responsive admin layout: mobile + tablet ===== */
    @media (max-width: 1279px) {
      body {
        height: auto !important;
        min-height: 100dvh !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
        display: block !important;
      }
      main {
        width: 100% !important;
        min-height: 100dvh !important;
        display: block !important;
      }
      main > header {
        position: sticky !important;
        top: 0 !important;
        z-index: 60 !important;
        padding: 12px !important;
        gap: 10px !important;
        flex-wrap: wrap !important;
        align-items: flex-start !important;
        background: rgba(245, 243, 247, 0.88) !important;
        backdrop-filter: blur(18px) !important;
        border-bottom: 1px solid rgba(0, 90, 43, 0.08) !important;
      }
      html.dark main > header {
        background: rgba(5, 5, 5, 0.86) !important;
        border-bottom-color: rgba(229, 184, 105, 0.12) !important;
      }
      main > header h2 {
        font-size: 1.35rem !important;
        line-height: 1.25 !important;
      }
      main > header > div:first-child {
        min-width: 0 !important;
        flex: 1 1 auto !important;
      }
      main > header > div:last-child {
        width: 100% !important;
        justify-content: flex-start !important;
        overflow-x: auto !important;
        padding-bottom: 2px !important;
      }
      main > header > div:last-child a,
      main > header > div:last-child button {
        flex: 0 0 auto !important;
      }
      .flex-1.overflow-y-auto {
        overflow: visible !important;
        padding-inline: 12px !important;
        padding-bottom: 28px !important;
      }
      .max-w-\[100rem\], .max-w-7xl, .max-w-5xl {
        width: 100% !important;
        max-width: 100% !important;
      }
      .grid {
        gap: 12px !important;
      }
      .rounded-\[2rem\], .rounded-3xl {
        border-radius: 1.25rem !important;
      }
      #mobileNavDrawer {
        right: auto !important;
        left: 0 !important;
        width: min(340px, 88vw) !important;
        transform: translateX(-115%) !important;
      }
      #mobileNavDrawer.isOpen {
        transform: translateX(0) !important;
      }
    }

    @media (max-width: 640px) {
      main > header { padding: 10px !important; }
      main > header h2 { font-size: 1.18rem !important; }
      main > header .uppercase { display: none !important; }
      .w-12.h-12 { width: 44px !important; height: 44px !important; }
      table { font-size: 12px !important; }
    }


    /* ===== FINAL mobile/tablet admin drawer fix ===== */
    @media (max-width: 1279px) {
      #mobileNavBtn {
        position: relative !important;
        z-index: 100002 !important;
        pointer-events: auto !important;
        cursor: pointer !important;
        touch-action: manipulation !important;
      }
      #mobileNavDrawer {
        display: flex !important;
        position: fixed !important;
        top: 0 !important;
        bottom: auto !important;
        left: 0 !important;
        right: auto !important;
        width: min(360px, 88vw) !important;
        max-width: 88vw !important;
        height: 100dvh !important;
        max-height: 100dvh !important;
        z-index: 100001 !important;
        visibility: visible !important;
        opacity: 1 !important;
        pointer-events: none !important;
        transform: translate3d(-120%, 0, 0) !important;
        transition: transform .32s cubic-bezier(.2,.8,.2,1) !important;
        border-left: 0 !important;
        border-right: 1px solid rgba(229,184,105,.22) !important;
      }
      #mobileNavDrawer.admin-menu-open {
        transform: translate3d(0, 0, 0) !important;
        pointer-events: auto !important;
      }
      #mobileNavOverlay {
        display: none !important;
        position: fixed !important;
        inset: 0 !important;
        z-index: 100000 !important;
        background: rgba(0,0,0,.62) !important;
        backdrop-filter: blur(7px) !important;
      }
      #mobileNavOverlay.admin-menu-open {
        display: block !important;
      }
      body.admin-menu-lock {
        overflow: hidden !important;
        touch-action: none !important;
      }
    }
</style>
  <style>
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #005A2B; border-radius: 10px; }
    html.dark ::-webkit-scrollbar-thumb { background: #E5B869; }
    #nexusCanvas { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: auto; }
    html.dark .dark-toggle-icon-moon { display: none; }
    html:not(.dark) .dark-toggle-icon-sun { display: none; }
    #mobileNavOverlay.hidden { display: none; }
    #mobileNavOverlay { display: block; }
    #mobileNavDrawer { transform: translateX(-110%); transition: transform .4s cubic-bezier(0.16,1,0.3,1); }
    #mobileNavDrawer.isOpen { transform: translateX(0); }
    .interactive-row { transition: all .25s ease; border-right: 3px solid transparent; }
    .interactive-row:hover { background: #fff !important; border-right-color: #005A2B; transform: translateX(-3px); }
    html.dark .interactive-row:hover { background: rgba(255,255,255,.03) !important; border-right-color: #E5B869; }
  </style>
  <script>
    (function () {
      const saved = localStorage.getItem("theme") || "dark";
      document.documentElement.setAttribute("data-theme", saved);
      document.documentElement.classList.toggle("dark", saved === "dark");
    })();
  </script>
</head>
<body class="bg-bg-light dark:bg-bg-dark text-gray-800 dark:text-gray-200 font-sans h-screen flex overflow-hidden selection:bg-accent selection:text-primaryDark">
  <canvas id="nexusCanvas"></canvas>
  <div class="fixed inset-0 bg-gradient-to-b from-white/40 to-white/80 dark:from-black/40 dark:to-[#050505]/90 pointer-events-none z-[1]"></div>

  <aside class="relative z-20 hidden xl:flex flex-col w-[280px] h-[calc(100vh-2rem)] my-4 mx-4 bg-card-light dark:bg-card-dark glass-panel rounded-3xl border border-border-light dark:border-border-dark overflow-hidden shrink-0">
    <div class="flex items-center gap-3 p-6 border-b border-border-light dark:border-border-dark shrink-0">
      <div class="w-12 h-12 flex items-center justify-center rounded-2xl bg-primary dark:bg-accent text-white dark:text-black shadow-lg"><span class="material-symbols-outlined text-[28px]">shield_person</span></div>
      <div><h1 class="font-display font-bold text-xl leading-none text-primary dark:text-white">عائلة خاشقجي</h1><p class="text-[10px] font-bold text-gray-500 dark:text-accent uppercase tracking-widest mt-1.5">نظام الإدارة المركزية</p></div>
    </div>
    <nav class="flex-1 overflow-y-auto p-4 space-y-6">
      <div class="space-y-2">
        <p class="px-3 text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-3">نظرة عامة</p>
        <a href="/admin/dashboard" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          
          <span class="material-symbols-outlined text-[22px]">dashboard</span> لوحة الإحصائيات
        </a>
      </div>

      <div class="space-y-2">
        <p class="px-3 text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-3">إدارة البيانات</p>
        <a href="/admin" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          
          <span class="material-symbols-outlined text-[22px]">group</span> إدارة الأفراد
        </a>
        <% if (typeof userCan === "function" && userCan("person_requests")) { %>
        <a href="/admin/person-requests" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          
          <span class="material-symbols-outlined text-[22px]">fact_check</span> طلبات الأفراد
        </a>
        <% } %>
        <a href="/admin/pages" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          
          <span class="material-symbols-outlined text-[22px]">history_edu</span> إدارة الصفحات
        </a>
        <a href="/admin/honor" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          
          <span class="material-symbols-outlined text-[22px]">workspace_premium</span> السير الذاتية
        </a>
        <a href="/admin/news" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          
          <span class="material-symbols-outlined text-[22px]">newspaper</span> الأخبار والمناسبات
        </a>
        <a href="/admin/support-messages" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          
          <span class="material-symbols-outlined text-[22px]">mail</span> رسائل الدعم
        </a>
      </div>

      <div class="space-y-2">
        <p class="px-3 text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-3">النظام والصلاحيات</p>
        <% if (typeof userCan === "function" && userCan("roles")) { %>
        <a href="/admin/roles" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          
          <span class="material-symbols-outlined text-[22px]">manage_accounts</span> وظائف الأفراد
        </a>
        <% } %>
        <% if (Number(admin?.is_super_admin || 0) === 1) { %>
        <a href="/admin/activity" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl bg-primary/10 dark:bg-accent/10 text-primary dark:text-accent font-bold text-sm border border-primary/20 dark:border-accent/20 transition-all relative overflow-hidden shadow-sm">
          <div class="absolute right-0 top-1/2 -translate-y-1/2 w-1.5 h-6 rounded-l-full bg-primary dark:bg-accent shadow-[0_0_10px_rgba(229,184,105,0.8)]"></div>
          <span class="material-symbols-outlined text-[22px]">manage_history</span> سجل النشاطات
        </a>
        <a href="/admin/maintenance" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          
          <span class="material-symbols-outlined text-[22px]">construction</span> وضع الصيانة
        </a>
        <% } %>
        <a href="/" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-gray-600 dark:text-gray-400 hover:bg-white dark:hover:bg-white/5 hover:text-primary dark:hover:text-accent font-bold text-sm transition-colors border border-transparent">
          
          <span class="material-symbols-outlined text-[22px]">account_tree</span> عرض الشجرة
        </a>
      </div>
    </nav>
    <div class="p-4 border-t border-border-light dark:border-border-dark shrink-0 m-2 rounded-2xl bg-white/50 dark:bg-black/30">
      <div class="flex items-center gap-3"><div class="w-10 h-10 rounded-full bg-primary/10 dark:bg-accent/10 flex items-center justify-center text-primary dark:text-accent border border-gray-200 dark:border-white/10 shadow-sm"><span class="material-symbols-outlined text-[20px]">person</span></div><div class="flex-1 min-w-0"><p class="text-sm font-bold text-gray-900 dark:text-white truncate"><%= admin?.username || "مدير النظام" %></p><p class="text-[10px] text-primary dark:text-accent uppercase tracking-widest mt-0.5 font-bold">Admin</p></div><form method="post" action="/admin/logout" class="m-0"><button type="submit" class="w-9 h-9 flex items-center justify-center rounded-xl bg-red-50 dark:bg-red-500/10 text-red-500 hover:bg-red-500 hover:text-white transition-all shadow-sm" title="تسجيل خروج"><span class="material-symbols-outlined text-[18px]">logout</span></button></form></div>
    </div>
  </aside>

  <main class="flex-1 flex flex-col min-w-0 h-full relative z-10">
    <header class="flex items-center justify-between p-4 lg:p-8 shrink-0">
      <div class="flex items-center gap-3">
        <button id="mobileNavBtn" onclick="return window.openAdminMobileMenu ? window.openAdminMobileMenu(event) : false" class="xl:hidden flex items-center justify-center w-12 h-12 rounded-2xl bg-card-light dark:bg-card-dark glass-panel border border-border-light dark:border-border-dark text-primary dark:text-accent shadow-sm" type="button"><span class="material-symbols-outlined text-[24px]">menu</span></button>
        <div><h2 class="text-2xl md:text-3xl font-display font-bold text-primary dark:text-white tracking-tight leading-none mb-1.5">سجل النشاطات</h2><div class="flex items-center gap-1.5 text-gray-500 text-[11px] font-bold uppercase tracking-widest"><span>لوحة الإدارة</span><span class="material-symbols-outlined text-[14px]">chevron_left</span><span>النظام والموقع</span><span class="material-symbols-outlined text-[14px]">chevron_left</span><span class="text-accent">سجل النشاطات</span></div></div>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <button id="themeBtn" class="flex items-center justify-center w-12 h-12 rounded-2xl bg-card-light dark:bg-card-dark glass-panel border border-border-light dark:border-border-dark text-gray-600 dark:text-accent shadow-sm hover:-translate-y-1 transition-transform" type="button" title="تبديل المظهر"><span class="material-symbols-outlined text-[22px] dark-toggle-icon-moon">dark_mode</span><span class="material-symbols-outlined hidden dark:block text-[24px]">light_mode</span></button>
        <a href="/admin/dashboard" class="flex items-center gap-2 px-6 h-12 rounded-2xl font-bold text-sm bg-card-light dark:bg-card-dark glass-panel border border-border-light dark:border-border-dark text-primary dark:text-accent shadow-sm hover:-translate-y-1 transition-transform"><span class="material-symbols-outlined text-[22px]">dashboard</span><span class="hidden sm:inline">الإحصائيات</span></a>
        <a href="/admin/person-requests" class="flex items-center gap-3 px-4 py-4 rounded-2xl border border-transparent hover:bg-gray-50 dark:hover:bg-white/5 transition-colors"><span class="material-symbols-outlined text-gray-400">fact_check</span> طلبات الأفراد</a>
        <a href="/admin/maintenance" class="flex items-center gap-2 px-6 h-12 rounded-2xl font-bold text-sm bg-primary dark:bg-accent text-white dark:text-black shadow-sm hover:-translate-y-1 transition-transform"><span class="material-symbols-outlined text-[22px]">construction</span><span class="hidden sm:inline">وضع الصيانة</span></a>
      </div>
    </header>

    <div class="flex-1 overflow-y-auto px-4 lg:px-8 pb-12">
      <div class="max-w-[100rem] mx-auto space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 lg:gap-6">
          <div class="bg-card-light dark:bg-card-dark glass-panel rounded-[2rem] border border-border-light dark:border-border-dark p-5 flex items-center gap-4 shadow-sm xl:col-span-2">
            <div class="w-14 h-14 rounded-2xl bg-primary/10 dark:bg-accent/10 flex items-center justify-center text-primary dark:text-accent"><span class="material-symbols-outlined text-[28px]">manage_history</span></div>
            <div><p class="text-[11px] font-bold text-gray-500 uppercase tracking-widest mb-0.5">ملخص الصفحة</p><p class="text-xl font-black text-primary dark:text-white leading-none">آخر 250 عملية داخل لوحة الإدارة</p></div>
          </div>
          <div class="bg-card-light dark:bg-card-dark glass-panel rounded-[2rem] border border-border-light dark:border-border-dark p-5 flex items-center gap-4 shadow-sm"><div class="w-14 h-14 rounded-2xl bg-blue-100 dark:bg-blue-500/15 flex items-center justify-center text-blue-700 dark:text-blue-300"><span class="material-symbols-outlined text-[28px]">list_alt</span></div><div><p class="text-[11px] font-bold text-gray-500 uppercase tracking-widest mb-0.5">إجمالي السجلات</p><p class="text-3xl font-black text-primary dark:text-white leading-none"><%= (logs || []).length %></p></div></div>
          <div class="bg-card-light dark:bg-card-dark glass-panel rounded-[2rem] border border-border-light dark:border-border-dark p-5 flex items-center gap-4 shadow-sm"><div class="w-14 h-14 rounded-2xl bg-green-100 dark:bg-green-500/15 flex items-center justify-center text-green-700 dark:text-green-300"><span class="material-symbols-outlined text-[28px]">person_search</span></div><div><p class="text-[11px] font-bold text-gray-500 uppercase tracking-widest mb-0.5">آخر مستخدم</p><p class="text-xl font-black text-primary dark:text-white leading-none"><%= logs?.[0]?.admin_username || '—' %></p></div></div>
        </div>

        <section class="bg-card-light dark:bg-card-dark glass-panel rounded-3xl shadow-sm border border-border-light dark:border-border-dark overflow-hidden">
          <div class="p-5 border-b border-border-light dark:border-border-dark flex items-center justify-between gap-4 flex-wrap">
            <div>
              <h3 class="font-black text-lg text-primary dark:text-white">تفاصيل السجل</h3>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">يعرض النشاط والمستخدم ونوع السجل والرقم المرجعي وعنوان IP وتوقيت العملية.</p>
            </div>
            <div class="px-4 py-2 rounded-xl bg-white/60 dark:bg-white/5 border border-black/5 dark:border-white/10 text-xs font-bold text-gray-500 dark:text-gray-300">عرض مباشر ومتناسق مع لوحة التحكم</div>
          </div>
          <div class="overflow-x-auto p-2">
            <table class="w-full min-w-[1100px] text-sm text-right border-separate border-spacing-y-2">
              <thead>
                <tr>
                  <th class="py-3 px-6 font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest text-[11px]">التاريخ</th>
                  <th class="py-3 px-6 font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest text-[11px]">المستخدم</th>
                  <th class="py-3 px-6 font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest text-[11px]">النشاط</th>
                  <th class="py-3 px-6 font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest text-[11px]">النوع</th>
                  <th class="py-3 px-6 font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest text-[11px]">الرقم</th>
                  <th class="py-3 px-6 font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest text-[11px]">IP</th>
                </tr>
              </thead>
              <tbody>
                <% (logs || []).forEach(function(l) { %>
                  <tr class="interactive-row bg-gray-50/50 dark:bg-white/5 border border-transparent border-b-gray-100 dark:border-b-white/5">
                    <td class="py-4 px-6 rounded-r-xl font-bold whitespace-nowrap"><%= l.created_at %></td>
                    <td class="py-4 px-6"><span class="inline-flex items-center gap-2"><span class="w-9 h-9 rounded-xl bg-primary/10 dark:bg-accent/10 flex items-center justify-center text-primary dark:text-accent"><span class="material-symbols-outlined text-[18px]">person</span></span><span class="font-bold"><%= l.admin_username || '-' %></span></span></td>
                    <td class="py-4 px-6"><span class="font-black text-gray-900 dark:text-white"><%= l.action %></span></td>
                    <td class="py-4 px-6 text-gray-600 dark:text-gray-300 font-medium"><%= l.entity_type || '-' %></td>
                    <td class="py-4 px-6"><span class="inline-flex px-3 py-1 rounded-lg bg-white dark:bg-black/30 border border-black/5 dark:border-white/10 font-bold"><%= l.entity_id || '-' %></span></td>
                    <td class="py-4 px-6 rounded-l-xl text-gray-500 dark:text-gray-400 font-medium"><%= l.ip_address || '-' %></td>
                  </tr>
                <% }) %>
                <% if (!logs || !logs.length) { %>
                  <tr><td colspan="6" class="p-10 text-center text-gray-500 font-bold">لا توجد نشاطات مسجلة بعد.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
  </main>

  <aside id="mobileNavDrawer" class="fixed top-0 left-0 h-full w-[320px] max-w-[85vw] bg-card-light dark:bg-card-dark glass-panel border-r border-border-light dark:border-border-dark z-[90] flex flex-col">
    <div class="h-1.5 w-full bg-primary"></div>
